# Sample environment file for the apache/hop image (hop-run and Hop Server).
#
# Copy this file, uncomment what you need and pass it to the container:
#
#   docker run --rm --env-file hop.env -v /path/to/project:/files apache/hop:<tag>
#
# This file is for 'docker run --env-file' only. Do not use it as a Docker Compose
# 'env_file': Compose strips quotes and expands ${...}, which breaks the quoted
# Azure key and HOP_FILE_PATH below.
#
# Notes on the file format (docker run --env-file):
#   - One VARIABLE=value per line. Everything after the first '=' is the value,
#     quotes included. Do not wrap values in quotes.
#   - Lines starting with '#' are comments. Comments after a value are not supported.
#   - A line with only a variable name (no '=') copies that variable from the
#     shell that runs 'docker run'. Use this for secrets so they stay out of the file.
#
# Values passed as environment variables are visible to anyone who can run
# 'docker inspect'. The values in HOP_CONFIG_OPTIONS are also printed to the
# container log ('docker logs'). Prefer mounted key files or a variable resolver
# (AWS Secrets Manager, Azure Key Vault, Google Secret Manager, HashiCorp Vault)
# for credentials.
#
# Documentation:
#   https://hop.apache.org/manual/latest/docker-container.html
#   https://hop.apache.org/manual/latest/docker-container.html#CloudCredentials

#
# Project and execution
#

HOP_LOG_LEVEL=Basic
#HOP_PROJECT_NAME=my-project
#HOP_PROJECT_FOLDER=/files
#HOP_ENVIRONMENT_NAME=my-project-prod
#HOP_ENVIRONMENT_CONFIG_FILE_NAME_PATHS=/files/config/my-project-prod.json

# Run a pipeline or workflow (short-lived container). Leave HOP_FILE_PATH empty
# to start a long-lived Hop Server instead.
#HOP_FILE_PATH=${PROJECT_HOME}/main.hwf
#HOP_RUN_CONFIG=local
#HOP_RUN_PARAMETERS=PARAM_1=value1,PARAM_2=value2

# Restricted JDBC drivers to download on start-up (Oracle, MySQL, ...).
#HOP_DRIVERS_DOWNLOAD=oracle,mariadb
#HOP_DRIVERS_ACCEPT_LICENSE=true

#
# Hop configuration (hop-conf)
#
# HOP_CONFIG_OPTIONS is passed to hop-conf.sh before Hop starts.
# Separate options with spaces. Quote a value that contains spaces,
# for example: --azure-account=myaccount --describe-variable=FOO="A description"
# The Azure, Google Cloud, Google Drive and Dropbox defaults below all go into
# this one variable: combine the options you need on a single line.
#
#HOP_CONFIG_OPTIONS=

#
# Amazon S3 (s3://)
#
# Hop uses the AWS SDK default credential chain, so the standard AWS variables
# work without any Hop configuration. Leave the secrets without a value to copy
# them from your shell.
#
#AWS_ACCESS_KEY_ID
#AWS_SECRET_ACCESS_KEY
#AWS_SESSION_TOKEN
#AWS_REGION=eu-west-1
#
# Or mount a credentials file and pick a profile:
#   -v ~/.aws:/home/hop/.aws:ro
#AWS_PROFILE=default

#
# Google Cloud Storage (gs://)
#
# Mount a service account key file, for example with -v /path/to/keys:/keys:ro,
# and point the standard Google variable at it:
#
#GOOGLE_APPLICATION_CREDENTIALS=/keys/gcp-service-account.json
#
# Or configure it in Hop:
#HOP_CONFIG_OPTIONS=--google-cloud-service-account-key-file=/keys/gcp-service-account.json

#
# Azure Storage (azure://)
#
# The default azure:// file system uses a storage account name and key.
# The key can be encrypted with 'hop-encrypt.sh -hop <key>'. The result contains
# a space, so quote it.
#
#HOP_CONFIG_OPTIONS=--azure-account=mystorageaccount --azure-key="Encrypted <hex string printed by hop-encrypt.sh>"
#
# Managed identity or a service principal (AZURE_CLIENT_ID, AZURE_TENANT_ID,
# AZURE_CLIENT_SECRET) only works with an Azure Storage connection in the
# project metadata that uses the 'Managed Identity' authentication type.

#
# Google Drive (googledrive://)
#
# Requires a credentials file and a tokens folder that already holds a token.
# The token is created by an interactive browser login, so generate it with
# Hop GUI on a desktop first and mount both into the container.
# The credentials file can stay on the read-only /keys mount. Hop writes to the
# tokens folder, so mount it read-write and make it owned by uid 501 (the 'hop'
# user in the image):
#   chown -R 501 /path/to/google-drive-tokens
#   -v /path/to/google-drive-tokens:/home/hop/google-drive-tokens
#
#HOP_CONFIG_OPTIONS=--google-drive-credentials-file=/keys/google-drive-credentials.json --google-drive-tokens-folder=/home/hop/google-drive-tokens

#
# Dropbox (dropbox://)
#
#HOP_CONFIG_OPTIONS=--dropbox-access-token=your-access-token

#
# Named connections (S3, MinIO, Azure, Google Cloud Storage, ...)
#
# Connections defined as metadata in your project are read from the project,
# not from this file. Use variables such as ${S3_SECRET_KEY} in the connection
# and provide them through the environment config file
# (HOP_ENVIRONMENT_CONFIG_FILE_NAME_PATHS) or as system properties:
#
#HOP_SYSTEM_PROPERTIES=S3_ACCESS_KEY=my-key,S3_SECRET_KEY=my-secret

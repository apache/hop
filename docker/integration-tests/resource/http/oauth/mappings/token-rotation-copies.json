{
  "mappings": [
    {
      "name": "copies token endpoint: first token",
      "scenarioName": "token-rotation-copies",
      "requiredScenarioState": "Started",
      "newScenarioState": "issued-1",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/copies/token",
        "bodyPatterns": [{ "contains": "grant_type=client_credentials" }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "access_token": "token-1", "token_type": "Bearer", "expires_in": 3600 }
      }
    },
    {
      "name": "copies api: token-1, first use",
      "scenarioName": "token-rotation-copies",
      "requiredScenarioState": "issued-1",
      "newScenarioState": "used-1",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/copies/items",
        "headers": { "Authorization": { "equalTo": "Bearer token-1" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "token": "token-1" }
      }
    },
    {
      "name": "copies api: token-1, second use",
      "scenarioName": "token-rotation-copies",
      "requiredScenarioState": "used-1",
      "newScenarioState": "used-2",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/copies/items",
        "headers": { "Authorization": { "equalTo": "Bearer token-1" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "token": "token-1" }
      }
    },
    {
      "name": "copies token endpoint: second token, only after token-1 stopped being accepted",
      "scenarioName": "token-rotation-copies",
      "requiredScenarioState": "used-2",
      "newScenarioState": "issued-2",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/copies/token",
        "bodyPatterns": [{ "contains": "grant_type=client_credentials" }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "access_token": "token-2", "token_type": "Bearer", "expires_in": 3600 }
      }
    },
    {
      "name": "copies api: token-2 is accepted in every state",
      "priority": 2,
      "request": {
        "method": "GET",
        "urlPath": "/copies/items",
        "headers": { "Authorization": { "equalTo": "Bearer token-2" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "token": "token-2" }
      }
    },
    {
      "name": "copies api: anything else, including token-1 from its third use on, is rejected",
      "priority": 10,
      "request": { "method": "GET", "urlPath": "/copies/items" },
      "response": {
        "status": 401,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "invalid_token" }
      }
    },
    {
      "name": "copies token endpoint: a third token request means a copy fetched its own token",
      "priority": 10,
      "request": { "method": "POST", "urlPath": "/copies/token" },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "invalid_request", "error_description": "unexpected token request" }
      }
    }
  ]
}

#
# Spark on Kubernetes image for the native Spark engine's cluster mode: driver and executor pods.
# Spark's own images run Java 17; the Hop classes in the fat jar need Java 21. The Kubernetes
# entrypoint and decommission scripts come with the Spark distribution.
#
#   docker build -f Dockerfile.kubernetes --build-arg SPARK_VERSION=4.1.3 -t hop-spark-kubernetes:4.1.3 .
#
# Run configuration: master k8s://https://<api server>, deploy mode Cluster, and in the Spark config
#   spark.kubernetes.container.image=hop-spark-kubernetes:4.1.3
FROM eclipse-temurin:21-jre-jammy

ARG SPARK_VERSION=4.1.3
ARG HADOOP_VERSION=3
ARG BASE_URL=https://dlcdn.apache.org/spark
ARG ARCHIVE_URL=https://archive.apache.org/dist/spark

ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${PATH}"

RUN apt-get update \
      && apt-get install -y --no-install-recommends curl bash procps tini \
      && rm -rf /var/lib/apt/lists/* \
      && SPARK_TGZ="spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz" \
      && ( curl -fSL --connect-timeout 30 --retry 3 --retry-delay 5 --retry-all-errors \
             --speed-limit 10240 --speed-time 60 \
             "${BASE_URL}/spark-${SPARK_VERSION}/${SPARK_TGZ}" -o /tmp/spark.tgz \
           || curl -fSL --connect-timeout 30 --retry 5 --retry-delay 5 --retry-all-errors \
             "${ARCHIVE_URL}/spark-${SPARK_VERSION}/${SPARK_TGZ}" -o /tmp/spark.tgz ) \
      && tar -xzf /tmp/spark.tgz -C /opt \
      && mv /opt/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION} ${SPARK_HOME} \
      && rm /tmp/spark.tgz \
      && cp ${SPARK_HOME}/kubernetes/dockerfiles/spark/entrypoint.sh /opt/entrypoint.sh \
      && cp ${SPARK_HOME}/kubernetes/dockerfiles/spark/decom.sh /opt/decom.sh \
      && chmod +x /opt/entrypoint.sh /opt/decom.sh \
      && mkdir -p ${SPARK_HOME}/work-dir

WORKDIR /opt/spark/work-dir
ENTRYPOINT ["/opt/entrypoint.sh"]

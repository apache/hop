<!--
  Local-only test users for Hop Web multi-role auth.
  Mount this directory as /config (see run-hop-web-local-with-users.sh).

  Passwords are plain text for easy local testing — do not use in production.
  Role names map to Hop built-in roles (see hop-web.adoc Authentication).
-->
<tomcat-users>
  <role rolename="hop-admin"/>
  <role rolename="hop-user"/>
  <role rolename="hop-operator"/>
  <role rolename="hop-readonly"/>

  <!-- Admin: full access including future security administration -->
  <user username="admin" password="admin" roles="hop-admin"/>
  <!-- User/developer: CRUD + execute -->
  <user username="developer" password="developer" roles="hop-user"/>
  <!-- Operator: view + execute only -->
  <user username="operator" password="operator" roles="hop-operator"/>
  <!-- Read-only: view only -->
  <user username="viewer" password="viewer" roles="hop-readonly"/>
</tomcat-users>

<!--
  Default Log4j2 configuration for Apache Hop.

  Hop's in-memory ``LoggingBuffer`` is always fed synchronously by ``LogChannel`` through
  ``HopLogStore``; ``Slf4jLoggingEventListener`` forwards those events to SLF4J. This file turns the
  SLF4J output into something the operator can see once ``log4j-slf4j2-impl`` provides the binding.

  It is intentionally small: the console appender is present so text logs are visible out of the
  box, and a custom ``log4j2.xml`` on the classpath overrides this one entirely (e.g. to add a JSON,
  Kafka or OpenTelemetry appender without touching Hop code). The Hop buffer is independent of this
  file so removing the console appender does not empty the GUI or the hop-server.
  -->
<Configuration status="WARN">
  <Appenders>
    <Console name="hopConsole" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{ISO8601} %-5p [%logger{40}] - %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="org.apache.hop" level="info"/>
    <Root level="warn">
      <AppenderRef ref="hopConsole"/>
    </Root>
  </Loggers>
</Configuration>
# Line endings are fixed by the repository, not by the platform or core.autocrlf, so a
# checkout (and the hop-client zip built from it) has the same bytes on every machine.
#
# Text files check out with LF everywhere. Git detects text vs. binary on its own, and a
# file already committed with CRLF keeps its CRLF (test data that needs it stays as is).
* text=auto eol=lf

# Unix scripts: always LF, a CR breaks the shebang line
*.sh text eol=lf
mvnw text eol=lf
assemblies/static/src/main/resources/hop text eol=lf
*Dockerfile text eol=lf

# Windows scripts: always CRLF, cmd.exe mis-parses labels and GOTO in LF batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
*.bz2 binary
*.xls binary
*.xlsx binary
*.ods binary
*.parquet binary
*.avro binary
*.dbf binary
*.p12 binary
*.jks binary
*.keystore binary
*.truststore binary
*.ser binary

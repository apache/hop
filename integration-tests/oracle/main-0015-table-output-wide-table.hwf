      <parallel>N</parallel>
      <xloc>128</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables (non-Unicode)</name>
      <description>Source and target have the same 1000 columns: ID, the CLOB C0001, an NVARCHAR2 for every tenth column and a VARCHAR2 for the rest. Row 1 fills every column, with national text in the NVARCHAR2 columns and a 64000 character CLOB; row 2 is all nulls; row 3 has short values throughout, and rows 4 to 200 copy it with a C0002 of their own, so a row bound into the wrong place of a statement shows.</description>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE

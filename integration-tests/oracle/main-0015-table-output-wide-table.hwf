<workflow>
  <name>main-0015-table-output-wide-table</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>A Table input to Table output copy of a 1000-column table of 200 rows, with a Table output that asks for 100 rows per INSERT statement. Oracle writes one row per statement whatever is asked for: an INSERT ... SELECT ... FROM dual UNION ALL of 65 rows of 1000 columns took Oracle about 50 seconds to parse, and the driver's description of its parameters, which binding a string needs, did not finish. The table mixes VARCHAR2, NVARCHAR2 and a CLOB like 0012, so national text and a value longer than a VARCHAR2 can hold must arrive intact, on the Unicode database and on the non-Unicode one, where national text bound as a plain string is lost.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/27 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/27 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unicode database</name>
      <description>The pipeline takes its connection from this variable.</description>
      <type>SET_VARIABLES</type>
      <attributes/>
      <replacevars>Y</replacevars>
      <filename/>
      <file_variable_type>JVM</file_variable_type>
      <fields>
        <field>
          <variable_name>ORACLE_CONNECTION</variable_name>
          <variable_value>oracle-service-name</variable_value>
          <variable_type>ROOT_WORKFLOW</variable_type>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>128</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description>Source and target have the same 1000 columns: ID, the CLOB C0001, an NVARCHAR2 for every tenth column and a VARCHAR2 for the rest. Row 1 fills every column, with national text in the NVARCHAR2 columns and a 64000 character CLOB; row 2 is all nulls; row 3 has short values throughout, and rows 4 to 200 copy it with a C0002 of their own, so a row bound into the wrong place of a statement shows.</description>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  table_missing EXCEPTION;
  PRAGMA EXCEPTION_INIT(table_missing, -942);
  -- Written as escapes so nothing depends on the client's NLS settings.
  japanese_literal CONSTANT VARCHAR2(100) := 'UNISTR(''\65E5\672C\8A9E\30C6\30AD\30B9\30C8'')';
  column_name VARCHAR2(10);
  ddl CLOB := 'ID NUMBER(10)';
  column_list CLOB := 'ID';
  copy_list CLOB;
  row_one CLOB := '1';
  row_three CLOB := '3';
  long_text CLOB;

  FUNCTION column_type(i PLS_INTEGER) RETURN VARCHAR2 IS
  BEGIN
    IF i = 1 THEN
      RETURN 'CLOB';
    ELSIF MOD(i, 10) = 0 THEN
      RETURN 'NVARCHAR2(20)';
    ELSE
      RETURN 'VARCHAR2(20)';
    END IF;
  END;
BEGIN
  BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE HOP_WIDE_MR_SOURCE PURGE';
  EXCEPTION
    WHEN table_missing THEN NULL;
  END;
  BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE HOP_WIDE_MR_TARGET PURGE';
  EXCEPTION
    WHEN table_missing THEN NULL;
  END;

  FOR i IN 1..999 LOOP
    column_name := 'C' || TO_CHAR(i, 'FM0000');
    ddl := ddl || ', ' || column_name || ' ' || column_type(i);
    column_list := column_list || ', ' || column_name;
    IF i = 1 THEN
      copy_list := column_name;
    ELSIF i = 2 THEN
      copy_list := copy_list || ', ''r'' || TO_CHAR(:k)';
    ELSE
      copy_list := copy_list || ', ' || column_name;
    END IF;
    IF i = 1 THEN
      row_one := row_one || ', :long_text';
      row_three := row_three || ', TO_CLOB(''short clob'')';
    ELSIF MOD(i, 10) = 0 THEN
      row_one := row_one || ', ' || japanese_literal;
      row_three := row_three || ', ' || japanese_literal;
    ELSE
      row_one := row_one || ', ''v' || i || '''';
      row_three := row_three || ', ''w' || i || '''';
    END IF;
  END LOOP;

  EXECUTE IMMEDIATE 'CREATE TABLE HOP_WIDE_MR_SOURCE (' || ddl || ')';
  EXECUTE IMMEDIATE 'CREATE TABLE HOP_WIDE_MR_TARGET (' || ddl || ')';

  -- 64000 characters: past the 4000 a VARCHAR2 holds, so it only arrives if the CLOB column was
  -- recognised and the value streamed.
  long_text := TO_CLOB(RPAD('0123456789', 4000, '0123456789'));
  FOR i IN 1..4 LOOP
    long_text := long_text || long_text;
  END LOOP;

  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_MR_SOURCE (' || column_list || ') VALUES (' || row_one || ')'
    USING long_text;
  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_MR_SOURCE (ID) VALUES (2)';
  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_MR_SOURCE (' || column_list || ') VALUES (' || row_three || ')';
  FOR i IN 4..200 LOOP
    EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_MR_SOURCE (' || column_list || ') SELECT :id, '
      || copy_list || ' FROM HOP_WIDE_MR_SOURCE WHERE ID = 3'
      USING i, i;
  END LOOP;
  COMMIT;
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0015-table-output-wide-table.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0015-table-output-wide-table.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check what was stored</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  found NUMBER;
  column_name VARCHAR2(10);
  column_list CLOB := 'ID';
BEGIN
  SELECT COUNT(*) INTO found FROM HOP_WIDE_MR_TARGET;
  IF found != 200 THEN
    RAISE_APPLICATION_ERROR(-20150, 'expected 200 rows but found ' || found);
  END IF;

  -- Every column but the CLOB, compared both ways. MINUS treats two nulls as equal, so this also
  -- covers the row of nulls, and a national character turned into a question mark shows up as a
  -- difference.
  FOR i IN 2..999 LOOP
    column_name := 'C' || TO_CHAR(i, 'FM0000');
    column_list := column_list || ', ' || column_name;
  END LOOP;
  EXECUTE IMMEDIATE
    'SELECT COUNT(*) FROM ('
      || '(SELECT ' || column_list || ' FROM HOP_WIDE_MR_SOURCE MINUS SELECT ' || column_list || ' FROM HOP_WIDE_MR_TARGET)'
      || ' UNION ALL '
      || '(SELECT ' || column_list || ' FROM HOP_WIDE_MR_TARGET MINUS SELECT ' || column_list || ' FROM HOP_WIDE_MR_SOURCE))'
    INTO found;
  IF found != 0 THEN
    RAISE_APPLICATION_ERROR(-20151,
      found || ' rows differ between source and target in the VARCHAR2 and NVARCHAR2 columns');
  END IF;

  -- The CLOB has to arrive whole: a value cut to 4000 would still leave the row behind.
  SELECT COUNT(*) INTO found
  FROM HOP_WIDE_MR_SOURCE s
  JOIN HOP_WIDE_MR_TARGET t ON t.ID = s.ID
  WHERE (s.C0001 IS NULL AND t.C0001 IS NULL)
     OR DBMS_LOB.COMPARE(s.C0001, t.C0001) = 0;
  IF found != 200 THEN
    RAISE_APPLICATION_ERROR(-20152, 'the CLOB column did not survive the write in ' || (200 - found) || ' rows');
  END IF;

  SELECT DBMS_LOB.GETLENGTH(C0001) INTO found FROM HOP_WIDE_MR_TARGET WHERE ID = 1;
  IF found != 64000 THEN
    RAISE_APPLICATION_ERROR(-20153, 'the CLOB value should be 64000 characters but is ' || found);
  END IF;
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>512</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Non-Unicode database</name>
      <description>The same copy on the WE8MSWIN1252 database, where a national character bound as a plain string is lost.</description>

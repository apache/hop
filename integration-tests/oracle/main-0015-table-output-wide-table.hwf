  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_MR_SOURCE (' || column_list || ') VALUES (' || row_one || ')'
    USING long_text;
  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_MR_SOURCE (ID) VALUES (2)';
  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_MR_SOURCE (' || column_list || ') VALUES (' || row_three || ')';
  FOR i IN 4..200 LOOP
    EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_MR_SOURCE (' || column_list || ') SELECT :id, '
      || copy_list || ' FROM HOP_WIDE_MR_SOURCE WHERE ID = 3'
      USING i, i;
  END LOOP;
  COMMIT;
END;</sql>

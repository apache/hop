<workflow>
  <name>main-0012-wide-table-write</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>A Table input to Table output copy of a 1000-column table, the most Oracle allows. To bind a string, Oracle needs to know whether its column is VARCHAR2, NVARCHAR2 or CLOB, and Hop asks the driver for the statement's parameter metadata. The driver answers by parsing the INSERT with a recursive parser whose depth grows with the number of columns, which used to overflow the 1 MB stack of a transform thread on Linux with a StackOverflowError (#9420). The table mixes VARCHAR2, NVARCHAR2 and a CLOB, so the copy also proves the column types were still found: national text and a value longer than a VARCHAR2 can hold must arrive intact.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/11 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/11 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description>Source and target have the same 1000 columns: ID, the CLOB C0001, an NVARCHAR2 for every tenth column and a VARCHAR2 for the rest. Row 1 fills every column, with national text in the NVARCHAR2 columns and a 64000 character CLOB; row 2 is all nulls; row 3 has short values throughout.</description>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  table_missing EXCEPTION;
  PRAGMA EXCEPTION_INIT(table_missing, -942);
  -- Written as escapes so nothing depends on the client's NLS settings.
  japanese_literal CONSTANT VARCHAR2(100) := 'UNISTR(''\65E5\672C\8A9E\30C6\30AD\30B9\30C8'')';
  column_name VARCHAR2(10);
  ddl CLOB := 'ID NUMBER(10)';
  column_list CLOB := 'ID';
  row_one CLOB := '1';
  row_three CLOB := '3';
  long_text CLOB;

  FUNCTION column_type(i PLS_INTEGER) RETURN VARCHAR2 IS
  BEGIN
    IF i = 1 THEN
      RETURN 'CLOB';
    ELSIF MOD(i, 10) = 0 THEN
      RETURN 'NVARCHAR2(20)';
    ELSE
      RETURN 'VARCHAR2(20)';
    END IF;
  END;
BEGIN
  BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE HOP_WIDE_SOURCE PURGE';
  EXCEPTION
    WHEN table_missing THEN NULL;
  END;
  BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE HOP_WIDE_TARGET PURGE';
  EXCEPTION
    WHEN table_missing THEN NULL;
  END;

  FOR i IN 1..999 LOOP
    column_name := 'C' || TO_CHAR(i, 'FM0000');
    ddl := ddl || ', ' || column_name || ' ' || column_type(i);
    column_list := column_list || ', ' || column_name;
    IF i = 1 THEN
      row_one := row_one || ', :long_text';
      row_three := row_three || ', TO_CLOB(''short clob'')';
    ELSIF MOD(i, 10) = 0 THEN
      row_one := row_one || ', ' || japanese_literal;
      row_three := row_three || ', ' || japanese_literal;
    ELSE
      row_one := row_one || ', ''v' || i || '''';
      row_three := row_three || ', ''w' || i || '''';
    END IF;
  END LOOP;

  EXECUTE IMMEDIATE 'CREATE TABLE HOP_WIDE_SOURCE (' || ddl || ')';
  EXECUTE IMMEDIATE 'CREATE TABLE HOP_WIDE_TARGET (' || ddl || ')';

  -- 64000 characters: past the 4000 a VARCHAR2 holds, so it only arrives if the CLOB column was
  -- recognised and the value streamed.
  long_text := TO_CLOB(RPAD('0123456789', 4000, '0123456789'));
  FOR i IN 1..4 LOOP
    long_text := long_text || long_text;
  END LOOP;

  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_SOURCE (' || column_list || ') VALUES (' || row_one || ')'
    USING long_text;
  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_SOURCE (ID) VALUES (2)';
  EXECUTE IMMEDIATE 'INSERT INTO HOP_WIDE_SOURCE (' || column_list || ') VALUES (' || row_three || ')';
  COMMIT;
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0012-wide-table-write.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0012-wide-table-write.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check what was stored</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  found NUMBER;
  column_name VARCHAR2(10);
  column_list CLOB := 'ID';
BEGIN
  SELECT COUNT(*) INTO found FROM HOP_WIDE_TARGET;
  IF found != 3 THEN
    RAISE_APPLICATION_ERROR(-20120, 'expected 3 rows but found ' || found);
  END IF;

  -- Every column but the CLOB, compared both ways. MINUS treats two nulls as equal, so this also
  -- covers the row of nulls, and a national character turned into a question mark shows up as a
  -- difference.
  FOR i IN 2..999 LOOP
    column_name := 'C' || TO_CHAR(i, 'FM0000');
    column_list := column_list || ', ' || column_name;
  END LOOP;
  EXECUTE IMMEDIATE
    'SELECT COUNT(*) FROM ('
      || '(SELECT ' || column_list || ' FROM HOP_WIDE_SOURCE MINUS SELECT ' || column_list || ' FROM HOP_WIDE_TARGET)'
      || ' UNION ALL '
      || '(SELECT ' || column_list || ' FROM HOP_WIDE_TARGET MINUS SELECT ' || column_list || ' FROM HOP_WIDE_SOURCE))'
    INTO found;
  IF found != 0 THEN
    RAISE_APPLICATION_ERROR(-20121,
      found || ' rows differ between source and target in the VARCHAR2 and NVARCHAR2 columns');
  END IF;

  -- The CLOB has to arrive whole: a value cut to 4000 would still leave the row behind.
  SELECT COUNT(*) INTO found
  FROM HOP_WIDE_SOURCE s
  JOIN HOP_WIDE_TARGET t ON t.ID = s.ID
  WHERE (s.C0001 IS NULL AND t.C0001 IS NULL)
     OR DBMS_LOB.COMPARE(s.C0001, t.C0001) = 0;
  IF found != 3 THEN
    RAISE_APPLICATION_ERROR(-20122, 'the CLOB column did not survive the write');
  END IF;

  SELECT DBMS_LOB.GETLENGTH(C0001) INTO found FROM HOP_WIDE_TARGET WHERE ID = 1;
  IF found != 64000 THEN
    RAISE_APPLICATION_ERROR(-20123, 'the CLOB value should be 64000 characters but is ' || found);
  END IF;
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>576</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Init tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Init tables</from>
      <to>0012-wide-table-write.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0012-wide-table-write.hpl</from>
      <to>check what was stored</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

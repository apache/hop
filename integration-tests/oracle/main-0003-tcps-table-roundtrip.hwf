<workflow>
  <name>main-0003-tcps-table-roundtrip</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Moves real data over the encrypted connection and reads it back through a different one, so the TLS connection is exercised beyond opening a session.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/07/28 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/07/28 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>write over tls</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  table_missing EXCEPTION;
  PRAGMA EXCEPTION_INIT(table_missing, -942);
BEGIN
  BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE HOP_TLS_ROUNDTRIP';
  EXCEPTION
    WHEN table_missing THEN NULL;
  END;
  EXECUTE IMMEDIATE 'CREATE TABLE HOP_TLS_ROUNDTRIP (ID NUMBER(10), LABEL VARCHAR2(50))';
  EXECUTE IMMEDIATE 'INSERT INTO HOP_TLS_ROUNDTRIP SELECT LEVEL, ''row '' || LEVEL FROM dual CONNECT BY LEVEL &lt;= 250';
  COMMIT;
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-tcps-wallet</connection>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>read back over the tns alias</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  rows_found NUMBER;
BEGIN
  SELECT COUNT(*) INTO rows_found FROM HOP_TLS_ROUNDTRIP;
  IF rows_found &lt;&gt; 250 THEN
    RAISE_APPLICATION_ERROR(-20004, 'expected 250 rows written over TLS but found ' || rows_found);
  END IF;
  EXECUTE IMMEDIATE 'DROP TABLE HOP_TLS_ROUNDTRIP';
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-tns-alias</connection>
      <parallel>N</parallel>
      <xloc>496</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>write over tls</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>write over tls</from>
      <to>read back over the tns alias</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

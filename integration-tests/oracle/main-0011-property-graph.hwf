<workflow>
  <name>main-0011-property-graph</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Create a SQL/PGQ property graph from a graph model and query it with GRAPH_TABLE</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/02 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/02 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Drop test graph and tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP PROPERTY GRAPH IF EXISTS SOCIAL_GRAPH;
DROP TABLE IF EXISTS KNOWS;
DROP TABLE IF EXISTS WORKS_AT;
DROP TABLE IF EXISTS PERSON;
DROP TABLE IF EXISTS COMPANY;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create property graph</name>
      <description/>
      <type>CREATE_PROPERTY_GRAPH</type>
      <attributes/>
      <connection>oracle-service-name</connection>
      <schema/>
      <graph_name>SOCIAL_GRAPH</graph_name>
      <graph_model>social</graph_model>
      <create_tables>Y</create_tables>
      <replace_graph>N</replace_graph>
      <node_tables>
      </node_tables>
      <edge_tables>
      </edge_tables>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Load nodes and edges</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO PERSON (ID, NAME) VALUES (1, 'Ann');
INSERT INTO PERSON (ID, NAME) VALUES (2, 'Bob');
INSERT INTO COMPANY (CODE) VALUES ('HOP');
INSERT INTO KNOWS (SOURCE_ID, TARGET_ID, SINCE) VALUES (1, 2, 2020);
INSERT INTO WORKS_AT (SOURCE_ID, TARGET_CODE) VALUES (1, 'HOP');
INSERT INTO WORKS_AT (SOURCE_ID, TARGET_CODE) VALUES (2, 'HOP');</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Ann knows Bob</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>oracle-service-name</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT * FROM GRAPH_TABLE (SOCIAL_GRAPH MATCH (a IS Person) -[k IS KNOWS]-&gt; (b IS Person) COLUMNS (a.name AS a_name, b.name AS b_name, k.since AS since)) WHERE a_name = 'Ann' AND b_name = 'Bob' AND since = 2020</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Two people work at HOP</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>oracle-service-name</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>2</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT * FROM GRAPH_TABLE (SOCIAL_GRAPH MATCH (p IS Person) -[w IS WORKS_AT]-&gt; (c IS Company) COLUMNS (p.name AS p_name, c.code AS code)) WHERE code = 'HOP'</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>992</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Replace property graph</name>
      <description/>
      <type>CREATE_PROPERTY_GRAPH</type>
      <attributes/>
      <connection>oracle-service-name</connection>
      <schema/>
      <graph_name>SOCIAL_GRAPH</graph_name>
      <graph_model>social</graph_model>
      <create_tables>Y</create_tables>
      <replace_graph>Y</replace_graph>
      <node_tables>
      </node_tables>
      <edge_tables>
      </edge_tables>
      <parallel>N</parallel>
      <xloc>992</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Still two people at HOP</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>oracle-service-name</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>2</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT * FROM GRAPH_TABLE (SOCIAL_GRAPH MATCH (p IS Person) -[w IS WORKS_AT]-&gt; (c IS Company) COLUMNS (p.name AS p_name, c.code AS code)) WHERE code = 'HOP'</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Cleanup</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP PROPERTY GRAPH IF EXISTS SOCIAL_GRAPH;
DROP TABLE IF EXISTS KNOWS;
DROP TABLE IF EXISTS WORKS_AT;
DROP TABLE IF EXISTS PERSON;
DROP TABLE IF EXISTS COMPANY;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Drop test graph and tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Drop test graph and tables</from>
      <to>Create property graph</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Create property graph</from>
      <to>Load nodes and edges</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load nodes and edges</from>
      <to>Ann knows Bob</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Ann knows Bob</from>
      <to>Two people work at HOP</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Two people work at HOP</from>
      <to>Replace property graph</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Replace property graph</from>
      <to>Still two people at HOP</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Still two people at HOP</from>
      <to>Cleanup</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

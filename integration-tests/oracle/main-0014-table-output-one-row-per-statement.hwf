<workflow>
  <name>main-0014-table-output-one-row-per-statement</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Table output asking for several rows per INSERT statement on Oracle, which writes one row per statement: a clean load of 2345 rows asking for 100 rows per statement with commit size 1000, and twelve rows asking for 3 rows per statement with commit size 6 and an error hop that must get exactly the three rows the database refuses, every other row written and reported once, with the amounts as sent. Failed batches recovered (KEEPS_PREFIX); a statement-level trigger counts the INSERT executions of the clean load, which are one array execution of one-row INSERTs per commit.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/27 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/27 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS TOMR_CLEAN;
DROP TABLE IF EXISTS TOMR_TARGET;
DROP TABLE IF EXISTS TOMR_WRITTEN;
DROP TABLE IF EXISTS TOMR_REJECTS;
DROP TABLE IF EXISTS TOMR_STMTS;
CREATE TABLE TOMR_CLEAN (ID NUMBER(19) NOT NULL PRIMARY KEY, LABEL VARCHAR(20) NOT NULL, AMOUNT NUMBER(10,2));
CREATE TABLE TOMR_TARGET (ID NUMBER(19) NOT NULL PRIMARY KEY, LABEL VARCHAR(20) NOT NULL, AMOUNT NUMBER(10,2));
CREATE TABLE TOMR_WRITTEN (ID NUMBER(19), LABEL VARCHAR(20), AMOUNT NUMBER(10,2));
CREATE TABLE TOMR_REJECTS (ID NUMBER(19), LABEL VARCHAR(20), AMOUNT NUMBER(10,2), ERR_DESC CLOB, ERR_CODE VARCHAR(20));
CREATE TABLE TOMR_STMTS (TBL VARCHAR(30));
INSERT INTO TOMR_TARGET (ID, LABEL, AMOUNT) VALUES (9000, 'seed', 9.99);
INSERT INTO TOMR_TARGET (ID, LABEL, AMOUNT) VALUES (9001, 'seed', 9.99);
INSERT INTO TOMR_TARGET (ID, LABEL, AMOUNT) VALUES (9002, 'seed', 9.99);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Count statements: trigger</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TRIGGER TOMR_CLEAN_STMT AFTER INSERT ON TOMR_CLEAN
BEGIN
  INSERT INTO TOMR_STMTS (TBL) VALUES ('TOMR_CLEAN');
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0014-table-output-one-row-per-statement-clean.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0014-table-output-one-row-per-statement-clean.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0014-table-output-one-row-per-statement-errors.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0014-table-output-one-row-per-statement-errors.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0014-table-output-one-row-per-statement-check.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0014-table-output-one-row-per-statement-check.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>992</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Init tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Init tables</from>
      <to>Count statements: trigger</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Count statements: trigger</from>
      <to>0014-table-output-one-row-per-statement-clean.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0014-table-output-one-row-per-statement-clean.hpl</from>
      <to>0014-table-output-one-row-per-statement-errors.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0014-table-output-one-row-per-statement-errors.hpl</from>
      <to>0014-table-output-one-row-per-statement-check.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

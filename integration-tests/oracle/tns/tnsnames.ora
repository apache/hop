#
# An alias over ordinary TCP, for the TNS_ADMIN integration test.
#
# The wallet the Oracle container generates carries a tnsnames.ora of its own, but only
# with a TCPS alias in it. This covers the other half: resolving an alias out of a
# tnsnames.ora with no TLS and no wallet anywhere in the picture, which is what most
# Oracle installations use the TNS_ADMIN directory for.
#
# Host and port are literal rather than ${ORACLE_HOST} and ${ORACLE_PORT}, because this
# file is read by the Oracle driver and never passes through Hop's variable
# substitution. Both environments reach the database at oracle:1521 -- the docker one
# over the compose network, the local one through the hosts file entry described in
# dev-env-config-local.json.

HOP_TCP =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = oracle)(PORT = 1521))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = FREEPDB1)
    )
  )

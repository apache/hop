<workflow>
  <name>main-0013-merge-into-table</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Merge into table end to end: insert of new keys, update of seeded keys, a key repeated within a batch, insert only, update only changed rows (counted by an update trigger where the database has one), batch updates on and off, and an error hop that must get exactly the three refused rows while every other row is written once. Oracle: MERGE with a SELECT ... FROM dual source and the changed condition in UPDATE ... WHERE; failed batches are recovered (KEEPS_PREFIX).</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/25 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/25 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS MIT_LOG;
DROP TABLE IF EXISTS MIT_BATCH;
DROP TABLE IF EXISTS MIT_ROWS;
DROP TABLE IF EXISTS MIT_INS;
DROP TABLE IF EXISTS MIT_CHG;
CREATE TABLE MIT_LOG (TBL VARCHAR(20), ID NUMBER(19));
CREATE TABLE MIT_BATCH (ID NUMBER(19) NOT NULL PRIMARY KEY, LABEL VARCHAR(10) NOT NULL, AMOUNT NUMBER(10,2), CONSTRAINT MIT_BATCH_AMOUNT CHECK (AMOUNT &gt;= 0));
INSERT INTO MIT_BATCH (ID, LABEL, AMOUNT) VALUES (1, 'seed', 1.00);
INSERT INTO MIT_BATCH (ID, LABEL, AMOUNT) VALUES (2, 'seed', 1.00);
INSERT INTO MIT_BATCH (ID, LABEL, AMOUNT) VALUES (3, 'seed', 1.00);
CREATE TABLE MIT_ROWS (ID NUMBER(19) NOT NULL PRIMARY KEY, LABEL VARCHAR(10) NOT NULL, AMOUNT NUMBER(10,2), CONSTRAINT MIT_ROWS_AMOUNT CHECK (AMOUNT &gt;= 0));
INSERT INTO MIT_ROWS (ID, LABEL, AMOUNT) VALUES (1, 'seed', 1.00);
INSERT INTO MIT_ROWS (ID, LABEL, AMOUNT) VALUES (2, 'seed', 1.00);
INSERT INTO MIT_ROWS (ID, LABEL, AMOUNT) VALUES (3, 'seed', 1.00);
CREATE TABLE MIT_INS (ID NUMBER(19) NOT NULL PRIMARY KEY, LABEL VARCHAR(10) NOT NULL, AMOUNT NUMBER(10,2), CONSTRAINT MIT_INS_AMOUNT CHECK (AMOUNT &gt;= 0));
INSERT INTO MIT_INS (ID, LABEL, AMOUNT) VALUES (1, 'seed', 1.00);
INSERT INTO MIT_INS (ID, LABEL, AMOUNT) VALUES (2, 'seed', 1.00);
INSERT INTO MIT_INS (ID, LABEL, AMOUNT) VALUES (3, 'seed', 1.00);
CREATE TABLE MIT_CHG (ID NUMBER(19) NOT NULL PRIMARY KEY, LABEL VARCHAR(10) NOT NULL, AMOUNT NUMBER(10,2), CONSTRAINT MIT_CHG_AMOUNT CHECK (AMOUNT &gt;= 0));
INSERT INTO MIT_CHG (ID, LABEL, AMOUNT) VALUES (1, 'seed', 1.00);
INSERT INTO MIT_CHG (ID, LABEL, AMOUNT) VALUES (2, 'seed', 1.00);
INSERT INTO MIT_CHG (ID, LABEL, AMOUNT) VALUES (3, 'seed', 1.00);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log updates of MIT_BATCH</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TRIGGER MIT_BATCH_UPD AFTER UPDATE ON MIT_BATCH FOR EACH ROW
BEGIN
  INSERT INTO MIT_LOG (TBL, ID) VALUES ('MIT_BATCH', :NEW.ID);
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log updates of MIT_ROWS</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TRIGGER MIT_ROWS_UPD AFTER UPDATE ON MIT_ROWS FOR EACH ROW
BEGIN
  INSERT INTO MIT_LOG (TBL, ID) VALUES ('MIT_ROWS', :NEW.ID);
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-service-name</connection>

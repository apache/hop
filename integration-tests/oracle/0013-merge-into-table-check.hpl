<pipeline>
  <info>
    <name>0013-merge-into-table-check</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Checks what the Merge into table pipelines wrote, and how many rows the database really updated.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/25 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Checks</from>
      <to>got &lt;&gt; expected?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>got &lt;&gt; expected?</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>got &lt;&gt; expected?</from>
      <to>ok</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Checks</name>
    <type>TableInput</type>
    <description>One row per check: what the tables hold and what they should.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>oracle-service-name</connection>
    <sql>SELECT 'batch: rows in the table' AS CHK, (SELECT COUNT(*) FROM MIT_BATCH) AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'batch: rows with the expected values' AS CHK, (SELECT COUNT(*) FROM MIT_BATCH WHERE (ID = 1 AND LABEL = 'one' AND AMOUNT = 10.5) OR (ID = 2 AND LABEL = 'two' AND AMOUNT = 2) OR (ID = 3 AND LABEL = 'seed' AND AMOUNT = 1) OR (ID = 5 AND LABEL = 'FIVE' AND AMOUNT = 55) OR (ID = 7 AND LABEL = 'seven' AND AMOUNT = 70) OR (ID = 8 AND LABEL = 'eight' AND AMOUNT = 88)) AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'batch: rows the database updated' AS CHK, (SELECT COUNT(*) FROM MIT_LOG WHERE TBL = 'MIT_BATCH') AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'rows: rows in the table' AS CHK, (SELECT COUNT(*) FROM MIT_ROWS) AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'rows: rows with the expected values' AS CHK, (SELECT COUNT(*) FROM MIT_ROWS WHERE (ID = 1 AND LABEL = 'one' AND AMOUNT = 10.5) OR (ID = 2 AND LABEL = 'two' AND AMOUNT = 2) OR (ID = 3 AND LABEL = 'seed' AND AMOUNT = 1) OR (ID = 5 AND LABEL = 'FIVE' AND AMOUNT = 55) OR (ID = 7 AND LABEL = 'seven' AND AMOUNT = 70) OR (ID = 8 AND LABEL = 'eight' AND AMOUNT = 88)) AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'rows: rows the database updated' AS CHK, (SELECT COUNT(*) FROM MIT_LOG WHERE TBL = 'MIT_ROWS') AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'ins: rows in the table' AS CHK, (SELECT COUNT(*) FROM MIT_INS) AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'ins: rows with the expected values' AS CHK, (SELECT COUNT(*) FROM MIT_INS WHERE (ID = 1 AND LABEL = 'seed' AND AMOUNT = 1) OR (ID = 2 AND LABEL = 'seed' AND AMOUNT = 1) OR (ID = 3 AND LABEL = 'seed' AND AMOUNT = 1) OR (ID = 5 AND LABEL = 'five' AND AMOUNT = 50) OR (ID = 7 AND LABEL = 'seven' AND AMOUNT = 70) OR (ID = 8 AND LABEL = 'eight' AND AMOUNT = 80)) AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'ins: rows the database updated' AS CHK, (SELECT COUNT(*) FROM MIT_LOG WHERE TBL = 'MIT_INS') AS GOT, 0 AS EXPECTED FROM dual
UNION ALL
SELECT 'chg: rows in the table' AS CHK, (SELECT COUNT(*) FROM MIT_CHG) AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'chg: rows with the expected values' AS CHK, (SELECT COUNT(*) FROM MIT_CHG WHERE (ID = 1 AND LABEL = 'one' AND AMOUNT = 10.5) OR (ID = 2 AND LABEL = 'two' AND AMOUNT = 2) OR (ID = 3 AND LABEL = 'seed' AND AMOUNT = 1) OR (ID = 5 AND LABEL = 'FIVE' AND AMOUNT = 55) OR (ID = 7 AND LABEL = 'seven' AND AMOUNT = 70) OR (ID = 8 AND LABEL = 'eight' AND AMOUNT = 88)) AS GOT, 6 AS EXPECTED FROM dual
UNION ALL
SELECT 'chg: rows the database updated' AS CHK, (SELECT COUNT(*) FROM MIT_LOG WHERE TBL = 'MIT_CHG') AS GOT, 4 AS EXPECTED FROM dual</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>got &lt;&gt; expected?</name>
    <type>FilterRows</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Abort</send_true_to>
    <send_false_to>ok</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>GOT</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue>EXPECTED</rightvalue>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description>A check failed: the row is logged.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>A Merge into table check failed</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>48</yloc>
    </GUI>
  </transform>
  <transform>
    <name>ok</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

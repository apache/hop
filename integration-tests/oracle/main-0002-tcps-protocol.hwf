<workflow>
  <name>main-0002-tcps-protocol</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Asks the database itself which protocol carried the session, so a "TLS" connection that quietly fell back to plain TCP cannot pass. The tnsnames alias is the interesting one: its protocol comes from tnsnames.ora rather than from the Use TLS option, and its wallet still has to reach the driver.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/07/28 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/07/28 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>tcps wallet is really tcps</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  actual VARCHAR2(30);
BEGIN
  SELECT SYS_CONTEXT('USERENV', 'NETWORK_PROTOCOL') INTO actual FROM dual;
  IF actual &lt;&gt; 'tcps' THEN
    RAISE_APPLICATION_ERROR(-20001, 'oracle-tcps-wallet: expected tcps but the session used ' || actual);
  END IF;
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-tcps-wallet</connection>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>tns alias is really tcps</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  actual VARCHAR2(30);
BEGIN
  SELECT SYS_CONTEXT('USERENV', 'NETWORK_PROTOCOL') INTO actual FROM dual;
  IF actual &lt;&gt; 'tcps' THEN
    RAISE_APPLICATION_ERROR(-20002, 'oracle-tns-alias: expected tcps but the session used ' || actual);
  END IF;
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-tns-alias</connection>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>plain connection is really tcp</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DECLARE
  actual VARCHAR2(30);
BEGIN
  SELECT SYS_CONTEXT('USERENV', 'NETWORK_PROTOCOL') INTO actual FROM dual;
  IF actual &lt;&gt; 'tcp' THEN
    RAISE_APPLICATION_ERROR(-20003, 'oracle-service-name: expected plain tcp but the session used ' || actual);
  END IF;
END;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>oracle-service-name</connection>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>tcps wallet is really tcps</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>tcps wallet is really tcps</from>
      <to>tns alias is really tcps</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>tns alias is really tcps</from>
      <to>plain connection is really tcp</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

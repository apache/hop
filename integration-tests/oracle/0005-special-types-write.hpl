<pipeline>
  <info>
    <name>0005-special-types-write</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Writes UUID, Internet Address and JSON values, and a row where all three are null, into the Oracle column types that hold them. Oracle has no UUID or address type, so those go into VARCHAR2; JSON goes into both the native JSON type and a VARCHAR2.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/20 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/20 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Text columns in</from>
      <to>To Hop types</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>To Hop types</from>
      <to>Special types out</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Text columns in</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>oracle-service-name</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT ID, UUID_TEXT, INET_TEXT, JSON_TEXT
FROM HOP_SPECIAL_TYPES_SOURCE
ORDER BY ID</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>To Hop types</name>
    <type>SelectValues</type>
    <description>Oracle hands these over as text; this is where they become the Hop types whose writing is under test.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <meta>
        <date_format_lenient>N</date_format_lenient>
        <length>-2</length>
        <lenient_string_to_number>N</lenient_string_to_number>
        <name>UUID_TEXT</name>
        <precision>-2</precision>
        <rename>UUID_VALUE</rename>
        <roundingType>half_even</roundingType>
        <storage_type/>
        <type>UUID</type>
      </meta>
      <meta>
        <date_format_lenient>N</date_format_lenient>
        <length>-2</length>
        <lenient_string_to_number>N</lenient_string_to_number>
        <name>INET_TEXT</name>
        <precision>-2</precision>
        <rename>INET_VALUE</rename>
        <roundingType>half_even</roundingType>
        <storage_type/>
        <type>Internet Address</type>
      </meta>
      <meta>
        <date_format_lenient>N</date_format_lenient>
        <length>-2</length>
        <lenient_string_to_number>N</lenient_string_to_number>
        <name>JSON_TEXT</name>
        <precision>-2</precision>
        <rename>PAYLOAD</rename>
        <roundingType>half_even</roundingType>
        <storage_type/>
        <type>JSON</type>
      </meta>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Special types out</name>
    <type>TableOutput</type>
    <description>The JSON value goes into the native JSON column and into a VARCHAR2 one, so a failure tells which of the two Oracle would not take.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>oracle-service-name</connection>
    <fields>
      <field>
        <column_name>ID</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>UUID_VALUE</column_name>
        <stream_name>UUID_VALUE</stream_name>
      </field>
      <field>
        <column_name>INET_VALUE</column_name>
        <stream_name>INET_VALUE</stream_name>
      </field>
      <field>
        <column_name>PAYLOAD</column_name>
        <stream_name>PAYLOAD</stream_name>
      </field>
      <field>
        <column_name>PAYLOAD_TEXT</column_name>
        <stream_name>PAYLOAD</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>HOP_SPECIAL_TYPES_TARGET</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<workflow>
  <name>main-0001-check-connections</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Opens every Oracle connection style the plugin can build a URL for: a service name and a SID over plain TCP, a service name over TCPS with an Oracle Wallet, and a tnsnames.ora alias.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/07/28 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/07/28 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check oracle connections</name>
      <description/>
      <type>CHECK_DB_CONNECTIONS</type>
      <attributes/>
      <connections>
        <connection>
          <name>oracle-service-name</name>
          <waitfor/>
          <waittime>millisecond</waittime>
        </connection>
        <connection>
          <name>oracle-sid</name>
          <waitfor/>
          <waittime>millisecond</waittime>
        </connection>
        <connection>
          <name>oracle-tcps-wallet</name>
          <waitfor/>
          <waittime>millisecond</waittime>
        </connection>
        <connection>
          <name>oracle-tns-alias</name>
          <waitfor/>
          <waittime>millisecond</waittime>
        </connection>
        <connection>
          <name>oracle-tns-alias-tcp</name>
          <waitfor/>
          <waittime>millisecond</waittime>
        </connection>
      </connections>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>check oracle connections</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

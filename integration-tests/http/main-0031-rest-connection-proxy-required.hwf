<workflow>
  <name>main-0031-rest-connection-proxy-required</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>The negative half of 0028: the very same URL, on a connection with no proxy configured. proxied_origin is only on the internal docker network, so the host does not even resolve from the test container and the transform must fail. The workflow that runs this pipeline inverts the result - it passes only when the pipeline fails.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/08/05 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/05 10:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0031-rest-connection-proxy-required.hpl</name>
      <description>Expected to FAIL: the target is only reachable through the proxy, and this
      pipeline deliberately has no proxy configured.</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0031-rest-connection-proxy-required.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Reaching the isolated host without a proxy must not succeed</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>144</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Failed as expected</name>
      <description>Clears the error the pipeline raised, so the workflow itself reports success.</description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>0031-rest-connection-proxy-required.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>0031-rest-connection-proxy-required.hpl</from>
      <to>Failed as expected</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0031-rest-connection-proxy-required.hpl</from>
      <to>Reaching the isolated host without a proxy must not succeed</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<pipeline>
  <info>
    <name>0059-rest-connection-oauth2-token-rotation-copies</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>OAuth 2 token rotation with four copies of the REST transform (issue #9550). The API accepts token-1 for rows 1 and 2 only, so the copies sending row 3 and later get a 401 while other copies still have requests in flight with token-1. All copies must share the one new token: all 20 rows end with status 200, and the token endpoint fails a third token request, which is what a copy fetching a token of its own would send.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/17 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 10:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>20 rows</from>
      <to>row number</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>row number</from>
      <to>REST via OAuth 2 connection</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>REST via OAuth 2 connection</from>
      <to>read token</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>read token</from>
      <to>check status</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check status</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>20 rows</name>
    <type>RowGenerator</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <never_ending>N</never_ending>
    <limit>20</limit>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>row number</name>
    <type>Sequence</type>
    <description>Sent as the X-Row header: the API accepts token-1 for rows 1 and 2 only.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <use_counter>Y</use_counter>
    <use_database>N</use_database>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <seqname>SEQ_</seqname>
    <start_at>1</start_at>
    <valuename>row</valuename>
    <attributes/>
    <GUI>
      <xloc>192</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>REST via OAuth 2 connection</name>
    <type>Rest</type>
    <description>Four copies, so several requests carry the rejected token at the same time.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>4</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>JSON</applicationType>
    <bodyField/>
    <connectionTimeout/>
    <connection_name>oauth2-token-rotation-copies</connection_name>
    <dynamicMethod>N</dynamicMethod>
    <headers>
      <header>
        <field>row</field>
        <name>X-Row</name>
      </header>
    </headers>
    <httpLogin/>
    <httpPassword>Encrypted </httpPassword>
    <ignoreSsl>N</ignoreSsl>
    <matrixParameters>
</matrixParameters>
    <method>GET</method>
    <methodFieldName/>
    <parameters>
</parameters>
    <proxyHost/>
    <proxyPort/>
    <readTimeout/>
    <result>
      <code>result_status</code>
      <name>result</name>
      <response_header/>
      <response_time/>
    </result>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <url>/copies/items</url>
    <urlField/>
    <urlInField>N</urlInField>
    <attributes/>
    <GUI>
      <xloc>272</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>read token</name>
    <type>JsonInput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name/>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>token</name>
        <path>$.token</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>Y</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField>result</valueField>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check status</name>
    <type>FilterRows</type>
    <description>Rows sent after the switch come back 401 when a copy keeps sending the rejected token.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to/>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>Y</negated>
            <leftvalue>result_status</leftvalue>
            <function>=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>200</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>#</mask>
            </value>
          </condition>
        </conditions>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>592</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>752</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<pipeline>
  <info>
    <name>0056-rest-connection-static-headers</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Static headers on a REST connection (issue #9551): the endpoint answers 403 without an x-as-user-email header. The connection sends it on every row; a header field on the transform with the same name wins.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/17 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 10:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>3 rows</from>
      <to>REST via connection</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>REST via connection</from>
      <to>read user</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>read user</from>
      <to>check connection header</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check connection header</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>1 row with own header</from>
      <to>REST with own header</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>REST with own header</from>
      <to>read user (own header)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>read user (own header)</from>
      <to>check own header wins</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check own header wins</from>
      <to>Abort (own header)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>3 rows</name>
    <type>RowGenerator</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <never_ending>N</never_ending>
    <limit>3</limit>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>REST via connection</name>
    <type>Rest</type>
    <description>No header fields: x-as-user-email comes from the connection.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>JSON</applicationType>
    <bodyField/>
    <connectionTimeout/>
    <connection_name>static-headers</connection_name>
    <dynamicMethod>N</dynamicMethod>
    <headers>
    </headers>
    <httpLogin/>
    <httpPassword>Encrypted </httpPassword>
    <ignoreSsl>N</ignoreSsl>
    <matrixParameters>
</matrixParameters>
    <method>GET</method>
    <methodFieldName/>
    <parameters>
</parameters>
    <proxyHost/>
    <proxyPort/>
    <readTimeout/>
    <result>
      <code>result_status</code>
      <name>result</name>
      <response_header/>
      <response_time/>
    </result>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <url>/requires-user</url>
    <urlField/>
    <urlInField>N</urlInField>
    <attributes/>
    <GUI>
      <xloc>272</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>read user</name>
    <type>JsonInput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name/>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>user</name>
        <path>$.user</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>Y</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField>result</valueField>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check connection header</name>
    <type>FilterRows</type>
    <description>Fails unless the server got the connection's header, with its variable resolved.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to/>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>Y</negated>
            <leftvalue>result_status</leftvalue>
            <function>=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>200</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>#</mask>
            </value>
          </condition>
          <condition>
            <negated>Y</negated>
            <operator>OR</operator>
            <leftvalue>user</leftvalue>
            <function>=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>hop@httpecho</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
          </condition>
        </conditions>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>592</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>752</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>1 row with own header</name>
    <type>RowGenerator</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>user_header</name>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>String</type>
        <nullif>row@example.com</nullif>
      </field>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <never_ending>N</never_ending>
    <limit>1</limit>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>REST with own header</name>
    <type>Rest</type>
    <description>Sets the same header itself, in another case: this value must win.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>JSON</applicationType>
    <bodyField/>
    <connectionTimeout/>
    <connection_name>static-headers</connection_name>
    <dynamicMethod>N</dynamicMethod>
    <headers>
      <header>
        <field>user_header</field>
        <name>X-As-User-Email</name>
      </header>
    </headers>
    <httpLogin/>
    <httpPassword>Encrypted </httpPassword>
    <ignoreSsl>N</ignoreSsl>
    <matrixParameters>
</matrixParameters>
    <method>GET</method>
    <methodFieldName/>
    <parameters>
</parameters>
    <proxyHost/>
    <proxyPort/>
    <readTimeout/>
    <result>
      <code>result_status</code>
      <name>result</name>
      <response_header/>
      <response_time/>
    </result>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <url>/requires-user</url>
    <urlField/>
    <urlInField>N</urlInField>
    <attributes/>
    <GUI>
      <xloc>272</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>read user (own header)</name>
    <type>JsonInput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name/>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>user</name>
        <path>$.user</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>Y</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField>result</valueField>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check own header wins</name>
    <type>FilterRows</type>
    <description>Fails unless the transform's own header replaced the connection's.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to/>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>Y</negated>
            <leftvalue>result_status</leftvalue>
            <function>=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>200</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>#</mask>
            </value>
          </condition>
          <condition>
            <negated>Y</negated>
            <operator>OR</operator>
            <leftvalue>user</leftvalue>
            <function>=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>row@example.com</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
          </condition>
        </conditions>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>592</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort (own header)</name>
    <type>Abort</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>752</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

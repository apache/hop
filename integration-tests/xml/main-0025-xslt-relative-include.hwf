<workflow>
  <name>main-0025-xslt-relative-include</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #8936: the XSLT action and transform resolve relative xsl:include, xsl:import and document() references against the stylesheet and the XML file, not the working directory.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/15 09:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/15 09:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>delete XSLT result</name>
      <description/>
      <type>DELETE_FILE</type>
      <attributes/>
      <fail_if_file_not_exists>N</fail_if_file_not_exists>
      <filename>${java.io.tmpdir}/hop-xml-0025-xslt-action-include.txt</filename>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>XSLT action</name>
      <description/>
      <type>XSLT</type>
      <attributes/>
      <ifFileExists>1</ifFileExists>
      <outputfilename>${java.io.tmpdir}/hop-xml-0025-xslt-action-include.txt</outputfilename>
      <xmlfilename>${PROJECT_HOME}/files/xslt-include-data/catalog.xml</xmlfilename>
      <xslfilename>${PROJECT_HOME}/files/xslt-include/titles.xsl</xslfilename>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>verify XSLT action result</name>
      <description/>
      <type>FILE_COMPARE</type>
      <attributes/>
      <filename1>${java.io.tmpdir}/hop-xml-0025-xslt-action-include.txt</filename1>
      <filename2>${PROJECT_HOME}/files/expected/0025-xslt-action-include.txt</filename2>
      <add_filename_result>N</add_filename_result>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>XSLT transform unit test</name>
      <description/>
      <type>RunPipelineTests</type>
      <attributes/>
      <test_names>
        <test_name>
          <name>0025-xslt-transform-relative-include UNIT</name>
        </test_name>
      </test_names>
      <parallel>N</parallel>
      <xloc>752</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>XSLT action failed</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>The XSLT action could not apply titles.xsl.</message>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>XSLT action result mismatch</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>The XSLT action result does not match files/expected/0025-xslt-action-include.txt.</message>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>delete XSLT result</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>delete XSLT result</from>
      <to>XSLT action</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>XSLT action</from>
      <to>verify XSLT action result</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>XSLT action</from>
      <to>XSLT action failed</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>verify XSLT action result</from>
      <to>XSLT transform unit test</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>verify XSLT action result</from>
      <to>XSLT action result mismatch</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

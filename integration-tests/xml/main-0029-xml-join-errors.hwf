      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Verify: simple XPath finds no node</name>
      <description></description>
      <type>EVAL</type>
      <attributes/>
      <script>var errors = previous_result.getNrErrors();
var found = previous_result.getLogText().indexOf("XPath statement returned no result [//missing]") &gt;= 0;
if (errors == 0 || !found) {
  action.logError("Expected the pipeline to fail with 'XPath statement returned no result [//missing]' in the log, got " + errors + " error(s), message found: " + found);
}
errors &gt; 0 &amp;&amp; found;</script>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>

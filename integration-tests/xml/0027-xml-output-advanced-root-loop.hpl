<pipeline>
  <info>
    <name>0027-xml-output-advanced-root-loop</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Issue #8936: a loop on the root element can only hold one row. The second row must fail with a clear message. Expected to fail.</description>
    <extended_description/>
    <pipeline_version/>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/15 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/15 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>customers</from>
      <to>XML Output (Advanced)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>customers</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>1</item>
        <item>Alice</item>
      </line>
      <line>
        <item>2</item>
        <item>Bob</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>id</name>
        <format/>
        <group/>
        <decimal/>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>name</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>XML Output (Advanced)</name>
    <type>AdvancedXMLOutput</type>
    <description>The loop is on the root element: one row per document.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <encoding>UTF-8</encoding>
    <compact_file>N</compact_file>
    <blank_line_after_xml_decl>Y</blank_line_after_xml_decl>
    <create_attr_if_null>N</create_attr_if_null>
    <create_attr_if_unmapped>N</create_attr_if_unmapped>
    <create_empty_element>Y</create_empty_element>
    <trim_values>N</trim_values>
    <generate_xsd>N</generate_xsd>
    <doctype_root/>
    <doctype_system/>
    <doctype_public/>
    <xsl_stylesheet_href/>
    <xsl_stylesheet_type>text/xsl</xsl_stylesheet_type>
    <file>
      <name>${java.io.tmpdir}/hop-xml-integration-output/0027-root-loop</name>
      <extension>xml</extension>
      <splitevery>0</splitevery>
      <split>N</split>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <zipped>N</zipped>
      <add_to_result_filenames>N</add_to_result_filenames>
      <do_not_open_newfile_init>N</do_not_open_newfile_init>
      <do_not_create_empty_file>N</do_not_create_empty_file>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
    </file>
    <tree>
      <name>customer</name>
      <kind>Element</kind>
      <loop>Y</loop>
      <children>
        <node>
          <name>id</name>
          <kind>Attribute</kind>
          <mapped_field>id</mapped_field>
        </node>
        <node>
          <name>name</name>
          <kind>Element</kind>
          <mapped_field>name</mapped_field>
        </node>
      </children>
    </tree>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

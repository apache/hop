        <nullif/>
        <length>-1</length>
        <precision>-1</precision>
        <attribute>N</attribute>
        <attributeParentName/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>

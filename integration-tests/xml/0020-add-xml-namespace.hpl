        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <length>-1</length>
        <precision>-1</precision>
        <attribute>N</attribute>
        <attributeParentName/>
      </field>
      <field>
        <name>name</name>

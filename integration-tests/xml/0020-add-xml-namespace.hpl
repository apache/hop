        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <length>-1</length>
        <precision>-1</precision>
        <attribute>N</attribute>
        <attributeParentName/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>48</yloc>
    </GUI>
  </transform>
  <transform>

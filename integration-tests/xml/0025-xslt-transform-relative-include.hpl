<pipeline>
  <info>
    <name>0025-xslt-transform-relative-include</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Issue #8936: the XSLT transform resolves a relative xsl:include and xsl:import against the folder of the stylesheet, not the working directory.</description>
    <extended_description/>
    <pipeline_version/>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/15 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/15 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>catalog</from>
      <to>XSLT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>XSLT</from>
      <to>Dummy (do nothing)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>catalog</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>&lt;catalog&gt;&lt;cd&gt;&lt;title&gt;Empire Burlesque&lt;/title&gt;&lt;/cd&gt;&lt;cd&gt;&lt;title&gt;Hide your heart&lt;/title&gt;&lt;/cd&gt;&lt;/catalog&gt;</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>xml</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>XSLT</name>
    <type>XSLT</type>
    <description>The stylesheet imports and includes stylesheets next to it.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <xslfilename>${PROJECT_HOME}/files/xslt-include/titles.xsl</xslfilename>
    <fieldname>xml</fieldname>
    <resultfieldname>result</resultfieldname>
    <xslfilefield/>
    <xslfilefielduse>N</xslfilefielduse>
    <xslfieldisafile>N</xslfieldisafile>
    <xslfactory>SAXON</xslfactory>
    <parameters>
    </parameters>
    <outputproperties>
    </outputproperties>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Dummy (do nothing)</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

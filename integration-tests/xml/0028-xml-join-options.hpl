      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname/>
      <fontsize>-1</fontsize>
      <height>50</height>
      <xloc>96</xloc>
      <yloc>16</yloc>
      <note>Each target data grid carries a 'case' field, so every join writes the same row layout (case, doc, result) into 'results'.
'no target rows' must not write a row.</note>
      <width>620</width>
    </notepad>
  </notepads>

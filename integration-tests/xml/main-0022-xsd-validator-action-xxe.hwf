<workflow>
  <name>main-0022-xsd-validator-action-xxe</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #8367: the XSD Validator action does not resolve external entities by default.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/14 14:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/14 14:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>80</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>safe xml validates with secure default</name>
      <description>A document without entities must still validate once external entities are off.</description>
      <type>XSD_VALIDATOR</type>
      <attributes/>
      <xsdsource>filename</xsdsource>
      <xmlfilename>${PROJECT_HOME}/files/xxe-safe-employee.xml</xmlfilename>
      <xsdfilename>${PROJECT_HOME}/files/xxe-employee.xsd</xsdfilename>
      <allowExternalEntities>N</allowExternalEntities>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>xxe xml is refused by secure default</name>
      <description>The DOCTYPE is disallowed, so this action fails and the file server is never contacted.</description>
      <type>XSD_VALIDATOR</type>
      <attributes/>
      <xsdsource>filename</xsdsource>
      <xmlfilename>${PROJECT_HOME}/files/xxe-employee.xml</xmlfilename>
      <xsdfilename>${PROJECT_HOME}/files/xxe-employee.xsd</xsdfilename>
      <allowExternalEntities>N</allowExternalEntities>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>xxe xml validates when entities are allowed</name>
      <description>Proves the previous action fails because of the hardening, not an unreachable payload.</description>
      <type>XSD_VALIDATOR</type>
      <attributes/>
      <xsdsource>filename</xsdsource>
      <xmlfilename>${PROJECT_HOME}/files/xxe-employee.xml</xmlfilename>
      <xsdfilename>${PROJECT_HOME}/files/xxe-employee.xsd</xsdfilename>
      <allowExternalEntities>Y</allowExternalEntities>
      <parallel>N</parallel>
      <xloc>816</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort workflow</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>safe xml validates with secure default</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>safe xml validates with secure default</from>
      <to>xxe xml is refused by secure default</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>safe xml validates with secure default</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>xxe xml is refused by secure default</from>
      <to>xxe xml validates when entities are allowed</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>xxe xml is refused by secure default</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>xxe xml validates when entities are allowed</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>xxe xml validates when entities are allowed</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

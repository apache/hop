<!--
  An XML External Entity (XXE) payload: the email element pulls its content from the integration
  test file server. With external entities disabled - the default since issue #8367 - the DOCTYPE
  is refused and the file server is never contacted, so validation fails. Enabling external
  entities on the transform or action resolves the entity and the document validates.
-->
<!DOCTYPE employee [
  <!ENTITY xxe SYSTEM "http://file-server:8080/xxe-payload.txt">
]>
<employee>
  <firstname>vimal</firstname>
  <lastname>jaiswal</lastname>
  <email>&xxe;</email>
</employee>

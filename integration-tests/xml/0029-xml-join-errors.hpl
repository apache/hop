<pipeline>
  <info>
    <name>0029-xml-join-errors</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Issue #9515: XML Join fails the pipeline with a clear message when an XPath finds no node or a field is missing. The defaults run without errors; main-0029 overrides one parameter at a time.</description>
    <extended_description/>
    <pipeline_version/>
    <parameters>
      <parameter>
        <name>TARGET_FIELD</name>
        <default_value>doc</default_value>
        <description>Target XML field of the simple join</description>
      </parameter>
      <parameter>
        <name>SOURCE_FIELD</name>
        <default_value>line</default_value>
        <description>Source XML field of the simple join</description>
      </parameter>
      <parameter>
        <name>SIMPLE_XPATH</name>
        <default_value>//order</default_value>
        <description>XPath of the simple join</description>
      </parameter>
      <parameter>
        <name>COMPLEX_XPATH</name>
        <default_value>//order[@id='?']/lines</default_value>
        <description>XPath of the complex join</description>
      </parameter>
      <parameter>
        <name>COMPARE_FIELD</name>
        <default_value>orderId</default_value>
        <description>Comparison field of the complex join</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/16 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/16 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>target</from>
      <to>simple join</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>source</from>
      <to>simple join</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>target</from>
      <to>complex join</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>source</from>
      <to>complex join</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>simple join</from>
      <to>simple result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>complex join</from>
      <to>complex result</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>target</name>
    <type>DataGrid</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>&lt;orders&gt;&lt;order id="1"&gt;&lt;lines/&gt;&lt;/order&gt;&lt;/orders&gt;</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>doc</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>source</name>
    <type>DataGrid</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>1</item>
        <item>&lt;line/&gt;</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>orderId</name>
        <format/>
        <group/>
        <decimal/>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>line</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>simple join</name>
    <type>XMLJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <complexJoin>N</complexJoin>
    <encoding>UTF-8</encoding>
    <joinCompareField/>
    <omitNullValues>N</omitNullValues>
    <omitXmlHeader>Y</omitXmlHeader>
    <sourceXmlField>${SOURCE_FIELD}</sourceXmlField>
    <sourceXmlTransform>source</sourceXmlTransform>
    <targetXPath>${SIMPLE_XPATH}</targetXPath>
    <targetXmlField>${TARGET_FIELD}</targetXmlField>
    <targetXmlTransform>target</targetXmlTransform>
    <valueXmlField>result</valueXmlField>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>complex join</name>
    <type>XMLJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <complexJoin>Y</complexJoin>
    <encoding>UTF-8</encoding>
    <joinCompareField>${COMPARE_FIELD}</joinCompareField>
    <omitNullValues>N</omitNullValues>
    <omitXmlHeader>Y</omitXmlHeader>
    <sourceXmlField>line</sourceXmlField>
    <sourceXmlTransform>source</sourceXmlTransform>
    <targetXPath>${COMPLEX_XPATH}</targetXPath>
    <targetXmlField>doc</targetXmlField>
    <targetXmlTransform>target</targetXmlTransform>
    <valueXmlField>result</valueXmlField>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>simple result</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>576</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>complex result</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>576</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

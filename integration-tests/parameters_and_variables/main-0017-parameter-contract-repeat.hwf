<workflow>
  <name>main-0017-parameter-contract-repeat</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Parameter contract for the Repeat action. The child ends the repetition itself, so a broken contract cannot loop forever.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/08/26 09:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/26 09:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Set variables</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <replacevars>Y</replacevars>
      <filename/>
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <fields>
        <field>
          <variable_name>PARAM</variable_name>
          <variable_value>parent-value</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
      </fields>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>176</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>repeat-value-on</name>
      <description/>
      <type>Repeat</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0017-repeat-child.hwf</filename>
      <parameters>
        <parameter><name>PARAM</name><value>from-tab</value></parameter>
        <parameter><name>EXPECTED</name><value>from-tab</value></parameter>
        <parameter><name>CASE</name><value>repeat-value-on</value></parameter>
      </parameters>
      <variable_name/>
      <variable_value/>
      <delay/>
      <keep_values>N</keep_values>
      <pass_all_parameters>Y</pass_all_parameters>
      <run_configuration>local</run_configuration>
      <logfile_enabled>N</logfile_enabled>
      <logfile_base/>
      <logfile_extension/>
      <logfile_append_execution_nr>N</logfile_append_execution_nr>
      <logfile_add_date>N</logfile_add_date>
      <logfile_add_time>N</logfile_add_time>
      <logfile_add_repetition_nr>N</logfile_add_repetition_nr>
      <logfile_update_interval/>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>320</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>

<pipeline>
  <info>
    <name>0014-assert-parameter</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Aborts unless PARAM holds EXPECTED. The engine behind the parameter contract tests.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>PARAM</name>
        <default_value>child-default</default_value>
        <description>The parameter under test. Its default must survive unless something passes a value.</description>
      </parameter>
      <parameter>
        <name>EXPECTED</name>
        <default_value>-nothing-expected-</default_value>
        <description>The value PARAM should have. Always supplied explicitly by the caller.</description>
      </parameter>
      <parameter>
        <name>CASE</name>
        <default_value>unnamed</default_value>
        <description>Name of the case, for the log line.</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/26 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/26 09:00:00.000</modified_date>
  </info>
  <transform>
    <name>Get variables</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>actual</name><variable>${PARAM}</variable><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>expected</name><variable>${EXPECTED}</variable><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>112</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>Log the case</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>N</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>CONTRACT ${CASE} : PARAM=&gt;${PARAM}&lt; EXPECTED=&gt;${EXPECTED}&lt;</logmessage>
    <fields/>
    <attributes/>
    <GUI><xloc>288</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>Mismatch?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>&lt;></function>
        <leftvalue>actual</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <rightvalue>expected</rightvalue>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>464</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <message>Parameter contract broken, see the CONTRACT log line above</message>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI><xloc>656</xloc><yloc>96</yloc></GUI>
  </transform>
  <order>
    <hop><from>Get variables</from><to>Log the case</to><enabled>Y</enabled></hop>
    <hop><from>Log the case</from><to>Mismatch?</to><enabled>Y</enabled></hop>
    <hop><from>Mismatch?</from><to>Abort</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>

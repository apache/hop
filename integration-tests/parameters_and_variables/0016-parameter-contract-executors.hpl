    <partitioning><method>none</method><schema_name/></partitioning>
    <run_configuration>local</run_configuration>
    <filename>${PROJECT_HOME}/0014-assert-parameter.hpl</filename>
    <group_size>1</group_size>
    <group_field/>
    <group_time/>

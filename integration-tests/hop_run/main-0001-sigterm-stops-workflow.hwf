<workflow>
  <name>main-0001-sigterm-stops-workflow</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>SIGTERM to hop-run stops the running workflow before the JVM exits (issue #9168).</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/30 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/30 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Send SIGTERM</name>
      <description>Runs 0001-run-until-stopped.hwf until it is stopped, sends SIGTERM and checks that hop-run stopped the run before it exited. The script logs why it failed.</description>
      <type>SHELL</type>
      <attributes/>
      <filename>${PROJECT_HOME}/sigterm-hop-run.sh</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>N</insertScript>
      <script/>
      <arguments>
        <argument>
          <value>0001-run-until-stopped.hwf</value>
          <hidden>N</hidden>
        </argument>
      </arguments>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>512</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>hop-run did not stop the run on SIGTERM, see the output of the script above</message>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Send SIGTERM</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Send SIGTERM</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Send SIGTERM</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<pipeline>
  <info>
    <name>0010-openlineage-pgbulkloader</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads public.orders_source and bulk-loads public.orders_bulk with the PostgreSQL Bulk Loader. The loader's field mapping carries per-column provenance (id&lt;-id, amount&lt;-amount), so the OpenLineage sink attaches the columnLineage facet to the orders_bulk dataset in Marquez. Representative of the database bulk loaders.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/02 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/02 12:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read orders_source</from>
      <to>Bulk load orders_bulk</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read orders_source</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>warehouse</connection>
    <sql>SELECT id, amount FROM public.orders_source</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Bulk load orders_bulk</name>
    <type>PGBulkLoader</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>warehouse</connection>
    <delimiter>;</delimiter>
    <enclosure>"</enclosure>
    <load_action>TRUNCATE</load_action>
    <mapping>
      <date_mask/>
      <field_name>id</field_name>
      <stream_name>id</stream_name>
    </mapping>
    <mapping>
      <date_mask/>
      <field_name>amount</field_name>
      <stream_name>amount</stream_name>
    </mapping>
    <schema>public</schema>
    <stop_on_error>N</stop_on_error>
    <table>orders_bulk</table>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<workflow>
  <name>main-0006-openlineage-sql-group</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Database lookup, Database join, Execute row SQL script and the SQL action report the tables they read and write: Marquez and the DataHub stand-in get them as the datasets of the pipeline's run and of the action's run.</description>
  <extended_description/>
  <workflow_version/>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/11/23 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/23 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create SQL group tables</name>
      <description>Recreates the tables of this workflow: the warehouse Postgres is shared with the other projects and not torn down between them.</description>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS public.sqlgroup_orders_copy&#10;;&#10;DROP TABLE IF EXISTS public.sqlgroup_audit&#10;;&#10;DROP TABLE IF EXISTS public.sqlgroup_regions&#10;;&#10;DROP TABLE IF EXISTS public.sqlgroup_customers&#10;;&#10;DROP TABLE IF EXISTS public.sqlgroup_orders&#10;;&#10;CREATE TABLE public.sqlgroup_orders (id INTEGER, customer_id INTEGER)&#10;;&#10;INSERT INTO public.sqlgroup_orders (id, customer_id) VALUES (1, 10), (2, 20), (3, 10)&#10;;&#10;CREATE TABLE public.sqlgroup_customers (id INTEGER, name VARCHAR(50))&#10;;&#10;INSERT INTO public.sqlgroup_customers (id, name) VALUES (10, 'Ann'), (20, 'Bob')&#10;;&#10;CREATE TABLE public.sqlgroup_regions (customer_id INTEGER, region VARCHAR(50))&#10;;&#10;INSERT INTO public.sqlgroup_regions (customer_id, region) VALUES (10, 'North'), (20, 'South')&#10;;&#10;CREATE TABLE public.sqlgroup_audit (order_id INTEGER)&#10;;&#10;CREATE TABLE public.sqlgroup_orders_copy (id INTEGER, customer_id INTEGER)&#10;;&#10;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>warehouse</connection>
      <parallel>N</parallel>
      <xloc>176</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Copy sqlgroup_orders</name>
      <description>The SQL action under test: it reads public.sqlgroup_orders and writes public.sqlgroup_orders_copy, which its run reports.</description>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO public.sqlgroup_orders_copy (id, customer_id) SELECT id, customer_id FROM public.sqlgroup_orders&#10;;&#10;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>warehouse</connection>
      <parallel>N</parallel>
      <xloc>336</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0017-openlineage-sql-group.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0017-openlineage-sql-group.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>512</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Wait for delivery and ingestion</name>
      <description/>
      <type>DELAY</type>
      <attributes/>
      <maximumTimeout>15</maximumTimeout>
      <scaletime>0</scaletime>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the lineage</name>
      <description>Checks the datasets Marquez and the DataHub stand-in have for the pipeline and the SQL action</description>
      <type>SHELL</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0017-openlineage-sql-group-validate.sh</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>N</insertScript>
      <script/>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create SQL group tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create SQL group tables</from>
      <to>Copy sqlgroup_orders</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Copy sqlgroup_orders</from>
      <to>0017-openlineage-sql-group.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0017-openlineage-sql-group.hpl</from>
      <to>Wait for delivery and ingestion</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Wait for delivery and ingestion</from>
      <to>Check the lineage</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

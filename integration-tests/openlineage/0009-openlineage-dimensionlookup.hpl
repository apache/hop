<pipeline>
  <info>
    <name>0009-openlineage-dimensionlookup</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads public.orders_source and maintains the public.orders_dim slowly-changing dimension with a Dimension Lookup/Update transform. The natural key and the argument-bound attribute carry per-column provenance (id&lt;-id, amount&lt;-amount); the generated technical key, version and validity dates do not. The OpenLineage sink attaches the columnLineage facet to the orders_dim dataset in Marquez.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/02 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/02 12:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read orders_source</from>
      <to>Dimension orders_dim</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read orders_source</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>warehouse</connection>
    <sql>SELECT id, amount FROM public.orders_source</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Dimension orders_dim</name>
    <type>DimensionLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>5000</cache_size>
    <commit>1000</commit>
    <connection>warehouse</connection>
    <fields>
      <date>
        <from>date_from</from>
        <name/>
        <to>date_to</to>
      </date>
      <field>
        <lookup>amount</lookup>
        <name>amount</name>
        <update>Insert</update>
      </field>
      <key>
        <lookup>id</lookup>
        <name>id</name>
      </key>
      <return>
        <creation_method>tablemax</creation_method>
        <name>dim_tk</name>
        <rename/>
        <version>version</version>
      </return>
    </fields>
    <max_year>2199</max_year>
    <min_year>1900</min_year>
    <preload_cache>N</preload_cache>
    <schema>public</schema>
    <sequence/>
    <start_date_field_name/>
    <table>orders_dim</table>
    <tkSourceField/>
    <unknown_row_check_disabled>N</unknown_row_check_disabled>
    <update>Y</update>
    <useBatch>N</useBatch>
    <use_start_date_alternative>N</use_start_date_alternative>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

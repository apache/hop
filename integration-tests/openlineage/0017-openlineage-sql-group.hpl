<pipeline>
  <info>
    <name>0017-openlineage-sql-group</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads public.sqlgroup_orders, looks up each customer in public.sqlgroup_customers with Database lookup, joins its region from public.sqlgroup_regions with Database join, and writes an audit row per order into public.sqlgroup_audit with Execute row SQL script. Each of them reports the table it reads or writes.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/23 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/23 12:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read sqlgroup_orders</from>
      <to>Look up customer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Look up customer</from>
      <to>Join region</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join region</from>
      <to>Write audit rows</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read sqlgroup_orders</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>warehouse</connection>
    <sql>SELECT id, customer_id, 'INSERT INTO public.sqlgroup_audit (order_id) VALUES (' || id || ')' AS audit_sql FROM public.sqlgroup_orders ORDER BY id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Look up customer</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>warehouse</connection>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>public</schema>
      <table>sqlgroup_customers</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>customer_id</name>
        <field>id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>name</name>
        <rename>customer_name</rename>
        <default/>
        <type>String</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Join region</name>
    <type>DBJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <connection>warehouse</connection>
    <outer_join>Y</outer_join>
    <parameter>
      <field>
        <name>customer_id</name>
        <type>Integer</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <rowlimit>0</rowlimit>
    <sql>SELECT region FROM public.sqlgroup_regions WHERE customer_id = ?</sql>
    <attributes/>
    <GUI>
      <xloc>528</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write audit rows</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>0</commit>
    <connection>warehouse</connection>
    <sql_field>audit_sql</sql_field>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <sqlFromfile>N</sqlFromfile>
    <sendOneStatement>Y</sendOneStatement>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<workflow>
  <name>main-0003-openlineage-writers</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Runs the relational write transforms that carry per-column provenance (Insert/Update, Combination Lookup/Update, Dimension Lookup/Update, PostgreSQL Bulk Loader) with the lineage hub enabled, so the openlineage sink delivers a WAREHOUSE_IO dataset with a columnLineage facet per target to Marquez. After waiting for asynchronous delivery and ingestion, it asserts that each target dataset (orders_upsert, orders_combi, orders_dim, orders_bulk) carries a columnLineage facet.</description>
  <extended_description/>
  <workflow_version/>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/08/02 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/02 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>

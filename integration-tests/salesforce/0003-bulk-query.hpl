<pipeline>
  <info>
    <name>0003-bulk-query</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
  </info>
  <order>
    <hop>
      <from>bulk</from>
      <to>Count rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count rows</from>
      <to>Wrong count?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wrong count?</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>bulk</name>
    <type>SalesforceBulkInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>salesforce-mock</connection>
    <operation>query</operation>
    <soql>SELECT Id, Name FROM Account</soql>
    <timeout>60</timeout>
    <pollInterval>1</pollInterval>
    <maxRows>0</maxRows>
    <jobIdField/>
    <fields>
      <field>
        <name>Id</name>
        <type>String</type>
      </field>
      <field>
        <name>Name</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Count rows</name>
    <type>MemoryGroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <give_back_row>Y</give_back_row>
    <group/>
    <fields>
      <field>
        <aggregate>rows_read</aggregate>
        <subject>Id</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wrong count?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>rows_read</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>3</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>grp</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>total</aggregate>
        <subject>val</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>kind memgroupby</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>kind</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>memgroupby</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>464</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>layout memgroupby</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>kind</name>
      </field>
      <field>
        <name>grp</name>
      </field>
      <field>
        <name>total</name>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>640</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Unique rows</name>
    <type>Unique</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <count_rows>Y</count_rows>
    <count_field>total</count_field>
    <fields>
      <field>
        <case_insensitive>N</case_insensitive>
        <name>grp</name>
      </field>
    </fields>
    <reject_duplicate_row>N</reject_duplicate_row>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>320</yloc>

<workflow>
  <name>main-002-ftp-connection</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Uploads through a named FTP connection and reads the result back through the VFS scheme of that same connection.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/08/11 08:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/11 08:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Put a file with the named connection</name>
      <description>The server settings all come from the ftp-test connection in the metadata.</description>
      <type>FTP_PUT</type>
      <attributes/>
      <connection>ftp-test</connection>
      <servername/>
      <serverport/>
      <username/>
      <password>Encrypted </password>
      <remoteDirectory/>
      <localDirectory>${PROJECT_HOME}/files</localDirectory>
      <wildcard>.*\.txt</wildcard>
      <binary>Y</binary>
      <timeout>0</timeout>
      <remove>N</remove>
      <only_new>N</only_new>
      <active>N</active>
      <control_encoding>ISO-8859-1</control_encoding>
      <proxy_host/>
      <proxy_port/>
      <proxy_username/>
      <proxy_password>Encrypted </proxy_password>
      <socksproxy_host/>
      <socksproxy_port>1080</socksproxy_port>
      <socksproxy_username/>
      <socksproxy_password>Encrypted </socksproxy_password>
      <parallel>N</parallel>
      <xloc>250</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>The file is there over the connection scheme</name>
      <description>The name of the connection doubles as a VFS scheme, usable in any action.</description>
      <type>FILE_EXISTS</type>
      <attributes/>
      <filename>ftp-test:///test.txt</filename>
      <parallel>N</parallel>
      <xloc>550</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Delete it again</name>
      <description>Leaves the server as we found it, so the test can run twice.</description>
      <type>FTP_DELETE</type>
      <attributes/>
      <connection>ftp-test</connection>
      <sftp_connection/>
      <protocol>FTP</protocol>
      <servername/>
      <port/>
      <username/>
      <password>Encrypted </password>
      <ftpdirectory/>
      <wildcard>.*\.txt</wildcard>
      <timeout>0</timeout>
      <active>N</active>
      <publicpublickey>N</publicpublickey>
      <keyfilename/>
      <keyfilepass>Encrypted </keyfilepass>
      <useproxy>N</useproxy>
      <proxy_host/>
      <proxy_port/>
      <proxy_username/>
      <proxy_password>Encrypted </proxy_password>
      <socksproxy_host/>
      <socksproxy_port>1080</socksproxy_port>
      <socksproxy_username/>
      <socksproxy_password>Encrypted </socksproxy_password>
      <nr_limit_success>10</nr_limit_success>
      <success_condition>success_is_all_files_downloaded</success_condition>
      <copyprevious>N</copyprevious>
      <parallel>N</parallel>
      <xloc>850</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1150</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Put a file with the named connection</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Put a file with the named connection</from>
      <to>The file is there over the connection scheme</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>The file is there over the connection scheme</from>
      <to>Delete it again</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Delete it again</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

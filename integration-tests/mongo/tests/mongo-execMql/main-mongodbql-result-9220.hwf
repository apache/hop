<workflow>
  <name>main-mongodbql-result-9220</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>MongoDB QL is false on write errors and runs every comma-separated instruction (#9220)</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/11/07 12:00:00.000</created_date>
  <modified_date>2026/11/07 12:00:00.000</modified_date>
  <workflow_version/>
  <parameters>
    <parameter>
      <name>MONGO_CONNECTION</name>
      <description/>
      <default_value>mongo</default_value>
    </parameter>
  </parameters>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>48</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <mql>{"delete": "mql_9220", "deletes": [{"q": {}, "limit": 0}]}</mql>
      <connection>${MONGO_CONNECTION}</connection>
      <useExternalFile>N</useExternalFile>
      <commandFile/>
      <useVariableSubstitution>N</useVariableSubstitution>
      <name>Clear collection</name>
      <description/>
      <type>MQL</type>
      <attributes/>
      <xloc>208</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <mql>{"insert": "mql_9220", "documents": [{"_id": 1}, {"_id": 1}]}</mql>
      <connection>${MONGO_CONNECTION}</connection>
      <useExternalFile>N</useExternalFile>
      <commandFile/>
      <useVariableSubstitution>N</useVariableSubstitution>
      <name>Duplicate _id is false</name>
      <description/>
      <type>MQL</type>
      <attributes/>
      <xloc>400</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <mql>{"insert": "mql_9220", "documents": [{"_id": 2, "v": "a"}]},
{"insert": "mql_9220", "documents": [{"_id": 3, "v": "b"}]}</mql>
      <connection>${MONGO_CONNECTION}</connection>
      <useExternalFile>N</useExternalFile>
      <commandFile/>
      <useVariableSubstitution>N</useVariableSubstitution>
      <name>Comma-separated is true</name>
      <description/>
      <type>MQL</type>
      <attributes/>
      <xloc>592</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <mql>{"insert": "mql_9220", "documents": [{"_id": 3, "v": "c"}]}</mql>
      <connection>${MONGO_CONNECTION}</connection>
      <useExternalFile>N</useExternalFile>
      <commandFile/>
      <useVariableSubstitution>N</useVariableSubstitution>
      <name>Second document was inserted</name>
      <description/>
      <type>MQL</type>
      <attributes/>
      <xloc>784</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <mql>{"drop": "mql_9220"}</mql>
      <connection>${MONGO_CONNECTION}</connection>
      <useExternalFile>N</useExternalFile>
      <commandFile/>
      <useVariableSubstitution>N</useVariableSubstitution>
      <name>Drop collection</name>
      <description/>
      <type>MQL</type>
      <attributes/>
      <xloc>976</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>1168</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <always_log_rows>N</always_log_rows>
      <name>Abort workflow</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>592</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Clear collection</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clear collection</from>
      <to>Duplicate _id is false</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Duplicate _id is false</from>
      <to>Comma-separated is true</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Duplicate _id is false</from>
      <to>Abort workflow</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Comma-separated is true</from>
      <to>Second document was inserted</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Comma-separated is true</from>
      <to>Abort workflow</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Second document was inserted</from>
      <to>Drop collection</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Second document was inserted</from>
      <to>Abort workflow</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Drop collection</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clear collection</from>
      <to>Abort workflow</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

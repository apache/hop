    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS hop_pgv_acc_target;
DROP TABLE IF EXISTS hop_pgv_acc_written;
DROP TABLE IF EXISTS hop_pgv_acc_rejects;
DROP TABLE IF EXISTS hop_pgv_one_target;
DROP TABLE IF EXISTS hop_pgv_one_written;
DROP TABLE IF EXISTS hop_pgv_one_rejects;
DROP TABLE IF EXISTS hop_pgv_del_target;
DROP TABLE IF EXISTS hop_pgv_del_written;
DROP TABLE IF EXISTS hop_pgv_del_rejects;
CREATE TABLE hop_pgv_acc_target (id TEXT PRIMARY KEY, document_id TEXT, chunk_index INTEGER, content TEXT, embedding vector(3));
CREATE TABLE hop_pgv_acc_written (document_id TEXT, chunk_index INTEGER, chunk_text TEXT);
CREATE TABLE hop_pgv_acc_rejects (document_id TEXT, chunk_index INTEGER, err_desc TEXT, err_code VARCHAR(40));
CREATE TABLE hop_pgv_one_target (id TEXT PRIMARY KEY, document_id TEXT, chunk_index INTEGER, content TEXT, embedding vector(3));
CREATE TABLE hop_pgv_one_written (document_id TEXT, chunk_index INTEGER, chunk_text TEXT);
CREATE TABLE hop_pgv_one_rejects (document_id TEXT, chunk_index INTEGER, err_desc TEXT, err_code VARCHAR(40));
CREATE TABLE hop_pgv_del_target (id TEXT PRIMARY KEY, document_id TEXT, chunk_index INTEGER, content TEXT, embedding vector(3));
CREATE TABLE hop_pgv_del_written (document_id TEXT, chunk_index INTEGER, chunk_text TEXT);
CREATE TABLE hop_pgv_del_rejects (document_id TEXT, chunk_index INTEGER, err_desc TEXT, err_code VARCHAR(40));
INSERT INTO hop_pgv_del_target (id, document_id, chunk_index, content, embedding) VALUES ('doc-keep_0', 'doc-keep', 0, 'old', '[0,1,0]'), ('doc-keep_1', 'doc-keep', 1, 'old', '[0,1,0]'), ('doc-keep_2', 'doc-keep', 2, 'old', '[0,1,0]'), ('doc-swap_0', 'doc-swap', 0, 'old', '[0,1,0]'), ('doc-swap_1', 'doc-swap', 1, 'old', '[0,1,0]'), ('doc-swap_2', 'doc-swap', 2, 'old', '[0,1,0]'), ('doc-swap_3', 'doc-swap', 3, 'old', '[0,1,0]');</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>

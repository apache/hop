<workflow>
  <name>main-0006-design-time-checks</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Design-time checks that only run through PgVectorUpsertMeta.check(), driven by hop lint over two subject pipelines.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/17 09:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/17 09:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>96</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Design-time checks</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Two design-time checks that only PgVectorUpsertMeta.check() can answer, so they are driven
# through "hop lint": it runs the same checkTransforms() that the Hop GUI runs and reports the
# native remarks as HOP-CHECK findings.
#
# Note on ${} below: Hop resolves its own variables in this script before running it, so only Hop
# variables are written with braces. Shell variables are written without them.

set -u

PROJECT_DIR="${PROJECT_HOME}"

HOP_CLI="$(printenv HOP_LOCATION 2&gt;/dev/null || true)"
if [ -n "$HOP_CLI" ] &amp;&amp; [ -x "$HOP_CLI/hop" ]; then
  HOP_CLI="$HOP_CLI/hop"
elif command -v hop &gt; /dev/null 2&gt;/dev/null; then
  HOP_CLI="$(command -v hop)"
elif [ -x /opt/hop/hop ]; then
  HOP_CLI=/opt/hop/hop
else
  echo "FAIL: no hop CLI found, so the design-time checks cannot be run."
  exit 1
fi
echo "Using hop CLI: $HOP_CLI"

export HOP_CONFIG_FOLDER="$PROJECT_DIR"
REPORT_DIR="$PROJECT_DIR/output"
mkdir -p "$REPORT_DIR"
failures=0

# hop lint exits 1 when a finding reaches --fail-on, so only an exit code above 1 means the
# linter itself could not run.
run_lint() {
  rm -f "$2"
  "$HOP_CLI" lint "$1" --format json --output "$2"
  rc=$?
  if [ $rc -gt 1 ]; then
    echo "FAIL: hop lint could not lint $1 (exit code $rc)"
    return 1
  fi
  if [ ! -s "$2" ]; then
    echo "FAIL: hop lint wrote no report for $1"
    return 1
  fi
  return 0
}

echo "=== Subject 1: variables in the numeric options are not design-time errors ==="
# Commit size, embedding dimensions and top-k are resolvable strings so they can be driven by
# variables. A check that cannot resolve one must stay quiet rather than call it out of range.
VARS_REPORT="$REPORT_DIR/lint-variables-in-numeric-fields.json"
if run_lint "$PROJECT_DIR/subject/variables-in-numeric-fields.hpl" "$VARS_REPORT"; then
  found=$(grep -c -e "dimensions must be greater" -e "Commit size cannot be negative" "$VARS_REPORT" || true)
  if [ "$found" -ne 0 ]; then
    echo "FAIL: a variable was reported as an out-of-range number."
    echo "----- report -----"
    cat "$VARS_REPORT"
    echo "------------------"
    failures=$((failures + 1))
  else
    echo "OK: no range findings for values that are still variables."
  fi
else
  failures=$((failures + 1))
fi

echo "=== Subject 2: concurrent DDL is flagged for the index, not only for table creation ==="
# The HNSW index and the mapped-column ALTERs run whether or not the transform creates the table,
# so more than one copy puts concurrent DDL in the path of the second copy.
COPIES_REPORT="$REPORT_DIR/lint-multiple-copies-ddl.json"
if run_lint "$PROJECT_DIR/subject/multiple-copies-ddl.hpl" "$COPIES_REPORT"; then
  found=$(grep -c "more than one copy" "$COPIES_REPORT" || true)
  if [ "$found" -lt 1 ]; then
    echo "FAIL: two copies creating an HNSW index were not flagged."
    echo "----- report -----"
    cat "$COPIES_REPORT"
    echo "------------------"
    failures=$((failures + 1))
  else
    echo "OK: concurrent DDL reported for an index-only configuration."
  fi
else
  failures=$((failures + 1))
fi

if [ $failures -ne 0 ]; then
  echo "$failures design-time check(s) failed."
  exit 1
fi
echo "All design-time checks passed."
exit 0
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>START</from>
      <to>Design-time checks</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<pipeline>
  <info>
    <name>0008-upsert-batch-error-accounting</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Twelve chunks through pgvector upsert with an error hop, three of them refused by the database: once with commit size 5, where PostgreSQL's validated batch failure contract keeps batching on with the error hop, and once with commit size 0, one transaction with a savepoint per row as before. Exactly the three bad chunks have to reach the error stream; every other chunk has to be stored and reported once on the main output. A third upsert deletes each document before its chunks: a document whose only new chunk is refused has to keep its earlier chunks.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/27 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/27 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Twelve chunks, three bad</from>
      <to>Batch upsert</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Batch upsert</from>
      <to>Written</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Batch upsert</from>
      <to>Rejects</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Twelve chunks, three bad (one transaction)</from>
      <to>One transaction upsert</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>One transaction upsert</from>
      <to>Written one transaction</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>One transaction upsert</from>
      <to>Rejects one transaction</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Replaced documents</from>
      <to>Replacing upsert</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Replacing upsert</from>
      <to>Written replaced</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Replacing upsert</from>
      <to>Rejects replaced</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Twelve chunks, three bad</name>
    <type>DataGrid</type>
    <description>Twelve chunks of one document. Chunks 2 (middle of the first commit window), 5 (first row of the second window) and 11 (last row of the final partial window) carry a vector of two dimensions, which the vector(3) column refuses.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line><item>doc-acc</item><item>0</item><item>c0</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>1</item><item>c1</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>2</item><item>c2</item><item>[1,0]</item></line>
      <line><item>doc-acc</item><item>3</item><item>c3</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>4</item><item>c4</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>5</item><item>c5</item><item>[1,0]</item></line>
      <line><item>doc-acc</item><item>6</item><item>c6</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>7</item><item>c7</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>8</item><item>c8</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>9</item><item>c9</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>10</item><item>c10</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>11</item><item>c11</item><item>[1,0]</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>document_id</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>chunk_index</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>chunk_text</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>embedding</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Batch upsert</name>
    <type>PgVectorUpsert</type>
    <description>Commit size 5 and an error hop. The connection's validated batch failure contract keeps batching on with the error hop and works out the rows of a failed batch: the refused rows go to the error hop with code PGVECTORUPSERT002, the others are stored and passed on after their commit.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pgvector</connection>
    <schemaName>public</schemaName>
    <tableName>hop_pgv_acc_target</tableName>
    <documentIdField>document_id</documentIdField>
    <chunkIndexField>chunk_index</chunkIndexField>
    <contentField>chunk_text</contentField>
    <embeddingField>embedding</embeddingField>
    <embeddingDimensions>${PGVECTOR_EMBEDDING_DIMENSIONS}</embeddingDimensions>
    <createTableIfMissing>N</createTableIfMissing>
    <createHnswIndex>N</createHnswIndex>
    <deleteDocumentBeforeUpsert>N</deleteDocumentBeforeUpsert>
    <commitSize>5</commitSize>
    <indexMetric>COSINE</indexMetric>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Written</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>pgvector</connection>
    <fields>
      <field>
        <column_name>document_id</column_name>
        <stream_name>document_id</stream_name>
      </field>
      <field>
        <column_name>chunk_index</column_name>
        <stream_name>chunk_index</stream_name>
      </field>
      <field>
        <column_name>chunk_text</column_name>
        <stream_name>chunk_text</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_pgv_acc_written</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rejects</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>pgvector</connection>
    <fields>
      <field>
        <column_name>document_id</column_name>
        <stream_name>document_id</stream_name>
      </field>
      <field>
        <column_name>chunk_index</column_name>
        <stream_name>chunk_index</stream_name>
      </field>
      <field>
        <column_name>err_desc</column_name>
        <stream_name>ERR_DESC</stream_name>
      </field>
      <field>
        <column_name>err_code</column_name>
        <stream_name>ERR_CODES</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_pgv_acc_rejects</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Twelve chunks, three bad (one transaction)</name>
    <type>DataGrid</type>
    <description>Twelve chunks of one document. Chunks 2 (middle of the first commit window), 5 (first row of the second window) and 11 (last row of the final partial window) carry a vector of two dimensions, which the vector(3) column refuses.</description>

        <name>embedding</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>464</yloc>
    </GUI>
  </transform>
  <transform>
    <name>One transaction upsert</name>
    <type>PgVectorUpsert</type>
    <description>Commit size 0 and an error hop: one transaction for the run, every row on its own behind a savepoint, as before; a refused row goes to the error hop with code PGVECTORUPSERT002.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pgvector</connection>
    <schemaName>public</schemaName>
    <tableName>hop_pgv_one_target</tableName>
    <documentIdField>document_id</documentIdField>
    <chunkIndexField>chunk_index</chunkIndexField>
    <contentField>chunk_text</contentField>
    <embeddingField>embedding</embeddingField>
    <embeddingDimensions>${PGVECTOR_EMBEDDING_DIMENSIONS}</embeddingDimensions>
    <createTableIfMissing>N</createTableIfMissing>
    <createHnswIndex>N</createHnswIndex>
    <deleteDocumentBeforeUpsert>N</deleteDocumentBeforeUpsert>
    <commitSize>0</commitSize>
    <indexMetric>COSINE</indexMetric>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>464</yloc>

        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>784</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Replacing upsert</name>
    <type>PgVectorUpsert</type>
    <description>Delete document before upsert, commit size 5 and an error hop. The delete of a document and the upsert of its first row are committed together, or neither is: doc-keep keeps its earlier chunks, and the delete of doc-swap runs with its first stored chunk.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pgvector</connection>
    <schemaName>public</schemaName>
    <tableName>hop_pgv_del_target</tableName>
    <documentIdField>document_id</documentIdField>
    <chunkIndexField>chunk_index</chunkIndexField>
    <contentField>chunk_text</contentField>
    <embeddingField>embedding</embeddingField>
    <embeddingDimensions>${PGVECTOR_EMBEDDING_DIMENSIONS}</embeddingDimensions>
    <createTableIfMissing>N</createTableIfMissing>
    <createHnswIndex>N</createHnswIndex>
    <deleteDocumentBeforeUpsert>Y</deleteDocumentBeforeUpsert>
    <commitSize>5</commitSize>
    <indexMetric>COSINE</indexMetric>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>784</yloc>
    </GUI>
  </transform>

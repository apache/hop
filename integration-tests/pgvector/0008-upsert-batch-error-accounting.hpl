      <line><item>doc-acc</item><item>5</item><item>c5</item><item>[1,0]</item></line>
      <line><item>doc-acc</item><item>6</item><item>c6</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>7</item><item>c7</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>8</item><item>c8</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>9</item><item>c9</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>10</item><item>c10</item><item>[1,0,0]</item></line>
      <line><item>doc-acc</item><item>11</item><item>c11</item><item>[1,0]</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>document_id</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>chunk_index</name>
        <type>Integer</type>
      </field>
      <field>

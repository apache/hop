  <transform>
    <name>Replaced documents</name>
    <type>DataGrid</type>
    <description>doc-keep has a single new chunk, which the database refuses. doc-swap has three: the first is refused, the other two are stored.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line><item>doc-keep</item><item>0</item><item>k0</item><item>[1,0]</item></line>
      <line><item>doc-swap</item><item>0</item><item>s0</item><item>[1,0]</item></line>
      <line><item>doc-swap</item><item>1</item><item>s1</item><item>[1,0,0]</item></line>
      <line><item>doc-swap</item><item>2</item><item>s2</item><item>[1,0,0]</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>document_id</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>chunk_index</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>chunk_text</name>
        <type>String</type>
      </field>
      <field>

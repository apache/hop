<workflow>
  <name>main-0008-samples-lint-clean</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>The Language Model Chat and GraphRAG samples have no hardcoded API key (SEC-002)</description>
  <extended_description>A sample stores the key of the provider it uses only, so the key fields of the other providers load with their default values. Those defaults must not read as hardcoded secrets.</extended_description>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/08 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/08 10:00:00.000</modified_date>
  <parameters/>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Copy the samples</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Hop resolves its own variables in this script before running it, so only Hop variables are
# written with braces. Shell variables are written without them.
#
# The samples are linted from a copy: the linter skips every path with /target/ in it, which is
# where a locally built client lives, and a copy also keeps the other samples out of the report.

set -eu

SAMPLES="${user.dir}/config/projects/samples/transforms"
COPY="${PROJECT_HOME}/output/samples"

rm -rf "$COPY"
mkdir -p "$COPY"

for f in \
  languagemodelchat/zero-shot/anthropic.hpl \
  languagemodelchat/zero-shot/huggingface.hpl \
  languagemodelchat/zero-shot/mistral.hpl \
  languagemodelchat/zero-shot/ollama.hpl \
  languagemodelchat/zero-shot/openai.hpl \
  languagemodelchat/fact-checking/bespoke-minicheck.hpl \
  graphrag-ask.hpl \
  graphrag-ask-hybrid.hpl; do
  if [ ! -f "$SAMPLES/$f" ]; then
    echo "FAIL: sample $SAMPLES/$f is missing"
    exit 1
  fi
  mkdir -p "$COPY/$(dirname "$f")"
  cp "$SAMPLES/$f" "$COPY/$f"
done
echo "Copied the samples to $COPY"
</script>
      <loglevel>Basic</loglevel>
      <nr>0</nr>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Lint the samples</name>
      <description/>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/output/samples</target>
      <include_metadata>N</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file>${PROJECT_HOME}/output/samples-lint.json</report_file>
      <report_format>JSON</report_format>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the findings</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Hop resolves its own variables in this script before running it, so only Hop variables are
# written with braces. Shell variables are written without them.

set -u

REPORT="${PROJECT_HOME}/output/samples-lint.json"

if [ ! -s "$REPORT" ]; then
  echo "FAIL: the linter wrote no report at $REPORT"
  exit 1
fi

# One finding per line, so a rule id and the file it names can be matched together.
FINDINGS=$(tr -d '\n' &lt; "$REPORT" | sed 's/}, {/\n/g')

# The samples carry info and warning findings of their own. None at all means nothing was linted,
# which would let the SEC-002 check below pass on an empty report.
TOTAL=$(printf '%s\n' "$FINDINGS" | grep -cF '"ruleId"')
if [ "$TOTAL" -eq 0 ]; then
  echo "FAIL: the linter reported nothing for the samples, so they were not linted"
  exit 1
fi

SECRETS=$(printf '%s\n' "$FINDINGS" | grep -F '"ruleId" : "SEC-002"')
if [ -n "$SECRETS" ]; then
  echo "FAIL: SEC-002 reports a hardcoded secret in the samples:"
  printf '%s\n' "$SECRETS" | grep -oE '"message" : "[^"]*"|"file" : "[^"]*"' | paste - -
  exit 1
fi

echo "OK: $TOTAL finding(s) for the samples, none of them SEC-002"
</script>
      <loglevel>Basic</loglevel>
      <nr>0</nr>
      <parallel>N</parallel>
      <xloc>592</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Copy the samples</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Copy the samples</from>
      <to>Lint the samples</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Lint the samples</from>
      <to>Check the findings</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

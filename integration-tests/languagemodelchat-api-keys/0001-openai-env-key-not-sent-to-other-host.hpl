<pipeline>
  <info>
    <name>0001-openai-env-key-not-sent-to-other-host</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>OpenAI with the API key field left at its default does not send OPENAI_API_KEY from the environment to another host</description>
    <extended_description>The key field is not in the file, as in every sample that uses another provider, so it loads with its default value. The environment variable is only sent to openai.com, and the stub is another host, so it must get no key. The stub endpoint answers with the API key it received, in square brackets, so the check compares the answer with the key the transform should have sent.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/08 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/08 10:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>prompt</from>
      <to>Language Model Chat</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Language Model Chat</from>
      <to>check key</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check key</from>
      <to>key received</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check key</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>prompt</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>prompt</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>expected</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>Which API key did you receive?</item>
        <item>[]</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Language Model Chat</name>
    <type>LanguageModelChat</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <inputField>prompt</inputField>
    <inputChatJson>false</inputChatJson>
    <outputChatJson>false</outputChatJson>
    <mock>false</mock>
    <outputFieldNamePrefix>llm_</outputFieldNamePrefix>
    <modelType>OPEN_AI</modelType>
    <parallelism>1</parallelism>
    <openAiBaseUrl>${LLM_STUB_URL}/openai/v1</openAiBaseUrl>
    <openAiMaxRetries>0</openAiMaxRetries>
    <mistralMaxRetries>0</mistralMaxRetries>
    <anthropicMaxRetries>0</anthropicMaxRetries>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check key</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>key received</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>llm_output</leftvalue>
        <function>=</function>
        <rightvalue>expected</rightvalue>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>key received</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>The stub endpoint received the expected API key</logmessage>
    <fields>
      <field>
        <name>llm_finish_reason</name>
      </field>
      <field>
        <name>llm_output</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>The Language Model Chat transform did not send the expected API key: compare llm_output with expected</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>

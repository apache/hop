<workflow>
  <name>main-0038-postgres-via-ssh-jump-host</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>PostgreSQL via an SSH tunnel through a jump host</description>
  <extended_description>The SSH server ssh-target and PostgreSQL (as postgres-behind-ssh) are on networks the test container is not on (see integration-tests-database.yaml). The direct tunnel to ssh-target has to fail, which proves the topology; the tunnel through the jump host ssh-jump, signed in with a private key, has to work.</extended_description>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/27 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/27 00:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Direct tunnel to ssh-target must fail</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>unit-test-db-ssh-target-direct</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>SELECT 1 AS one</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>N</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>ssh-target is reachable without the jump host</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>The SSH server behind the jump host was reached directly: the jump host test proves nothing, check the networks in integration-tests-database.yaml</message>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Tunnel through the jump host</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>unit-test-db-ssh-jump-host</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>SELECT 1 AS one, current_database() AS db</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>N</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>512</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Direct tunnel to ssh-target must fail</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Direct tunnel to ssh-target must fail</from>
      <to>ssh-target is reachable without the jump host</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Direct tunnel to ssh-target must fail</from>
      <to>Tunnel through the jump host</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

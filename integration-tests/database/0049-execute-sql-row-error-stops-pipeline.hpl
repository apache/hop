<pipeline>
  <info>
    <name>0049-execute-sql-row-error-stops-pipeline</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Table Input (a few thousand rows) to Filter rows to Execute SQL row. One INSERT (id 1500) violates the target CHECK constraint and there is no error hop, so the SQL error must stop the whole local pipeline (error-triggered shutdown) instead of hanging.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/10 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/10 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Table Input</from>
      <to>Filter rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filter rows</from>
      <to>Execute SQL row</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Table Input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>unit-test-db</connection>
    <sql>SELECT id, name, sql FROM public.it0049_execute_sql_row_stops_source</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Filter rows</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Execute SQL row</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>id</leftvalue>
        <function>&lt;=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>2000</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute SQL row</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>2</commit>
    <connection>unit-test-db</connection>
    <sql_field>sql</sql_field>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <sqlFromfile>N</sqlFromfile>
    <sendOneStatement>Y</sendOneStatement>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <attributes/>
</pipeline>
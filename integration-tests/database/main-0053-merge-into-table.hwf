<workflow>
  <name>main-0053-merge-into-table</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Merge into table end to end: insert of new keys, update of seeded keys, a key repeated within a batch, insert only, update only changed rows (counted by an update trigger where the database has one), batch updates on and off, and an error hop that must get exactly the three refused rows while every other row is written once. PostgreSQL: MERGE (PostgreSQL 15 and later), its parameters cast to the column types, so the overlong label must be refused as by a plain INSERT; failed batches are recovered (LOSES_WHOLE_BATCH), rows run behind a savepoint each without batches.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/25 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/25 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS mit_log;
DROP TABLE IF EXISTS mit_batch;
DROP TABLE IF EXISTS mit_rows;
DROP TABLE IF EXISTS mit_ins;
DROP TABLE IF EXISTS mit_chg;
CREATE TABLE mit_log (tbl VARCHAR(20), id BIGINT);
CREATE TABLE mit_batch (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(10) NOT NULL, amount NUMERIC(10,2), CONSTRAINT mit_batch_amount CHECK (amount &gt;= 0));
INSERT INTO mit_batch (id, label, amount) VALUES (1, 'seed', 1.00);
INSERT INTO mit_batch (id, label, amount) VALUES (2, 'seed', 1.00);
INSERT INTO mit_batch (id, label, amount) VALUES (3, 'seed', 1.00);
CREATE TABLE mit_rows (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(10) NOT NULL, amount NUMERIC(10,2), CONSTRAINT mit_rows_amount CHECK (amount &gt;= 0));
INSERT INTO mit_rows (id, label, amount) VALUES (1, 'seed', 1.00);
INSERT INTO mit_rows (id, label, amount) VALUES (2, 'seed', 1.00);
INSERT INTO mit_rows (id, label, amount) VALUES (3, 'seed', 1.00);
CREATE TABLE mit_ins (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(10) NOT NULL, amount NUMERIC(10,2), CONSTRAINT mit_ins_amount CHECK (amount &gt;= 0));
INSERT INTO mit_ins (id, label, amount) VALUES (1, 'seed', 1.00);
INSERT INTO mit_ins (id, label, amount) VALUES (2, 'seed', 1.00);
INSERT INTO mit_ins (id, label, amount) VALUES (3, 'seed', 1.00);
CREATE TABLE mit_chg (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(10) NOT NULL, amount NUMERIC(10,2), CONSTRAINT mit_chg_amount CHECK (amount &gt;= 0));
INSERT INTO mit_chg (id, label, amount) VALUES (1, 'seed', 1.00);
INSERT INTO mit_chg (id, label, amount) VALUES (2, 'seed', 1.00);
INSERT INTO mit_chg (id, label, amount) VALUES (3, 'seed', 1.00);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>unit-test-db</connection>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log updates function</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE OR REPLACE FUNCTION mit_log_update() RETURNS trigger AS $$
BEGIN
  INSERT INTO mit_log (tbl, id) VALUES (TG_TABLE_NAME, NEW.id);
  RETURN NEW;
END;
$$ LANGUAGE plpgsql</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>unit-test-db</connection>
      <parallel>N</parallel>
      <xloc>320</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log updates of mit_batch</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TRIGGER mit_batch_upd AFTER UPDATE ON mit_batch FOR EACH ROW EXECUTE FUNCTION mit_log_update()</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>unit-test-db</connection>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>

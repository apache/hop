<workflow>
  <name>main-0050-mysql-bulk-file</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Bulk load from MySQL into file (issue #9166): export with and without High Priority, and a connection that does not exist is a false result, not a stopped workflow.</description>
  <extended_description>The MySQL server writes the files, into its secure_file_priv folder /var/lib/mysql-files (a tmpfs in the compose file, so it is empty on every start). LOAD_FILE() reads them back on the server.</extended_description>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/05 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/05 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init table</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>mysql</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>DROP TABLE IF EXISTS bulk_file_source;

CREATE TABLE bulk_file_source
(
    id   INT,
    name VARCHAR(20)
) ENGINE = InnoDB;

INSERT INTO bulk_file_source (id, name)
VALUES (1, 'Goku'),
       (2, 'Vegeta');
</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>N</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Export with High Priority</name>
      <description/>
      <type>MYSQL_BULK_FILE</type>
      <attributes/>
      <addfiletoresult>N</addfiletoresult>
      <connection>mysql</connection>
      <enclosed/>
      <filename>/var/lib/mysql-files/0050-high-priority.txt</filename>
      <highpriority>Y</highpriority>
      <iffileexists>2</iffileexists>
      <limitlines>0</limitlines>
      <lineterminated/>
      <listcolumn/>
      <optionenclosed>N</optionenclosed>
      <outdumpvalue>0</outdumpvalue>
      <schemaname/>
      <separator>;</separator>
      <tablename>bulk_file_source</tablename>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check High Priority file</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>mysql</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT 1 FROM DUAL
WHERE LOAD_FILE('/var/lib/mysql-files/0050-high-priority.txt') = '1;Goku\n2;Vegeta\n'</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Export without High Priority</name>
      <description/>
      <type>MYSQL_BULK_FILE</type>
      <attributes/>
      <addfiletoresult>N</addfiletoresult>
      <connection>mysql</connection>
      <enclosed/>
      <filename>/var/lib/mysql-files/0050-share-mode.txt</filename>
      <highpriority>N</highpriority>
      <iffileexists>2</iffileexists>
      <limitlines>0</limitlines>
      <lineterminated/>
      <listcolumn/>
      <optionenclosed>N</optionenclosed>
      <outdumpvalue>0</outdumpvalue>
      <schemaname/>
      <separator>;</separator>
      <tablename>bulk_file_source</tablename>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>208</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check file without High Priority</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>mysql</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT 1 FROM DUAL
WHERE LOAD_FILE('/var/lib/mysql-files/0050-share-mode.txt') = '1;Goku\n2;Vegeta\n'</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>208</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Export with unknown connection</name>
      <description/>
      <type>MYSQL_BULK_FILE</type>
      <attributes/>
      <addfiletoresult>N</addfiletoresult>
      <connection>does-not-exist</connection>
      <enclosed/>
      <filename>/var/lib/mysql-files/0050-unknown-connection.txt</filename>
      <highpriority>N</highpriority>
      <iffileexists>2</iffileexists>
      <limitlines>0</limitlines>
      <lineterminated/>
      <listcolumn/>
      <optionenclosed>N</optionenclosed>
      <outdumpvalue>0</outdumpvalue>
      <schemaname/>
      <separator>;</separator>
      <tablename>bulk_file_source</tablename>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>336</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>336</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort: unknown connection was true</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>Y</always_log_rows>
      <message>The export with a connection that does not exist gave a true result</message>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>464</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Init table</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Init table</from>
      <to>Export with High Priority</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Export with High Priority</from>
      <to>Check High Priority file</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check High Priority file</from>
      <to>Export without High Priority</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Export without High Priority</from>
      <to>Check file without High Priority</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check file without High Priority</from>
      <to>Export with unknown connection</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Export with unknown connection</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Export with unknown connection</from>
      <to>Abort: unknown connection was true</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

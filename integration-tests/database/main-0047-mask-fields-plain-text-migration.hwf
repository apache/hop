<workflow>
  <name>main-0047-mask-fields-plain-text-migration</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/07 20:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/07 20:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>scripts/script-mask-fields-plain-text-migration.sql</name>
      <description/>
      <type>SQL</type>
      <connection>unit-test-db</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql/>
      <sqlfilename>${PROJECT_HOME}/scripts/script-mask-fields-plain-text-migration.sql</sqlfilename>
      <sqlfromfile>Y</sqlfromfile>
      <useVariableSubstitution>N</useVariableSubstitution>
      <attributes/>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>mask</name>
      <description/>
      <type>PIPELINE</type>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0047-mask-fields-plain-text-migration.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <attributes/>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Matt keeps the stored value</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT 1
FROM   public.mask_0047_result
WHERE  id = 1 AND first_name = 'fn-legacy'
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>1</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Ann continues the stored sequence</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT 1
FROM   public.mask_0047_result
WHERE  id = 2 AND first_name = 'fn100'
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>1</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>2 mappings</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT 1
FROM   public.mask_0047
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>2</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>no keys left in plain text</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT 1
FROM   public.mask_0047
WHERE  source_key NOT LIKE 'hmac-sha256:%'
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>0</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1024</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>scripts/script-mask-fields-plain-text-migration.sql</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>scripts/script-mask-fields-plain-text-migration.sql</from>
      <to>mask</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>mask</from>
      <to>Matt keeps the stored value</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Matt keeps the stored value</from>
      <to>Ann continues the stored sequence</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Ann continues the stored sequence</from>
      <to>2 mappings</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>2 mappings</from>
      <to>no keys left in plain text</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

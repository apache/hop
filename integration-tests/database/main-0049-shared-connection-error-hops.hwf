<workflow>
  <name>main-0049-shared-connection-error-hops</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Transforms with an error hop on PostgreSQL that share one connection (transactional) or one thread (single threaded): only the failing rows may be rejected, and no good row may be lost</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/03 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/03 12:00:00.000</modified_date>
  <parameters>
    </parameters>

        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check normal local</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>unit-test-db</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT 1
WHERE (SELECT string_agg(id || &apos;:&apos; || name, &apos;,&apos; ORDER BY id) FROM public.it0049_a)
    = (SELECT string_agg(g || &apos;:&apos; || CASE WHEN g % 97 &lt;&gt; 0 THEN &apos;a&apos; ELSE &apos;x&apos; END, &apos;,&apos; ORDER BY g)
       FROM generate_series(1, 3000) g)
  AND (SELECT string_agg(id::text, &apos;,&apos; ORDER BY id) FROM public.it0049_err_a)
    = (SELECT string_agg(g::text, &apos;,&apos; ORDER BY g) FROM generate_series(1, 3000) g WHERE g % 97 = 0)
  AND (SELECT string_agg(id || &apos;:&apos; || name, &apos;,&apos; ORDER BY id) FROM public.it0049_b)
    = (SELECT string_agg(g || &apos;:&apos; || CASE WHEN g % 97 &lt;&gt; 0 AND g % 89 &lt;&gt; 0 THEN &apos;a&apos; ELSE &apos;x&apos; END, &apos;,&apos; ORDER BY g)
       FROM generate_series(1, 3000) g WHERE g &lt;= 1500 OR (g % 97 &lt;&gt; 0 AND g % 89 &lt;&gt; 0))
  AND (SELECT string_agg(id::text, &apos;,&apos; ORDER BY id) FROM public.it0049_err_b)
    = (SELECT string_agg(g::text, &apos;,&apos; ORDER BY g) FROM generate_series(1, 3000) g
       WHERE g % 97 &lt;&gt; 0 AND g % 89 = 0)
  AND (SELECT string_agg(id || &apos;:&apos; || name, &apos;,&apos; ORDER BY id) FROM public.it0049_c)
    = (SELECT string_agg(g || &apos;:a&apos;, &apos;,&apos; ORDER BY g) FROM generate_series(1, 3000) g
       WHERE g % 97 &lt;&gt; 0 AND g % 89 &lt;&gt; 0 AND g % 83 &lt;&gt; 0)
  AND (SELECT string_agg(id::text, &apos;,&apos; ORDER BY id) FROM public.it0049_err_c)
    = (SELECT string_agg(g::text, &apos;,&apos; ORDER BY g) FROM generate_series(1, 3000) g
       WHERE g % 97 &lt;&gt; 0 AND g % 89 &lt;&gt; 0 AND g % 83 = 0)</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>48</yloc>

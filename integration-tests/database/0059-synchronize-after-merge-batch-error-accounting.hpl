<pipeline>
  <info>
    <name>0059-synchronize-after-merge-batch-error-accounting</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Twelve rows through Synchronize after merge on PostgreSQL with an error hop and commit size 5, inserts, updates and deletes, three of them refused by the database and one skipped, once with batch updates on and once with them off. Exactly those three have to reach the error stream; every other row has to be written and reported once on the main output.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/27 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/27 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Twelve rows, three bad</from>
      <to>Batch synchronize</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Batch synchronize</from>
      <to>Rejects</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Batch synchronize</from>
      <to>Written</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Twelve rows, three bad (row by row)</from>
      <to>Row by row synchronize</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Row by row synchronize</from>
      <to>Rejects row by row</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Row by row synchronize</from>
      <to>Written row by row</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Twelve rows, three bad</name>
    <type>DataGrid</type>
    <description>Twelve rows, the operation in FLAG: new inserts, changed updates, deleted deletes, identical is skipped. Three are refused by the database: the update of 2 to 'bad' (the check constraint, in the middle of the first commit window), the insert of 5 (a duplicate key, first row of the second window) and the delete of 6 (a child row refers to it). The skipped row 11 is the last of the final partial window.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line><item>0</item><item>new</item><item>changed</item></line>
      <line><item>1</item><item>new</item><item>changed</item></line>
      <line><item>2</item><item>bad</item><item>changed</item></line>
      <line><item>3</item><item>-</item><item>deleted</item></line>
      <line><item>8</item><item>new</item><item>new</item></line>
      <line><item>5</item><item>new</item><item>new</item></line>
      <line><item>4</item><item>-</item><item>deleted</item></line>
      <line><item>6</item><item>-</item><item>deleted</item></line>
      <line><item>9</item><item>new</item><item>new</item></line>
      <line><item>7</item><item>new</item><item>changed</item></line>
      <line><item>10</item><item>new</item><item>new</item></line>
      <line><item>11</item><item>new</item><item>identical</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>ID</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>LABEL</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>FLAG</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Batch synchronize</name>
    <type>SynchronizeAfterMerge</type>
    <description>Use batch updates on, an error hop, commit size 5. The connection's validated batch failure contract keeps batching on with the error hop, without a savepoint per row, and works out the rows of a failed batch: the refused rows go to the error hop with code SUYNC002.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>unit-test-db</connection>
    <commit>5</commit>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <use_batch>Y</use_batch>
    <perform_lookup>N</perform_lookup>
    <operation_order_field>FLAG</operation_order_field>
    <order_insert>new</order_insert>
    <order_update>changed</order_update>
    <order_delete>deleted</order_delete>
    <lookup>
      <schema/>
      <table>hop_sam_err_target</table>
      <key>
        <name>ID</name>
        <field>id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>id</name>
        <rename>ID</rename>
        <update>N</update>
      </value>
      <value>
        <name>label</name>
        <rename>LABEL</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Written</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>label</column_name>
        <stream_name>LABEL</stream_name>
      </field>
      <field>
        <column_name>flag</column_name>
        <stream_name>FLAG</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_sam_err_written</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rejects</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>label</column_name>
        <stream_name>LABEL</stream_name>
      </field>
      <field>
        <column_name>flag</column_name>
        <stream_name>FLAG</stream_name>
      </field>
      <field>
        <column_name>err_desc</column_name>
        <stream_name>ERR_DESC</stream_name>
      </field>
      <field>
        <column_name>err_code</column_name>
        <stream_name>ERR_CODES</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_sam_err_rejects</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Twelve rows, three bad (row by row)</name>
    <type>DataGrid</type>
    <description>Twelve rows, the operation in FLAG: new inserts, changed updates, deleted deletes, identical is skipped. Three are refused by the database: the update of 2 to 'bad' (the check constraint, in the middle of the first commit window), the insert of 5 (a duplicate key, first row of the second window) and the delete of 6 (a child row refers to it). The skipped row 11 is the last of the final partial window.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line><item>0</item><item>new</item><item>changed</item></line>
      <line><item>1</item><item>new</item><item>changed</item></line>
      <line><item>2</item><item>bad</item><item>changed</item></line>
      <line><item>3</item><item>-</item><item>deleted</item></line>
      <line><item>8</item><item>new</item><item>new</item></line>
      <line><item>5</item><item>new</item><item>new</item></line>
      <line><item>4</item><item>-</item><item>deleted</item></line>
      <line><item>6</item><item>-</item><item>deleted</item></line>
      <line><item>9</item><item>new</item><item>new</item></line>
      <line><item>7</item><item>new</item><item>changed</item></line>
      <line><item>10</item><item>new</item><item>new</item></line>
      <line><item>11</item><item>new</item><item>identical</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>ID</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>LABEL</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>FLAG</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>464</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Row by row synchronize</name>
    <type>SynchronizeAfterMerge</type>
    <description>Use batch updates off, an error hop, commit size 5. Every row runs behind a savepoint and is passed on right after its statement, as before; a refused row goes to the error hop with code SUYNC001.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>unit-test-db</connection>
    <commit>5</commit>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <use_batch>N</use_batch>
    <perform_lookup>N</perform_lookup>
    <operation_order_field>FLAG</operation_order_field>
    <order_insert>new</order_insert>
    <order_update>changed</order_update>
    <order_delete>deleted</order_delete>
    <lookup>
      <schema/>
      <table>hop_sam_rbr_target</table>
      <key>
        <name>ID</name>
        <field>id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>id</name>
        <rename>ID</rename>
        <update>N</update>
      </value>
      <value>
        <name>label</name>
        <rename>LABEL</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>464</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Written row by row</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>label</column_name>
        <stream_name>LABEL</stream_name>
      </field>
      <field>
        <column_name>flag</column_name>
        <stream_name>FLAG</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_sam_rbr_written</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>400</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rejects row by row</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>label</column_name>
        <stream_name>LABEL</stream_name>
      </field>
      <field>
        <column_name>flag</column_name>
        <stream_name>FLAG</stream_name>
      </field>
      <field>
        <column_name>err_desc</column_name>
        <stream_name>ERR_DESC</stream_name>
      </field>
      <field>
        <column_name>err_code</column_name>
        <stream_name>ERR_CODES</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_sam_rbr_rejects</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>528</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>Batch synchronize</source_transform>
      <target_transform>Rejects</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>ERR_COUNT</nr_valuename>
      <descriptions_valuename>ERR_DESC</descriptions_valuename>
      <fields_valuename>ERR_FIELDS</fields_valuename>
      <codes_valuename>ERR_CODES</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
    <error>
      <source_transform>Row by row synchronize</source_transform>
      <target_transform>Rejects row by row</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>ERR_COUNT</nr_valuename>
      <descriptions_valuename>ERR_DESC</descriptions_valuename>
      <fields_valuename>ERR_FIELDS</fields_valuename>
      <codes_valuename>ERR_CODES</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <attributes/>
</pipeline>

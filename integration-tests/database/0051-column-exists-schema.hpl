<pipeline>
  <info>
    <name>0051-column-exists-schema</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Column exists with a schema, for a fixed table name and a table name from a field (#9635)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/22 15:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/22 15:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>columns of hop_ce.ce_table</from>
      <to>fixed table with schema</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>fixed table with schema</from>
      <to>fixed table with schema result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>tables and columns in hop_ce</from>
      <to>table from field with schema</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>table from field with schema</from>
      <to>table from field with schema result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>columns of ce_public_table</from>
      <to>fixed table without schema</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>fixed table without schema</from>
      <to>fixed table without schema result</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>columns of hop_ce.ce_table</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>id</item>
      </line>
      <line>
        <item>description</item>
      </line>
      <line>
        <item>order</item>
      </line>
      <line>
        <item>not_there</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>column_name</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>fixed table with schema</name>
    <type>ColumnExists</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <columnnamefield>column_name</columnnamefield>
    <connection>unit-test-db</connection>
    <istablenameInfield>N</istablenameInfield>
    <resultfieldname>result</resultfieldname>
    <schemaname>hop_ce</schemaname>
    <tablename>ce_table</tablename>
    <tablenamefield/>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>fixed table with schema result</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>tables and columns in hop_ce</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>ce_table</item>
        <item>id</item>
      </line>
      <line>
        <item>ce_table</item>
        <item>not_there</item>
      </line>
      <line>
        <item>missing_table</item>
        <item>id</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>table_name</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>column_name</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>table from field with schema</name>
    <type>ColumnExists</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <columnnamefield>column_name</columnnamefield>
    <connection>unit-test-db</connection>
    <istablenameInfield>Y</istablenameInfield>
    <resultfieldname>result</resultfieldname>
    <schemaname>hop_ce</schemaname>
    <tablename/>
    <tablenamefield>table_name</tablenamefield>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>table from field with schema result</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>columns of ce_public_table</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>key</item>
      </line>
      <line>
        <item>not_there</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>column_name</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>352</yloc>
    </GUI>
  </transform>
  <transform>
    <name>fixed table without schema</name>
    <type>ColumnExists</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <columnnamefield>column_name</columnnamefield>
    <connection>unit-test-db</connection>
    <istablenameInfield>N</istablenameInfield>
    <resultfieldname>result</resultfieldname>
    <schemaname/>
    <tablename>ce_public_table</tablename>
    <tablenamefield/>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>352</yloc>
    </GUI>
  </transform>
  <transform>
    <name>fixed table without schema result</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>352</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

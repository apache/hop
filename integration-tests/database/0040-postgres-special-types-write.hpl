<pipeline>
  <info>
    <name>0040-postgres-special-types-write</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Writes UUID, Internet Address and JSON values, and a row where all three are null, into the matching Postgres column types.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/20 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/20 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Text columns in</from>
      <to>To Hop types</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>To Hop types</from>
      <to>Special types out</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Text columns in</name>
    <type>TableInput</type>
    <description>The JSON value is cast in SQL, so the driver hands it over already typed. The UUID and the address arrive as text and are given their Hop type below.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>unit-test-db</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT id,
       uuid_text,
       inet_text,
       json_text::jsonb AS json_value
FROM special_types_source
ORDER BY id;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>To Hop types</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <meta>
        <date_format_lenient>N</date_format_lenient>
        <length>-2</length>
        <lenient_string_to_number>N</lenient_string_to_number>
        <name>uuid_text</name>
        <precision>-2</precision>
        <rename>uuid_value</rename>
        <roundingType>half_even</roundingType>
        <storage_type/>
        <type>UUID</type>
      </meta>
      <meta>
        <date_format_lenient>N</date_format_lenient>
        <length>-2</length>
        <lenient_string_to_number>N</lenient_string_to_number>
        <name>inet_text</name>
        <precision>-2</precision>
        <rename>inet_value</rename>
        <roundingType>half_even</roundingType>
        <storage_type/>
        <type>Internet Address</type>
      </meta>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Special types out</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>id</stream_name>
      </field>
      <field>
        <column_name>uuid_value</column_name>
        <stream_name>uuid_value</stream_name>
      </field>
      <field>
        <column_name>inet_value</column_name>
        <stream_name>inet_value</stream_name>
      </field>
      <field>
        <column_name>json_value</column_name>
        <stream_name>json_value</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>special_types_target</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

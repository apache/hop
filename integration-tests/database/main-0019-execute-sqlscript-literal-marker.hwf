<workflow>
  <name>main-0019-execute-sqlscript-literal-marker</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Execute SQL script with text replacement on PostgreSQL: question marks in literals, dollar quotes and the JSONB ?| operator are not markers.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/24 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/24 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Prepare tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>
DROP TABLE IF EXISTS public.it0019_literal_marker;
DROP TABLE IF EXISTS public.it0019_jsonb;
DROP TABLE IF EXISTS public.it0019_jsonb_hits;

CREATE TABLE public.it0019_literal_marker (id int NULL, name varchar NULL, tag varchar NULL, tag2 varchar NULL);
CREATE TABLE public.it0019_jsonb (id int NULL, doc jsonb NULL);
CREATE TABLE public.it0019_jsonb_hits (id int NULL);

INSERT INTO public.it0019_jsonb VALUES (1, &apos;{"a": 1}&apos;), (2, &apos;{"b": 1}&apos;);
</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>unit-test-db</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0019-execute-sqlscript-literal-marker</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0019-execute-sqlscript-literal-marker.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check literals and JSONB filter</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>unit-test-db</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT 1
WHERE (SELECT string_agg(id || &apos;:&apos; || name || &apos;:&apos; || tag || &apos;:&apos; || tag2, &apos;,&apos; ORDER BY id) FROM public.it0019_literal_marker) = &apos;1:one:what?:and?,2:two:what?:and?&apos;
  AND (SELECT string_agg(id::text, &apos;,&apos; ORDER BY id) FROM public.it0019_jsonb_hits) = &apos;1&apos;</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Prepare tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Prepare tables</from>
      <to>0019-execute-sqlscript-literal-marker</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0019-execute-sqlscript-literal-marker</from>
      <to>check literals and JSONB filter</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

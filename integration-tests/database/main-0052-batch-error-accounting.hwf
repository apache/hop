<workflow>
  <name>main-0052-batch-error-accounting</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Table Output with batch updates and an error hop on PostgreSQL. Twelve rows at commit size 5, three of them violating the primary key: one in the middle of the first commit window, one at the first position of the second and one at the end of the final partial batch. PostgreSQL aborts the whole transaction on the first failing statement, so the good rows of the failing window have to be driven again rather than rejected with it. Asserts that exactly the three bad rows reach the error stream and that the nine good rows are in the table and on the main output, each exactly once. Same contract as oracle/main-0006-batch-error-accounting.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/11 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/11 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS hop_batch_err_target;
DROP TABLE IF EXISTS hop_batch_err_written;
DROP TABLE IF EXISTS hop_batch_err_rejects;
CREATE TABLE hop_batch_err_target (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(20));
CREATE TABLE hop_batch_err_written (id BIGINT, label VARCHAR(20));
CREATE TABLE hop_batch_err_rejects (id BIGINT, label VARCHAR(20), err_desc TEXT);
INSERT INTO hop_batch_err_target (id, label) VALUES (9000, 'seed');
INSERT INTO hop_batch_err_target (id, label) VALUES (9001, 'seed');
INSERT INTO hop_batch_err_target (id, label) VALUES (9002, 'seed');</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>unit-test-db</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0052-batch-error-accounting.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0052-batch-error-accounting.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>every row on exactly one stream</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DO $$
DECLARE
  n BIGINT;
BEGIN

  -- Twelve rows went in; twelve rows have to come out on exactly one of the two streams.
  SELECT COUNT(*) INTO n FROM (SELECT id FROM hop_batch_err_written UNION ALL SELECT id FROM hop_batch_err_rejects) s;
  IF n &lt;&gt; 12 THEN
    RAISE EXCEPTION 'rows on the main output plus rows on the error stream: got %, expected 12', n;
  END IF;

  -- Only the three rows the database refused are rejects. A driver that rolls back or abandons
  -- the rest of the batch must not take the good rows of that commit window down with it.
  SELECT COUNT(*) INTO n FROM hop_batch_err_rejects;
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'rows on the error stream: got %, expected 3', n;
  END IF;

  -- The rejects are exactly the bad rows: middle of window 1, first of window 2, last of the final partial batch.
  SELECT COUNT(*) INTO n FROM hop_batch_err_rejects WHERE id IN (9000, 9001, 9002);
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'rejected rows that are the bad rows: got %, expected 3', n;
  END IF;

  -- All nine good rows are reported on the main output.
  SELECT COUNT(*) INTO n FROM hop_batch_err_written;
  IF n &lt;&gt; 9 THEN
    RAISE EXCEPTION 'rows on the main output: got %, expected 9', n;
  END IF;

  -- Every row is reported exactly once. A retry that re-sent a row the database had already
  -- applied, or reported it twice, would show up here.
  SELECT COUNT(*) INTO n FROM (SELECT id FROM hop_batch_err_written GROUP BY id HAVING COUNT(*) &gt; 1) d;
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'rows reported on the main output more than once: got %, expected 0', n;
  END IF;

  -- Rows behind a failure were retried, not reported as never attempted, and every reject carries a message.
  SELECT COUNT(*) INTO n FROM hop_batch_err_rejects WHERE err_desc IS NULL OR err_desc LIKE '%not sent to the database%';
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'rejected rows without a database error message: got %, expected 0', n;
  END IF;

  -- What the database holds: the three seed rows plus the nine good rows.
  SELECT COUNT(*) INTO n FROM hop_batch_err_target;
  IF n &lt;&gt; 12 THEN
    RAISE EXCEPTION 'rows in the target table (3 seeded + 9 written): got %, expected 12', n;
  END IF;

  -- Every good input row is in the table with the label it was sent with.
  SELECT COUNT(*) INTO n FROM hop_batch_err_target WHERE id IN (0, 1, 3, 4, 6, 7, 8, 9, 10) AND label = CONCAT('r', id);
  IF n &lt;&gt; 9 THEN
    RAISE EXCEPTION 'good input rows present in the target table: got %, expected 9', n;
  END IF;

  -- No row was reported as written while it is absent from the table.
  SELECT COUNT(*) INTO n FROM hop_batch_err_written w WHERE NOT EXISTS (SELECT 1 FROM hop_batch_err_target x WHERE x.id = w.id AND x.label = w.label);
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'rows reported as written that are not in the table: got %, expected 0', n;
  END IF;

  -- The seed rows were not overwritten by the rejected rows.
  SELECT COUNT(*) INTO n FROM hop_batch_err_target WHERE id IN (9000, 9001, 9002) AND label = 'seed';
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'seed rows left untouched: got %, expected 3', n;
  END IF;
END
$$;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>unit-test-db</connection>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Init tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Init tables</from>
      <to>0052-batch-error-accounting.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0052-batch-error-accounting.hpl</from>
      <to>every row on exactly one stream</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS hop_sam_err_child;
DROP TABLE IF EXISTS hop_sam_err_target;
DROP TABLE IF EXISTS hop_sam_err_written;
DROP TABLE IF EXISTS hop_sam_err_rejects;
DROP TABLE IF EXISTS hop_sam_rbr_child;
DROP TABLE IF EXISTS hop_sam_rbr_target;
DROP TABLE IF EXISTS hop_sam_rbr_written;
DROP TABLE IF EXISTS hop_sam_rbr_rejects;
CREATE TABLE hop_sam_err_target (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(20), CONSTRAINT hop_sam_err_target_ck CHECK (label &lt;&gt; 'bad'));
CREATE TABLE hop_sam_err_child (id BIGINT NOT NULL PRIMARY KEY, parent BIGINT NOT NULL REFERENCES hop_sam_err_target (id));
CREATE TABLE hop_sam_err_written (id BIGINT, label VARCHAR(20), flag VARCHAR(20));
CREATE TABLE hop_sam_err_rejects (id BIGINT, label VARCHAR(20), flag VARCHAR(20), err_desc TEXT, err_code VARCHAR(20));
INSERT INTO hop_sam_err_target (id, label) VALUES (0, 'old'), (1, 'old'), (2, 'old'), (3, 'old'), (4, 'old'), (5, 'old'), (6, 'old'), (7, 'old');
INSERT INTO hop_sam_err_child (id, parent) VALUES (6, 6);
CREATE TABLE hop_sam_rbr_target (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(20), CONSTRAINT hop_sam_rbr_target_ck CHECK (label &lt;&gt; 'bad'));
CREATE TABLE hop_sam_rbr_child (id BIGINT NOT NULL PRIMARY KEY, parent BIGINT NOT NULL REFERENCES hop_sam_rbr_target (id));
CREATE TABLE hop_sam_rbr_written (id BIGINT, label VARCHAR(20), flag VARCHAR(20));
CREATE TABLE hop_sam_rbr_rejects (id BIGINT, label VARCHAR(20), flag VARCHAR(20), err_desc TEXT, err_code VARCHAR(20));
INSERT INTO hop_sam_rbr_target (id, label) VALUES (0, 'old'), (1, 'old'), (2, 'old'), (3, 'old'), (4, 'old'), (5, 'old'), (6, 'old'), (7, 'old');
INSERT INTO hop_sam_rbr_child (id, parent) VALUES (6, 6);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>unit-test-db</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0059-synchronize-after-merge-batch-error-accounting.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0059-synchronize-after-merge-batch-error-accounting.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>every row on exactly one stream</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DO $$
DECLARE
  n BIGINT;
BEGIN

  -- batch updates on: twelve rows went in; twelve rows have to come out on exactly one of the two streams.
  SELECT COUNT(*) INTO n FROM (SELECT id FROM hop_sam_err_written UNION ALL SELECT id FROM hop_sam_err_rejects) s;
  IF n &lt;&gt; 12 THEN
    RAISE EXCEPTION 'batch updates on: rows on the main output plus rows on the error stream: got %, expected 12', n;
  END IF;

  -- batch updates on: only the three rows the database refused are rejects; the good rows of their batches are not taken down with them.
  SELECT COUNT(*) INTO n FROM hop_sam_err_rejects;
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'batch updates on: rows on the error stream: got %, expected 3', n;
  END IF;

  -- batch updates on: the rejects are exactly the bad rows: the update of 2 (check constraint), the insert of 5 (duplicate key) and the delete of 6 (foreign key).
  SELECT COUNT(*) INTO n FROM hop_sam_err_rejects WHERE id IN (2, 5, 6);
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'batch updates on: rejected rows that are the bad rows: got %, expected 3', n;
  END IF;

  -- batch updates on: every reject carries the database's message and the code SUYNC002 of a row refused in a batch, so batching stayed on with the error hop.
  SELECT COUNT(*) INTO n FROM hop_sam_err_rejects WHERE err_desc IS NOT NULL AND err_code = 'SUYNC002';
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'batch updates on: rejects with a message and code SUYNC002: got %, expected 3', n;
  END IF;

  -- batch updates on: all nine other rows are reported on the main output, each once, the skipped row 11 too.
  SELECT COUNT(DISTINCT id) INTO n FROM hop_sam_err_written WHERE id IN (0, 1, 3, 4, 7, 8, 9, 10, 11);
  IF n &lt;&gt; 9 THEN
    RAISE EXCEPTION 'batch updates on: good rows on the main output: got %, expected 9', n;
  END IF;

  -- batch updates on: no row is reported more than once.
  SELECT COUNT(*) INTO n FROM (SELECT id FROM hop_sam_err_written GROUP BY id HAVING COUNT(*) &gt; 1) d;
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'batch updates on: rows on the main output more than once: got %, expected 0', n;
  END IF;

  -- batch updates on: the table holds the eight rows it started with, minus the two deletes, plus the four inserts, minus the refused one.
  SELECT COUNT(*) INTO n FROM hop_sam_err_target;
  IF n &lt;&gt; 9 THEN
    RAISE EXCEPTION 'batch updates on: rows in the target table: got %, expected 9', n;
  END IF;

  -- batch updates on: the six updates and inserts that went through are committed.
  SELECT COUNT(*) INTO n FROM hop_sam_err_target WHERE id IN (0, 1, 7, 8, 9, 10) AND label = 'new';
  IF n &lt;&gt; 6 THEN
    RAISE EXCEPTION 'batch updates on: rows written in the table: got %, expected 6', n;
  END IF;

  -- batch updates on: the refused update, insert and delete left their rows alone.
  SELECT COUNT(*) INTO n FROM hop_sam_err_target WHERE id IN (2, 5, 6) AND label = 'old';
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'batch updates on: refused rows still holding their old value: got %, expected 3', n;
  END IF;

  -- batch updates on: the two deletes that went through are committed.
  SELECT COUNT(*) INTO n FROM hop_sam_err_target WHERE id IN (3, 4);
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'batch updates on: deleted rows still in the table: got %, expected 0', n;
  END IF;

  -- batch updates on: no row is reported on the main output unless what it did is in the table.
  SELECT COUNT(*) INTO n FROM hop_sam_err_written w WHERE (w.flag IN ('new', 'changed') AND NOT EXISTS (SELECT 1 FROM hop_sam_err_target x WHERE x.id = w.id AND x.label = 'new')) OR (w.flag = 'deleted' AND EXISTS (SELECT 1 FROM hop_sam_err_target x WHERE x.id = w.id));
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'batch updates on: rows reported on the main output that were not written: got %, expected 0', n;
  END IF;

  -- batch updates off: twelve rows went in; twelve rows have to come out on exactly one of the two streams.
  SELECT COUNT(*) INTO n FROM (SELECT id FROM hop_sam_rbr_written UNION ALL SELECT id FROM hop_sam_rbr_rejects) s;
  IF n &lt;&gt; 12 THEN
    RAISE EXCEPTION 'batch updates off: rows on the main output plus rows on the error stream: got %, expected 12', n;
  END IF;

  -- batch updates off: only the three rows the database refused are rejects; the good rows of their batches are not taken down with them.
  SELECT COUNT(*) INTO n FROM hop_sam_rbr_rejects;
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'batch updates off: rows on the error stream: got %, expected 3', n;
  END IF;

  -- batch updates off: the rejects are exactly the bad rows: the update of 2 (check constraint), the insert of 5 (duplicate key) and the delete of 6 (foreign key).
  SELECT COUNT(*) INTO n FROM hop_sam_rbr_rejects WHERE id IN (2, 5, 6);
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'batch updates off: rejected rows that are the bad rows: got %, expected 3', n;
  END IF;

  -- batch updates off: every reject carries the database's message and the code SUYNC001 of a row that ran on its own.
  SELECT COUNT(*) INTO n FROM hop_sam_rbr_rejects WHERE err_desc IS NOT NULL AND err_code = 'SUYNC001';
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'batch updates off: rejects with a message and code SUYNC001: got %, expected 3', n;
  END IF;

  -- batch updates off: all nine other rows are reported on the main output, each once, the skipped row 11 too.
  SELECT COUNT(DISTINCT id) INTO n FROM hop_sam_rbr_written WHERE id IN (0, 1, 3, 4, 7, 8, 9, 10, 11);
  IF n &lt;&gt; 9 THEN
    RAISE EXCEPTION 'batch updates off: good rows on the main output: got %, expected 9', n;
  END IF;

  -- batch updates off: no row is reported more than once.
  SELECT COUNT(*) INTO n FROM (SELECT id FROM hop_sam_rbr_written GROUP BY id HAVING COUNT(*) &gt; 1) d;
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'batch updates off: rows on the main output more than once: got %, expected 0', n;
  END IF;

  -- batch updates off: the table holds the eight rows it started with, minus the two deletes, plus the four inserts, minus the refused one.
  SELECT COUNT(*) INTO n FROM hop_sam_rbr_target;
  IF n &lt;&gt; 9 THEN
    RAISE EXCEPTION 'batch updates off: rows in the target table: got %, expected 9', n;
  END IF;

  -- batch updates off: the six updates and inserts that went through are committed.
  SELECT COUNT(*) INTO n FROM hop_sam_rbr_target WHERE id IN (0, 1, 7, 8, 9, 10) AND label = 'new';
  IF n &lt;&gt; 6 THEN
    RAISE EXCEPTION 'batch updates off: rows written in the table: got %, expected 6', n;
  END IF;

  -- batch updates off: the refused update, insert and delete left their rows alone.
  SELECT COUNT(*) INTO n FROM hop_sam_rbr_target WHERE id IN (2, 5, 6) AND label = 'old';
  IF n &lt;&gt; 3 THEN
    RAISE EXCEPTION 'batch updates off: refused rows still holding their old value: got %, expected 3', n;
  END IF;

  -- batch updates off: the two deletes that went through are committed.
  SELECT COUNT(*) INTO n FROM hop_sam_rbr_target WHERE id IN (3, 4);
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'batch updates off: deleted rows still in the table: got %, expected 0', n;
  END IF;

  -- batch updates off: no row is reported on the main output unless what it did is in the table.
  SELECT COUNT(*) INTO n FROM hop_sam_rbr_written w WHERE (w.flag IN ('new', 'changed') AND NOT EXISTS (SELECT 1 FROM hop_sam_rbr_target x WHERE x.id = w.id AND x.label = 'new')) OR (w.flag = 'deleted' AND EXISTS (SELECT 1 FROM hop_sam_rbr_target x WHERE x.id = w.id));
  IF n &lt;&gt; 0 THEN
    RAISE EXCEPTION 'batch updates off: rows reported on the main output that were not written: got %, expected 0', n;
  END IF;
END
$$;</sql>

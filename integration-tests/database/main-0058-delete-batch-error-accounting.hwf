    <hop>
      <from>Init tables</from>
      <to>0058-delete-batch-error-accounting.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0058-delete-batch-error-accounting.hpl</from>
      <to>every row on exactly one stream</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>

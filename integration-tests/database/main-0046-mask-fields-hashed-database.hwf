<workflow>
  <name>main-0046-mask-fields-hashed-database</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/07 20:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/07 20:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>scripts/script-mask-fields-hashed-database.sql</name>
      <description/>
      <type>SQL</type>
      <connection>unit-test-db</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql/>
      <sqlfilename>${PROJECT_HOME}/scripts/script-mask-fields-hashed-database.sql</sqlfilename>
      <sqlfromfile>Y</sqlfromfile>
      <useVariableSubstitution>N</useVariableSubstitution>
      <attributes/>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>first run</name>
      <description/>
      <type>PIPELINE</type>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0046-mask-fields-hashed-database.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <parameter>
          <name>RESULT_TABLE</name>
          <stream_name/>
          <value>mask_0046_run1</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <attributes/>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>second run</name>
      <description/>
      <type>PIPELINE</type>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0046-mask-fields-hashed-database.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <parameter>
          <name>RESULT_TABLE</name>
          <stream_name/>
          <value>mask_0046_run2</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <attributes/>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>3 hashed mappings</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT 1
FROM   public.mask_0046
WHERE  source_key LIKE 'hmac-sha256:%'
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>3</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>no names in plain text</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT 1
FROM   public.mask_0046
WHERE  source_key IN ('Matt', 'Ann', 'Bart')
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>0</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>no masked value used twice</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT masked_value
FROM   public.mask_0046
GROUP  BY masked_value
HAVING COUNT(*) &gt; 1
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>0</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1024</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Matt keeps one value</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT DISTINCT first_name
FROM   public.mask_0046_run1
WHERE  id IN (1, 4)
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>1</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1184</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>both runs give the same values</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <connection>unit-test-db</connection>
      <custom_sql>SELECT 1
FROM   public.mask_0046_run1 r1
JOIN   public.mask_0046_run2 r2 ON r1.id = r2.id AND r1.first_name = r2.first_name
WHERE  r1.first_name LIKE 'fn%'
</custom_sql>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <limit>4</limit>
      <schemaname>public</schemaname>
      <success_condition>rows_count_equal</success_condition>
      <tablename/>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1344</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>scripts/script-mask-fields-hashed-database.sql</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>scripts/script-mask-fields-hashed-database.sql</from>
      <to>first run</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>first run</from>
      <to>second run</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>second run</from>
      <to>3 hashed mappings</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>3 hashed mappings</from>
      <to>no names in plain text</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>no names in plain text</from>
      <to>no masked value used twice</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>no masked value used twice</from>
      <to>Matt keeps one value</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Matt keeps one value</from>
      <to>both runs give the same values</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

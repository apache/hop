<pipeline>
  <info>
    <name>0053-update-batch-error-accounting</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Twelve rows through Update on PostgreSQL with an error hop and commit size 5, three of them refused by the database, once with batch updates on and once with them off. Exactly those three have to reach the error stream; every other row has to be updated and reported once on the main output.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/25 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Twelve updates, three bad</from>
      <to>Batch update</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Batch update</from>
      <to>Rejects</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Batch update</from>
      <to>Written</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Twelve updates, three bad (row by row)</from>
      <to>Row by row update</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Row by row update</from>
      <to>Rejects row by row</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Row by row update</from>
      <to>Written row by row</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Twelve updates, three bad</name>
    <type>DataGrid</type>
    <description>Every row sets LABEL on an existing ID. Rows 2 (middle of the first commit window), 5 (first row of the second window) and 11 (last row of the final partial window) set it to 'bad', which the table's check constraint refuses.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line><item>0</item><item>new</item></line>
      <line><item>1</item><item>new</item></line>
      <line><item>2</item><item>bad</item></line>
      <line><item>3</item><item>new</item></line>
      <line><item>4</item><item>new</item></line>
      <line><item>5</item><item>bad</item></line>
      <line><item>6</item><item>new</item></line>
      <line><item>7</item><item>new</item></line>
      <line><item>8</item><item>new</item></line>
      <line><item>9</item><item>new</item></line>
      <line><item>10</item><item>new</item></line>
      <line><item>11</item><item>bad</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>ID</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>LABEL</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Batch update</name>
    <type>Update</type>
    <description>Use batch updates on, an error hop, commit size 5. The connection's validated batch failure contract keeps batching on with the error hop and works out the rows of a failed batch: the refused rows go to the error hop with code UPD002.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>unit-test-db</connection>
    <skip_lookup>N</skip_lookup>
    <commit>5</commit>
    <use_batch>Y</use_batch>
    <error_ignored>N</error_ignored>
    <ignore_flag_field/>
    <lookup>
      <schema/>
      <table>hop_upd_err_target</table>
      <key>
        <name>ID</name>
        <field>id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>label</name>
        <rename>LABEL</rename>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Written</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>label</column_name>
        <stream_name>LABEL</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_upd_err_written</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rejects</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>label</column_name>
        <stream_name>LABEL</stream_name>
      </field>
      <field>
        <column_name>err_desc</column_name>
        <stream_name>ERR_DESC</stream_name>
      </field>
      <field>
        <column_name>err_code</column_name>
        <stream_name>ERR_CODES</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_upd_err_rejects</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Twelve updates, three bad (row by row)</name>
    <type>DataGrid</type>
    <description>Every row sets LABEL on an existing ID. Rows 2 (middle of the first commit window), 5 (first row of the second window) and 11 (last row of the final partial window) set it to 'bad', which the table's check constraint refuses.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line><item>0</item><item>new</item></line>
      <line><item>1</item><item>new</item></line>
      <line><item>2</item><item>bad</item></line>
      <line><item>3</item><item>new</item></line>
      <line><item>4</item><item>new</item></line>
      <line><item>5</item><item>bad</item></line>
      <line><item>6</item><item>new</item></line>
      <line><item>7</item><item>new</item></line>
      <line><item>8</item><item>new</item></line>
      <line><item>9</item><item>new</item></line>
      <line><item>10</item><item>new</item></line>
      <line><item>11</item><item>bad</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>ID</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>LABEL</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>464</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Row by row update</name>
    <type>Update</type>
    <description>Use batch updates off, an error hop, commit size 5. Every row is updated on its own and passed on after the commit that includes it; a refused row goes to the error hop with code UPD001.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>unit-test-db</connection>
    <skip_lookup>N</skip_lookup>
    <commit>5</commit>
    <use_batch>N</use_batch>
    <error_ignored>N</error_ignored>
    <ignore_flag_field/>
    <lookup>
      <schema/>
      <table>hop_upd_rbr_target</table>
      <key>
        <name>ID</name>
        <field>id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>label</name>
        <rename>LABEL</rename>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>464</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Written row by row</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>label</column_name>
        <stream_name>LABEL</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_upd_rbr_written</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>400</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rejects row by row</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>label</column_name>
        <stream_name>LABEL</stream_name>
      </field>
      <field>
        <column_name>err_desc</column_name>
        <stream_name>ERR_DESC</stream_name>
      </field>
      <field>
        <column_name>err_code</column_name>
        <stream_name>ERR_CODES</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>hop_upd_rbr_rejects</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>528</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>Batch update</source_transform>
      <target_transform>Rejects</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>ERR_COUNT</nr_valuename>
      <descriptions_valuename>ERR_DESC</descriptions_valuename>
      <fields_valuename>ERR_FIELDS</fields_valuename>
      <codes_valuename>ERR_CODES</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
    <error>
      <source_transform>Row by row update</source_transform>
      <target_transform>Rejects row by row</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>ERR_COUNT</nr_valuename>
      <descriptions_valuename>ERR_DESC</descriptions_valuename>
      <fields_valuename>ERR_FIELDS</fields_valuename>
      <codes_valuename>ERR_CODES</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <attributes/>
</pipeline>

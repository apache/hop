      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check update</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>unit-test-db</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT 1
WHERE (SELECT string_agg(id || &apos;:&apos; || name, &apos;,&apos; ORDER BY id) FROM public.it0048_update) = &apos;1:a,2:b,3:x,4:d,5:e&apos;
  AND (SELECT string_agg(id::text, &apos;,&apos; ORDER BY id) FROM public.it0048_errors WHERE test = &apos;update&apos;) = &apos;3&apos;</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>

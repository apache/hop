    <action>
      <name>check dimension lookup</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>unit-test-db</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT 1
WHERE (SELECT string_agg(id || &apos;:&apos; || version || &apos;:&apos; || name || &apos;:&apos; || CASE WHEN date_to &lt; &apos;2100-01-01&apos; THEN &apos;closed&apos; ELSE &apos;open&apos; END, &apos;,&apos; ORDER BY id, version) FROM public.it0048_dimension WHERE tk &gt; 0) = &apos;1:1:a:closed,1:2:z:open,2:1:b:open,4:1:d:open,5:1:e:open&apos;
  AND (SELECT string_agg(id::text, &apos;,&apos; ORDER BY id) FROM public.it0048_errors WHERE test = &apos;dimension-lookup&apos;) = &apos;1,3&apos;</custom_sql>

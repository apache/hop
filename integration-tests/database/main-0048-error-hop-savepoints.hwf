<workflow>
  <name>main-0048-error-hop-savepoints</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>With an error hop on PostgreSQL only the failing rows may be rejected, not every row after them</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/26 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/26 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/scripts/0048-error-hop-savepoints.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>unit-test-db</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0048-update-error-hop</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>

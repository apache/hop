WHERE (SELECT string_agg(id || &apos;:&apos; || name, &apos;,&apos; ORDER BY id) FROM public.it0048_delete) = &apos;3:x&apos;
  AND (SELECT string_agg(id::text, &apos;,&apos; ORDER BY id) FROM public.it0048_errors WHERE test = &apos;delete&apos;) = &apos;3&apos;</custom_sql>

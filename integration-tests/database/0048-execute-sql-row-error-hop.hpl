<pipeline>
  <info>
    <name>0048-execute-sql-row-error-hop</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>The second insert of id 2 violates the primary key. Only that row may go to the error hop: on PostgreSQL the failed statement aborts the transaction, so without a savepoint per row every row after it failed as well.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/26 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/26 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Data grid</from>
      <to>Execute row SQL script</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Execute row SQL script</from>
      <to>Error rows</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Data grid</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>test</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>id</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>sql</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>execute-sql-row</item>
        <item>1</item>
        <item>INSERT INTO public.it0048_execute_sql_row VALUES (1)</item>
      </line>
      <line>
        <item>execute-sql-row</item>
        <item>2</item>
        <item>INSERT INTO public.it0048_execute_sql_row VALUES (2)</item>
      </line>
      <line>
        <item>execute-sql-row</item>
        <item>2</item>
        <item>INSERT INTO public.it0048_execute_sql_row VALUES (2)</item>
      </line>
      <line>
        <item>execute-sql-row</item>
        <item>3</item>
        <item>INSERT INTO public.it0048_execute_sql_row VALUES (3)</item>
      </line>
      <line>
        <item>execute-sql-row</item>
        <item>4</item>
        <item>INSERT INTO public.it0048_execute_sql_row VALUES (4)</item>
      </line>
      <line>
        <item>execute-sql-row</item>
        <item>5</item>
        <item>INSERT INTO public.it0048_execute_sql_row VALUES (5)</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Execute row SQL script</name>
    <type>ExecSqlRow</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>2</commit>
    <connection>unit-test-db</connection>
    <sql_field>sql</sql_field>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <sqlFromfile>N</sqlFromfile>
    <sendOneStatement>Y</sendOneStatement>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Error rows</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>unit-test-db</connection>
    <fields>
      <field>
        <column_name>test</column_name>
        <stream_name>test</stream_name>
      </field>
      <field>
        <column_name>id</column_name>
        <stream_name>id</stream_name>
      </field>
    </fields>
    <return_field/>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>public</schema>
    <specify_fields>Y</specify_fields>
    <table>it0048_errors</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>Execute row SQL script</source_transform>
      <target_transform>Error rows</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename/>
      <descriptions_valuename/>
      <fields_valuename/>
      <codes_valuename/>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <attributes/>
</pipeline>

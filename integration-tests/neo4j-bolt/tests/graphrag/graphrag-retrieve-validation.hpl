<pipeline>
  <info>
    <name>graphrag-retrieve-validation</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Vector search on the chunks, then the facts of each chunk</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/10 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/10 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>query vectors</from>
      <to>Graph vector search</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Graph vector search</from>
      <to>rank</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>rank</from>
      <to>Facts of the chunk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Facts of the chunk</from>
      <to>Fact</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fact</from>
      <to>One row per chunk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>One row per chunk</from>
      <to>Validation</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>query vectors</name>
    <type>DataGrid</type>
    <description>Close to one chunk each</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>query_id</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>q</name>
        <precision>-1</precision>
        <type>Vector</type>
      </field>
    </fields>
    <data>
      <line>
        <item>q1</item>
        <item>[1,0,0]</item>
      </line>
      <line>
        <item>q2</item>
        <item>[0,0,1]</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Graph vector search</name>
    <type>GraphVectorSearch</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <element_type>NODE</element_type>
    <index_name>graphrag_it_chunks</index_name>
    <label>Chunk</label>
    <vector_property>embedding</vector_property>
    <similarity>COSINE</similarity>
    <embedding_field>q</embedding_field>
    <top_k>2</top_k>
    <min_score>0</min_score>
    <eat_row_on_no_match>Y</eat_row_on_no_match>
    <score_field>score</score_field>
    <return_properties>
      <return_property>
        <property>id</property>
        <field_name>chunk_id</field_name>
        <type>String</type>
      </return_property>
    </return_properties>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>rank</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <valuename>rank</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name/>
    <start_at>1</start_at>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Facts of the chunk</name>
    <type>Neo4jCypherOutput</type>
    <description>The entities the chunk mentions and their relationships: one row per fact</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <cypher>MATCH (c:Chunk {id: $chunk_id})
OPTIONAL MATCH (c)-[:MENTIONS]-&gt;(e:Entity)
OPTIONAL MATCH (e)-[r:RELATED_TO]-&gt;(o:Entity)
RETURN e.name AS entity, e.type AS entity_type, r.type AS relation, o.name AS related_entity</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <nr_retries_on_error/>
    <retry>N</retry>
    <cypher_from_field>N</cypher_from_field>
    <cypher_field/>
    <unwind>N</unwind>
    <unwind_map/>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <mappings>
      <mapping>
        <parameter>chunk_id</parameter>
        <field>chunk_id</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>entity</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>entity_type</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>relation</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>related_entity</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
    </returns>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Fact</name>
    <type>ScriptValueMod</type>
    <description>Entity (type) -RELATION-&gt; other entity</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var fact = null;
if (entity != null) {
  fact = entity;
  if (entity_type != null) {
    fact = fact + " (" + entity_type + ")";
  }
  if (relation != null) {
    fact = fact + " -" + relation + "-&gt; " + related_entity;
  }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>fact</name>
        <rename>fact</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>768</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>One row per chunk</name>
    <type>GroupBy</type>
    <description>The rows of a chunk are consecutive</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>graphrag</prefix>
    <add_linenr>N</add_linenr>
    <all_rows>N</all_rows>
    <fields>
      <field>
        <aggregate>facts</aggregate>
        <subject>fact</subject>
        <type>CONCAT_DISTINCT</type>
        <valuefield>; </valuefield>
      </field>
    </fields>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>query_id</name>
      </field>
      <field>
        <name>rank</name>
      </field>
      <field>
        <name>chunk_id</name>
      </field>
    </group>
    <ignore_aggregate>N</ignore_aggregate>
    <attributes/>
    <GUI>
      <xloc>928</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Validation</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>query_id</name>
        <rename/>
      </field>
      <field>
        <name>rank</name>
        <rename/>
      </field>
      <field>
        <name>chunk_id</name>
        <rename/>
      </field>
      <field>
        <name>facts</name>
        <rename/>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1120</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

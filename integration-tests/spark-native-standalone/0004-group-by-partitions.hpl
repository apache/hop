<pipeline>
  <info>
    <name>0004-group-by-partitions</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Group By on several partitions: per customer (every aggregation type), all rows with the cumulative and moving aggregations and the line number per group, without grouping fields, and the one row of an empty input</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>OUTPUT_FOLDER</name>
        <default_value>${HOP_DATA}/output/0004-group-by-partitions/local</default_value>
        <description>Where the rows go: a folder per leaf, one file per partition on Spark</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/27 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/27 12:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>orders</from>
      <to>group by customer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>orders</from>
      <to>running per customer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>orders</from>
      <to>all orders</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>orders</from>
      <to>no orders</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>no orders</from>
      <to>group nothing</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>group by customer</from>
      <to>write aggregates</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>running per customer</from>
      <to>write running</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>all orders</from>
      <to>write total</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>group nothing</from>
      <to>write empty</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>

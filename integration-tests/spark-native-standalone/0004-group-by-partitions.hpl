  <transform>
    <name>group by customer</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>customer</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>rows</aggregate>
        <subject/>
        <type>COUNT_ANY</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>amounts</aggregate>
        <subject>amount</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>sum_amount</aggregate>
        <subject>amount</subject>
        <type>SUM</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>avg_amount</aggregate>
        <subject>amount</subject>
        <type>AVERAGE</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>median_amount</aggregate>
        <subject>amount</subject>
        <type>MEDIAN</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>p90_amount</aggregate>
        <subject>amount</subject>
        <type>PERCENTILE</type>
        <valuefield>90</valuefield>
        <orderfield/>
      </field>
      <field>
        <aggregate>p90_rank_amount</aggregate>
        <subject>amount</subject>
        <type>PERCENTILE_NEAREST_RANK</type>
        <valuefield>90</valuefield>
        <orderfield/>
      </field>
      <field>
        <aggregate>min_amount</aggregate>
        <subject>amount</subject>
        <type>MIN</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>max_amount</aggregate>
        <subject>amount</subject>
        <type>MAX</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>first_amount</aggregate>
        <subject>amount</subject>
        <type>FIRST</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>first_amount_incl_null</aggregate>
        <subject>amount</subject>
        <type>FIRST_INCL_NULL</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>last_order</aggregate>
        <subject>order_id</subject>
        <type>LAST</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>products</aggregate>
        <subject>product</subject>
        <type>CONCAT_COMMA</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>distinct_products</aggregate>
        <subject>product</subject>
        <type>COUNT_DISTINCT</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>stddev_amount</aggregate>
        <subject>amount</subject>
        <type>STD_DEV</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>stddev_sample_amount</aggregate>
        <subject>amount</subject>
        <type>STD_DEV_SAMPLE</type>
        <valuefield/>
        <orderfield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>

<workflow>
  <name>main-0003-conf-json</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #9630: pass the run conf as a JSON object with a number, and a logical date.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/21 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/21 12:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>GREETING</name>
      <default_value>hello from hop</default_value>
      <description>The greeting the hop_it_conf DAG expects</description>
    </parameter>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description></description>
      <type>SPECIAL</type>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Trigger hop_it_conf with JSON</name>
      <description></description>
      <type>AIRFLOW_TRIGGER_DAG_RUN</type>
      <attributes/>
      <connection>airflow</connection>
      <dag_id>hop_it_conf</dag_id>
      <dag_run_id/>
      <logical_date>2026-11-21T10:00:00+01:00</logical_date>
      <conf_json>{"greeting": "${GREETING}", "count": 3}</conf_json>
      <conf>
      </conf>
      <wait_for_completion>Y</wait_for_completion>
      <poll_interval_seconds>2</poll_interval_seconds>
      <timeout_seconds>300</timeout_seconds>
      <dag_run_id_variable>AIRFLOW_DAG_RUN_ID</dag_run_id_variable>
      <state_variable>AIRFLOW_DAG_RUN_STATE</state_variable>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>DAG run failed</name>
      <description></description>
      <type>ABORT</type>
      <always_log_rows>N</always_log_rows>
      <message>The run of hop_it_conf did not succeed: the JSON run conf did not arrive or the action failed.</message>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description></description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Trigger hop_it_conf with JSON</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Trigger hop_it_conf with JSON</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Trigger hop_it_conf with JSON</from>
      <to>DAG run failed</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
</workflow>

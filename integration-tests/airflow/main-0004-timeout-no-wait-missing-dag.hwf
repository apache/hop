<workflow>
  <name>main-0004-timeout-no-wait-missing-dag</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #9630: the wait times out, a run without waiting succeeds once queued, a missing DAG fails.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/21 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/21 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description></description>
      <type>SPECIAL</type>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Wait 5 seconds for hop_it_slow</name>
      <description></description>
      <type>AIRFLOW_TRIGGER_DAG_RUN</type>
      <attributes/>
      <connection>airflow</connection>
      <dag_id>hop_it_slow</dag_id>
      <dag_run_id/>
      <logical_date/>
      <conf_json/>
      <conf>
      </conf>
      <wait_for_completion>Y</wait_for_completion>
      <poll_interval_seconds>1</poll_interval_seconds>
      <timeout_seconds>5</timeout_seconds>
      <dag_run_id_variable>AIRFLOW_DAG_RUN_ID</dag_run_id_variable>
      <state_variable>AIRFLOW_DAG_RUN_STATE</state_variable>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Did not time out</name>
      <description></description>
      <type>ABORT</type>
      <always_log_rows>N</always_log_rows>
      <message>The wait for hop_it_slow should have timed out.</message>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Still queued or running</name>
      <description></description>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <comparevalue>queued|running</comparevalue>
      <fieldtype>string</fieldtype>
      <successbooleancondition>true</successbooleancondition>
      <successcondition>regexp</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successwhenvarset>N</successwhenvarset>
      <valuetype>variable</valuetype>
      <variablename>AIRFLOW_DAG_RUN_STATE</variablename>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Wrong state after timeout</name>
      <description></description>
      <type>ABORT</type>
      <always_log_rows>N</always_log_rows>
      <message>After the timeout AIRFLOW_DAG_RUN_STATE should be queued or running.</message>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Trigger hop_it_success without waiting</name>
      <description></description>
      <type>AIRFLOW_TRIGGER_DAG_RUN</type>
      <attributes/>
      <connection>airflow</connection>
      <dag_id>hop_it_success</dag_id>
      <dag_run_id/>
      <logical_date/>
      <conf_json/>
      <conf>
      </conf>
      <wait_for_completion>N</wait_for_completion>
      <poll_interval_seconds>2</poll_interval_seconds>
      <timeout_seconds>300</timeout_seconds>
      <dag_run_id_variable>AIRFLOW_DAG_RUN_ID</dag_run_id_variable>
      <state_variable>AIRFLOW_DAG_RUN_STATE</state_variable>
      <parallel>N</parallel>
      <xloc>624</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Trigger without waiting failed</name>
      <description></description>
      <type>ABORT</type>
      <always_log_rows>N</always_log_rows>
      <message>Triggering hop_it_success without waiting failed.</message>
      <parallel>N</parallel>
      <xloc>624</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>State is queued</name>
      <description></description>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <comparevalue>queued</comparevalue>
      <fieldtype>string</fieldtype>
      <successbooleancondition>true</successbooleancondition>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successwhenvarset>N</successwhenvarset>
      <valuetype>variable</valuetype>
      <variablename>AIRFLOW_DAG_RUN_STATE</variablename>
      <parallel>N</parallel>
      <xloc>816</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Not queued</name>
      <description></description>
      <type>ABORT</type>
      <always_log_rows>N</always_log_rows>
      <message>Without waiting AIRFLOW_DAG_RUN_STATE should be queued.</message>
      <parallel>N</parallel>
      <xloc>816</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Trigger a missing DAG</name>
      <description></description>
      <type>AIRFLOW_TRIGGER_DAG_RUN</type>
      <attributes/>
      <connection>airflow</connection>
      <dag_id>hop_it_does_not_exist</dag_id>
      <dag_run_id/>
      <logical_date/>
      <conf_json/>
      <conf>
      </conf>
      <wait_for_completion>N</wait_for_completion>
      <poll_interval_seconds>2</poll_interval_seconds>
      <timeout_seconds>300</timeout_seconds>
      <dag_run_id_variable>AIRFLOW_DAG_RUN_ID</dag_run_id_variable>
      <state_variable>AIRFLOW_DAG_RUN_STATE</state_variable>
      <parallel>N</parallel>
      <xloc>1008</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Missing DAG did not fail</name>
      <description></description>
      <type>ABORT</type>
      <always_log_rows>N</always_log_rows>
      <message>Triggering a DAG that does not exist should fail the action.</message>
      <parallel>N</parallel>
      <xloc>1008</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description></description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1200</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Wait 5 seconds for hop_it_slow</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Wait 5 seconds for hop_it_slow</from>
      <to>Still queued or running</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Wait 5 seconds for hop_it_slow</from>
      <to>Did not time out</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Still queued or running</from>
      <to>Trigger hop_it_success without waiting</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Still queued or running</from>
      <to>Wrong state after timeout</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Trigger hop_it_success without waiting</from>
      <to>State is queued</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Trigger hop_it_success without waiting</from>
      <to>Trigger without waiting failed</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>State is queued</from>
      <to>Trigger a missing DAG</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>State is queued</from>
      <to>Not queued</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Trigger a missing DAG</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Trigger a missing DAG</from>
      <to>Missing DAG did not fail</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
</workflow>

<workflow>
  <name>0001-import-preserves-run-configurations</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>hop-import keeps the run configuration names of the source files when no defaults are given</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/24 16:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/24 16:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>112</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Import without run configurations</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
SRC="${PROJECT_HOME}/subject/pdi"
OUT="${PROJECT_HOME}/output/0001-preserved"

rm -rf "$OUT"
mkdir -p "$OUT"

sh hop-import.sh -i "$SRC" -o "$OUT"

# Naming no defaults used to blank every run configuration, leaving imported workflows unable to
# run (issues #3814 and #8516). The names the PDI files carried have to survive instead.
grep -q '&lt;run_configuration&gt;Kettle pipeline runner&lt;/run_configuration&gt;' "$OUT/parent.hwf"
grep -q '&lt;run_configuration&gt;Kettle workflow runner&lt;/run_configuration&gt;' "$OUT/parent.hwf"

# --skip-folders defaults to false, so the sub-folder was imported as well.
test -f "$OUT/sub/child.hpl"
test -f "$OUT/sub/nested.hwf"</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Failure: the source run configurations did not survive the import</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Failure: the source run configurations did not survive the import</message>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Import without run configurations</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Import without run configurations</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Import without run configurations</from>
      <to>Failure: the source run configurations did not survive the import</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>210</backgroundcolorblue>
      <backgroundcolorgreen>136</backgroundcolorgreen>
      <backgroundcolorred>15</backgroundcolorred>
      <bordercolorblue>250</bordercolorblue>
      <bordercolorgreen>231</bordercolorgreen>
      <bordercolorred>200</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>250</fontcolorblue>
      <fontcolorgreen>231</fontcolorgreen>
      <fontcolorred>200</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>116</height>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <note>The PDI job under subject/pdi names a run configuration on both of its entries.

hop-import is run without --pipeline-run-configuration / --workflow-run-configuration, so those
names have to come through the import unchanged. Before issue #8516 they were replaced with an
empty element and the imported workflow failed at execution time with
"You need to specify a workflow run configuration to execute this workflow".</note>
      <width>560</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

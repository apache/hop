<workflow>
  <name>0002-import-applies-default-run-configurations</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>hop-import overwrites the source run configuration names when defaults are given</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/24 16:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/24 16:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>112</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Import with run configurations</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
SRC="${PROJECT_HOME}/subject/pdi"
OUT="${PROJECT_HOME}/output/0002-defaults"

rm -rf "$OUT"
mkdir -p "$OUT"

sh hop-import.sh -i "$SRC" -o "$OUT" \
  --pipeline-run-configuration 'Imported pipelines' \
  --workflow-run-configuration 'Imported workflows'

grep -q '&lt;run_configuration&gt;Imported pipelines&lt;/run_configuration&gt;' "$OUT/parent.hwf"
grep -q '&lt;run_configuration&gt;Imported workflows&lt;/run_configuration&gt;' "$OUT/parent.hwf"

# The names from the source files must be gone.
if grep -q 'Kettle pipeline runner' "$OUT/parent.hwf"; then
  echo "The source pipeline run configuration was not replaced"
  exit 1
fi</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Failure: the default run configurations were not applied</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Failure: the default run configurations were not applied</message>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Import with run configurations</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Import with run configurations</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Import with run configurations</from>
      <to>Failure: the default run configurations were not applied</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>210</backgroundcolorblue>
      <backgroundcolorgreen>136</backgroundcolorgreen>
      <backgroundcolorred>15</backgroundcolorred>
      <bordercolorblue>250</bordercolorblue>
      <bordercolorgreen>231</bordercolorgreen>
      <bordercolorred>200</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>250</fontcolorblue>
      <fontcolorgreen>231</fontcolorgreen>
      <fontcolorred>200</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>100</height>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <note>The counterpart of test 0001: given --pipeline-run-configuration and
--workflow-run-configuration, hop-import replaces whatever the source files named.

These are the CLI equivalents of the two run configuration fields on the Metadata tab of the
import dialog in Hop GUI.</note>
      <width>560</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

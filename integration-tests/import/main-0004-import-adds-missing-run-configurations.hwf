<workflow>
  <name>0004-import-adds-missing-run-configurations</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>hop-import gives a Pipeline or Workflow action the default run configuration when the PDI source named none</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/26 16:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/26 16:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>112</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Import with run configurations</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
SRC="${PROJECT_HOME}/subject/pdi-without-run-configuration"
OUT="${PROJECT_HOME}/output/0004-added"

rm -rf "$OUT"
mkdir -p "$OUT"

sh hop-import.sh -i "$SRC" -o "$OUT" \
  --pipeline-run-configuration 'Imported pipelines' \
  --workflow-run-configuration 'Imported workflows'

# Two of the three PDI entries carry no run_configuration element at all, so the importer has to
# add one. It only replaced elements that were already there, which left those actions unable to
# run (#3814). The third entry's element is present but empty; a default was always applied over
# that one, so main-0005 is what covers it, on the path where no default is given.
test "$(grep -c '&lt;run_configuration&gt;Imported pipelines&lt;/run_configuration&gt;' "$OUT/parent.hwf")" = 2
test "$(grep -c '&lt;run_configuration&gt;Imported workflows&lt;/run_configuration&gt;' "$OUT/parent.hwf")" = 1

# Filling the empty element must not leave a second one behind.
test "$(grep -c '&lt;run_configuration&gt;' "$OUT/parent.hwf")" = 3</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Failure: the default run configurations were not added</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Failure: the default run configurations were not added</message>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Import with run configurations</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Import with run configurations</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Import with run configurations</from>
      <to>Failure: the default run configurations were not added</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>210</backgroundcolorblue>
      <backgroundcolorgreen>136</backgroundcolorgreen>
      <backgroundcolorred>15</backgroundcolorred>
      <bordercolorblue>250</bordercolorblue>
      <bordercolorgreen>231</bordercolorgreen>
      <bordercolorred>200</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>250</fontcolorblue>
      <fontcolorgreen>231</fontcolorgreen>
      <fontcolorred>200</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>132</height>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <note>The PDI job under subject/pdi-without-run-configuration has three entries that name no
run configuration. Two carry no run_configuration element at all, the way PDI wrote job entries
before version 8, and the third carries an empty one, the way PDI 8 and later write it when none
was ever selected. Neither carries a name to preserve.

hop-import is given both --pipeline-run-configuration and --workflow-run-configuration here, so
all three actions have to come out of the import naming them, and the empty element has to be
filled rather than duplicated. The importer used to add nothing where the element was absent, so
those actions failed at execution time with
"You need to specify a workflow run configuration to execute this workflow" (issue #3814).

The empty element was already overwritten whenever a default was given, so the case where nothing
fills it is the one without defaults: main-0005 covers that.</note>
      <width>620</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>main-007-delete-file</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Delete a file and check it is gone</description>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <parallel>N</parallel>
      <xloc>32</xloc>
      <yloc>64</yloc>
    </action>
    
    <action>
      <filename>${PROJECT_HOME}/../vfs/write-line.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
      <parameter>
        <name>FILE</name>
        <value>finance:///roundtrip-delete/daily.csv</value>
      </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>write-line</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>64</yloc>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <include_subfolders>N</include_subfolders>
      <fields>
        <field>
          <name>finance:///roundtrip-delete</name>
          <filemask>daily.csv</filemask>
        </field>
      </fields>
      <name>Delete daily</name>
      <type>DELETE_FILES</type>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>64</yloc>
    </action>
    <action>
      <filename>finance:///roundtrip-delete/daily.csv</filename>
      <name>Daily exists</name>
      <type>FILE_EXISTS</type>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>64</yloc>
    </action>
    <action>
      <name>File was still there</name>
      <type>ABORT</type>
      <always_log_rows>Y</always_log_rows>
      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>File is gone</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>160</yloc>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>write-line</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>write-line</from>
      <to>Delete daily</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Delete daily</from>
      <to>Daily exists</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Daily exists</from>
      <to>File was still there</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Daily exists</from>
      <to>File is gone</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
</workflow>

<workflow>
  <name>main-006-move</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Move a file and check the old name is gone</description>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <parallel>N</parallel>
      <xloc>32</xloc>
      <yloc>64</yloc>
    </action>
    
    <action>
      <filename>${PROJECT_HOME}/../vfs/write-line.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
      <parameter>
        <name>FILE</name>
        <value>finance:///roundtrip-move/daily.csv</value>
      </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>write-line</name>
      <type>PIPELINE</type>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>64</yloc>
    </action>
    <action>
      <move_empty_folders>N</move_empty_folders>
      <arg_from_previous>N</arg_from_previous>
      <include_subfolders>N</include_subfolders>
      <destination_is_a_file>Y</destination_is_a_file>
      <create_destination_folder>Y</create_destination_folder>
      <success_condition>success_if_no_errors</success_condition>
      <iffileexists>overwrite_file</iffileexists>
      <ifmovedfileexists>overwrite_file</ifmovedfileexists>
      <simulate>N</simulate>
      <fields>
        <field>
          <source_filefolder>finance:///roundtrip-move/daily.csv</source_filefolder>
          <destination_filefolder>finance:///roundtrip-move/moved.csv</destination_filefolder>
          <wildcard/>
        </field>
      </fields>
      <name>Move daily</name>
      <type>MOVE_FILES</type>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>64</yloc>
    </action>
    <action>
      <filename>finance:///roundtrip-move/moved.csv</filename>
      <name>Moved exists</name>
      <type>FILE_EXISTS</type>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>64</yloc>
    </action>
    <action>
      <filename>finance:///roundtrip-move/daily.csv</filename>
      <name>Old name exists</name>
      <type>FILE_EXISTS</type>
      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>64</yloc>
    </action>
    <action>
      <name>Old name was still there</name>
      <type>ABORT</type>
      <always_log_rows>Y</always_log_rows>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Old name is gone</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <xloc>848</xloc>
      <yloc>160</yloc>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>write-line</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>write-line</from>
      <to>Move daily</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Move daily</from>
      <to>Moved exists</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Moved exists</from>
      <to>Old name exists</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Old name exists</from>
      <to>Old name was still there</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Old name exists</from>
      <to>Old name is gone</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
</workflow>

<workflow>
  <name>main-0001-check-data-catalog</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Checks datasets with the Check data catalog action against a stand-in for DataHub: what passes, what fails and why (issue #9323).</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/11 20:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/11 20:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Start the DataHub stub</name>
      <description>Starts a stand-in for the DataHub GraphQL API in the test container</description>
      <type>SHELL</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0001-start-datahub-stub.sh</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>N</insertScript>
      <script/>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>All datasets pass</name>
      <description>A table, a file and a catalog id that DataHub has, recent, not deprecated, with passing assertions</description>
      <type>CHECK_DATA_CATALOG</type>
      <attributes/>
      <catalog>datahub-stub</catalog>
      <check_deprecation>Y</check_deprecation>
      <max_age>1</max_age>
      <max_age_unit>HOURS</max_age_unit>
      <check_assertions>Y</check_assertions>
      <unknown_answer>FAIL</unknown_answer>
      <datasets>
        <dataset>
          <type>TABLE</type>
          <connection>warehouse</connection>
          <schema></schema>
          <name>orders</name>
        </dataset>
        <dataset>
          <type>FILE</type>
          <connection></connection>
          <schema></schema>
          <name>${PROJECT_HOME}/files/customers.csv</name>
        </dataset>
        <dataset>
          <type>CATALOG_ID</type>
          <connection></connection>
          <schema></schema>
          <name>urn:li:dataset:(urn:li:dataPlatform:hive,it.healthy,PROD)</name>
        </dataset>
      </datasets>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unexpected: All datasets pass</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>All datasets pass: the action should have been true</message>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>A deprecated dataset fails</name>
      <description>it.deprecated is deprecated in DataHub</description>
      <type>CHECK_DATA_CATALOG</type>
      <attributes/>
      <catalog>datahub-stub</catalog>
      <check_deprecation>Y</check_deprecation>
      <max_age>1</max_age>
      <max_age_unit>HOURS</max_age_unit>
      <check_assertions>Y</check_assertions>
      <unknown_answer>FAIL</unknown_answer>
      <datasets>
        <dataset>
          <type>CATALOG_ID</type>
          <connection></connection>
          <schema></schema>
          <name>urn:li:dataset:(urn:li:dataPlatform:hive,it.deprecated,PROD)</name>
        </dataset>
      </datasets>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unexpected: A deprecated dataset fails</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>A deprecated dataset fails: the action should have been false</message>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Stale data fails</name>
      <description>it.stale last changed 72 hours ago, the maximum age is 1 hour</description>
      <type>CHECK_DATA_CATALOG</type>
      <attributes/>
      <catalog>datahub-stub</catalog>
      <check_deprecation>Y</check_deprecation>
      <max_age>1</max_age>
      <max_age_unit>HOURS</max_age_unit>
      <check_assertions>Y</check_assertions>
      <unknown_answer>FAIL</unknown_answer>
      <datasets>
        <dataset>
          <type>CATALOG_ID</type>
          <connection></connection>
          <schema></schema>
          <name>urn:li:dataset:(urn:li:dataPlatform:hive,it.stale,PROD)</name>
        </dataset>
      </datasets>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unexpected: Stale data fails</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Stale data fails: the action should have been false</message>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>A failed assertion fails</name>
      <description>The latest run of the assertion on it.failing failed</description>
      <type>CHECK_DATA_CATALOG</type>
      <attributes/>
      <catalog>datahub-stub</catalog>
      <check_deprecation>Y</check_deprecation>
      <max_age>1</max_age>
      <max_age_unit>HOURS</max_age_unit>
      <check_assertions>Y</check_assertions>
      <unknown_answer>FAIL</unknown_answer>
      <datasets>
        <dataset>
          <type>CATALOG_ID</type>
          <connection></connection>
          <schema></schema>
          <name>urn:li:dataset:(urn:li:dataPlatform:hive,it.failing,PROD)</name>
        </dataset>
      </datasets>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unexpected: A failed assertion fails</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>A failed assertion fails: the action should have been false</message>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>An unknown dataset fails</name>
      <description>DataHub does not have it.unknown</description>
      <type>CHECK_DATA_CATALOG</type>
      <attributes/>
      <catalog>datahub-stub</catalog>
      <check_deprecation>Y</check_deprecation>
      <max_age>1</max_age>
      <max_age_unit>HOURS</max_age_unit>
      <check_assertions>Y</check_assertions>
      <unknown_answer>FAIL</unknown_answer>
      <datasets>
        <dataset>
          <type>CATALOG_ID</type>
          <connection></connection>
          <schema></schema>
          <name>urn:li:dataset:(urn:li:dataPlatform:hive,it.unknown,PROD)</name>
        </dataset>
      </datasets>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unexpected: An unknown dataset fails</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>An unknown dataset fails: the action should have been false</message>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>An unreachable catalog fails</name>
      <description>Nothing listens on the URL of datahub-unreachable</description>
      <type>CHECK_DATA_CATALOG</type>
      <attributes/>
      <catalog>datahub-unreachable</catalog>
      <check_deprecation>Y</check_deprecation>
      <max_age>1</max_age>
      <max_age_unit>HOURS</max_age_unit>
      <check_assertions>Y</check_assertions>
      <unknown_answer>FAIL</unknown_answer>
      <datasets>
        <dataset>
          <type>CATALOG_ID</type>
          <connection></connection>
          <schema></schema>
          <name>urn:li:dataset:(urn:li:dataPlatform:hive,it.healthy,PROD)</name>
        </dataset>
      </datasets>
      <parallel>N</parallel>
      <xloc>1248</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unexpected: An unreachable catalog fails</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>An unreachable catalog fails: the action should have been false</message>
      <parallel>N</parallel>
      <xloc>1248</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>An unreachable catalog can be ignored</name>
      <description>The same catalog, with unknown answers skipped</description>
      <type>CHECK_DATA_CATALOG</type>
      <attributes/>
      <catalog>datahub-unreachable</catalog>
      <check_deprecation>Y</check_deprecation>
      <max_age>1</max_age>
      <max_age_unit>HOURS</max_age_unit>
      <check_assertions>Y</check_assertions>
      <unknown_answer>IGNORE</unknown_answer>
      <datasets>
        <dataset>
          <type>CATALOG_ID</type>
          <connection></connection>
          <schema></schema>
          <name>urn:li:dataset:(urn:li:dataPlatform:hive,it.healthy,PROD)</name>
        </dataset>
      </datasets>
      <parallel>N</parallel>
      <xloc>1440</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unexpected: An unreachable catalog can be ignored</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>An unreachable catalog can be ignored: the action should have been true</message>
      <parallel>N</parallel>
      <xloc>1440</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Stale data passes without a maximum age</name>
      <description>it.stale without a maximum age only needs to exist, not be deprecated and pass its assertions</description>
      <type>CHECK_DATA_CATALOG</type>
      <attributes/>
      <catalog>datahub-stub</catalog>
      <check_deprecation>Y</check_deprecation>
      <max_age></max_age>
      <max_age_unit>HOURS</max_age_unit>
      <check_assertions>Y</check_assertions>
      <unknown_answer>FAIL</unknown_answer>
      <datasets>
        <dataset>
          <type>CATALOG_ID</type>
          <connection></connection>
          <schema></schema>
          <name>urn:li:dataset:(urn:li:dataPlatform:hive,it.stale,PROD)</name>
        </dataset>
      </datasets>
      <parallel>N</parallel>
      <xloc>1632</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unexpected: Stale data passes without a maximum age</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Stale data passes without a maximum age: the action should have been true</message>
      <parallel>N</parallel>
      <xloc>1632</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the requests</name>
      <description>Checks what the actions asked the stub, then stops it</description>
      <type>SHELL</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0001-check-and-stop-datahub-stub.sh</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>N</insertScript>
      <script/>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>1824</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>2016</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>The actions did not ask DataHub what they should, see the output of the script above</message>
      <parallel>N</parallel>
      <xloc>1824</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Start the DataHub stub</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Start the DataHub stub</from>
      <to>All datasets pass</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>All datasets pass</from>
      <to>Unexpected: All datasets pass</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>All datasets pass</from>
      <to>A deprecated dataset fails</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>A deprecated dataset fails</from>
      <to>Unexpected: A deprecated dataset fails</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>A deprecated dataset fails</from>
      <to>Stale data fails</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Stale data fails</from>
      <to>Unexpected: Stale data fails</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Stale data fails</from>
      <to>A failed assertion fails</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>A failed assertion fails</from>
      <to>Unexpected: A failed assertion fails</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>A failed assertion fails</from>
      <to>An unknown dataset fails</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>An unknown dataset fails</from>
      <to>Unexpected: An unknown dataset fails</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>An unknown dataset fails</from>
      <to>An unreachable catalog fails</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>An unreachable catalog fails</from>
      <to>Unexpected: An unreachable catalog fails</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>An unreachable catalog fails</from>
      <to>An unreachable catalog can be ignored</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>An unreachable catalog can be ignored</from>
      <to>Unexpected: An unreachable catalog can be ignored</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>An unreachable catalog can be ignored</from>
      <to>Stale data passes without a maximum age</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Stale data passes without a maximum age</from>
      <to>Unexpected: Stale data passes without a maximum age</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Stale data passes without a maximum age</from>
      <to>Check the requests</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check the requests</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check the requests</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

  </transform>
  <transform>
    <name>Check empty then good</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Empty then good OK</send_true_to>
    <send_false_to>Empty then good wrong count - Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>num_rows</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>3</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>592</xloc>
      <yloc>448</yloc>

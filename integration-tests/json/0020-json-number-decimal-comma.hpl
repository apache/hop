<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>0020-json-number-decimal-comma</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>A JSON number is read as the number it is: the decimal and grouping symbols of the field are for text. With a comma as decimal symbol, 199.5 used to come out as 1995.</description>
    <extended_description/>
    <created_user>-</created_user>
    <created_date>2026/11/13 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/13 12:00:00.000</modified_date>
  </info>
  <transform>
    <type>JsonNormalizeInput</type>
    <name>JSON normalize amounts</name>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <rownum_field/>
    <limit>0</limit>
    <valueField/>
    <IsInFields>N</IsInFields>
    <IsAFile>N</IsAFile>
    <addresultfile>N</addresultfile>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <recordPath>$.amounts[*]</recordPath>
    <fieldSeparator>.</fieldSeparator>
    <maxFlattenDepth>-1</maxFlattenDepth>
    <arrayHandling>STRINGIFY</arrayHandling>
    <beyondDepthBehavior>STRINGIFY</beyondDepthBehavior>
    <ignoreMissingField>N</ignoreMissingField>
    <shortFileFieldName/>
    <extensionFieldName/>
    <pathFieldName/>
    <sizeFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <files>
      <file>
        <name>${HOP_UNIT_TESTS_FOLDER}/resources/json-number-decimal-comma-it.json</name>
        <filemask/>
        <exclude_filemask/>
        <file_required>N</file_required>
        <include_subfolders>N</include_subfolders>
      </file>
    </files>
    <fields>
      <field>
        <name>id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>id</path>
      </field>
      <field>
        <name>amount</name>
        <length>-1</length>
        <type>Number</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal>,</decimal>
        <group>.</group>
        <repeat>N</repeat>
        <path>amount</path>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>A JSON number into a Number field whose decimal symbol is a comma.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>JsonInput</type>
    <name>JSON input amounts</name>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <ignoreMissingPath>N</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name>${HOP_UNIT_TESTS_FOLDER}/resources/json-number-decimal-comma-it.json</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>$.amounts[*].id</path>
      </field>
      <field>
        <name>amount</name>
        <length>-1</length>
        <type>BigNumber</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal>,</decimal>
        <group>.</group>
        <repeat>N</repeat>
        <path>$.amounts[*].amount</path>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>N</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField/>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>224</yloc>
    </GUI>
    <description>A JSON number into a BigNumber field whose decimal symbol is a comma.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Validate normalize</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Validate input</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>224</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>JSON normalize amounts</from>
      <to>Validate normalize</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>JSON input amounts</from>
      <to>Validate input</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>

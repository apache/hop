<workflow>
  <name>main-0002-load-balance-workflow-executor</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Run 100 child workflows through the load-balancing pool, then read finished counts from both Hop Servers</description>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/08/18 14:42:45.408</created_date>
  <modified_date>2026/08/18 14:42:45.408</modified_date>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>48</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <replacevars>Y</replacevars>
      <fields>
        <field>
          <variable_name>EXEC_OK</variable_name>
          <variable_value>0</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
        <field>
          <variable_name>EXEC_ERRORS</variable_name>
          <variable_value>0</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
        <field>
          <variable_name>SERVER_A_WORKFLOWS</variable_name>
          <variable_value>0</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
        <field>
          <variable_name>SERVER_B_WORKFLOWS</variable_name>
          <variable_value>0</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
      </fields>
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <name>Init variables</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <xloc>192</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/0002-drive-100-workflows.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Drive 100 workflows</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>384</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/0001-server-status.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Check server status</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>576</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <valuetype>variable</valuetype>
      <fieldtype>number</fieldtype>
      <variablename>SERVER_A_WORKFLOWS</variablename>
      <comparevalue>1</comparevalue>
      <successcondition>equal</successcondition>
      <successwhenvarset>N</successwhenvarset>
      <successbooleancondition>true</successbooleancondition>
      <successnumbercondition>greaterequal</successnumbercondition>
      <name>Server A used</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <xloc>192</xloc>
      <yloc>272</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <valuetype>variable</valuetype>
      <fieldtype>number</fieldtype>
      <variablename>SERVER_B_WORKFLOWS</variablename>
      <comparevalue>1</comparevalue>
      <successcondition>equal</successcondition>
      <successwhenvarset>N</successwhenvarset>
      <successbooleancondition>true</successbooleancondition>
      <successnumbercondition>greaterequal</successnumbercondition>
      <name>Server B used</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <xloc>384</xloc>
      <yloc>272</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <valuetype>variable</valuetype>
      <fieldtype>number</fieldtype>
      <variablename>EXEC_OK</variablename>
      <comparevalue>100</comparevalue>
      <successcondition>equal</successcondition>
      <successwhenvarset>N</successwhenvarset>
      <successbooleancondition>true</successbooleancondition>
      <successnumbercondition>equal</successnumbercondition>
      <name>100 executions</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <xloc>576</xloc>
      <yloc>272</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <valuetype>variable</valuetype>
      <fieldtype>number</fieldtype>
      <variablename>EXEC_ERRORS</variablename>
      <comparevalue>0</comparevalue>
      <successcondition>equal</successcondition>
      <successwhenvarset>N</successwhenvarset>
      <successbooleancondition>true</successbooleancondition>
      <successnumbercondition>equal</successnumbercondition>
      <name>No execution errors</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <xloc>768</xloc>
      <yloc>272</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Init variables</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Init variables</from>
      <to>Drive 100 workflows</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Drive 100 workflows</from>
      <to>Check server status</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check server status</from>
      <to>Server A used</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Server A used</from>
      <to>Server B used</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Server B used</from>
      <to>100 executions</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>100 executions</from>
      <to>No execution errors</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

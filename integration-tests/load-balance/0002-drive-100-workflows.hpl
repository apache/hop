<pipeline>
  <info>
    <name>0002-drive-100-workflows</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Submit 100 child workflows through the load-balancing run configuration</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>100 rows</from>
      <to>Workflow executor</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Workflow executor</from>
      <to>Count successes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count successes</from>
      <to>Set EXEC_OK</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>100 rows</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
    </fields>
    <limit>100</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field/>
    <last_time_field/>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Workflow executor</name>
    <type>WorkflowExecutor</type>
    <description/>
    <distribute>Y</distribute>
    <copies>4</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <run_configuration>load-balance</run_configuration>
    <filename>${PROJECT_HOME}/0001-child-delay.hwf</filename>
    <group_size>1</group_size>
    <group_field/>
    <group_time/>
    <parameters>
      <inherit_all_vars>Y</inherit_all_vars>
    </parameters>
    <execution_result_target_transform>Count successes</execution_result_target_transform>
    <execution_time_field>ExecutionTime</execution_time_field>
    <execution_result_field>ExecutionResult</execution_result_field>
    <execution_errors_field>ExecutionNrErrors</execution_errors_field>
    <execution_lines_read_field/>
    <execution_lines_written_field/>
    <execution_lines_input_field/>
    <execution_lines_output_field/>
    <execution_lines_rejected_field/>
    <execution_lines_updated_field/>
    <execution_lines_deleted_field/>
    <execution_files_retrieved_field/>
    <execution_exit_status_field/>
    <execution_log_text_field/>
    <execution_log_channelid_field/>
    <result_rows_target_transform/>
    <result_files_target_transform/>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Count successes</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <add_linenr>N</add_linenr>
    <all_rows>N</all_rows>
    <directory>${java.io.tmpdir}</directory>
    <fields>
      <field>
        <aggregate>okCount</aggregate>
        <type>COUNT_ANY</type>
      </field>
      <field>
        <aggregate>errorSum</aggregate>
        <subject>ExecutionNrErrors</subject>
        <type>SUM</type>
      </field>
    </fields>
    <give_back_row>N</give_back_row>
    <group>
    </group>
    <ignore_aggregate>N</ignore_aggregate>
    <prefix>grp</prefix>
    <attributes/>
    <GUI>
      <xloc>512</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Set EXEC_OK</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>okCount</field_name>
        <variable_name>EXEC_OK</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value>0</default_value>
      </field>
      <field>
        <field_name>errorSum</field_name>
        <variable_name>EXEC_ERRORS</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value>0</default_value>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <attributes/>
    <GUI>
      <xloc>704</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

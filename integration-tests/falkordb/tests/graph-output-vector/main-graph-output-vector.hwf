      <xloc>448</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>create vector index</name>
      <description />
      <type>NEO4J_INDEX</type>
      <attributes />
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>graph_output_vector_docs</index_name>
          <object_name>VectorDoc</object_name>
          <object_properties>embedding</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>96</yloc>
      <attributes_hac />

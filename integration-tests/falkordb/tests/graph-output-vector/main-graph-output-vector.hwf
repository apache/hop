    <action>
      <name>drop index after test</name>
      <description />
      <type>NEO4J_INDEX</type>
      <attributes />
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>graph_output_vector_docs</index_name>
          <object_name>VectorDoc</object_name>
          <object_properties>embedding</object_properties>
          <object_type>NODE</object_type>

<pipeline>
  <info>
    <name>neo4j-execution-logging-check</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2023/04/29 09:46:27.700</created_date>
    <modified_user>-</modified_user>
    <modified_date>2023/04/29 09:46:27.700</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>one row</from>
      <to>read logging</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>read logging</from>
      <to>check logging</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>read logging</from>
      <to>no logging</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>no logging</from>
      <to>Abort no logging</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check logging</from>
      <to>Logging ok</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check logging</from>
      <to>Abort logging</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>logging info</from>
      <to>check logging info</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check logging info</from>
      <to>Logging info ok</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check logging info</from>
      <to>Abort logging info</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>one row</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
</fields>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>read logging</name>
    <type>Neo4jCypherOutput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <batch_size/>
    <connection>Test</connection>
    <cypher>MATCH (p:Execution {type: 'PIPELINE', name: 'neo4j-execution-logging-pipeline'}) MATCH (w:Execution {type: 'WORKFLOW', name: 'neo4j-execution-logging-workflow'}) OPTIONAL MATCH (t:Execution {type: 'TRANSFORM'})-[:EXECUTION_OF_TRANSFORM]-&gt;(:Transform)-[:TRANSFORM_OF_PIPELINE]-&gt;(:Pipeline {name: 'neo4j-execution-logging-pipeline'}) RETURN p.status AS pipeline_status, w.status AS workflow_status, count(t) AS transforms</cypher>
    <cypher_field/>
    <cypher_from_field>N</cypher_from_field>
    <mappings>
</mappings>
    <nr_retries_on_error/>
    <read_only>N</read_only>
    <retry>Y</retry>
    <return_graph_field/>
    <returning_graph>N</returning_graph>
    <returns>
      <return>
        <name>pipeline_status</name>
        <source_type>String</source_type>
        <type>String</type>
      </return>
      <return>
        <name>workflow_status</name>
        <source_type>String</source_type>
        <type>String</type>
      </return>
      <return>
        <name>transforms</name>
        <source_type>Integer</source_type>
        <type>Integer</type>
      </return>
    </returns>
    <unwind>N</unwind>
    <unwind_map/>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check logging</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
<condition>
<conditions>
<condition>
<conditions>
</conditions>
<function>=</function>
<leftvalue>pipeline_status</leftvalue>
<negated>N</negated>
<operator>-</operator>
<value>
<isnull>N</isnull>
<length>-1</length>
<mask/>
<name>constant</name>
<precision>-1</precision>
<text>Finished</text>
<type>String</type>
</value>
</condition>
<condition>
<conditions>
</conditions>
<function>=</function>
<leftvalue>workflow_status</leftvalue>
<negated>N</negated>
<operator>AND</operator>
<value>
<isnull>N</isnull>
<length>-1</length>
<mask/>
<name>constant</name>
<precision>-1</precision>
<text>Finished</text>
<type>String</type>
</value>
</condition>
<condition>
<conditions>
</conditions>
<function>=</function>
<leftvalue>transforms</leftvalue>
<negated>N</negated>
<operator>AND</operator>
<value>
<isnull>N</isnull>
<length>-1</length>
<mask/>
<name>constant</name>
<precision>-1</precision>
<text>2</text>
<type>Integer</type>
</value>
</condition>
</conditions>
<negated>N</negated>
<operator>-</operator>
</condition>
    </compare>
    <send_false_to>Abort logging</send_false_to>
    <send_true_to>Logging ok</send_true_to>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Logging ok</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>

    <attributes/>
    <GUI>
      <xloc>576</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort logging</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <message/>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>no logging</name>
    <type>DetectEmptyStream</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>

    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort no logging</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <message/>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>352</yloc>
    </GUI>
  </transform>
  <transform>
    <name>logging info</name>
    <type>GetLoggingInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>pipeline_success</name>
        <type>TYPE_SYSTEM_INFO_PIPELINE_PREVIOUS_SUCCESS_DATE</type>
        <argument>neo4j-execution-logging-pipeline</argument>
      </field>
      <field>
        <name>workflow_success</name>
        <type>TYPE_SYSTEM_INFO_WORKFLOW_PREVIOUS_SUCCESS_DATE</type>
        <argument>neo4j-execution-logging-workflow</argument>
      </field>
      <field>
        <name>workflow_execution</name>
        <type>TYPE_SYSTEM_INFO_WORKFLOW_PREVIOUS_EXECUTION_DATE</type>
        <argument>neo4j-execution-logging-workflow</argument>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>480</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check logging info</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
<condition>
<conditions>
<condition>
<conditions>
</conditions>
<function>IS NOT NULL</function>
<leftvalue>pipeline_success</leftvalue>
<negated>N</negated>
<operator>-</operator>
<value>
<isnull>N</isnull>
<length>-1</length>
<mask/>
<name>constant</name>
<precision>-1</precision>
<text></text>
<type>String</type>
</value>
</condition>
<condition>
<conditions>
</conditions>
<function>IS NOT NULL</function>
<leftvalue>workflow_success</leftvalue>
<negated>N</negated>
<operator>AND</operator>
<value>
<isnull>N</isnull>
<length>-1</length>
<mask/>
<name>constant</name>
<precision>-1</precision>
<text></text>
<type>String</type>
</value>
</condition>
<condition>
<conditions>
</conditions>
<function>IS NOT NULL</function>
<leftvalue>workflow_execution</leftvalue>
<negated>N</negated>
<operator>AND</operator>
<value>
<isnull>N</isnull>
<length>-1</length>
<mask/>
<name>constant</name>
<precision>-1</precision>
<text></text>
<type>String</type>
</value>
</condition>
</conditions>
<negated>N</negated>
<operator>-</operator>
</condition>
    </compare>
    <send_false_to>Abort logging info</send_false_to>
    <send_true_to>Logging info ok</send_true_to>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>480</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Logging info ok</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>

    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>480</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort logging info</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <message/>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>

<pipeline>
  <info>
    <name>list-one</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Fail unless ${DIR} contains exactly one file matching ${MASK}</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>DIR</name>
        <default_value/>
        <description>Folder URI</description>
      </parameter>
      <parameter>
        <name>MASK</name>
        <default_value/>
        <description>File mask</description>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop>
      <from>Get file names</from>
      <to>Count rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count rows</from>
      <to>Wrong count?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wrong count?</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  
  <transform>
    <name>Get file names</name>
    <type>GetFileNames</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <file>
      <name>${DIR}</name>
      <filemask>${MASK}</filemask>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <filter>
      <filterfiletype>only_files</filterfiletype>
    </filter>
    <rownum>N</rownum>
    <filefield>N</filefield>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <raiseAnExceptionIfNoFile>Y</raiseAnExceptionIfNoFile>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Count rows</name>
    <type>MemoryGroupBy</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <give_back_row>Y</give_back_row>
    <group/>
    <fields>
      <field>
        <aggregate>rows_read</aggregate>
        <subject>short_filename</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>lowest</aggregate>
        <subject>short_filename</subject>
        <type>MIN</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>highest</aggregate>
        <subject>short_filename</subject>
        <type>MAX</type>
        <valuefield/>
      </field>
    </fields>
    <GUI>
      <xloc>400</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wrong count?</name>
    <type>FilterRows</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Abort</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>rows_read</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>1</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <GUI>
      <xloc>720</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
</pipeline>

<pipeline>
  <info>
    <name>expect-alpha</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Fail unless ${FILE} is the single line alpha</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>FILE</name>
        <default_value/>
        <description>Full VFS filename</description>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop>
      <from>Read text</from>
      <to>Count rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count rows</from>
      <to>Wrong count?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wrong count?</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wrong count?</from>
      <to>Wrong lowest?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wrong lowest?</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wrong lowest?</from>
      <to>Wrong highest?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wrong highest?</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  
  <transform>
    <name>Read text</name>
    <type>TextFileInput2</type>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <accept_filenames>N</accept_filenames>
    <passing_through_fields>N</passing_through_fields>
    <separator>,</separator>
    <enclosure/>
    <header>N</header>
    <nr_headerlines>1</nr_headerlines>
    <footer>N</footer>
    <noempty>Y</noempty>
    <format>UNIX</format>
    <encoding>UTF-8</encoding>
    <length>Characters</length>
    <date_format_lenient>Y</date_format_lenient>
    <date_format_locale>en_US</date_format_locale>
    <file>
      <name>${FILE}</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
      <type>CSV</type>
      <compression>None</compression>
    </file>
    <fields>
      <field>
        <name>line</name>
        <type>String</type>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <error_ignored>N</error_ignored>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Count rows</name>
    <type>MemoryGroupBy</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <give_back_row>Y</give_back_row>
    <group/>
    <fields>
      <field>
        <aggregate>rows_read</aggregate>
        <subject>line</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>lowest</aggregate>
        <subject>line</subject>
        <type>MIN</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>highest</aggregate>
        <subject>line</subject>
        <type>MAX</type>
        <valuefield/>
      </field>
    </fields>
    <GUI>
      <xloc>400</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wrong count?</name>
    <type>FilterRows</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Abort</send_true_to>
    <send_false_to>Wrong lowest?</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>rows_read</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>1</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wrong lowest?</name>
    <type>FilterRows</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Abort</send_true_to>
    <send_false_to>Wrong highest?</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>lowest</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>alpha</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask></mask>
        </value>
      </condition>
    </compare>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wrong highest?</name>
    <type>FilterRows</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Abort</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>highest</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>alpha</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask></mask>
        </value>
      </condition>
    </compare>
    <GUI>
      <xloc>880</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <GUI>
      <xloc>1040</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
</pipeline>

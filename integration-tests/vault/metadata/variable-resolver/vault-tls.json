{
  "virtualPath": "",
  "name": "vault-tls",
  "description": "Hashicorp Vault over HTTPS, trusting the server certificate through its CA",
  "variable-resolver": {
    "Vault-Variable-Resolver": {
      "vaultAddress": "https://vault-tls:8200",
      "pemString": "",
      "openTimeout": "",
      "pemFilePath": "/tmp/vault-tls/vault-ca.pem",
      "readTimeout": "",
      "vaultToken": "myroot"
    }
  }
}

<workflow>
  <name>state-and-joins</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Every action is a task: a variable and result rows reach the next actions, through two parallel branches and a Join</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/23 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/23 00:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Set label</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <replacevars>Y</replacevars>
      <filename/>
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <fields>
        <field>
          <variable_name>RUN_LABEL</variable_name>
          <variable_value>from-set-variables</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>three-rows-to-result.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/three-rows-to-result.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>count-result-rows.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/count-result-rows.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Fan out</name>
      <description/>
      <type>DUMMY</type>
      <attributes/>

      <parallel>Y</parallel>
      <xloc>736</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Label arrived</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <valuetype>variable</valuetype>
      <variablename>${RUN_LABEL}</variablename>
      <fieldtype>string</fieldtype>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successbooleancondition>true</successbooleancondition>
      <comparevalue>from-set-variables</comparevalue>
      <successwhenvarset>N</successwhenvarset>
      <parallel>N</parallel>
      <xloc>896</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Rows arrived</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <valuetype>variable</valuetype>
      <variablename>${ROWS_FROM_RESULT}</variablename>
      <fieldtype>string</fieldtype>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successbooleancondition>true</successbooleancondition>
      <comparevalue>3</comparevalue>
      <successwhenvarset>N</successwhenvarset>
      <parallel>N</parallel>
      <xloc>896</xloc>
      <yloc>256</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Both done</name>
      <description/>
      <type>JOIN</type>
      <attributes/>

      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Label passed the Join</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <valuetype>variable</valuetype>
      <variablename>${RUN_LABEL}</variablename>
      <fieldtype>string</fieldtype>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successbooleancondition>true</successbooleancondition>
      <comparevalue>from-set-variables</comparevalue>
      <successwhenvarset>N</successwhenvarset>
      <parallel>N</parallel>
      <xloc>1216</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>

      <parallel>N</parallel>
      <xloc>1376</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>State missing</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>The state did not arrive: RUN_LABEL is '${RUN_LABEL}', ROWS_FROM_RESULT is '${ROWS_FROM_RESULT}'</message>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Set label</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Set label</from>
      <to>three-rows-to-result.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>three-rows-to-result.hpl</from>
      <to>count-result-rows.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>count-result-rows.hpl</from>
      <to>Fan out</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Fan out</from>
      <to>Label arrived</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Fan out</from>
      <to>Rows arrived</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Label arrived</from>
      <to>Both done</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Rows arrived</from>
      <to>Both done</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Both done</from>
      <to>Label passed the Join</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Label passed the Join</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>count-result-rows.hpl</from>
      <to>State missing</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Label arrived</from>
      <to>State missing</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Rows arrived</from>
      <to>State missing</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Label passed the Join</from>
      <to>State missing</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>join-after-a-false-check</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Check ends false on its success hop into the Join: the Join's result is false, and the action after it does not run</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/23 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/23 00:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Fan out</name>
      <description/>
      <type>DUMMY</type>
      <attributes/>

      <parallel>Y</parallel>
      <xloc>208</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <valuetype>variable</valuetype>
      <variablename>${Internal.Workflow.Name}</variablename>
      <fieldtype>string</fieldtype>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successbooleancondition>true</successbooleancondition>
      <comparevalue>another workflow</comparevalue>
      <successwhenvarset>N</successwhenvarset>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Handle the check</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>The check failed</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>IT</logsubject>
      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>0</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Other branch</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>The other branch runs</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>IT</logsubject>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>256</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Both done</name>
      <description/>
      <type>JOIN</type>
      <attributes/>

      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>After the Join</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>After the Join runs</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>IT</logsubject>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Fan out</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Fan out</from>
      <to>Check</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Fan out</from>
      <to>Other branch</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Check</from>
      <to>Both done</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check</from>
      <to>Handle the check</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Other branch</from>
      <to>Both done</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Both done</from>
      <to>After the Join</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>stops-after-a-failure</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Check fails and has only a success hop: the workflow stops there, and the failure hop after Transform is never followed</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/23 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/23 00:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <valuetype>variable</valuetype>
      <variablename>${Internal.Workflow.Name}</variablename>
      <fieldtype>string</fieldtype>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successbooleancondition>true</successbooleancondition>
      <comparevalue>another workflow</comparevalue>
      <successwhenvarset>N</successwhenvarset>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Transform</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>Transform runs</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>IT</logsubject>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>On failure</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>On failure runs</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>IT</logsubject>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Check</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Check</from>
      <to>Transform</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Transform</from>
      <to>On failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>join-failure-hop</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>A pipeline fails on its success hop into the Join: the Join's result is false and its failure hop is followed</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/23 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/23 00:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Fan out</name>
      <description/>
      <type>DUMMY</type>
      <attributes/>

      <parallel>Y</parallel>
      <xloc>208</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>fails-with-errors.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/fails-with-errors.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Other branch</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>The other branch runs</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>IT</logsubject>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>256</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Both done</name>
      <description/>
      <type>JOIN</type>
      <attributes/>

      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Mail on failure</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>The Join failed: mail sent</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>IT</logsubject>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Fan out</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Fan out</from>
      <to>fails-with-errors.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Fan out</from>
      <to>Other branch</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>fails-with-errors.hpl</from>
      <to>Both done</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Other branch</from>
      <to>Both done</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Both done</from>
      <to>Mail on failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

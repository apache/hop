<workflow>
  <name>main-0016-airflow-dag-settings</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Airflow DAG objects of greeting.hwf: greeting-daily has its own DAG id, schedule, display name, tags, limits and parameter value; greeting-whole keeps the DAG id of the workflow and runs it as one task; greeting-wrong-date is a DAG that fails with the reason and keeps its schedule; greeting-typo has a schedule Airflow can't parse, which fails only that DAG.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/27 18:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/27 18:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Run the DAG in Airflow and check it</name>
      <description>Airflow DAG objects of greeting.hwf: greeting-daily has its own DAG id, schedule, display name, tags, limits and parameter value; greeting-whole keeps the DAG id of the workflow and runs it as one task; greeting-wrong-date is a DAG that fails with the reason and keeps its schedule; greeting-typo has a schedule Airflow can't parse, which fails only that DAG.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>python3 "${PROJECT_HOME}/airflow_dag_run.py" --dag hopit__greeting_daily --schedule "0 6 * * *" --detail 'dag_display_name="Greeting, daily"' --detail max_active_runs=1 --detail max_active_tasks=2 --detail catchup=false --tag hop --tag daily --tag greeting --log-contains "Greeting: from the Airflow DAG object" --xcom success=true &amp;&amp; python3 "${PROJECT_HOME}/airflow_dag_run.py" --dag hopit__greeting --conf '{"GREETING": "from the run conf"}' --task-ids run_workflow --log-contains "Greeting: from the run conf" --xcom success=true &amp;&amp; python3 "${PROJECT_HOME}/airflow_dag_run.py" --dag hopit__greeting_wrong_date --schedule "0 6 1 1 *" --expect failed --task-ids run_workflow --log-contains "start date soon" &amp;&amp; python3 "${PROJECT_HOME}/airflow_dag_run.py" --dag hopit__greeting_typo --schedule None --expect failed --task-ids run_workflow --log-contains "schedule @dayly is not one of the presets"</script>
      <arguments>
      </arguments>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Run the DAG in Airflow and check it</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Run the DAG in Airflow and check it</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

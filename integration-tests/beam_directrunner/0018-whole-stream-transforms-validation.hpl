<pipeline>
  <info>
    <name>0018-whole-stream-transforms-validation</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Counts the rows each transform of 0018-whole-stream-transforms wrote.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/23 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/23 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>unique-states*.csv</from>
      <to>count unique-states</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count unique-states</from>
      <to>Validate unique-states</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>last-row*.csv</from>
      <to>count last-row</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count last-row</from>
      <to>Validate last-row</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>detect-last*.csv</from>
      <to>count detect-last</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count detect-last</from>
      <to>Validate detect-last</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>sample*.csv</from>
      <to>count sample</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count sample</from>
      <to>Validate sample</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>reservoir*.csv</from>
      <to>count reservoir</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count reservoir</from>
      <to>Validate reservoir</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>empty-stream*.csv</from>
      <to>count empty-stream</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count empty-stream</from>
      <to>Validate empty-stream</to>
      <enabled>Y</enabled>
    </hop>
  </order>

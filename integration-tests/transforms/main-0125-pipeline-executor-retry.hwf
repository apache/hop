<workflow>
  <name>main-0125-pipeline-executor-retry</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Pipeline Executor retries: an inherited variable, a static ${TOKEN} cell, and field values that include a null, a boolean and a date.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/24 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/24 00:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>delete inherited result</name>
      <description/>
      <type>DELETE_FILE</type>
      <attributes/>
      <fail_if_file_not_exists>N</fail_if_file_not_exists>
      <filename>${java.io.tmpdir}/hop-it-0125-inherited.txt</filename>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>inherited variable</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0125-retry-inherited-parent.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>N</pass_all_parameters>
        <parameter>
          <name>TOKEN</name>
          <stream_name/>
          <value>stale</value>
        </parameter>
      </parameters>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check inherited variable</name>
      <description/>
      <type>FILE_COMPARE</type>
      <attributes/>
      <filename1>${java.io.tmpdir}/hop-it-0125-inherited.txt</filename1>
      <filename2>${PROJECT_HOME}/files/expected/0125-retry-inherited.txt</filename2>
      <add_filename_result>N</add_filename_result>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>delete static result</name>
      <description/>
      <type>DELETE_FILE</type>
      <attributes/>
      <fail_if_file_not_exists>N</fail_if_file_not_exists>
      <filename>${java.io.tmpdir}/hop-it-0125-static.txt</filename>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>static variable cell</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0125-retry-static-parent.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>N</pass_all_parameters>
        <parameter>
          <name>TOKEN</name>
          <stream_name/>
          <value>stale</value>
        </parameter>
      </parameters>
      <parallel>N</parallel>
      <xloc>992</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check static variable cell</name>
      <description/>
      <type>FILE_COMPARE</type>
      <attributes/>
      <filename1>${java.io.tmpdir}/hop-it-0125-static.txt</filename1>
      <filename2>${PROJECT_HOME}/files/expected/0125-retry-static.txt</filename2>
      <add_filename_result>N</add_filename_result>
      <parallel>N</parallel>
      <xloc>1184</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>delete field result</name>
      <description/>
      <type>DELETE_FILE</type>
      <attributes/>
      <fail_if_file_not_exists>N</fail_if_file_not_exists>
      <filename>${java.io.tmpdir}/hop-it-0125-fields.txt</filename>
      <parallel>N</parallel>
      <xloc>1376</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>delete field marker</name>
      <description/>

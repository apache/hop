<pipeline>
  <info>
    <name>0112-git-input-github-pull-requests</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/10 12:00:00.000</created_date>
    <modified_date>2026/09/10 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Reads one page of pull requests from ${GIT_IT_OWNER}/${GIT_IT_REPO}.&#xA;&#xA;Pull requests are a moving target, so this asserts the row contract rather than specific rows: every field the transform promises is populated, the numbers are unique, and a full page is returned. The commit test covers exact values against an immutable tag.</note>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <width>620</width>
      <heigth>150</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <transform>
    <name>read pull requests</name>
    <type>GitInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>github</connection>
    <source>REMOTE</source>
    <local_repository_path/>
    <resource_type>PULL_REQUESTS</resource_type>
    <owner>${GIT_IT_OWNER}</owner>
    <repository>${GIT_IT_REPO}</repository>
    <state>all</state>
    <since/>
    <branch/>
    <page_size>20</page_size>
    <max_pages>1</max_pages>
    <include_raw_json>N</include_raw_json>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>

  <order>
    <hop>
      <from>read pull requests</from>
      <to>pull request fields ok?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>pull request fields ok?</from>
      <to>count pull requests</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>pull request fields ok?</from>
      <to>Abort rows invalid</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count pull requests</from>
      <to>enough pull requests?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>enough pull requests?</from>
      <to>success</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>enough pull requests?</from>
      <to>Abort count invalid</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>FilterRows</type>
    <name>pull request fields ok?</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <function>=</function>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>entity_type</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>pull_requests</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>provider</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>github</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>repo_owner</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>apache</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>repo_name</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>hop</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>number</leftvalue>
            <function>></function>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>0</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>title</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>author</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>created_at</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>url</leftvalue>
            <function>STARTS WITH</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>https://github.com/apache/hop/pull/</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>merged</leftvalue>
            <function>IN LIST</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>Y;N</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>count pull requests</send_true_to>
    <send_false_to>Abort rows invalid</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>448</xloc>
      <yloc>272</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GroupBy</type>
    <name>count pull requests</name>
    <all_rows>N</all_rows>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <ignore_aggregate>N</ignore_aggregate>
    <group/>
    <fields>
      <field>
        <aggregate>row_count</aggregate>
        <subject>id</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>distinct_number</aggregate>
        <subject>number</subject>
        <type>COUNT_DISTINCT</type>
        <valuefield/>
      </field>
    </fields>
    <add_linenr>N</add_linenr>
    <give_back_row>N</give_back_row>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>768</xloc>
      <yloc>272</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>enough pull requests?</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <function>=</function>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>row_count</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>20</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>row_count</leftvalue>
            <function>=</function>
            <rightvalue>distinct_number</rightvalue>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>success</send_true_to>
    <send_false_to>Abort count invalid</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1024</xloc>
      <yloc>272</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>success</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1280</xloc>
      <yloc>272</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Abort rows invalid</name>
    <row_threshold>0</row_threshold>
    <message>Git Input returned pull request rows that do not match the expected shape</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1024</xloc>
      <yloc>400</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>Abort</type>
    <name>Abort count invalid</name>
    <row_threshold>0</row_threshold>
    <message>Git Input returned an unexpected number of pull requests</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1024</xloc>
      <yloc>528</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>

  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var fieldSum = fieldA + fieldB;

var par1 = getVariable("PAR1", "");
var par2 = getVariable("PAR2", "");
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>fieldSum</name>
        <rename>fieldSum</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>par1</name>

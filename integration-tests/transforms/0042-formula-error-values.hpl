<pipeline>
  <info>
    <name>0042-formula-error-values</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Excel reports a failed calculation with an error value instead of throwing, which
used to leave the output field silently blank. A #DIV/0! now fails the row, so with error handling
configured it is diverted to the error stream while the rows that do calculate pass through.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/12 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/12 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>input numbers</from>
      <to>divide</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>divide</from>
      <to>verify calculated rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>divide</from>
      <to>verify error description</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify calculated rows</from>
      <to>count calculated rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify calculated rows</from>
      <to>Abort on wrong value</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count calculated rows</from>
      <to>verify calculated count</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify calculated count</from>
      <to>Calculated rows OK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify calculated count</from>
      <to>Abort on calculated count</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify error description</from>
      <to>count error rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify error description</from>
      <to>Abort on wrong error</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count error rows</from>
      <to>verify error count</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify error count</from>
      <to>Errors OK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify error count</from>
      <to>Abort on error count</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>input numbers</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>div by zero</item>
        <item>10</item>
        <item>0</item>
      </line>
      <line>
        <item>valid</item>
        <item>10</item>
        <item>2</item>
      </line>
    </data>
    <fields>
      <field>
        <name>label</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>numerator</name>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>denominator</name>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>divide</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formulas>
      <formula>
        <field_name>ratio</field_name>
        <formula>[numerator]/[denominator]</formula>
        <replace_field/>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <value_type>5</value_type>
      </formula>
    </formulas>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>verify calculated rows</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>count calculated rows</send_true_to>
    <send_false_to>Abort on wrong value</send_false_to>
    <compare>
      <condition>
        <conditions>
          <condition>
            <conditions>
</conditions>
            <function>=</function>
            <leftvalue>label</leftvalue>
            <negated>N</negated>
            <operator>-</operator>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>valid</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <conditions>
</conditions>
            <function>=</function>
            <leftvalue>ratio</leftvalue>
            <negated>N</negated>
            <operator>AND</operator>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>5</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>####0;-####0</mask>
            </value>
          </condition>
        </conditions>
        <negated>N</negated>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>count calculated rows</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
    </group>
    <fields>
      <field>
        <aggregate>calculated_rows</aggregate>
        <subject>label</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>verify calculated count</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Calculated rows OK</send_true_to>
    <send_false_to>Abort on calculated count</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>calculated_rows</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>1</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Calculated rows OK</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort on wrong value</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>16</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort on calculated count</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>16</yloc>
    </GUI>
  </transform>
  <transform>
    <name>verify error description</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>count error rows</send_true_to>
    <send_false_to>Abort on wrong error</send_false_to>
    <compare>
      <condition>
        <conditions>
          <condition>
            <conditions>
</conditions>
            <function>CONTAINS</function>
            <leftvalue>err_desc</leftvalue>
            <negated>N</negated>
            <operator>-</operator>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>#DIV/0!</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <conditions>
</conditions>
            <function>=</function>
            <leftvalue>err_field</leftvalue>
            <negated>N</negated>
            <operator>AND</operator>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>ratio</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <conditions>
</conditions>
            <function>=</function>
            <leftvalue>label</leftvalue>
            <negated>N</negated>
            <operator>AND</operator>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>div by zero</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
        </conditions>
        <negated>N</negated>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>count error rows</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
    </group>
    <fields>
      <field>
        <aggregate>error_rows</aggregate>
        <subject>label</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>verify error count</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Errors OK</send_true_to>
    <send_false_to>Abort on error count</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>error_rows</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>1</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Errors OK</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort on wrong error</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>320</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort on error count</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>320</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>divide</source_transform>
      <target_transform>verify error description</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>err_nr</nr_valuename>
      <descriptions_valuename>err_desc</descriptions_valuename>
      <fields_valuename>err_field</fields_valuename>
      <codes_valuename>err_code</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <attributes/>
</pipeline>

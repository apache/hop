<pipeline>
  <info>
    <name>0104-vcard-output-file-name-field-generate</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Each file keeps all of its cards, also when another file was written to in between.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/13 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/13 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>cards for two files</from>
      <to>VCard output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>cards for two files</name>
    <type>DataGrid</type>
    <description>Rows alternate between a.vcf and b.vcf: both files are written to twice.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>Ann Alpha</item>
        <item>field-a-1</item>
        <item>${java.io.tmpdir}/vcard-output-0104-field/a.vcf</item>
      </line>
      <line>
        <item>Bob Beta</item>
        <item>field-b-1</item>
        <item>${java.io.tmpdir}/vcard-output-0104-field/b.vcf</item>
      </line>
      <line>
        <item>Cid Alpha</item>
        <item>field-a-2</item>
        <item>${java.io.tmpdir}/vcard-output-0104-field/a.vcf</item>
      </line>
      <line>
        <item>Dee Beta</item>
        <item>field-b-2</item>
        <item>${java.io.tmpdir}/vcard-output-0104-field/b.vcf</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>fn</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>uid</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>target</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>VCard output</name>
    <type>VCardOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <operation_type>writetofile</operation_type>
    <vcard_version>3.0</vcard_version>
    <output_field>vcard_text</output_field>
    <pass_input_fields>N</pass_input_fields>
    <add_prodid>N</add_prodid>
    <add_revision>N</add_revision>
    <file_name_in_field>Y</file_name_in_field>
    <file_name_field>target</file_name_field>
    <encoding>UTF-8</encoding>
    <file>
      <name/>
      <extension>vcf</extension>
      <create_parent_folder>Y</create_parent_folder>
      <append>N</append>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <doNotOpenNewFileInit>Y</doNotOpenNewFileInit>
    </file>
    <field>
      <hop_field>fn</hop_field>
      <property>fn</property>
      <parameter_types/>
    </field>
    <field>
      <hop_field>uid</hop_field>
      <property>uid</property>
      <parameter_types/>
    </field>
    <add_to_result_filenames>N</add_to_result_filenames>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<workflow>
  <name>main-0042-formula-error-handling</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Formula transform error reporting: dates the Excel date serial numbers can not
represent, Excel error values, and the #N/A value that has to keep mapping to a null.
See https://github.com/apache/hop/issues/3572</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/08/12 09:00:00.000</created_date>

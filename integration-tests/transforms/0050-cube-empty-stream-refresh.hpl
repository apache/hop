<pipeline>
  <info>
    <name>0050-cube-empty-stream-refresh</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/15 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/15 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ubuntu</fontname>
      <fontsize>11</fontsize>
      <height>26</height>
      <xloc>64</xloc>
      <yloc>16</yloc>
      <note>Cube Output receives no rows, so it has to learn the layout from the pipeline. That made Cube Input re-open its file, which by then can be gone: a cube refreshed in place is truncated by the output transform, a concurrent job may have replaced it, here it is simply deleted. The layout must still end up in the copy.</note>
      <width>900</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>read empty cube</from>
      <to>wait until the source is gone</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>wait until the source is gone</from>
      <to>write copy</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>one row</from>
      <to>source file name</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>source file name</from>
      <to>delete source cube</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>read empty cube</name>
    <type>CubeInput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <file>
      <name>${java.io.tmpdir}/file-0050-empty.cube</name>
    </file>
    <limit>0</limit>
    <addfilenameresult>N</addfilenameresult>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>wait until the source is gone</name>
    <type>BlockUntilTransformsFinish</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <transforms>
      <transform>
        <CopyNr>0</CopyNr>
        <name>delete source cube</name>
      </transform>
    </transforms>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>write copy</name>
    <type>CubeOutput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <file>
      <name>${java.io.tmpdir}/file-0050-empty-copy.cube</name>
      <add_to_result_filenames>N</add_to_result_filenames>
      <do_not_open_newfile_init>N</do_not_open_newfile_init>
    </file>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>one row</name>
    <type>RowGenerator</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>source file name</name>
    <type>GetVariable</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>filename</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${java.io.tmpdir}/file-0050-empty.cube</variable>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>delete source cube</name>
    <type>ProcessFiles</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <addresultfilenames>N</addresultfilenames>
    <createparentfolder>N</createparentfolder>
    <operation_type>delete</operation_type>
    <overwritetargetfile>N</overwritetargetfile>
    <simulate>N</simulate>
    <sourcefilenamefield>filename</sourcefilenamefield>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<pipeline>
  <info>
    <name>0115-text-chunker-structure-headings</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Structure chunking: AsciiDoc delimited blocks and Markdown code fences are not headings, skipped heading levels keep their parent, closing hashes are dropped and Auto picks the right parser (#9282).</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/07 12:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop> <from>Document</from> <to>Chunk</to> <enabled>Y</enabled> </hop>
    <hop> <from>Chunk</from> <to>OUTPUT</to> <enabled>Y</enabled> </hop>
  </order>
  <transform>
    <name>Document</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>asciidoc-example-block</item>
        <item>ASCIIDOC</item>
        <item>= Title&#10;&#10;Intro.&#10;&#10;== Section&#10;&#10;Before the block.&#10;&#10;====&#10;Example text inside the block.&#10;====&#10;&#10;After the block.&#10;&#10;== Next&#10;&#10;More text.</item>
      </line>
      <line>
        <item>asciidoc-example-block-auto</item>
        <item>AUTO</item>
        <item>= Title&#10;&#10;Intro.&#10;&#10;== Section&#10;&#10;Before the block.&#10;&#10;====&#10;Example text inside the block.&#10;====&#10;&#10;After the block.&#10;&#10;== Next&#10;&#10;More text.</item>
      </line>
      <line>
        <item>markdown-code-fence</item>
        <item>MARKDOWN</item>
        <item># Guide&#10;&#10;Intro.&#10;&#10;```bash&#10;# download the zip&#10;curl -O https://example.com/hop.zip&#10;```&#10;&#10;After the block.</item>
      </line>
      <line>
        <item>markdown-skipped-level</item>
        <item>MARKDOWN</item>
        <item># Guide&#10;&#10;Intro.&#10;&#10;### Detail&#10;&#10;Detail text.</item>
      </line>
      <line>
        <item>markdown-closing-hashes</item>
        <item>MARKDOWN</item>
        <item># Guide #&#10;&#10;Intro.&#10;&#10;## Install ##&#10;&#10;Install text.</item>
      </line>
      <line>
        <item>auto-markdown-mentions-hop-xml</item>
        <item>AUTO</item>
        <item># Pipelines&#10;&#10;A &lt;pipeline&gt; runs transforms, a &lt;workflow&gt; runs actions.&#10;&#10;## Run&#10;&#10;Use hop-run.</item>
      </line>
      <line>
        <item>auto-markdown-starts-with-brace</item>
        <item>AUTO</item>
        <item>{{&lt; note &gt;}}&#10;Read this first.&#10;{{&lt; /note &gt;}}&#10;&#10;# Guide&#10;&#10;Intro.&#10;&#10;## Next&#10;&#10;More text.</item>
      </line>
      <line>
        <item>auto-markdown-equals-line</item>
        <item>AUTO</item>
        <item># Guide&#10;&#10;The answer:&#10;= 42&#10;&#10;## Next&#10;&#10;More text.</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>case_id</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>content_type</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>content</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Chunk</name>
    <type>TextChunker</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <inputField>content</inputField>
    <outputChunkField>chunk_text</outputChunkField>
    <chunkingStrategy>STRUCTURE</chunkingStrategy>
    <contentType>AUTO</contentType>
    <contentTypeField>content_type</contentTypeField>
    <chunkSize>1000</chunkSize>
    <chunkOverlap>0</chunkOverlap>
    <includeMetadata>Y</includeMetadata>
    <chunkIndexField>chunk_index</chunkIndexField>
    <chunkStartPosField>chunk_start_position</chunkStartPosField>
    <documentIdField>chunk_doc_id</documentIdField>
    <chunkCountField>total_chunks</chunkCountField>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>OUTPUT</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

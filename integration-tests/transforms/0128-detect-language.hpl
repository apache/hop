<pipeline>
  <info>
    <name>0128-detect-language</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Detect language with the default options (every spoken language, high accuracy, one thread) and with a chosen set of languages, low accuracy mode and parallel jobs. Blank and null texts pass with UNKNOWN.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>DETECT_LANGUAGE_FIELD</name>
        <default_value>text</default_value>
        <description>The corpus field accepts a variable</description>
      </parameter>
      <parameter>
        <name>DETECT_LANGUAGE_THIRD</name>
        <default_value>GERMAN</default_value>
        <description>A language to choose accepts a variable</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/16 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/16 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>texts</from>
      <to>detect, default options</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>texts</from>
      <to>detect, chosen languages</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>detect, default options</from>
      <to>validate</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>detect, chosen languages</from>
      <to>validate chosen</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>texts</name>
    <type>DataGrid</type>
    <description>English, French and German text, only spaces, and no text at all (null).</description>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>1</item>
        <item>The children are playing in the garden while their parents prepare dinner in the kitchen.</item>
      </line>
      <line>
        <item>2</item>
        <item>Les enfants jouent dans le jardin pendant que leurs parents préparent le dîner dans la cuisine.</item>
      </line>
      <line>
        <item>3</item>
        <item>Die Kinder spielen im Garten, während ihre Eltern in der Küche das Abendessen vorbereiten.</item>
      </line>
      <line>
        <item>4</item>
        <item>   </item>
      </line>
      <line>
        <item>5</item>
        <item/>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>id</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>text</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>detect, default options</name>
    <type>DetectLanguage</type>
    <description>Every spoken language, high accuracy, one thread.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <corpusField>text</corpusField>
    <parallelism>N</parallelism>
    <lowAccuracy>N</lowAccuracy>
    <languages>
    </languages>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>detect, chosen languages</name>
    <type>DetectLanguage</type>
    <description>English, French and German only, low accuracy mode, parallel jobs: the rows can come out in another order.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <corpusField>${DETECT_LANGUAGE_FIELD}</corpusField>
    <parallelism>Y</parallelism>
    <lowAccuracy>Y</lowAccuracy>
    <languages>
      <language>
        <name>ENGLISH</name>
      </language>
      <language>
        <name>FRENCH</name>
      </language>
      <language>
        <name>${DETECT_LANGUAGE_THIRD}</name>
      </language>
    </languages>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>validate</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>validate chosen</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

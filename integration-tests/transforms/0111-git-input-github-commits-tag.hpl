<pipeline>
  <info>
    <name>0111-git-input-github-commits-tag</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/10 12:00:00.000</created_date>
    <modified_date>2026/09/10 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Reads the three most recent commits reachable from the ${GIT_IT_TAG} tag of ${GIT_IT_OWNER}/${GIT_IT_REPO}.&#xA;&#xA;A tag is immutable, so this is a genuine golden data set: the same three commit hashes for as long as the tag exists. Pinning to a tag also keeps the test to a single API call, which matters because it runs anonymously against a 60 requests per hour limit.</note>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <width>620</width>
      <heigth>150</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <transform>
    <name>read tagged commits</name>
    <type>GitInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>github</connection>
    <source>REMOTE</source>
    <local_repository_path/>
    <resource_type>COMMITS</resource_type>
    <owner>${GIT_IT_OWNER}</owner>
    <repository>${GIT_IT_REPO}</repository>
    <state>all</state>
    <since/>
    <branch>${GIT_IT_TAG}</branch>
    <page_size>3</page_size>
    <max_pages>1</max_pages>
    <include_raw_json>N</include_raw_json>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>

  <order>
    <hop>
      <from>read tagged commits</from>
      <to>commit rows are golden?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>commit rows are golden?</from>
      <to>count commits</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>commit rows are golden?</from>
      <to>Abort rows invalid</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count commits</from>
      <to>commit count is golden?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>commit count is golden?</from>
      <to>success</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>commit count is golden?</from>
      <to>Abort count invalid</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>FilterRows</type>
    <name>commit rows are golden?</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <function>=</function>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>sha</leftvalue>
            <function>IN LIST</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>52f03a5cd39312a4b1c29dbcd503244e9fd21716;4957064cce4f4d89bcbccd242c4a41bd66e24e5c;9311fd6a51c123a177f0198dccd86d03902408b5</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>author</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>created_at</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>provider</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>github</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>entity_type</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>commits</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>count commits</send_true_to>
    <send_false_to>Abort rows invalid</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>448</xloc>
      <yloc>272</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GroupBy</type>
    <name>count commits</name>
    <all_rows>N</all_rows>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <ignore_aggregate>N</ignore_aggregate>
    <group/>
    <fields>
      <field>
        <aggregate>row_count</aggregate>
        <subject>sha</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>distinct_sha</aggregate>
        <subject>sha</subject>
        <type>COUNT_DISTINCT</type>
        <valuefield/>
      </field>
    </fields>
    <add_linenr>N</add_linenr>
    <give_back_row>N</give_back_row>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>768</xloc>
      <yloc>272</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>commit count is golden?</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <function>=</function>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>row_count</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>3</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>distinct_sha</leftvalue>
            <function>=</function>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>3</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>success</send_true_to>
    <send_false_to>Abort count invalid</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1024</xloc>
      <yloc>272</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>success</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1280</xloc>
      <yloc>272</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Abort rows invalid</name>
    <row_threshold>0</row_threshold>
    <message>Git Input returned commit rows that do not match the pinned tag</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1024</xloc>
      <yloc>400</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>

  <transform>
    <type>Abort</type>
    <name>Abort count invalid</name>
    <row_threshold>0</row_threshold>
    <message>Git Input returned a different number of commits than the pinned tag holds</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1024</xloc>
      <yloc>528</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>

  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

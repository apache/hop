<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>0116-vector-lazy-conversion</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>A lazily converted String field converts to Vector and back. Select Values builds
      a fresh target whose storage metadata is empty, so the conversion has to run against the
      source field.</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/16 21:00:00.000</created_date>
    <modified_date>2026/09/16 21:00:00.000</modified_date>
    <created_hop_version/>
    <modified_hop_version>2.20.0-SNAPSHOT</modified_hop_version>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>Lazy CSV</name>
    <filename>${PROJECT_HOME}/files/vector-lazy.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>Y</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <namingScheme/>
    <fields>
      <field>
        <name>embedding</name>
        <length>-1</length>
        <type>Vector</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Back to text</name>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>embedding</name>
        <rename>embedding</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask/>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>OUTPUT</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>512</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Back to text</from>
      <to>OUTPUT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lazy CSV</from>
      <to>Back to text</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>

        <position>-1</position>
        <length>-1</length>
        <type>Boolean</type>
        <ignore>N</ignore>
        <format>yes/no</format>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <null_string/>
        <if_null_value/>
      </field>
      <field>
        <name>ja_nee</name>
        <position>-1</position>
        <length>3</length>

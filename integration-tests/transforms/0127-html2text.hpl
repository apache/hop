<pipeline>
  <info>
    <name>0127-html2text</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Every row reaches the output, also a row with blank or no HTML: it gets an empty text. With one copy and with three.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/13 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/13 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>html rows</from>
      <to>HTML to text</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>html rows</from>
      <to>spread over the copies</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>spread over the copies</from>
      <to>HTML to text in 3 copies</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HTML to text</from>
      <to>validate</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HTML to text in 3 copies</from>
      <to>validate copies</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>html rows</name>
    <type>DataGrid</type>
    <description>HTML, HTML with only spaces, and no HTML at all (null).</description>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>1</item>
        <item>&lt;p&gt;Hello &lt;b&gt;world&lt;/b&gt;&lt;/p&gt;</item>
      </line>
      <line>
        <item>2</item>
        <item>   </item>
      </line>
      <line>
        <item>3</item>
        <item/>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>id</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>html</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>HTML to text</name>
    <type>Html2Text</type>
    <description>One copy.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <htmlField>html</htmlField>
    <outputField>text</outputField>
    <safelistType>basic</safelistType>
    <cleanOnly>N</cleanOnly>
    <normalisedText>N</normalisedText>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>spread over the copies</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>HTML to text in 3 copies</name>
    <type>Html2Text</type>
    <description>Three copies: the rows can come out in another order.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>3</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <htmlField>html</htmlField>
    <outputField>text</outputField>
    <safelistType>basic</safelistType>
    <cleanOnly>N</cleanOnly>
    <normalisedText>N</normalisedText>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>validate</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>validate copies</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

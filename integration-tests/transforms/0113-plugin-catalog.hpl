<pipeline>
  <info>
    <name>0113-plugin-catalog</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Plugin Catalog reads the live plugin registry. The golden set is restricted to the
      Plugin Catalog transform's own row so that installing, removing or moving any other plugin to
      the Marketplace cannot break this test.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/16 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/16 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop> <from>Plugin Catalog</from> <to>Only this transform</to> <enabled>Y</enabled> </hop>
    <hop> <from>Only this transform</from> <to>Sort by property</to> <enabled>Y</enabled> </hop>
    <hop> <from>Only this transform</from> <to>DISCARD</to> <enabled>Y</enabled> </hop>
    <hop> <from>Sort by property</from> <to>OUTPUT</to> <enabled>Y</enabled> </hop>
  </order>
  <transform>
    <name>Plugin Catalog</name>
    <type>PluginCatalog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <includeTransforms>Y</includeTransforms>
    <includeActions>N</includeActions>
    <includeMetadataTypes>N</includeMetadataTypes>
    <detailLevel>PER_PROPERTY</detailLevel>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Only this transform</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Sort by property</send_true_to>
    <send_false_to>DISCARD</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>plugin_id</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>PluginCatalog</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Sort by property</name>
    <type>SortRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>out</prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>property_xml_key</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>OUTPUT</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>DISCARD</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<pipeline>
  <info>
    <name>0129-sorted-merge-descending</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Sorted merge on a descending field merges descending, whether or not a Sort rows before it marked the field descending (#9528)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/16 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/16 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>descending a</from>
      <to>merge descending input</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>descending b</from>
      <to>merge descending input</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>merge descending input</from>
      <to>number descending input</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>number descending input</from>
      <to>validate descending input</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>unsorted c</from>
      <to>sort c descending</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>unsorted d</from>
      <to>sort d descending</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>sort c descending</from>
      <to>merge sorted input</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>sort d descending</from>
      <to>merge sorted input</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>merge sorted input</from>
      <to>number sorted input</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>number sorted input</from>
      <to>validate sorted input</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>descending a</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>id</name>
        <precision>-1</precision>
        <type>Integer</type>
      </field>
    </fields>
    <data>
      <line>
        <item>5</item>
      </line>
      <line>
        <item>3</item>
      </line>
      <line>
        <item>1</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>descending b</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>id</name>
        <precision>-1</precision>
        <type>Integer</type>
      </field>
    </fields>
    <data>
      <line>
        <item>6</item>
      </line>
      <line>
        <item>4</item>
      </line>
      <line>
        <item>2</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>merge descending input</name>
    <type>SortedMerge</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>id</name>
        <ascending>N</ascending>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>number descending input</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <seqname>SEQ_</seqname>
    <counter_name>SEQ_DESCENDING_INPUT</counter_name>
    <start_at>1</start_at>
    <use_counter>Y</use_counter>
    <use_database>N</use_database>
    <valuename>nr</valuename>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>validate descending input</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>

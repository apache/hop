<pipeline>
  <info>
    <name>0136-watch-files</name>
    <description>Watch files emits the existing files on its first scan and stops after its maximum run time</description>
    <parameters />
  </info>
  <notepads />
  <order><hop><from>Watch directory</from><to>sort by name</to><enabled>Y</enabled></hop><hop><from>sort by name</from><to>validate</to><enabled>Y</enabled></hop></order>
  <transform>
    <name>Watch directory</name><type>WatchFiles</type><copies>1</copies><distribute>Y</distribute>
    <directory>${PROJECT_HOME}/files</directory>
    <watchId>it-watch-files</watchId>
    <patternSyntax>REGEXP</patternSyntax>
    <includeWildcard>sample-file[0-9]\.txt</includeWildcard>
    <excludeWildcard>.*\.tmp</excludeWildcard>
    <includeSubdirectories>N</includeSubdirectories>
    <strategy>AUTO</strategy>
    <created>Y</created><modified>Y</modified><deleted>Y</deleted>
    <pollingInterval>5000</pollingInterval>
    <reconciliationInterval>60000</reconciliationInterval>
    <eventCapacity>4096</eventCapacity><maximumEntries>100000</maximumEntries>
    <waitUntilStable>N</waitUntilStable><minimumAge>2000</minimumAge>
    <stabilityChecks>2</stabilityChecks><stabilityInterval>1000</stabilityInterval>
    <stateDirectory>${PROJECT_HOME}/output/0136-watch-files-state</stateDirectory>
    <initialScan>EMIT_EXISTING</initialScan><maximumRunTime>0.05</maximumRunTime><maximumRunTimeUnit>MINUTES</maximumRunTimeUnit><checkpointInterval>5000</checkpointInterval>
    <GUI><xloc>160</xloc><yloc>180</yloc></GUI>
  </transform>
  <transform>
    <name>sort by name</name><type>SortRows</type><description /><distribute>Y</distribute><custom_distribution /><copies>1</copies>
    <partitioning><method>none</method><schema_name /></partitioning>
    <directory>${java.io.tmpdir}</directory><prefix>out</prefix><sort_size>1000000</sort_size><free_memory />
    <compress>N</compress><compress_variable /><unique_rows>N</unique_rows>
    <fields><field><name>short_filename</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive>
    <collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field></fields>
    <attributes /><GUI><xloc>400</xloc><yloc>180</yloc></GUI>
  </transform>
<transform><name>validate</name><type>Dummy</type><description />
<distribute>Y</distribute><custom_distribution /><copies>1</copies>
<partitioning><method>none</method><schema_name /></partitioning><attributes />
<GUI><xloc>600</xloc><yloc>180</yloc></GUI></transform></pipeline>

<pipeline>
  <info>
    <name>0125-retry-fields-child</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Records field-mapped parameters. The first attempt fails so the executor retries the same row.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>LABEL</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>NOTE</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>FLAG</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>WHEN</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/24 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/24 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Generate rows</from>
      <to>Record fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Record fields</from>
      <to>Needs retry</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Needs retry</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Needs retry</from>
      <to>Done</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Generate rows</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>row</name>
        <type>Integer</type>
        <format>0</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif>1</nullif>
        <length>-1</length>
        <precision>0</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field/>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <row_time_field/>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Record fields</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var label = getVariable("LABEL", "");
var note = getVariable("NOTE", "");
var flag = getVariable("FLAG", "");
var when = getVariable("WHEN", "");
var path = java.lang.System.getProperty("java.io.tmpdir") + "/hop-it-0125-fields.txt";
var out = new java.io.FileWriter(path, true);
out.write(label + "|" + note + "|" + flag + "|" + when + "\n");
out.close();
var marker = new java.io.File(java.lang.System.getProperty("java.io.tmpdir") + "/hop-it-0125-fields.marker");
var first = !marker.exists();
if (first) {
  var touch = new java.io.FileWriter(marker);
  touch.close();
}
var fail = first ? "Y" : "N";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>fail</name>
        <rename>fail</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <languageVersion>ES6</languageVersion>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Needs retry</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Abort</send_true_to>
    <send_false_to>Done</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>fail</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>field parameters recorded, retry the same row</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>32</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Done</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

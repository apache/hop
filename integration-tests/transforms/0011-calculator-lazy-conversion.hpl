<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>0011-calculator-lazy-conversion</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>CSV file input with lazy conversion keeps the bytes read from the file. The
      calculations get the values: lower case of a String field, and the sum of two Integer
      fields, one of them empty.</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/17 09:00:00.000</created_date>
    <modified_date>2026/11/17 09:00:00.000</modified_date>
    <created_hop_version/>
    <modified_hop_version>2.20.0-SNAPSHOT</modified_hop_version>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>Lazy CSV</name>
    <filename>${PROJECT_HOME}/files/calculator-lazy-conversion.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>Y</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <namingScheme/>
    <fields>
      <field>
        <name>text</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>a</name>
        <length>-1</length>
        <type>Integer</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>b</name>
        <length>-1</length>
        <type>Integer</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Calculator</type>
    <name>calculate</name>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <calc_type>LOWER_CASE</calc_type>
      <conversion_mask/>
      <currency_symbol/>
      <decimal_symbol/>
      <field_a>text</field_a>
      <field_b/>
      <field_c/>
      <field_name>lower</field_name>
      <grouping_symbol/>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>String</value_type>
    </calculation>
    <calculation>
      <calc_type>ADD</calc_type>
      <conversion_mask/>
      <currency_symbol/>
      <decimal_symbol/>
      <field_a>a</field_a>
      <field_b>b</field_b>
      <field_c/>
      <field_name>sum</field_name>
      <grouping_symbol/>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>clean</name>
    <fields>
      <field>
        <name>lower</name>
      </field>
      <field>
        <name>sum</name>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>512</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>verify</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>704</xloc>
      <yloc>96</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Lazy CSV</from>
      <to>calculate</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>calculate</from>
      <to>clean</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>clean</from>
      <to>verify</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>

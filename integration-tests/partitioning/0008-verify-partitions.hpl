<pipeline>
  <info>
    <name>0008-verify-partitions</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Checks the result rows: every key in one partition with Remainder of division and with Hash on fields, all 1000 rows, Hash on fields on all 4 partitions, and 250 rows in every Rebalance partition.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/23 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/23 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>rows from result</from>
      <to>per key</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>per key</from>
      <to>key in several Remainder partitions?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>key in several Remainder partitions?</from>
      <to>Remainder of division split a key: abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>key in several Remainder partitions?</from>
      <to>key in several Hash partitions?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>key in several Hash partitions?</from>
      <to>Hash on fields split a key: abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>key in several Hash partitions?</from>
      <to>every key in one partition</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>rows from result</from>
      <to>totals</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>totals</from>
      <to>not 1000 rows?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>not 1000 rows?</from>
      <to>rows missing: abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>not 1000 rows?</from>
      <to>Hash not on 4 partitions?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hash not on 4 partitions?</from>
      <to>Hash on fields used too few partitions: abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hash not on 4 partitions?</from>
      <to>all rows, all partitions</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>rows from result</from>
      <to>per Rebalance partition</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>per Rebalance partition</from>
      <to>not 250 rows?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>not 250 rows?</from>
      <to>Rebalance is uneven: abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>not 250 rows?</from>
      <to>250 rows per partition</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>rows from result</name>
    <type>RowsFromResult</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>id</name>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>key</name>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>modCopy</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>hashCopy</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>rebalanceCopy</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>per key</name>
    <type>MemoryGroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>key</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>modPartitions</aggregate>
        <subject>modCopy</subject>
        <type>COUNT_DISTINCT</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>hashPartitions</aggregate>
        <subject>hashCopy</subject>
        <type>COUNT_DISTINCT</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>key in several Remainder partitions?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
        </conditions>
        <function>&lt;&gt;</function>
        <leftvalue>modPartitions</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>0</precision>
          <type>Integer</type>
          <text>1</text>
          <mask>#</mask>
        </value>
      </condition>
    </compare>
    <send_true_to>Remainder of division split a key: abort</send_true_to>
    <send_false_to>key in several Hash partitions?</send_false_to>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Remainder of division split a key: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>Remainder of division sent rows with the same key to more than one partition.</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>16</yloc>
    </GUI>
  </transform>
  <transform>
    <name>key in several Hash partitions?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
        </conditions>
        <function>&lt;&gt;</function>
        <leftvalue>hashPartitions</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>0</precision>
          <type>Integer</type>
          <text>1</text>
          <mask>#</mask>
        </value>
      </condition>
    </compare>
    <send_true_to>Hash on fields split a key: abort</send_true_to>
    <send_false_to>every key in one partition</send_false_to>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Hash on fields split a key: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>Hash on fields sent rows with the same key to more than one partition.</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>16</yloc>
    </GUI>
  </transform>
  <transform>
    <name>every key in one partition</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>totals</name>
    <type>MemoryGroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <give_back_row>N</give_back_row>
    <group>
    </group>
    <fields>
      <field>
        <aggregate>rows</aggregate>
        <subject>id</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>hashPartitions</aggregate>
        <subject>hashCopy</subject>
        <type>COUNT_DISTINCT</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>not 1000 rows?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
        </conditions>
        <function>&lt;&gt;</function>
        <leftvalue>rows</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>0</precision>
          <type>Integer</type>
          <text>1000</text>
          <mask>#</mask>
        </value>
      </condition>
    </compare>
    <send_true_to>rows missing: abort</send_true_to>
    <send_false_to>Hash not on 4 partitions?</send_false_to>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>rows missing: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>The partitioned pipeline did not pass on its 1000 rows.</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>320</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Hash not on 4 partitions?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
        </conditions>
        <function>&lt;&gt;</function>
        <leftvalue>hashPartitions</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>0</precision>
          <type>Integer</type>
          <text>4</text>
          <mask>#</mask>
        </value>
      </condition>
    </compare>
    <send_true_to>Hash on fields used too few partitions: abort</send_true_to>
    <send_false_to>all rows, all partitions</send_false_to>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Hash on fields used too few partitions: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>Hash on fields did not use all 4 partitions: its fields did not reach the partitioner.</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>320</yloc>
    </GUI>
  </transform>
  <transform>
    <name>all rows, all partitions</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>per Rebalance partition</name>
    <type>MemoryGroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>rebalanceCopy</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>rows</aggregate>
        <subject>id</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>400</yloc>
    </GUI>
  </transform>
  <transform>
    <name>not 250 rows?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
        </conditions>
        <function>&lt;&gt;</function>
        <leftvalue>rows</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>0</precision>
          <type>Integer</type>
          <text>250</text>
          <mask>#</mask>
        </value>
      </condition>
    </compare>
    <send_true_to>Rebalance is uneven: abort</send_true_to>
    <send_false_to>250 rows per partition</send_false_to>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>400</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rebalance is uneven: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>Rebalance did not give each of its 4 partitions 250 rows.</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>480</yloc>
    </GUI>
  </transform>
  <transform>
    <name>250 rows per partition</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>400</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

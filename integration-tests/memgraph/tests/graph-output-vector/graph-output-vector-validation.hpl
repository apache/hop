<pipeline>
  <info>
    <name>graph-output-vector-validation</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description />
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2019/08/06 18:28:33.119</created_date>
    <modified_user>-</modified_user>
    <modified_date>2019/08/06 18:28:33.119</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>query vector</from>
      <to>Search vectors</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Search vectors</from>
      <to>embedding as text</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>embedding as text</from>
      <to>sort by id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>sort by id</from>
      <to>Validation</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>query vector</name>
    <type>DataGrid</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <fields>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>q</name>
        <precision>-1</precision>
        <type>Vector</type>
      </field>
    </fields>
    <data>
      <line>
        <item>[0.9,0.1,0]</item>
      </line>
    </data>
    <attributes />
    <GUI>
      <xloc>144</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Search vectors</name>
    <type>Neo4jCypherOutput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>Test</connection>
    <cypher>CALL vector_search.search('graph_output_vector_docs', 2, $q) YIELD node, similarity
RETURN node.id AS id, node.embedding AS embedding</cypher>
    <batch_size />
    <read_only>Y</read_only>
    <nr_retries_on_error />
    <retry>Y</retry>
    <cypher_from_field>N</cypher_from_field>
    <cypher_field />
    <unwind>N</unwind>
    <unwind_map />
    <returning_graph>N</returning_graph>
    <return_graph_field />
    <mappings>
      <mapping>
        <parameter>q</parameter>
        <field>q</field>
        <type>Vector</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>id</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>embedding</name>
        <type>Vector</type>
        <source_type>List</source_type>
      </return>
    </returns>
    <attributes />
    <GUI>
      <xloc>192</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>sort by id</name>
    <type>SortRows</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>out</prefix>
    <sort_size>1000000</sort_size>
    <free_memory />
    <compress>N</compress>
    <compress_variable />
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>id</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes />
    <GUI>
      <xloc>304</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Validation</name>
    <type>Dummy</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <GUI>
      <xloc>608</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>embedding as text</name>
    <type>SelectValues</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <fields>
      <field>
        <name>id</name>
        <rename />
      </field>
      <field>
        <name>embedding</name>
        <rename />
      </field>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>embedding</name>
        <rename>embedding</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type />
        <conversion_mask />
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale />
        <date_format_timezone />
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol />
        <grouping_symbol />
        <currency_symbol />
        <encoding />
        <roundingType>half_even</roundingType>
      </meta>
    </fields>
    <attributes />
    <GUI>
      <xloc>480</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>

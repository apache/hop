{
  "name": "pipeline-executor-children",
  "enabled": true,
  "loggingParentsOnly": false,
  "pipelineFilename": "${PROJECT_HOME}/003-pipeline-log.hpl",
  "executingAtStart": false,
  "executingPeriodically": false,
  "intervalInSeconds": "30",
  "executingAtEnd": true,
  "logLevel": "BASIC",
  "pipelinesToLog": [
    {
      "pipelineToLogFilename": "${PROJECT_HOME}/003-pipeline-executor-parent.hpl"
    },
    {
      "pipelineToLogFilename": "${PROJECT_HOME}/003-pipeline-executor-child.hpl"
    }
  ],
  "failParentOnLoggingFailure": true
}

<pipeline>
  <info>
    <name>0004-embed-blank-text</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Embed text in one batch that mixes text with empty and whitespace-only values.
      The blank values are made by a formula, because a Data Grid turns a value of only spaces
      into null before Embed text would see it.
      The rows with text get an embedding, the others pass through without one, and no row is
      lost. Sending blank text used to stop the transform for the whole batch (#8750).</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/09 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/09 12:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop> <from>chunks</from> <to>make blank text</to> <enabled>Y</enabled> </hop>
    <hop> <from>make blank text</from> <to>Embed text</to> <enabled>Y</enabled> </hop>
    <hop> <from>Embed text</from> <to>has text?</to> <enabled>Y</enabled> </hop>
    <hop> <from>has text?</from> <to>embedded</to> <enabled>Y</enabled> </hop>
    <hop> <from>has text?</from> <to>not embedded</to> <enabled>Y</enabled> </hop>
    <hop> <from>embedded</from> <to>OUTPUT</to> <enabled>Y</enabled> </hop>
    <hop> <from>embedded</from> <to>Abort</to> <enabled>Y</enabled> </hop>
    <hop> <from>not embedded</from> <to>OUTPUT</to> <enabled>Y</enabled> </hop>
    <hop> <from>not embedded</from> <to>Abort</to> <enabled>Y</enabled> </hop>
    <hop> <from>OUTPUT</from> <to>count rows</to> <enabled>Y</enabled> </hop>
    <hop> <from>count rows</from> <to>check row count</to> <enabled>Y</enabled> </hop>
    <hop> <from>check row count</from> <to>Done</to> <enabled>Y</enabled> </hop>
    <hop> <from>check row count</from> <to>Abort</to> <enabled>Y</enabled> </hop>
  </order>
  <transform>
    <name>chunks</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>Apache Hop is a data orchestration platform.</item>
        <item/>
        <item>Y</item>
      </line>
      <line>
        <item/>
        <item>spaces</item>
        <item>N</item>
      </line>
      <line>
        <item/>
        <item>tab-newline</item>
        <item>N</item>
      </line>
      <line>
        <item/>
        <item/>
        <item>N</item>
      </line>
      <line>
        <item>Embeddings turn text into vectors for retrieval.</item>
        <item/>
        <item>Y</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>text</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>blank</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>has_text</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>make blank text</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formulas>
      <formula>
        <field_name>chunk_text</field_name>
        <formula>IF([blank]="spaces",REPT(" ",3),IF([blank]="tab-newline",CHAR(9)&amp;" "&amp;CHAR(10),[text]&amp;""))</formula>
        <replace_field/>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <value_type>2</value_type>
      </formula>
    </formulas>
    <attributes/>
    <GUI>
      <xloc>176</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Embed text</name>
    <type>EmbedText</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <ai_provider>ollama-embeddings</ai_provider>
    <model_name/>
    <input_field>chunk_text</input_field>
    <output_field>embedding</output_field>
    <output_format>STRING</output_format>
    <batch_size>16</batch_size>
    <include_model_metadata>Y</include_model_metadata>
    <model_field>embedding_model</model_field>
    <dimensions_field>embedding_dimensions</dimensions_field>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>has text?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>embedded</send_true_to>
    <send_false_to>not embedded</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>has_text</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>embedded</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>OUTPUT</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>embedding</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text></text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>576</xloc>
      <yloc>48</yloc>
    </GUI>
  </transform>
  <transform>
    <name>not embedded</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>OUTPUT</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>embedding</leftvalue>
        <function>IS NULL</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text></text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>576</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>OUTPUT</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>count rows</name>
    <type>MemoryGroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <give_back_row>N</give_back_row>
    <group>
    </group>
    <fields>
      <field>
        <aggregate>row_count</aggregate>
        <subject>has_text</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check row count</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Done</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>row_count</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>5</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Done</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>1216</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>Embed text gave a row with text no embedding, gave blank text an embedding, or lost a row. The row logged above shows what came back.</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

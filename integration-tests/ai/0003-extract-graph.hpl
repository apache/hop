<pipeline>
  <info>
    <name>0003-extract-graph</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Extract graph reads entities and relationships with a local model</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/19 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/19 09:00:00.000</modified_date>
    <key_for_session_key />
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>texts</from>
      <to>Extract graph</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Extract graph</from>
      <to>check graph</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check graph</from>
      <to>OUTPUT</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>texts</name>
    <type>DataGrid</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <data>
      <line>
        <item>doc-1</item>
        <item>Ada Lovelace worked with Charles Babbage on the Analytical Engine in London. She wrote what is seen as the first computer program for it.</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>document_id</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>text</name>
        <type>String</type>
      </field>
    </fields>
    <attributes />
    <GUI>
      <xloc>64</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Extract graph</name>
    <type>ExtractGraph</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <ai_provider>ollama-chat</ai_provider>
    <model_name />
    <input_field>text</input_field>
    <entity_types>Person, Organization, Product, Place</entity_types>
    <relationship_types>WORKED_WITH, WORKED_ON, CREATED, LOCATED_IN</relationship_types>
    <instructions />
    <kind_field>graph_element</kind_field>
    <name_field>name</name_field>
    <type_field>type</type_field>
    <description_field>description</description_field>
    <source_field>source</source_field>
    <target_field>target</target_field>
    <GUI>
      <xloc>240</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check graph</name>
    <type>ScriptValueMod</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>CountElements</jsScript_name>
        <jsScript_script>
// Every element has a type from the configured lists, and the right fields filled in
var entityTypes = ["Person", "Organization", "Product", "Place"];
var relationshipTypes = ["WORKED_WITH", "WORKED_ON", "CREATED", "LOCATED_IN"];
if (graph_element == "ENTITY") {
  if (!name || entityTypes.indexOf("" + type) &lt; 0) {
    throw new Error("Unexpected entity: " + name + " (" + type + ")");
  }
  entities++;
} else if (graph_element == "RELATIONSHIP") {
  if (!source || !target || relationshipTypes.indexOf("" + type) &lt; 0) {
    throw new Error("Unexpected relationship: " + source + " -[" + type + "]-&gt; " + target);
  }
  relationships++;
} else {
  throw new Error("Unexpected element kind: " + graph_element);
}
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>StartScript</jsScript_name>
        <jsScript_script>
var entities = 0;
var relationships = 0;
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>2</jsScript_type>
        <jsScript_name>CheckCounts</jsScript_name>
        <jsScript_script>
// The text names Ada Lovelace, Charles Babbage, the Analytical Engine and London
if (entities &lt; 3 || relationships &lt; 2) {
  throw new Error("Extract graph read " + entities + " entities and " + relationships + " relationships, expected at least 3 and 2");
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields />
    <attributes />
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>OUTPUT</name>
    <type>Dummy</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <GUI>
      <xloc>592</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>

<pipeline>
  <info>
    <name>0002-structured-extract</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Read a severity, a customer impact flag and an amount out of two free text
      support tickets, using a real model. What the model judges varies, so the test asserts the
      shape rather than the judgement: both required fields come back typed and non null. An
      answer the model cannot produce in the right shape fails the parse and stops the
      pipeline, which is the real assertion here.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/19 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/19 09:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop> <from>tickets</from> <to>Structured extract</to> <enabled>Y</enabled> </hop>
    <hop> <from>Structured extract</from> <to>check severity</to> <enabled>Y</enabled> </hop>
    <hop> <from>check severity</from> <to>check impact</to> <enabled>Y</enabled> </hop>
    <hop> <from>check severity</from> <to>Abort</to> <enabled>Y</enabled> </hop>
    <hop> <from>check impact</from> <to>OUTPUT</to> <enabled>Y</enabled> </hop>
    <hop> <from>check impact</from> <to>Abort</to> <enabled>Y</enabled> </hop>
  </order>
  <transform>
    <name>tickets</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>Production database is unreachable since 03:00, the whole order intake is down. Estimated loss so far 4500 euros.</item>
      </line>
      <line>
        <item>The export button on the reporting screen is slightly misaligned in dark mode. Cosmetic only.</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>ticket_text</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Structured extract</name>
    <type>StructuredExtract</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <ai_provider>ollama-chat</ai_provider>
    <model_name/>
    <input_field>ticket_text</input_field>
    <instructions/>
    <fields>
      <field>
        <name>severity</name>
        <type>String</type>
        <description>How urgent this ticket is</description>
        <required>Y</required>
        <allowed_values>low,medium,high</allowed_values>
      </field>
      <field>
        <name>customer_impact</name>
        <type>Boolean</type>
        <description>Whether customers are affected right now</description>
        <required>Y</required>
        <allowed_values></allowed_values>
      </field>
      <field>
        <name>estimated_loss</name>
        <type>Number</type>
        <description>Money lost so far in euros, if the ticket says</description>
        <required>N</required>
        <allowed_values></allowed_values>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check severity</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>check impact</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>severity</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text></text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check impact</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>OUTPUT</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>customer_impact</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text></text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>656</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>OUTPUT</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>832</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>Structured extract did not return both required fields. The row logged above shows what came back.</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

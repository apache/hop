<pipeline>
  <info>
    <name>0005-thinking</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Ask a thinking model the same question with Language Model Chat's Thinking option
      Off and On, and check that the option reaches Ollama.</description>
    <extended_description>qwen3 reasons before it answers unless told not to, and Ollama counts
      those reasoning tokens as output. With Thinking Off the answer to a one word question is a
      handful of tokens; with Thinking On the same question at temperature 0 costs many more. If
      the option did not reach Ollama both rows would show the same count. The answer itself must
      not carry the reasoning.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/10 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/10 09:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>prompt</from>
      <to>thinking off</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>thinking off</from>
      <to>thinking on</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>thinking on</from>
      <to>check no error off</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check no error off</from>
      <to>check no error on</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check no error on</from>
      <to>check answer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check answer</from>
      <to>check no reasoning in answer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check no reasoning in answer</from>
      <to>check off is short</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check off is short</from>
      <to>check on reasons</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check on reasons</from>
      <to>answer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check no error off</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check no error on</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check answer</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check no reasoning in answer</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check off is short</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check on reasons</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>prompt</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>prompt</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>Reply with one word: what colour is a clear sky at noon?</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>thinking off</name>
    <type>LanguageModelChat</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <inputField>prompt</inputField>
    <inputChatJson>false</inputChatJson>
    <outputChatJson>false</outputChatJson>
    <mock>false</mock>
    <outputFieldNamePrefix>off_</outputFieldNamePrefix>
    <modelType>OLLAMA</modelType>
    <parallelism>1</parallelism>
    <openAiUseProxy>false</openAiUseProxy>
    <openAiLogRequests>false</openAiLogRequests>
    <openAiLogResponses>false</openAiLogResponses>
    <huggingFaceReturnFullText>false</huggingFaceReturnFullText>
    <huggingFaceWaitForModel>false</huggingFaceWaitForModel>
    <mistralSafePrompt>false</mistralSafePrompt>
    <mistralLogRequests>false</mistralLogRequests>
    <mistralLogResponses>false</mistralLogResponses>
    <ollamaImageEndpoint>${OLLAMA_BASE_URL}</ollamaImageEndpoint>
    <ollamaModelName>qwen3-hop-it</ollamaModelName>
    <ollamaTemperature>0.0</ollamaTemperature>
    <ollamaNumPredict>512</ollamaNumPredict>
    <ollamaThink>OFF</ollamaThink>
    <ollamaTimeout>300</ollamaTimeout>
    <ollamaMaxRetries>3</ollamaMaxRetries>
    <anthropicLogRequests>false</anthropicLogRequests>
    <anthropicLogResponses>false</anthropicLogResponses>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>thinking on</name>
    <type>LanguageModelChat</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <inputField>prompt</inputField>
    <inputChatJson>false</inputChatJson>
    <outputChatJson>false</outputChatJson>
    <mock>false</mock>
    <outputFieldNamePrefix>on_</outputFieldNamePrefix>
    <modelType>OLLAMA</modelType>
    <parallelism>1</parallelism>
    <openAiUseProxy>false</openAiUseProxy>
    <openAiLogRequests>false</openAiLogRequests>
    <openAiLogResponses>false</openAiLogResponses>
    <huggingFaceReturnFullText>false</huggingFaceReturnFullText>
    <huggingFaceWaitForModel>false</huggingFaceWaitForModel>
    <mistralSafePrompt>false</mistralSafePrompt>
    <mistralLogRequests>false</mistralLogRequests>
    <mistralLogResponses>false</mistralLogResponses>
    <ollamaImageEndpoint>${OLLAMA_BASE_URL}</ollamaImageEndpoint>
    <ollamaModelName>qwen3-hop-it</ollamaModelName>
    <ollamaTemperature>0.0</ollamaTemperature>
    <ollamaNumPredict>512</ollamaNumPredict>
    <ollamaThink>ON</ollamaThink>
    <ollamaTimeout>300</ollamaTimeout>
    <ollamaMaxRetries>3</ollamaMaxRetries>
    <anthropicLogRequests>false</anthropicLogRequests>
    <anthropicLogResponses>false</anthropicLogResponses>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check no error off</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>check no error on</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>off_finish_reason</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>ERROR</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>576</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check no error on</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>check answer</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>on_finish_reason</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>ERROR</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check answer</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>check no reasoning in answer</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>off_output</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check no reasoning in answer</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>check off is short</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>Y</negated>
        <leftvalue>off_output</leftvalue>
        <function>CONTAINS</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>&lt;think&gt;</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check off is short</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>check on reasons</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>off_output_token_count</leftvalue>
        <function>&lt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>64</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>1216</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check on reasons</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>answer</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>on_output_token_count</leftvalue>
        <function>&gt;</function>
        <rightvalue>off_output_token_count</rightvalue>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>1376</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>answer</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>Y</limitRows>
    <limitRowsNumber>1</limitRowsNumber>
    <logmessage>Thinking Off and On both reached Ollama</logmessage>
    <fields>
      <field>
        <name>off_output_token_count</name>
      </field>
      <field>
        <name>on_output_token_count</name>
      </field>
      <field>
        <name>off_output</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1536</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <row_threshold>0</row_threshold>
    <message>Thinking Off or On did not reach Ollama. The row logged above shows the output and token counts with each.</message>
    <always_log_rows>Y</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>

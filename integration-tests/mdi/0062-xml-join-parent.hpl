<pipeline>
  <info>
    <name>0062-xml-join-parent</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Issue #9515: inject every XML Join option. Each value changes the result: the complex join places the lines per order, ISO-8859-1 turns the euro sign into a character reference, the header is omitted and the empty &lt;drop/&gt; is removed.</description>
    <extended_description/>
    <pipeline_version/>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/16 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/16 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>XML join options</from>
      <to>inject XML join options</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>inject XML join options</from>
      <to>Verify</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>XML join options</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>target</item>
        <item>doc</item>
        <item>source</item>
        <item>line</item>
        <item>xml_result</item>
        <item>//order[@id='?']/lines</item>
        <item>Y</item>
        <item>orderId</item>
        <item>ISO-8859-1</item>
        <item>Y</item>
        <item>Y</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>targetXmlTransform</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>targetXmlField</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>sourceXmlTransform</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>sourceXmlField</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>valueXmlField</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>targetXPath</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>complexJoin</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>joinCompareField</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>encoding</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>omitXmlHeader</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <set_empty_string>N</set_empty_string>
        <name>omitNullValues</name>
        <format/>
        <group/>
        <decimal/>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>inject XML join options</name>
    <type>MetaInject</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/0062-xml-join-child.hpl</filename>
    <source_transform>Output</source_transform>
    <source_output_fields>
      <source_output_field>
        <source_output_field_name>doc</source_output_field_name>
        <source_output_field_type>String</source_output_field_type>
        <source_output_field_length>-1</source_output_field_length>
        <source_output_field_precision>-1</source_output_field_precision>
      </source_output_field>
      <source_output_field>
        <source_output_field_name>xml_result</source_output_field_name>
        <source_output_field_type>String</source_output_field_type>
        <source_output_field_length>-1</source_output_field_length>
        <source_output_field_precision>-1</source_output_field_precision>
      </source_output_field>
    </source_output_fields>
    <target_file/>
    <no_execution>N</no_execution>
    <stream_source_transform/>
    <stream_target_transform/>
    <mappings>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>TARGET_XML_TRANSFORM</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>targetXmlTransform</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>TARGET_XML_FIELD</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>targetXmlField</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>SOURCE_XML_TRANSFORM</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>sourceXmlTransform</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>SOURCE_XML_FIELD</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>sourceXmlField</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>VALUE_XML_FIELD</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>valueXmlField</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>TARGET_XPATH</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>targetXPath</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>COMPLEX_JOIN</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>complexJoin</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>JOIN_COMPARE_FIELD</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>joinCompareField</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>ENCODING</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>encoding</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>OMIT_XML_HEADER</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>omitXmlHeader</source_field>
      </mapping>
      <mapping>
        <target_transform_name>XML join</target_transform_name>
        <target_attribute_key>OMIT_NULL_VALUES</target_attribute_key>
        <target_detail>N</target_detail>
        <source_transform>XML join options</source_transform>
        <source_field>omitNullValues</source_field>
      </mapping>
    </mappings>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Verify</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

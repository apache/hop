<workflow>
  <name>main-0062-xml-join</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #9515: metadata injection of every XML Join option.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/16 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/16 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description></description>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Run XML Join Unit Tests</name>
      <description></description>
      <type>RunPipelineTests</type>
      <attributes/>
      <test_names>
        <test_name>
          <name>0062-xml-join-parent UNIT</name>
        </test_name>
      </test_names>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>XML join injection mismatch</name>
      <description></description>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>The injected XML Join result does not match golden-xml-join-parent.</message>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Run XML Join Unit Tests</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Run XML Join Unit Tests</from>
      <to>XML join injection mismatch</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<pipeline>
  <info>
    <name>002-validation</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/10 14:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/10 14:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>params</from>
      <to>find-pipeline-execution</to>
      <enabled>Y</enabled>
    </hop>
    <!-- Branch A: Parent-child links -->
    <hop>
      <from>find-pipeline-execution</from>
      <to>verify-pipeline-has-parent</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify-pipeline-has-parent</from>
      <to>find-pipeline-parent-id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find-pipeline-parent-id</from>
      <to>verify-pipeline-parent-id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify-pipeline-parent-id</from>
      <to>select-before-action-parent</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>select-before-action-parent</from>
      <to>find-action-parent-id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find-action-parent-id</from>
      <to>verify-action-parent-id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>verify-action-parent-id</from>
      <to>select-before-find-executions</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>select-before-find-executions</from>
      <to>find-executions-of-action</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find-executions-of-action</from>
      <to>verify-child-pipeline-execution</to>
      <enabled>Y</enabled>
    </hop>
    <!-- Branch B: Mapping output rows in execution data -->
    <hop>
      <from>find-pipeline-execution</from>
      <to>select-for-get-execution-data</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>select-for-get-execution-data</from>
      <to>get-execution-data</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>get-execution-data</from>
      <to>filter-simple-mapping</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>filter-simple-mapping</from>
      <to>count-mapping-rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count-mapping-rows</from>
      <to>verify-mapping-rows-exist</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>params</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <name>name</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <name>type</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <name>ownerId</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>002-pipeline-with-mapping</item>
        <item>Pipeline</item>
        <item>all-transforms</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>find-pipeline-execution</name>
    <type>ExecInfo</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <location>caching-file</location>
    <operationType>FindLastExecution</operationType>
    <idFieldName/>
    <parentIdFieldName/>
    <typeFieldName>type</typeFieldName>
    <nameFieldName>name</nameFieldName>
    <includeChildrenFieldName/>
    <limitFieldName/>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <!-- Branch A Transforms -->
  <transform>
    <name>verify-pipeline-has-parent</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
if (executionId == null || parentId == null) {
  throw "Pipeline execution ID or parent action ID is null!";
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields/>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>find-pipeline-parent-id</name>
    <type>ExecInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <location>caching-file</location>
    <operationType>FindParentId</operationType>
    <idFieldName>executionId</idFieldName>
    <parentIdFieldName/>
    <typeFieldName/>
    <nameFieldName/>
    <includeChildrenFieldName/>
    <limitFieldName/>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>verify-pipeline-parent-id</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
if (id == null || !id.equals(parentId)) {
  throw "findParentId(pipelineId) [" + id + "] did not match parent action ID [" + parentId + "]!";
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields/>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>select-before-action-parent</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <meta>
        <name>id</name>
        <rename>resolvedPipelineParentId</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <conversion_mask/>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
    </fields>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>find-action-parent-id</name>
    <type>ExecInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <location>caching-file</location>
    <operationType>FindParentId</operationType>
    <idFieldName>parentId</idFieldName>
    <parentIdFieldName/>
    <typeFieldName/>
    <nameFieldName/>
    <includeChildrenFieldName/>
    <limitFieldName/>
    <attributes/>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>verify-action-parent-id</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
if (id == null || id.equals("") || id.equals(parentId)) {
  throw "findParentId(actionId) [" + id + "] is null or equal to actionId itself!";
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields/>
    <attributes/>
    <GUI>
      <xloc>1200</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>select-before-find-executions</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>parentId</name>
      </field>
      <field>
        <name>executionId</name>
        <rename>origPipelineId</rename>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1360</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>find-executions-of-action</name>
    <type>ExecInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <location>caching-file</location>
    <operationType>FindExecutions</operationType>
    <idFieldName/>
    <parentIdFieldName>parentId</parentIdFieldName>
    <typeFieldName/>
    <nameFieldName/>
    <includeChildrenFieldName/>
    <limitFieldName/>
    <attributes/>
    <GUI>
      <xloc>1520</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>verify-child-pipeline-execution</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
if (executionId == null || !executionId.equals(origPipelineId)) {
  throw "findExecutions(actionId) did not return expected pipeline execution ID [" + origPipelineId + "]! Got: [" + executionId + "]";
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields/>
    <attributes/>
    <GUI>
      <xloc>1680</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>

  <!-- Branch B Transforms -->
  <transform>
    <name>select-for-get-execution-data</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>executionId</name>
        <rename>pipelineExecId</rename>
      </field>
      <field>
        <name>ownerId</name>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>get-execution-data</name>
    <type>ExecInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <location>caching-file</location>
    <operationType>GetExecutionData</operationType>
    <idFieldName>ownerId</idFieldName>
    <parentIdFieldName>pipelineExecId</parentIdFieldName>
    <typeFieldName/>
    <nameFieldName/>
    <includeChildrenFieldName/>
    <limitFieldName/>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>filter-simple-mapping</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>name</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>simple-mapping</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>count-mapping-rows</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <fields>
      <field>
        <aggregate>mappingRowCount</aggregate>
        <subject>name</subject>
        <type>COUNT_ANY</type>
      </field>
    </fields>
    <give_back_row>Y</give_back_row>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>verify-mapping-rows-exist</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
if (mappingRowCount == null || mappingRowCount &lt; 10) {
  throw "Mapping transform output rows missing or insufficient in execution data! Expected &gt;= 10, got: " + mappingRowCount;
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields/>
    <attributes/>
    <GUI>
      <xloc>1040</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

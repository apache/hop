<workflow>
  <name>main-0010-get-mails-subfolders</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Get mails over a folder and its subfolders: unique #IdFile#, move and delete counters, move target below the source folder (#9208)</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/07 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/07 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>prepare mailbox (inline)</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <arg_from_previous>N</arg_from_previous>
      <arguments>
</arguments>
      <exec_per_row>N</exec_per_row>
      <insertScript>Y</insertScript>
      <loglevel>Basic</loglevel>
      <script>#!/bin/bash
# Fresh mailbox for folders@example.com: INBOX with 4 messages and an empty INBOX.sub.
WEBADMIN="http://${MAIL_SMTP_SERVER}:8000"
MAILUSER="folders@example.com"
OUT="${PROJECT_HOME}/output/0010-inline"

ready=0
for attempt in $(seq 1 60); do
  if curl -sf -o /dev/null --max-time 2 "$WEBADMIN/domains"; then
    ready=1
    break
  fi
  sleep 2
done
if [ "$ready" != 1 ]; then
  echo "James WebAdmin did not accept connections on port 8000"
  exit 1
fi

curl -s -XPUT "$WEBADMIN/domains/example.com"
curl -s -XPUT "$WEBADMIN/users/$MAILUSER" -d '{"password":"password"}' -H "Content-Type: application/json"
curl -sf -XDELETE "$WEBADMIN/users/$MAILUSER/mailboxes" || exit 1
curl -sf -XPUT "$WEBADMIN/users/$MAILUSER/mailboxes/INBOX" || exit 1
curl -sf -XPUT "$WEBADMIN/users/$MAILUSER/mailboxes/INBOX.sub" || exit 1

rm -rf "$OUT"
mkdir -p "$OUT"

for n in 1 2 3 4; do
  printf 'From: sender@example.com\r\nTo: %s\r\nSubject: Message %s\r\n\r\nBody of message %s\r\n' "$MAILUSER" "$n" "$n" \
    | curl -sS --url "smtp://${MAIL_SMTP_SERVER}:25" --mail-from sender@example.com --mail-rcpt "$MAILUSER" -T - || exit 1
done

# Delivery is asynchronous: wait until all 4 messages are in INBOX
for attempt in $(seq 1 60); do
  count=$(curl -s "$WEBADMIN/users/$MAILUSER/mailboxes/INBOX/messageCount")
  if [ "$count" = 4 ]; then
    echo "INBOX of $MAILUSER holds 4 messages"
    exit 0
  fi
  sleep 1
done
echo "Expected 4 messages in INBOX of $MAILUSER, found $count"
exit 1
</script>
      <set_append_logfile>N</set_append_logfile>

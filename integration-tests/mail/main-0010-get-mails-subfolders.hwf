      <script>#!/bin/bash
# Every message saved once, and all 4 now in INBOX.z: none read or copied again from INBOX.z.
WEBADMIN="http://${MAIL_SMTP_SERVER}:8000"
MAILUSER="folders@example.com"
OUT="${PROJECT_HOME}/output/0010-move-inline"
errors=0
files=$(ls "$OUT")
nfiles=$(ls "$OUT" | wc -l)
echo "Saved message files: " $files
if [ "$nfiles" != 4 ]; then
  echo "Expected 4 message files, found $nfiles"
  errors=$((errors + 1))
fi
for n in 1 2 3 4; do
  found=$(grep -l "^Subject: Message $n" "$OUT"/*.mail 2&gt;/dev/null | wc -l)
  if [ "$found" != 1 ]; then
    echo "Message $n was found in $found files, expected 1"
    errors=$((errors + 1))
  fi
done
for expected in INBOX:0 INBOX.a:0 INBOX.z:4; do
  mailbox=${expected%%:*}
  count=$(curl -s "$WEBADMIN/users/$MAILUSER/mailboxes/$mailbox/messageCount")
  echo "$mailbox holds $count messages"
  if [ "$count" != "${expected##*:}" ]; then
    echo "Expected ${expected##*:} messages in $mailbox"
    errors=$((errors + 1))
  fi
done
exit $errors
</script>

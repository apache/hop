<workflow>
  <name>main-0010-get-mails-subfolders</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Get mails over a folder and its subfolder: unique #IdFile#, move and delete counters (#9208)</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/07 12:00:00.000</created_date>

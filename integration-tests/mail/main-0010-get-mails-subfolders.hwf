      <insertScript>Y</insertScript>
      <loglevel>Basic</loglevel>
      <script>#!/bin/bash
# #IdFile# must be unique over all folders: 4 files, each message saved exactly once.
OUT="${PROJECT_HOME}/output/0010-inline"
errors=0
files=$(ls "$OUT")
nfiles=$(ls "$OUT" | wc -l)
echo "Saved message files: " $files
if [ "$nfiles" != 4 ]; then
  echo "Expected 4 message files, found $nfiles"
  errors=$((errors + 1))
fi
for n in 1 2 3 4; do
  found=$(grep -l "^Subject: Message $n" "$OUT"/*.mail 2&gt;/dev/null | wc -l)
  if [ "$found" != 1 ]; then
    echo "Message $n was found in $found files, expected 1"
    errors=$((errors + 1))
  fi
done
exit $errors
</script>

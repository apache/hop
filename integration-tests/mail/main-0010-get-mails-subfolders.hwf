      <script>#!/bin/bash
# Fresh mailbox for folders@example.com: INBOX with 3 messages, INBOX.a with 1 and an empty
# INBOX.z. INBOX.z is the move target: it sorts after INBOX.a, so it is reached as a subfolder
# after messages were moved into it.
WEBADMIN="http://${MAIL_SMTP_SERVER}:8000"
MAILUSER="folders@example.com"
OUT="${PROJECT_HOME}/output/0010-move-connection"

curl -s -XPUT "$WEBADMIN/domains/example.com"
curl -s -XPUT "$WEBADMIN/users/$MAILUSER" -d '{"password":"password"}' -H "Content-Type: application/json"
curl -sf -XDELETE "$WEBADMIN/users/$MAILUSER/mailboxes" || exit 1
for mailbox in INBOX INBOX.a INBOX.z; do
  curl -sf -XPUT "$WEBADMIN/users/$MAILUSER/mailboxes/$mailbox" || exit 1
done

rm -rf "$OUT"
mkdir -p "$OUT"

for n in 1 2 3; do
  printf 'From: sender@example.com\r\nTo: %s\r\nSubject: Message %s\r\n\r\nBody of message %s\r\n' "$MAILUSER" "$n" "$n" \
    | curl -sS --url "smtp://${MAIL_SMTP_SERVER}:25" --mail-from sender@example.com --mail-rcpt "$MAILUSER" -T - || exit 1
done
# Put message 4 straight into INBOX.a with an IMAP APPEND (curl needs a file of known size)
printf 'From: sender@example.com\r\nTo: %s\r\nSubject: Message 4\r\n\r\nBody of message 4\r\n' "$MAILUSER" &gt; "$OUT/../0010-message-4.eml"
curl -sSk --url "imaps://${MAIL_SMTP_SERVER}:993/INBOX.a" --user "$MAILUSER:password" -T "$OUT/../0010-message-4.eml" || exit 1
rm -f "$OUT/../0010-message-4.eml"

# Delivery is asynchronous: wait until all 3 messages are in INBOX
for attempt in $(seq 1 60); do
  count=$(curl -s "$WEBADMIN/users/$MAILUSER/mailboxes/INBOX/messageCount")
  sub=$(curl -s "$WEBADMIN/users/$MAILUSER/mailboxes/INBOX.a/messageCount")
  if [ "$count" = 3 ] &amp;&amp; [ "$sub" = 1 ]; then
    echo "INBOX of $MAILUSER holds 3 messages, INBOX.a holds 1"
    exit 0
  fi
  sleep 1
done
echo "Expected 3 messages in INBOX and 1 in INBOX.a of $MAILUSER, found $count and $sub"
exit 1
</script>

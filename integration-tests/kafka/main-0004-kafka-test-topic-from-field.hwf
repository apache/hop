<workflow>
  <name>main-0004-kafka-test-topic-from-field</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Checks that the Kafka Producer routes each row to the topic named in a field.</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/08/01 12:00:00.000</created_date>
  <modified_date>2026/08/01 12:00:00.000</modified_date>
  <workflow_version/>
  <parameters>
    <parameter>
      <name>BOOTSTRAP_SERVERS</name>
      <description>Kafka bootstrap servers (docker IT network hostname)</description>
      <default_value>kafka:9092</default_value>
    </parameter>
  </parameters>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>128</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/prepare-kafka-test-0004-topic-from-field.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>prepare-kafka-test-0004-topic-from-field.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>336</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/0004-kafka-consumer-topic-from-field.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>0004-kafka-consumer-topic-from-field.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>608</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <script>
var txt = previous_result.getLogText();

// Only topic A was consumed. Seeing A's message proves the row was routed by its
// field; not seeing B's proves the other row went somewhere else rather than
// every row landing on one topic.
var expectedValue = "Message = Hello topic A!";
var unexpectedValue = "Message = Hello topic B!";

var routedToTopicA = txt.contains(expectedValue);
var leakedTopicB = txt.contains(unexpectedValue);

if (routedToTopicA) {
  log.logBasic("Expected value logged as ''" + expectedValue + "'' FOUND!");
} else {
  log.logBasic("Expected value logged as ''" + expectedValue + "'' NOT FOUND!");
}

if (leakedTopicB) {
  log.logBasic("Unexpected value logged as ''" + unexpectedValue + "'' FOUND on topic A!");
}

var ok = routedToTopicA &amp;&amp; !leakedTopicB;

ok;</script>
      <name>Check log</name>
      <description/>
      <type>EVAL</type>
      <attributes/>
      <xloc>864</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>prepare-kafka-test-0004-topic-from-field.hpl</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>prepare-kafka-test-0004-topic-from-field.hpl</from>
      <to>0004-kafka-consumer-topic-from-field.hpl</to>
      <evaluation>N</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>0004-kafka-consumer-topic-from-field.hpl</from>
      <to>Check log</to>
      <evaluation>N</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

<workflow>
  <name>main-0001-lineage-sinks</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Lineage sinks selected in run configurations, with lineage not enabled with variables: only the runs whose run configuration, or whose parent's, selects a sink report their lineage (issue #9324).</description>
  <extended_description />
  <workflow_version />
  <created_user>-</created_user>
  <created_date>2026/11/15 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/15 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description />
      <type>SPECIAL</type>
      <attributes />
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Start the DataHub stub</name>
      <description>Starts a stand-in for DataHub in the test container</description>
      <type>SHELL</type>
      <attributes />
      <filename>${PROJECT_HOME}/0001-start-datahub-stub.sh</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile />
      <set_append_logfile>N</set_append_logfile>
      <logext />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>N</insertScript>
      <script />
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>0001-lineage-sink-reported</name>
      <description>Its run configuration, local-lineage, selects the datahub-stub lineage sink</description>
      <type>PIPELINE</type>
      <attributes />
      <filename>${PROJECT_HOME}/0001-lineage-sink-reported.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile />
      <logext />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local-lineage</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>0002-lineage-sink-not-reported</name>
      <description>Its run configuration, local, has no lineage sink</description>
      <type>PIPELINE</type>
      <attributes />
      <filename>${PROJECT_HOME}/0002-lineage-sink-not-reported.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile />
      <logext />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>576</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>0003-lineage-sink-child-workflow</name>
      <description>Its run configuration, local-lineage, selects the datahub-stub lineage sink; the pipeline it runs has none of its own</description>
      <type>WORKFLOW</type>
      <attributes />
      <filename>${PROJECT_HOME}/0003-lineage-sink-child-workflow.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile />
      <logext />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <pass_export>N</pass_export>
      <run_configuration>local-lineage</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>576</xloc>
      <yloc>224</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Publish to DataHub</name>
      <description>Publishes the pipeline in publish/, which never runs, to the datahub-stub lineage sink</description>
      <type>PUBLISH_TO_DATAHUB</type>
      <attributes />
      <sink>datahub-stub</sink>
      <folder>${PROJECT_HOME}/publish</folder>
      <parallel>N</parallel>
      <xloc>576</xloc>
      <yloc>352</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Check and stop the DataHub stub</name>
      <description>Only 0001, 0003 and 0004 reported their lineage, with the token of the data catalog, and so did the file 0004 wrote</description>
      <type>SHELL</type>
      <attributes />
      <filename>${PROJECT_HOME}/0001-check-and-stop-datahub-stub.sh</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile />
      <set_append_logfile>N</set_append_logfile>
      <logext />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>N</insertScript>
      <script />
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>784</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Start the DataHub stub</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Start the DataHub stub</from>
      <to>0001-lineage-sink-reported</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0001-lineage-sink-reported</from>
      <to>0002-lineage-sink-not-reported</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0002-lineage-sink-not-reported</from>
      <to>0003-lineage-sink-child-workflow</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0003-lineage-sink-child-workflow</from>
      <to>Publish to DataHub</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Publish to DataHub</from>
      <to>Check and stop the DataHub stub</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes />
</workflow>

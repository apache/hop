<workflow>
  <name>0007-lineage-sink-unit-test-child-workflow</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Run by the Workflow executor of 0007-lineage-sink-unit-tested-executor while its unit test runs: it writes a file, and reports nothing to a lineage sink of a run configuration.</description>
  <extended_description />
  <workflow_version />
  <created_user>-</created_user>
  <created_date>2026/11/23 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/23 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description />
      <type>SPECIAL</type>
      <attributes />
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Write a file</name>
      <description />
      <type>WRITE_TO_FILE</type>
      <attributes />
      <filename>${java.io.tmpdir}/lineage-sinks-it/unit-test-child-workflow.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>written while a unit test runs</content>
      <encoding>UTF-8</encoding>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Write a file</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes />
</workflow>

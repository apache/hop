<workflow>
  <name>0003-lineage-sink-child-workflow</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Run by main-0001-lineage-sinks with the local-lineage workflow run configuration: it, and the pipeline it runs, report their lineage to the datahub-stub lineage sink.</description>
  <extended_description />
  <workflow_version />
  <created_user>-</created_user>
  <created_date>2026/11/15 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/15 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description />
      <type>SPECIAL</type>
      <attributes />
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>0004-lineage-sink-inherited</name>
      <description>Its run configuration, local, has no lineage sink: it reports to the sink of this workflow's run configuration</description>
      <type>PIPELINE</type>
      <attributes />
      <filename>${PROJECT_HOME}/0004-lineage-sink-inherited.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile />
      <logext />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Run the unit test</name>
      <description>Runs lineage-sinks-unit-test: its test pipeline inherits this workflow's lineage sink. And lineage-sinks-unit-test-executor, whose Workflow executor starts a workflow that must not report to that sink</description>
      <type>RunPipelineTests</type>
      <attributes />
      <test_names>
        <test_name>
          <name>lineage-sinks-unit-test</name>
        </test_name>
        <test_name>
          <name>lineage-sinks-unit-test-executor</name>
        </test_name>
      </test_names>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>0008-lineage-sink-execute-tests</name>
      <description>Its Execute tests transform runs a unit test: the result goes to the lineage sink this pipeline inherits from this workflow</description>
      <type>PIPELINE</type>
      <attributes />
      <filename>${PROJECT_HOME}/0008-lineage-sink-execute-tests.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile />
      <logext />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>0004-lineage-sink-inherited</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>0004-lineage-sink-inherited</from>
      <to>Run the unit test</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Run the unit test</from>
      <to>0008-lineage-sink-execute-tests</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes />
</workflow>

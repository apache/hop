      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0055-delete-batch-error-accounting.hpl</from>
      <to>every row on exactly one stream</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>main-0055-delete-batch-error-accounting</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Delete with an error hop on SQL Server 2022 (Microsoft driver), twelve deletes at commit size 5, three of them refused by a foreign key that still references the row: one in the middle of the first commit window, one at the first position of the second and one at the end of the final partial window. Once with batch deletes on: the driver's validated batch failure contract (it runs the whole batch and marks the failed rows) tells which rows of a failed batch were refused. Once with batch deletes off: every row is deleted on its own and passed on right after its delete, as before. Asserts for both that exactly the three referenced rows reach the error stream, with the error code of their path, that the nine other rows are deleted, committed and reported once, and that no row is reported on the main output while it is still in the table.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/27 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/27 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS HOP_DEL_ERR_CHILD;
DROP TABLE IF EXISTS HOP_DEL_ERR_TARGET;
DROP TABLE IF EXISTS HOP_DEL_ERR_WRITTEN;
DROP TABLE IF EXISTS HOP_DEL_ERR_REJECTS;
DROP TABLE IF EXISTS HOP_DEL_RBR_CHILD;
DROP TABLE IF EXISTS HOP_DEL_RBR_TARGET;
DROP TABLE IF EXISTS HOP_DEL_RBR_WRITTEN;
DROP TABLE IF EXISTS HOP_DEL_RBR_REJECTS;
CREATE TABLE HOP_DEL_ERR_TARGET (ID BIGINT NOT NULL PRIMARY KEY, LABEL VARCHAR(20));
CREATE TABLE HOP_DEL_ERR_CHILD (CHILD_ID BIGINT NOT NULL PRIMARY KEY, PARENT_ID BIGINT NOT NULL, CONSTRAINT HOP_DEL_ERR_CHILD_FK FOREIGN KEY (PARENT_ID) REFERENCES HOP_DEL_ERR_TARGET (ID));
CREATE TABLE HOP_DEL_ERR_WRITTEN (ID BIGINT, LABEL VARCHAR(20));
CREATE TABLE HOP_DEL_ERR_REJECTS (ID BIGINT, LABEL VARCHAR(20), ERR_DESC NVARCHAR(MAX), ERR_CODE VARCHAR(20));
INSERT INTO HOP_DEL_ERR_TARGET (ID, LABEL) VALUES (0, 'old'), (1, 'old'), (2, 'old'), (3, 'old'), (4, 'old'), (5, 'old'), (6, 'old'), (7, 'old'), (8, 'old'), (9, 'old'), (10, 'old'), (11, 'old');
INSERT INTO HOP_DEL_ERR_CHILD (CHILD_ID, PARENT_ID) VALUES (2, 2), (5, 5), (11, 11);
CREATE TABLE HOP_DEL_RBR_TARGET (ID BIGINT NOT NULL PRIMARY KEY, LABEL VARCHAR(20));
CREATE TABLE HOP_DEL_RBR_CHILD (CHILD_ID BIGINT NOT NULL PRIMARY KEY, PARENT_ID BIGINT NOT NULL, CONSTRAINT HOP_DEL_RBR_CHILD_FK FOREIGN KEY (PARENT_ID) REFERENCES HOP_DEL_RBR_TARGET (ID));
CREATE TABLE HOP_DEL_RBR_WRITTEN (ID BIGINT, LABEL VARCHAR(20));
CREATE TABLE HOP_DEL_RBR_REJECTS (ID BIGINT, LABEL VARCHAR(20), ERR_DESC NVARCHAR(MAX), ERR_CODE VARCHAR(20));
INSERT INTO HOP_DEL_RBR_TARGET (ID, LABEL) VALUES (0, 'old'), (1, 'old'), (2, 'old'), (3, 'old'), (4, 'old'), (5, 'old'), (6, 'old'), (7, 'old'), (8, 'old'), (9, 'old'), (10, 'old'), (11, 'old');
INSERT INTO HOP_DEL_RBR_CHILD (CHILD_ID, PARENT_ID) VALUES (2, 2), (5, 5), (11, 11);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>mssql-2022</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0055-delete-batch-error-accounting.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0055-delete-batch-error-accounting.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>every row on exactly one stream</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>SET NOCOUNT ON;
DECLARE @n BIGINT;
DECLARE @msg NVARCHAR(400);

-- batch deletes on: twelve rows went in; twelve rows have to come out on exactly one of the two streams.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_DEL_ERR_WRITTEN UNION ALL SELECT ID FROM HOP_DEL_ERR_REJECTS) s;
IF @n &lt;&gt; 12
BEGIN
  SET @msg = CONCAT('batch deletes on: rows on the main output plus rows on the error stream: got ', @n, ', expected 12');
  THROW 51400, @msg, 1;
END;

-- batch deletes on: only the three rows the database refused are rejects; the good rows of their commit window are not taken down with them.
SELECT @n = COUNT(*) FROM HOP_DEL_ERR_REJECTS;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes on: rows on the error stream: got ', @n, ', expected 3');
  THROW 51401, @msg, 1;
END;

-- batch deletes on: the rejects are exactly the referenced rows: middle of window 1, first of window 2, last of the final partial window.
SELECT @n = COUNT(*) FROM HOP_DEL_ERR_REJECTS WHERE ID IN (2, 5, 11);
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes on: rejected rows that are the referenced rows: got ', @n, ', expected 3');
  THROW 51402, @msg, 1;
END;

-- batch deletes on: every reject carries the database's message and the code DEL002 of its path.
SELECT @n = COUNT(*) FROM HOP_DEL_ERR_REJECTS WHERE ERR_DESC IS NOT NULL AND ERR_CODE = 'DEL002';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes on: rejects with a message and code DEL002: got ', @n, ', expected 3');
  THROW 51403, @msg, 1;
END;

-- batch deletes on: all nine other rows are reported on the main output, each once.
SELECT @n = COUNT(*) FROM (SELECT DISTINCT ID FROM HOP_DEL_ERR_WRITTEN WHERE ID IN (0, 1, 3, 4, 6, 7, 8, 9, 10)) d;
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch deletes on: deleted rows on the main output: got ', @n, ', expected 9');
  THROW 51404, @msg, 1;
END;

-- batch deletes on: no row is reported more than once.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_DEL_ERR_WRITTEN GROUP BY ID HAVING COUNT(*) &gt; 1) d;
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch deletes on: rows on the main output more than once: got ', @n, ', expected 0');
  THROW 51405, @msg, 1;
END;

-- batch deletes on: only the three referenced rows are left in the table.
SELECT @n = COUNT(*) FROM HOP_DEL_ERR_TARGET;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes on: rows left in the target table: got ', @n, ', expected 3');
  THROW 51406, @msg, 1;
END;

-- batch deletes on: the referenced rows are the ones left.
SELECT @n = COUNT(*) FROM HOP_DEL_ERR_TARGET WHERE ID IN (2, 5, 11);
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes on: referenced rows still in the table: got ', @n, ', expected 3');
  THROW 51407, @msg, 1;
END;

-- batch deletes on: no row is reported as deleted while it is still in the table.
SELECT @n = COUNT(*) FROM HOP_DEL_ERR_WRITTEN w WHERE EXISTS (SELECT 1 FROM HOP_DEL_ERR_TARGET x WHERE x.ID = w.ID);
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch deletes on: rows reported as deleted that are still in the table: got ', @n, ', expected 0');
  THROW 51408, @msg, 1;
END;

-- batch deletes off: twelve rows went in; twelve rows have to come out on exactly one of the two streams.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_DEL_RBR_WRITTEN UNION ALL SELECT ID FROM HOP_DEL_RBR_REJECTS) s;
IF @n &lt;&gt; 12
BEGIN
  SET @msg = CONCAT('batch deletes off: rows on the main output plus rows on the error stream: got ', @n, ', expected 12');
  THROW 51409, @msg, 1;
END;

-- batch deletes off: only the three rows the database refused are rejects; the good rows of their commit window are not taken down with them.
SELECT @n = COUNT(*) FROM HOP_DEL_RBR_REJECTS;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes off: rows on the error stream: got ', @n, ', expected 3');
  THROW 51410, @msg, 1;
END;

-- batch deletes off: the rejects are exactly the referenced rows: middle of window 1, first of window 2, last of the final partial window.
SELECT @n = COUNT(*) FROM HOP_DEL_RBR_REJECTS WHERE ID IN (2, 5, 11);
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes off: rejected rows that are the referenced rows: got ', @n, ', expected 3');
  THROW 51411, @msg, 1;
END;

-- batch deletes off: every reject carries the database's message and the code DEL001 of its path.
SELECT @n = COUNT(*) FROM HOP_DEL_RBR_REJECTS WHERE ERR_DESC IS NOT NULL AND ERR_CODE = 'DEL001';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes off: rejects with a message and code DEL001: got ', @n, ', expected 3');
  THROW 51412, @msg, 1;
END;

-- batch deletes off: all nine other rows are reported on the main output, each once.
SELECT @n = COUNT(*) FROM (SELECT DISTINCT ID FROM HOP_DEL_RBR_WRITTEN WHERE ID IN (0, 1, 3, 4, 6, 7, 8, 9, 10)) d;
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch deletes off: deleted rows on the main output: got ', @n, ', expected 9');
  THROW 51413, @msg, 1;
END;

-- batch deletes off: no row is reported more than once.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_DEL_RBR_WRITTEN GROUP BY ID HAVING COUNT(*) &gt; 1) d;
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch deletes off: rows on the main output more than once: got ', @n, ', expected 0');
  THROW 51414, @msg, 1;
END;

-- batch deletes off: only the three referenced rows are left in the table.
SELECT @n = COUNT(*) FROM HOP_DEL_RBR_TARGET;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes off: rows left in the target table: got ', @n, ', expected 3');
  THROW 51415, @msg, 1;
END;

-- batch deletes off: the referenced rows are the ones left.
SELECT @n = COUNT(*) FROM HOP_DEL_RBR_TARGET WHERE ID IN (2, 5, 11);
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch deletes off: referenced rows still in the table: got ', @n, ', expected 3');
  THROW 51416, @msg, 1;
END;

-- batch deletes off: no row is reported as deleted while it is still in the table.
SELECT @n = COUNT(*) FROM HOP_DEL_RBR_WRITTEN w WHERE EXISTS (SELECT 1 FROM HOP_DEL_RBR_TARGET x WHERE x.ID = w.ID);
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch deletes off: rows reported as deleted that are still in the table: got ', @n, ', expected 0');
  THROW 51417, @msg, 1;
END;</sql>

<pipeline>
  <info>
    <name>0057-insert-update-batch-error-accounting</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Fourteen rows through Insert/Update on SQL Server 2022 with an error hop and commit size 5, inserts and updates interleaved, three of them refused by the database, once with batch updates on and once with them off. Exactly those three have to reach the error stream; every other row has to be written and reported once on the main output, in a table that ends up the same both ways.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/27 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/27 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Fourteen rows, three bad</from>
      <to>Batch insert update</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Batch insert update</from>
      <to>Rejects</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Batch insert update</from>
      <to>Written</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fourteen rows, three bad (row by row)</from>
      <to>Row by row insert update</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Row by row insert update</from>
      <to>Rejects row by row</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Row by row insert update</from>
      <to>Written row by row</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Fourteen rows, three bad</name>
    <type>DataGrid</type>
    <description>Fourteen rows on a table that holds the even ids 0-10 as 'old': the even ids are updated, the odd ones inserted. Three set LABEL to 'bad', which the table's check constraint refuses: id 2 (an update in the middle of the first commit window), id 5 (an insert, first row of the second window) and id 11 (an insert in the final window). Id 8 needs no change, and id 10 comes twice in the final window: the second time it is updated again to 'newer'.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line><item>0</item><item>new</item></line>
      <line><item>1</item><item>new</item></line>
      <line><item>2</item><item>bad</item></line>
      <line><item>3</item><item>new</item></line>
      <line><item>4</item><item>new</item></line>
      <line><item>5</item><item>bad</item></line>
      <line><item>6</item><item>new</item></line>
      <line><item>7</item><item>new</item></line>
      <line><item>8</item><item>old</item></line>
      <line><item>9</item><item>new</item></line>
      <line><item>10</item><item>new</item></line>
      <line><item>11</item><item>bad</item></line>
      <line><item>10</item><item>newer</item></line>
      <line><item>13</item><item>new</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>ID</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>LABEL</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Batch insert update</name>
    <type>InsertUpdate</type>
    <description>Use batch updates on, an error hop, commit size 5. The driver's validated batch failure contract (it runs the whole batch and marks the failed rows) tells which rows of a failed batch were refused. The refused rows go to the error hop with code ISU002.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mssql-2022</connection>
    <commit>5</commit>
    <update_bypassed>N</update_bypassed>
    <use_batch>Y</use_batch>
    <lookup>
      <schema/>
      <table>HOP_IU_ERR_TARGET</table>
      <key>
        <name>ID</name>
        <field>ID</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>ID</name>
        <rename>ID</rename>
        <update>N</update>
      </value>
      <value>
        <name>LABEL</name>
        <rename>LABEL</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Written</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>mssql-2022</connection>
    <fields>
      <field>
        <column_name>ID</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>LABEL</column_name>
        <stream_name>LABEL</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>HOP_IU_ERR_WRITTEN</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rejects</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>mssql-2022</connection>
    <fields>
      <field>
        <column_name>ID</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>LABEL</column_name>
        <stream_name>LABEL</stream_name>
      </field>
      <field>
        <column_name>ERR_DESC</column_name>
        <stream_name>ERR_DESC</stream_name>
      </field>
      <field>
        <column_name>ERR_CODE</column_name>
        <stream_name>ERR_CODES</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>HOP_IU_ERR_REJECTS</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Fourteen rows, three bad (row by row)</name>
    <type>DataGrid</type>
    <description>Fourteen rows on a table that holds the even ids 0-10 as 'old': the even ids are updated, the odd ones inserted. Three set LABEL to 'bad', which the table's check constraint refuses: id 2 (an update in the middle of the first commit window), id 5 (an insert, first row of the second window) and id 11 (an insert in the final window). Id 8 needs no change, and id 10 comes twice in the final window: the second time it is updated again to 'newer'.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line><item>0</item><item>new</item></line>
      <line><item>1</item><item>new</item></line>
      <line><item>2</item><item>bad</item></line>
      <line><item>3</item><item>new</item></line>
      <line><item>4</item><item>new</item></line>
      <line><item>5</item><item>bad</item></line>
      <line><item>6</item><item>new</item></line>
      <line><item>7</item><item>new</item></line>
      <line><item>8</item><item>old</item></line>
      <line><item>9</item><item>new</item></line>
      <line><item>10</item><item>new</item></line>
      <line><item>11</item><item>bad</item></line>
      <line><item>10</item><item>newer</item></line>
      <line><item>13</item><item>new</item></line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>ID</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>LABEL</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>464</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Row by row insert update</name>
    <type>InsertUpdate</type>
    <description>Use batch updates off, an error hop, commit size 5. Every row is inserted or updated on its own and passed on right after it, as before; a refused row goes to the error hop with code ISU001.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mssql-2022</connection>
    <commit>5</commit>
    <update_bypassed>N</update_bypassed>
    <use_batch>N</use_batch>
    <lookup>
      <schema/>
      <table>HOP_IU_RBR_TARGET</table>
      <key>
        <name>ID</name>
        <field>ID</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>ID</name>
        <rename>ID</rename>
        <update>N</update>
      </value>
      <value>
        <name>LABEL</name>
        <rename>LABEL</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>464</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Written row by row</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>mssql-2022</connection>
    <fields>
      <field>
        <column_name>ID</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>LABEL</column_name>
        <stream_name>LABEL</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>HOP_IU_RBR_WRITTEN</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>400</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rejects row by row</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>mssql-2022</connection>
    <fields>
      <field>
        <column_name>ID</column_name>
        <stream_name>ID</stream_name>
      </field>
      <field>
        <column_name>LABEL</column_name>
        <stream_name>LABEL</stream_name>
      </field>
      <field>
        <column_name>ERR_DESC</column_name>
        <stream_name>ERR_DESC</stream_name>
      </field>
      <field>
        <column_name>ERR_CODE</column_name>
        <stream_name>ERR_CODES</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>Y</specify_fields>
    <table>HOP_IU_RBR_REJECTS</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>528</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>Batch insert update</source_transform>
      <target_transform>Rejects</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>ERR_COUNT</nr_valuename>
      <descriptions_valuename>ERR_DESC</descriptions_valuename>
      <fields_valuename>ERR_FIELDS</fields_valuename>
      <codes_valuename>ERR_CODES</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
    <error>
      <source_transform>Row by row insert update</source_transform>
      <target_transform>Rejects row by row</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>ERR_COUNT</nr_valuename>
      <descriptions_valuename>ERR_DESC</descriptions_valuename>
      <fields_valuename>ERR_FIELDS</fields_valuename>
      <codes_valuename>ERR_CODES</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <attributes/>
</pipeline>

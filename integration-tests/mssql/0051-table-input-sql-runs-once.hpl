<pipeline>
  <info>
    <name>0051-table-input-sql-runs-once</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>A Table Input whose SQL inserts a row before it selects: every execution of that SQL leaves a row in it0051_run_log</description>
    <extended_description>Hop may only run the SQL of a Table Input to read the rows, not to work out its output fields (#9036). RUN_LABEL goes into the SQL so every case has its own SQL text: the database cache of query fields is shared by the whole JVM, and an entry for one case would otherwise hide the extra execution in the next.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>RUN_LABEL</name>
        <default_value>default</default_value>
        <description>Written to it0051_run_log by every execution of the SQL</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/05 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/05 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Insert and count</from>
      <to>Log runs</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Insert and count</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mssql-2022</connection>
    <sql>INSERT INTO it0051_run_log (run_label) VALUES ('${RUN_LABEL}');
SELECT COUNT(*) AS runs FROM it0051_run_log WHERE run_label = '${RUN_LABEL}';</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Log runs</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <displayHeader>Y</displayHeader>
    <fields>
      <field>
        <name>runs</name>
      </field>
    </fields>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <loglevel>Basic</loglevel>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

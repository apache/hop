        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>every row on exactly one stream</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>SET NOCOUNT ON;
DECLARE @n BIGINT;
DECLARE @msg NVARCHAR(400);

-- batch updates on: twelve rows went in; twelve rows have to come out on exactly one of the two streams.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_SAM_ERR_WRITTEN UNION ALL SELECT ID FROM HOP_SAM_ERR_REJECTS) s;
IF @n &lt;&gt; 12
BEGIN
  SET @msg = CONCAT('batch updates on: rows on the main output plus rows on the error stream: got ', @n, ', expected 12');
  THROW 51560, @msg, 1;
END;

-- batch updates on: only the three rows the database refused are rejects; the good rows of their batches are not taken down with them.
SELECT @n = COUNT(*) FROM HOP_SAM_ERR_REJECTS;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: rows on the error stream: got ', @n, ', expected 3');
  THROW 51561, @msg, 1;
END;

-- batch updates on: the rejects are exactly the bad rows: the update of 2 (check constraint), the insert of 5 (duplicate key) and the delete of 6 (foreign key).
SELECT @n = COUNT(*) FROM HOP_SAM_ERR_REJECTS WHERE ID IN (2, 5, 6);
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: rejected rows that are the bad rows: got ', @n, ', expected 3');
  THROW 51562, @msg, 1;
END;

-- batch updates on: every reject carries the database's message and the code SUYNC002 of a row refused in a batch, so batching stayed on with the error hop.
SELECT @n = COUNT(*) FROM HOP_SAM_ERR_REJECTS WHERE ERR_DESC IS NOT NULL AND ERR_CODE = 'SUYNC002';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: rejects with a message and code SUYNC002: got ', @n, ', expected 3');
  THROW 51563, @msg, 1;
END;

-- batch updates on: all nine other rows are reported on the main output, each once, the skipped row 11 too.
SELECT @n = COUNT(DISTINCT ID) FROM HOP_SAM_ERR_WRITTEN WHERE ID IN (0, 1, 3, 4, 7, 8, 9, 10, 11);
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch updates on: good rows on the main output: got ', @n, ', expected 9');
  THROW 51564, @msg, 1;
END;

-- batch updates on: no row is reported more than once.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_SAM_ERR_WRITTEN GROUP BY ID HAVING COUNT(*) &gt; 1) d;
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates on: rows on the main output more than once: got ', @n, ', expected 0');
  THROW 51565, @msg, 1;
END;

-- batch updates on: the table holds the eight rows it started with, minus the two deletes, plus the four inserts, minus the refused one.
SELECT @n = COUNT(*) FROM HOP_SAM_ERR_TARGET;
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch updates on: rows in the target table: got ', @n, ', expected 9');
  THROW 51566, @msg, 1;
END;

-- batch updates on: the six updates and inserts that went through are committed.
SELECT @n = COUNT(*) FROM HOP_SAM_ERR_TARGET WHERE ID IN (0, 1, 7, 8, 9, 10) AND LABEL = 'new';
IF @n &lt;&gt; 6
BEGIN
  SET @msg = CONCAT('batch updates on: rows written in the table: got ', @n, ', expected 6');
  THROW 51567, @msg, 1;
END;

-- batch updates on: the refused update, insert and delete left their rows alone.
SELECT @n = COUNT(*) FROM HOP_SAM_ERR_TARGET WHERE ID IN (2, 5, 6) AND LABEL = 'old';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: refused rows still holding their old value: got ', @n, ', expected 3');
  THROW 51568, @msg, 1;
END;

-- batch updates on: the two deletes that went through are committed.
SELECT @n = COUNT(*) FROM HOP_SAM_ERR_TARGET WHERE ID IN (3, 4);
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates on: deleted rows still in the table: got ', @n, ', expected 0');
  THROW 51569, @msg, 1;
END;

-- batch updates on: no row is reported on the main output unless what it did is in the table.
SELECT @n = COUNT(*) FROM HOP_SAM_ERR_WRITTEN w WHERE (w.FLAG IN ('new', 'changed') AND NOT EXISTS (SELECT 1 FROM HOP_SAM_ERR_TARGET x WHERE x.ID = w.ID AND x.LABEL = 'new')) OR (w.FLAG = 'deleted' AND EXISTS (SELECT 1 FROM HOP_SAM_ERR_TARGET x WHERE x.ID = w.ID));
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates on: rows reported on the main output that were not written: got ', @n, ', expected 0');
  THROW 51570, @msg, 1;
END;

-- batch updates off: twelve rows went in; twelve rows have to come out on exactly one of the two streams.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_SAM_RBR_WRITTEN UNION ALL SELECT ID FROM HOP_SAM_RBR_REJECTS) s;
IF @n &lt;&gt; 12
BEGIN
  SET @msg = CONCAT('batch updates off: rows on the main output plus rows on the error stream: got ', @n, ', expected 12');
  THROW 51571, @msg, 1;
END;

-- batch updates off: only the three rows the database refused are rejects; the good rows of their batches are not taken down with them.
SELECT @n = COUNT(*) FROM HOP_SAM_RBR_REJECTS;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: rows on the error stream: got ', @n, ', expected 3');
  THROW 51572, @msg, 1;
END;

-- batch updates off: the rejects are exactly the bad rows: the update of 2 (check constraint), the insert of 5 (duplicate key) and the delete of 6 (foreign key).
SELECT @n = COUNT(*) FROM HOP_SAM_RBR_REJECTS WHERE ID IN (2, 5, 6);
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: rejected rows that are the bad rows: got ', @n, ', expected 3');
  THROW 51573, @msg, 1;
END;

-- batch updates off: every reject carries the database's message and the code SUYNC001 of a row that ran on its own.
SELECT @n = COUNT(*) FROM HOP_SAM_RBR_REJECTS WHERE ERR_DESC IS NOT NULL AND ERR_CODE = 'SUYNC001';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: rejects with a message and code SUYNC001: got ', @n, ', expected 3');
  THROW 51574, @msg, 1;
END;

-- batch updates off: all nine other rows are reported on the main output, each once, the skipped row 11 too.
SELECT @n = COUNT(DISTINCT ID) FROM HOP_SAM_RBR_WRITTEN WHERE ID IN (0, 1, 3, 4, 7, 8, 9, 10, 11);
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch updates off: good rows on the main output: got ', @n, ', expected 9');
  THROW 51575, @msg, 1;
END;

-- batch updates off: no row is reported more than once.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_SAM_RBR_WRITTEN GROUP BY ID HAVING COUNT(*) &gt; 1) d;
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates off: rows on the main output more than once: got ', @n, ', expected 0');
  THROW 51576, @msg, 1;
END;

-- batch updates off: the table holds the eight rows it started with, minus the two deletes, plus the four inserts, minus the refused one.
SELECT @n = COUNT(*) FROM HOP_SAM_RBR_TARGET;
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch updates off: rows in the target table: got ', @n, ', expected 9');
  THROW 51577, @msg, 1;
END;

-- batch updates off: the six updates and inserts that went through are committed.
SELECT @n = COUNT(*) FROM HOP_SAM_RBR_TARGET WHERE ID IN (0, 1, 7, 8, 9, 10) AND LABEL = 'new';
IF @n &lt;&gt; 6
BEGIN
  SET @msg = CONCAT('batch updates off: rows written in the table: got ', @n, ', expected 6');
  THROW 51578, @msg, 1;
END;

-- batch updates off: the refused update, insert and delete left their rows alone.
SELECT @n = COUNT(*) FROM HOP_SAM_RBR_TARGET WHERE ID IN (2, 5, 6) AND LABEL = 'old';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: refused rows still holding their old value: got ', @n, ', expected 3');
  THROW 51579, @msg, 1;
END;

-- batch updates off: the two deletes that went through are committed.
SELECT @n = COUNT(*) FROM HOP_SAM_RBR_TARGET WHERE ID IN (3, 4);
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates off: deleted rows still in the table: got ', @n, ', expected 0');
  THROW 51580, @msg, 1;
END;

-- batch updates off: no row is reported on the main output unless what it did is in the table.
SELECT @n = COUNT(*) FROM HOP_SAM_RBR_WRITTEN w WHERE (w.FLAG IN ('new', 'changed') AND NOT EXISTS (SELECT 1 FROM HOP_SAM_RBR_TARGET x WHERE x.ID = w.ID AND x.LABEL = 'new')) OR (w.FLAG = 'deleted' AND EXISTS (SELECT 1 FROM HOP_SAM_RBR_TARGET x WHERE x.ID = w.ID));
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates off: rows reported on the main output that were not written: got ', @n, ', expected 0');
  THROW 51581, @msg, 1;
END;</sql>

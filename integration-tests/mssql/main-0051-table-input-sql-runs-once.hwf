<workflow>
  <name>main-0051-table-input-sql-runs-once</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>The SQL of a Table Input on SQL Server runs once per pipeline run, with and without execution information and a data profile (#9036)</description>
  <extended_description>Hop asked the transforms for their output fields twice during a run: to attach the samplers of a data profile, and to report transform schemas to lineage (even with lineage off). A Table Input on SQL Server can only answer by running its SQL, so inserts and procedure calls in it ran twice. The run under 'local' covers the lineage path, the run under 'local-exec-info' the samplers as well.</extended_description>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/05 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/05 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>reset run log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/scripts/0051-table-input-sql-runs-once.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>mssql-2022</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>run local</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0051-table-input-sql-runs-once.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <parameter>
          <name>RUN_LABEL</name>
          <stream_name/>
          <value>local</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>run local-exec-info</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0051-table-input-sql-runs-once.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local-exec-info</run_configuration>
      <parameters>
        <parameter>
          <name>RUN_LABEL</name>
          <stream_name/>
          <value>exec-info</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check one execution per run</name>
      <description>Every run executes the SQL once: one row per label</description>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>mssql-2022</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT 1
WHERE (SELECT COUNT(*) FROM it0051_run_log WHERE run_label = &apos;local&apos;) = 1
  AND (SELECT COUNT(*) FROM it0051_run_log WHERE run_label = &apos;exec-info&apos;) = 1
  AND (SELECT COUNT(*) FROM it0051_run_log) = 2</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>reset run log</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>reset run log</from>
      <to>run local</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>run local</from>
      <to>run local-exec-info</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>run local-exec-info</from>
      <to>check one execution per run</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

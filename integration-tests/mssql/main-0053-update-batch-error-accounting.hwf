<workflow>
  <name>main-0053-update-batch-error-accounting</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Update with an error hop on SQL Server 2022 (Microsoft driver), twelve updates at commit size 5, three of them refused by a check constraint: one in the middle of the first commit window, one at the first position of the second and one at the end of the final partial window. Once with batch updates on: the driver's validated batch failure contract (it runs the whole batch and marks the failed rows) tells which rows of a failed batch were refused. Once with batch updates off: every row is updated on its own and passed on after its commit. Asserts for both that exactly the three bad rows reach the error stream, with the error code of their path, that the nine good updates are committed and reported once, and that no row is reported on the main output unless its update is in the table.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/25 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/25 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS HOP_UPD_ERR_TARGET;
DROP TABLE IF EXISTS HOP_UPD_ERR_WRITTEN;
DROP TABLE IF EXISTS HOP_UPD_ERR_REJECTS;
DROP TABLE IF EXISTS HOP_UPD_RBR_TARGET;
DROP TABLE IF EXISTS HOP_UPD_RBR_WRITTEN;
DROP TABLE IF EXISTS HOP_UPD_RBR_REJECTS;
CREATE TABLE HOP_UPD_ERR_TARGET (ID BIGINT NOT NULL PRIMARY KEY, LABEL VARCHAR(20), CONSTRAINT HOP_UPD_ERR_TARGET_ck CHECK (LABEL &lt;&gt; 'bad'));
CREATE TABLE HOP_UPD_ERR_WRITTEN (ID BIGINT, LABEL VARCHAR(20));
CREATE TABLE HOP_UPD_ERR_REJECTS (ID BIGINT, LABEL VARCHAR(20), ERR_DESC NVARCHAR(MAX), ERR_CODE VARCHAR(20));
INSERT INTO HOP_UPD_ERR_TARGET (ID, LABEL) VALUES (0, 'old'), (1, 'old'), (2, 'old'), (3, 'old'), (4, 'old'), (5, 'old'), (6, 'old'), (7, 'old'), (8, 'old'), (9, 'old'), (10, 'old'), (11, 'old');
CREATE TABLE HOP_UPD_RBR_TARGET (ID BIGINT NOT NULL PRIMARY KEY, LABEL VARCHAR(20), CONSTRAINT HOP_UPD_RBR_TARGET_ck CHECK (LABEL &lt;&gt; 'bad'));
CREATE TABLE HOP_UPD_RBR_WRITTEN (ID BIGINT, LABEL VARCHAR(20));
CREATE TABLE HOP_UPD_RBR_REJECTS (ID BIGINT, LABEL VARCHAR(20), ERR_DESC NVARCHAR(MAX), ERR_CODE VARCHAR(20));
INSERT INTO HOP_UPD_RBR_TARGET (ID, LABEL) VALUES (0, 'old'), (1, 'old'), (2, 'old'), (3, 'old'), (4, 'old'), (5, 'old'), (6, 'old'), (7, 'old'), (8, 'old'), (9, 'old'), (10, 'old'), (11, 'old');</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>mssql-2022</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0053-update-batch-error-accounting.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0053-update-batch-error-accounting.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>every row on exactly one stream</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>SET NOCOUNT ON;
DECLARE @n BIGINT;
DECLARE @msg NVARCHAR(400);

-- batch updates on: twelve rows went in; twelve rows have to come out on exactly one of the two streams.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_UPD_ERR_WRITTEN UNION ALL SELECT ID FROM HOP_UPD_ERR_REJECTS) s;
IF @n &lt;&gt; 12
BEGIN
  SET @msg = CONCAT('batch updates on: rows on the main output plus rows on the error stream: got ', @n, ', expected 12');
  THROW 51300, @msg, 1;
END;

-- batch updates on: only the three rows the database refused are rejects; the good rows of their commit window are not taken down with them.
SELECT @n = COUNT(*) FROM HOP_UPD_ERR_REJECTS;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: rows on the error stream: got ', @n, ', expected 3');
  THROW 51301, @msg, 1;
END;

-- batch updates on: the rejects are exactly the bad rows: middle of window 1, first of window 2, last of the final partial window.
SELECT @n = COUNT(*) FROM HOP_UPD_ERR_REJECTS WHERE ID IN (2, 5, 11);
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: rejected rows that are the bad rows: got ', @n, ', expected 3');
  THROW 51302, @msg, 1;
END;

-- batch updates on: every reject carries the database's message and the code UPD002 of a row of a batch, so batching stayed on with the error hop.
SELECT @n = COUNT(*) FROM HOP_UPD_ERR_REJECTS WHERE ERR_DESC IS NOT NULL AND ERR_CODE = 'UPD002';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: rejects with a message and code UPD002: got ', @n, ', expected 3');
  THROW 51303, @msg, 1;
END;

-- batch updates on: all nine good rows are reported on the main output, each once.
SELECT @n = COUNT(DISTINCT ID) FROM HOP_UPD_ERR_WRITTEN WHERE ID IN (0, 1, 3, 4, 6, 7, 8, 9, 10);
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch updates on: good rows on the main output: got ', @n, ', expected 9');
  THROW 51304, @msg, 1;
END;

-- batch updates on: no row is reported more than once.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_UPD_ERR_WRITTEN GROUP BY ID HAVING COUNT(*) &gt; 1) d;
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates on: rows on the main output more than once: got ', @n, ', expected 0');
  THROW 51305, @msg, 1;
END;

-- batch updates on: the update neither adds nor removes rows.
SELECT @n = COUNT(*) FROM HOP_UPD_ERR_TARGET;
IF @n &lt;&gt; 12
BEGIN
  SET @msg = CONCAT('batch updates on: rows in the target table: got ', @n, ', expected 12');
  THROW 51306, @msg, 1;
END;

-- batch updates on: the nine good updates are committed.
SELECT @n = COUNT(*) FROM HOP_UPD_ERR_TARGET WHERE ID IN (0, 1, 3, 4, 6, 7, 8, 9, 10) AND LABEL = 'new';
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch updates on: good rows updated in the table: got ', @n, ', expected 9');
  THROW 51307, @msg, 1;
END;

-- batch updates on: the three refused updates left their rows alone.
SELECT @n = COUNT(*) FROM HOP_UPD_ERR_TARGET WHERE ID IN (2, 5, 11) AND LABEL = 'old';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: refused rows still holding their old value: got ', @n, ', expected 3');
  THROW 51308, @msg, 1;
END;

-- batch updates on: no row is reported as updated unless its update is in the table.
SELECT @n = COUNT(*) FROM HOP_UPD_ERR_WRITTEN w WHERE NOT EXISTS (SELECT 1 FROM HOP_UPD_ERR_TARGET x WHERE x.ID = w.ID AND x.LABEL = 'new');
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates on: rows reported as updated that were not updated: got ', @n, ', expected 0');
  THROW 51309, @msg, 1;
END;

-- batch updates off: twelve rows went in; twelve rows have to come out on exactly one of the two streams.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_UPD_RBR_WRITTEN UNION ALL SELECT ID FROM HOP_UPD_RBR_REJECTS) s;
IF @n &lt;&gt; 12
BEGIN
  SET @msg = CONCAT('batch updates off: rows on the main output plus rows on the error stream: got ', @n, ', expected 12');
  THROW 51310, @msg, 1;
END;

-- batch updates off: only the three rows the database refused are rejects; the good rows of their commit window are not taken down with them.
SELECT @n = COUNT(*) FROM HOP_UPD_RBR_REJECTS;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: rows on the error stream: got ', @n, ', expected 3');
  THROW 51311, @msg, 1;
END;

-- batch updates off: the rejects are exactly the bad rows: middle of window 1, first of window 2, last of the final partial window.
SELECT @n = COUNT(*) FROM HOP_UPD_RBR_REJECTS WHERE ID IN (2, 5, 11);
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: rejected rows that are the bad rows: got ', @n, ', expected 3');
  THROW 51312, @msg, 1;
END;

-- batch updates off: every reject carries the database's message and the code UPD001 of a row updated on its own.
SELECT @n = COUNT(*) FROM HOP_UPD_RBR_REJECTS WHERE ERR_DESC IS NOT NULL AND ERR_CODE = 'UPD001';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: rejects with a message and code UPD001: got ', @n, ', expected 3');
  THROW 51313, @msg, 1;
END;

-- batch updates off: all nine good rows are reported on the main output, each once.
SELECT @n = COUNT(DISTINCT ID) FROM HOP_UPD_RBR_WRITTEN WHERE ID IN (0, 1, 3, 4, 6, 7, 8, 9, 10);
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch updates off: good rows on the main output: got ', @n, ', expected 9');
  THROW 51314, @msg, 1;
END;

-- batch updates off: no row is reported more than once.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_UPD_RBR_WRITTEN GROUP BY ID HAVING COUNT(*) &gt; 1) d;
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates off: rows on the main output more than once: got ', @n, ', expected 0');
  THROW 51315, @msg, 1;
END;

-- batch updates off: the update neither adds nor removes rows.
SELECT @n = COUNT(*) FROM HOP_UPD_RBR_TARGET;
IF @n &lt;&gt; 12
BEGIN
  SET @msg = CONCAT('batch updates off: rows in the target table: got ', @n, ', expected 12');
  THROW 51316, @msg, 1;
END;

-- batch updates off: the nine good updates are committed.
SELECT @n = COUNT(*) FROM HOP_UPD_RBR_TARGET WHERE ID IN (0, 1, 3, 4, 6, 7, 8, 9, 10) AND LABEL = 'new';
IF @n &lt;&gt; 9
BEGIN
  SET @msg = CONCAT('batch updates off: good rows updated in the table: got ', @n, ', expected 9');
  THROW 51317, @msg, 1;
END;

-- batch updates off: the three refused updates left their rows alone.
SELECT @n = COUNT(*) FROM HOP_UPD_RBR_TARGET WHERE ID IN (2, 5, 11) AND LABEL = 'old';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: refused rows still holding their old value: got ', @n, ', expected 3');
  THROW 51318, @msg, 1;
END;

-- batch updates off: no row is reported as updated unless its update is in the table.
SELECT @n = COUNT(*) FROM HOP_UPD_RBR_WRITTEN w WHERE NOT EXISTS (SELECT 1 FROM HOP_UPD_RBR_TARGET x WHERE x.ID = w.ID AND x.LABEL = 'new');
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates off: rows reported as updated that were not updated: got ', @n, ', expected 0');
  THROW 51319, @msg, 1;
END;</sql>

        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>every row on exactly one stream</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>SET NOCOUNT ON;
DECLARE @n BIGINT;
DECLARE @msg NVARCHAR(400);

-- batch updates on: fourteen rows went in; fourteen rows have to come out on exactly one of the two streams.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_IU_ERR_WRITTEN UNION ALL SELECT ID FROM HOP_IU_ERR_REJECTS) s;
IF @n &lt;&gt; 14
BEGIN
  SET @msg = CONCAT('batch updates on: fourteen rows went in: got ', @n, ', expected 14');
  THROW 51400, @msg, 1;
END;

-- batch updates on: only the three rows the database refused are rejects; the good rows of their commit window are not taken down with them.
SELECT @n = COUNT(*) FROM HOP_IU_ERR_REJECTS;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: only the three rows the database refused are rejects: got ', @n, ', expected 3');
  THROW 51401, @msg, 1;
END;

-- batch updates on: the rejects are exactly the bad rows: an update in window 1, the first insert of window 2, an insert in the final window.
SELECT @n = COUNT(*) FROM HOP_IU_ERR_REJECTS WHERE ID IN (2, 5, 11) AND LABEL = 'bad';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: the rejects are exactly the bad rows: an update in window 1, the first insert of window 2, an insert in the final window: got ', @n, ', expected 3');
  THROW 51402, @msg, 1;
END;

-- batch updates on: every reject carries the database's message and the code ISU002 of its path.
SELECT @n = COUNT(*) FROM HOP_IU_ERR_REJECTS WHERE ERR_DESC IS NOT NULL AND ERR_CODE = 'ISU002';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates on: every reject carries the database''s message and the code ISU002 of its path: got ', @n, ', expected 3');
  THROW 51403, @msg, 1;
END;

-- batch updates on: the eleven good rows are reported on the main output, each once, id 10 with both of its labels.
SELECT @n = COUNT(*) FROM (SELECT DISTINCT ID, LABEL FROM HOP_IU_ERR_WRITTEN) d;
IF @n &lt;&gt; 11
BEGIN
  SET @msg = CONCAT('batch updates on: the eleven good rows are reported on the main output, each once, id 10 with both of its labels: got ', @n, ', expected 11');
  THROW 51404, @msg, 1;
END;

-- batch updates on: no row is reported more than once.
SELECT @n = COUNT(*) FROM (SELECT ID, LABEL FROM HOP_IU_ERR_WRITTEN GROUP BY ID, LABEL HAVING COUNT(*) &gt; 1) d;
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates on: no row is reported more than once: got ', @n, ', expected 0');
  THROW 51405, @msg, 1;
END;

-- batch updates on: the table holds the six rows it had and the five good inserts, not the two refused ones.
SELECT @n = COUNT(*) FROM HOP_IU_ERR_TARGET;
IF @n &lt;&gt; 11
BEGIN
  SET @msg = CONCAT('batch updates on: the table holds the six rows it had and the five good inserts, not the two refused ones: got ', @n, ', expected 11');
  THROW 51406, @msg, 1;
END;

-- batch updates on: the inserts and updates are committed, id 10 with the label of its second row.
SELECT @n = COUNT(*) FROM HOP_IU_ERR_TARGET WHERE (ID IN (0, 1, 3, 4, 6, 7, 9, 13) AND LABEL = 'new') OR (ID = 8 AND LABEL = 'old') OR (ID = 10 AND LABEL = 'newer');
IF @n &lt;&gt; 10
BEGIN
  SET @msg = CONCAT('batch updates on: the inserts and updates are committed, id 10 with the label of its second row: got ', @n, ', expected 10');
  THROW 51407, @msg, 1;
END;

-- batch updates on: the refused update left its row alone, and the refused inserts added nothing.
SELECT @n = COUNT(*) FROM HOP_IU_ERR_TARGET WHERE (ID = 2 AND LABEL = 'old') OR ID IN (5, 11);
IF @n &lt;&gt; 1
BEGIN
  SET @msg = CONCAT('batch updates on: the refused update left its row alone, and the refused inserts added nothing: got ', @n, ', expected 1');
  THROW 51408, @msg, 1;
END;

-- batch updates on: no row is reported on the main output unless the table holds what it wrote, or a later row of the same id overwrote it.
SELECT @n = COUNT(*) FROM HOP_IU_ERR_WRITTEN w WHERE NOT EXISTS (SELECT 1 FROM HOP_IU_ERR_TARGET x WHERE x.ID = w.ID AND (x.LABEL = w.LABEL OR (w.ID = 10 AND w.LABEL = 'new')));
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates on: no row is reported on the main output unless the table holds what it wrote, or a later row of the same id overwrote it: got ', @n, ', expected 0');
  THROW 51409, @msg, 1;
END;

-- batch updates off: fourteen rows went in; fourteen rows have to come out on exactly one of the two streams.
SELECT @n = COUNT(*) FROM (SELECT ID FROM HOP_IU_RBR_WRITTEN UNION ALL SELECT ID FROM HOP_IU_RBR_REJECTS) s;
IF @n &lt;&gt; 14
BEGIN
  SET @msg = CONCAT('batch updates off: fourteen rows went in: got ', @n, ', expected 14');
  THROW 51410, @msg, 1;
END;

-- batch updates off: only the three rows the database refused are rejects; the good rows of their commit window are not taken down with them.
SELECT @n = COUNT(*) FROM HOP_IU_RBR_REJECTS;
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: only the three rows the database refused are rejects: got ', @n, ', expected 3');
  THROW 51411, @msg, 1;
END;

-- batch updates off: the rejects are exactly the bad rows: an update in window 1, the first insert of window 2, an insert in the final window.
SELECT @n = COUNT(*) FROM HOP_IU_RBR_REJECTS WHERE ID IN (2, 5, 11) AND LABEL = 'bad';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: the rejects are exactly the bad rows: an update in window 1, the first insert of window 2, an insert in the final window: got ', @n, ', expected 3');
  THROW 51412, @msg, 1;
END;

-- batch updates off: every reject carries the database's message and the code ISU001 of its path.
SELECT @n = COUNT(*) FROM HOP_IU_RBR_REJECTS WHERE ERR_DESC IS NOT NULL AND ERR_CODE = 'ISU001';
IF @n &lt;&gt; 3
BEGIN
  SET @msg = CONCAT('batch updates off: every reject carries the database''s message and the code ISU001 of its path: got ', @n, ', expected 3');
  THROW 51413, @msg, 1;
END;

-- batch updates off: the eleven good rows are reported on the main output, each once, id 10 with both of its labels.
SELECT @n = COUNT(*) FROM (SELECT DISTINCT ID, LABEL FROM HOP_IU_RBR_WRITTEN) d;
IF @n &lt;&gt; 11
BEGIN
  SET @msg = CONCAT('batch updates off: the eleven good rows are reported on the main output, each once, id 10 with both of its labels: got ', @n, ', expected 11');
  THROW 51414, @msg, 1;
END;

-- batch updates off: no row is reported more than once.
SELECT @n = COUNT(*) FROM (SELECT ID, LABEL FROM HOP_IU_RBR_WRITTEN GROUP BY ID, LABEL HAVING COUNT(*) &gt; 1) d;
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates off: no row is reported more than once: got ', @n, ', expected 0');
  THROW 51415, @msg, 1;
END;

-- batch updates off: the table holds the six rows it had and the five good inserts, not the two refused ones.
SELECT @n = COUNT(*) FROM HOP_IU_RBR_TARGET;
IF @n &lt;&gt; 11
BEGIN
  SET @msg = CONCAT('batch updates off: the table holds the six rows it had and the five good inserts, not the two refused ones: got ', @n, ', expected 11');
  THROW 51416, @msg, 1;
END;

-- batch updates off: the inserts and updates are committed, id 10 with the label of its second row.
SELECT @n = COUNT(*) FROM HOP_IU_RBR_TARGET WHERE (ID IN (0, 1, 3, 4, 6, 7, 9, 13) AND LABEL = 'new') OR (ID = 8 AND LABEL = 'old') OR (ID = 10 AND LABEL = 'newer');
IF @n &lt;&gt; 10
BEGIN
  SET @msg = CONCAT('batch updates off: the inserts and updates are committed, id 10 with the label of its second row: got ', @n, ', expected 10');
  THROW 51417, @msg, 1;
END;

-- batch updates off: the refused update left its row alone, and the refused inserts added nothing.
SELECT @n = COUNT(*) FROM HOP_IU_RBR_TARGET WHERE (ID = 2 AND LABEL = 'old') OR ID IN (5, 11);
IF @n &lt;&gt; 1
BEGIN
  SET @msg = CONCAT('batch updates off: the refused update left its row alone, and the refused inserts added nothing: got ', @n, ', expected 1');
  THROW 51418, @msg, 1;
END;

-- batch updates off: no row is reported on the main output unless the table holds what it wrote, or a later row of the same id overwrote it.
SELECT @n = COUNT(*) FROM HOP_IU_RBR_WRITTEN w WHERE NOT EXISTS (SELECT 1 FROM HOP_IU_RBR_TARGET x WHERE x.ID = w.ID AND (x.LABEL = w.LABEL OR (w.ID = 10 AND w.LABEL = 'new')));
IF @n &lt;&gt; 0
BEGIN
  SET @msg = CONCAT('batch updates off: no row is reported on the main output unless the table holds what it wrote, or a later row of the same id overwrote it: got ', @n, ', expected 0');
  THROW 51419, @msg, 1;
END;</sql>

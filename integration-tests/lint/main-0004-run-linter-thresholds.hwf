<workflow>
  <name>main-0004-run-linter-thresholds</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #8826: the Run Linter action fails on Fail on and Max warnings, honours a config file and a baseline, and fails on a broken config file or a missing folder. Each action that should fail leads on through its failure hop; its success hop aborts the workflow.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/09 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/09 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>96</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Fail on Error fails</name>
      <description>broken.hpl is an error, so Fail on Error fails the action.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/findings</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>ERROR</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file/>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Max warnings 0 fails</name>
      <description>One warning is more than Max warnings 0.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/findings</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings>0</max_warnings>
      <baseline_file/>
      <report_file/>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Max warnings 1 passes</name>
      <description>One warning is not more than Max warnings 1.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/findings</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings>1</max_warnings>
      <baseline_file/>
      <report_file/>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>A broken config file fails</name>
      <description>A config file that is not valid YAML fails the action with the parser's error, rather than linting with the default rules.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/findings</target>
      <include_metadata>Y</include_metadata>
      <config_file>${PROJECT_HOME}/files/run-linter-broken.yml</config_file>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file/>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>A config file replaces the project's</name>
      <description>run-linter-no-docs.yml switches DOC-001 off again, so there is no warning left.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/findings</target>
      <include_metadata>Y</include_metadata>
      <config_file>${PROJECT_HOME}/files/run-linter-no-docs.yml</config_file>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings>0</max_warnings>
      <baseline_file/>
      <report_file/>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Write a baseline with hop lint</name>
      <description>hop lint --write-baseline over run-linter/findings, for the next action.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Note on ${} below: Hop resolves its own variables in this script before running it, so only Hop
# variables are written with braces. Shell variables are written without them.

set -u

PROJECT_DIR="${PROJECT_HOME}"

# hop-run.sh and hop-gui.sh both start the JVM from the Hop installation, so ${user.dir} is the
# install folder: /opt/hop in the test image, the client folder when run from Hop GUI.
HOP_CLI="${user.dir}/hop"
if [ ! -x "$HOP_CLI" ]; then
  echo "FAIL: no hop CLI at $HOP_CLI, so the action cannot be compared with hop lint."
  exit 1
fi
export HOP_CONFIG_FOLDER="$PROJECT_DIR"
mkdir -p "$PROJECT_DIR/output"

# Accept today's findings in run-linter/findings, the way a team adopting the linter would.
BASELINE="$PROJECT_DIR/output/run-linter-baseline.json"
rm -f "$BASELINE"
"$HOP_CLI" lint "$PROJECT_DIR/run-linter/findings" --write-baseline "$BASELINE"
rc=$?
if [ $rc -ne 0 ] || [ ! -s "$BASELINE" ]; then
  echo "FAIL: hop lint --write-baseline did not write $BASELINE (exit code $rc)"
  exit 1
fi
echo "Wrote $BASELINE"
exit 0
</script>
      <loglevel>Basic</loglevel>
      <nr>0</nr>
      <parallel>N</parallel>
      <xloc>1248</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>A baseline accepts the findings</name>
      <description>Every finding is in the baseline written by hop lint, so even Fail on Warning passes.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/findings</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>WARNING</fail_on>
      <max_warnings/>
      <baseline_file>${PROJECT_HOME}/output/run-linter-baseline.json</baseline_file>
      <report_file/>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>1440</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>A clean folder passes</name>
      <description>A documented pipeline and the default rules: no findings.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/clean</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>WARNING</fail_on>
      <max_warnings>0</max_warnings>
      <baseline_file/>
      <report_file/>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>1632</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>A missing folder fails</name>
      <description>There is nothing to lint, which is an error rather than a clean run.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/no-such-folder</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file/>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>1824</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>2016</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Should have failed</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>A Run Linter action that should have failed succeeded. The log shows which one.</message>
      <parallel>N</parallel>
      <xloc>1008</xloc>
      <yloc>272</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Fail on Error fails</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Fail on Error fails</from>
      <to>Should have failed</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>

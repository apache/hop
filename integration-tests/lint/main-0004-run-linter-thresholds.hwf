      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>A config file replaces the project's</from>
      <to>Write a baseline with hop lint</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>

      <to>Max warnings 1 passes</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Max warnings 1 passes</from>
      <to>A broken config file fails</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>A broken config file fails</from>
      <to>Should have failed</to>
      <enabled>Y</enabled>

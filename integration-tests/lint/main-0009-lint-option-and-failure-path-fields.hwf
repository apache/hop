<workflow>
  <name>main-0009-lint-option-and-failure-path-fields</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #9500: HAS_OPTION and OPTION_MATCHES on connection attributes, url, appliesTo by database type, category on transforms and actionsWithoutFailurePath on workflows.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/21 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/21 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Lint the options folder</name>
      <description/>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/options</target>
      <include_metadata>N</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file>${PROJECT_HOME}/output/options-findings.json</report_file>
      <report_format>JSON</report_format>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Lint the connections</name>
      <description/>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/metadata/rdbms</target>
      <include_metadata>Y</include_metadata>
      <config_file>${PROJECT_HOME}/options/hop-lint.yml</config_file>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file>${PROJECT_HOME}/output/options-connections.json</report_file>
      <report_format>JSON</report_format>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the findings</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Note on ${} below: Hop resolves its own variables in this script before running it, so only Hop
# variables are written with braces. Shell variables are written without them, and the Python
# below uses none.

set -u

PROJECT_DIR="${PROJECT_HOME}"

# hop-run.sh and hop-gui.sh both start the JVM from the Hop installation, so ${user.dir} is the
# install folder: /opt/hop in the test image, the client folder when run from Hop GUI.
HOP_CLI="${user.dir}/hop"
if [ ! -x "$HOP_CLI" ]; then
  echo "FAIL: no hop CLI at $HOP_CLI"
  exit 1
fi
export HOP_CONFIG_FOLDER="$PROJECT_DIR"
mkdir -p "$PROJECT_DIR/output"

# Issue #9500, part 5: the option conditions read a connection's attributes as options, url is the
# URL Hop builds, appliesTo narrows a connection rule by database type, category is the transform's
# category in English and actionsWithoutFailurePath lists the actions a workflow does not follow
# on failure. The rules are in options/hop-lint.yml.
#
# The connections are the project's own, PG_TLS, PG_PLAIN and PG_MANUAL among them: the linter
# reads a connection file through the project's metadata. CRM, OPS and Vault are H2 connections,
# which appliesTo: [POSTGRESQL] leaves alone.

REPORT="$PROJECT_DIR/output/options-findings.json"
CONNECTIONS_REPORT="$PROJECT_DIR/output/options-connections.json"
for report in "$REPORT" "$CONNECTIONS_REPORT"; do
  if [ ! -s "$report" ]; then
    echo "FAIL: the action wrote no report at $report"
    exit 1
  fi
done

python3 - "$REPORT" "$CONNECTIONS_REPORT" &lt;&lt;'PY'
import json
import sys

findings = []
for path in sys.argv[1:3]:
    with open(path) as f:
        findings.extend(json.load(f)["findings"])
failures = []


def sources(rule_id):
    return sorted((finding.get("source") or {}).get("name") for finding in findings if finding["ruleId"] == rule_id)


def messages(rule_id):
    return [finding["message"] for finding in findings if finding["ruleId"] == rule_id]


def expect(label, actual, expected):
    if actual != expected:
        failures.append(label)
        print("FAIL: " + label + ": expected " + repr(expected) + ", got " + repr(actual))
    else:
        print("OK: " + label + " = " + repr(actual))


expect("PostgreSQL connections without sslmode in their options", sources("OPT-001"), ["PG_MANUAL", "PG_PLAIN"])
expect("PostgreSQL connections with TLS in neither the options nor the URL", sources("OPT-002"), ["PG_PLAIN"])
expect("every connection could be read", sources("SYSTEM-003"), [])
expect("Output transforms", sources("OPT-003"), ["Write the file"])
expect("workflows with actions that stop unhandled", sources("OPT-004"), ["failure-paths"])
opt_messages = [m for rule in ["OPT-001", "OPT-002", "OPT-003", "OPT-004"] for m in messages(rule)]
expect("no finding shows a connection URL", [m for m in opt_messages if "jdbc:" in m], [])
opt004 = messages("OPT-004")
expect("the finding names the action without a failure hop", len(opt004) == 1 and "[Check the input]" in opt004[0], True)

if failures:
    print(str(len(failures)) + " check(s) failed.")
    sys.exit(1)
print("All checks passed.")
PY
</script>
      <loglevel>Basic</loglevel>
      <nr>0</nr>
      <parallel>N</parallel>
      <xloc>592</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>768</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Lint the options folder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Lint the options folder</from>
      <to>Lint the connections</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Lint the connections</from>
      <to>Check the findings</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check the findings</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

{
  "rdbms": {
    "POSTGRESQL": {
      "databaseName": "sales",
      "pluginId": "POSTGRESQL",
      "accessType": 0,
      "hostname": "db.example.org",
      "password": "${PG_PASSWORD}",
      "pluginName": "PostgreSQL",
      "port": "5432",
      "attributes": {
        "SUPPORTS_TIMESTAMP_DATA_TYPE": "Y",
        "QUOTE_ALL_FIELDS": "N",
        "SUPPORTS_BOOLEAN_DATA_TYPE": "Y",
        "FORCE_IDENTIFIERS_TO_LOWERCASE": "N",
        "PRESERVE_RESERVED_WORD_CASE": "Y",
        "SQL_CONNECT": "",
        "FORCE_IDENTIFIERS_TO_UPPERCASE": "N",
        "PREFERRED_SCHEMA_NAME": ""
      },
      "manualUrl": "jdbc:postgresql://${PG_HOST}:5432/sales?sslmode=require",
      "username": "${PG_USER}"
    }
  },
  "name": "PG_MANUAL"
}

<workflow>
  <name>main-0007-lint-sarif-rules-and-run</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #9500: SARIF from hop lint and the Run Linter action declares every enabled rule, also those that found nothing, and records the run in runs[0].invocations.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/21 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/21 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Lint the clean folder to SARIF</name>
      <description/>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/clean</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file>${PROJECT_HOME}/output/sarif-clean-action.sarif</report_file>
      <report_format>SARIF</report_format>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the SARIF report</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Note on ${} below: Hop resolves its own variables in this script before running it, so only Hop
# variables are written with braces. Shell variables are written without them, and the Python
# below uses none.

set -u

PROJECT_DIR="${PROJECT_HOME}"

# hop-run.sh and hop-gui.sh both start the JVM from the Hop installation, so ${user.dir} is the
# install folder: /opt/hop in the test image, the client folder when run from Hop GUI.
HOP_CLI="${user.dir}/hop"
if [ ! -x "$HOP_CLI" ]; then
  echo "FAIL: no hop CLI at $HOP_CLI"
  exit 1
fi
export HOP_CONFIG_FOLDER="$PROJECT_DIR"
mkdir -p "$PROJECT_DIR/output"

# Issue #9500, part 1: SARIF declared only the rules that found something, and nothing about the
# run, so a rule that ran and found nothing read the same as one that was switched off. Both
# hop lint and the Run Linter action now declare every enabled rule, as --list-rules lists them,
# and record the run in runs[0].invocations.

ACTION_REPORT="$PROJECT_DIR/output/sarif-clean-action.sarif"
CLI_REPORT="$PROJECT_DIR/output/sarif-clean-cli.sarif"
RULE_LIST="$PROJECT_DIR/output/sarif-clean-rules.txt"

if [ ! -s "$ACTION_REPORT" ]; then
  echo "FAIL: the action wrote no report at $ACTION_REPORT"
  exit 1
fi

rm -f "$CLI_REPORT"
"$HOP_CLI" lint "$PROJECT_DIR/run-linter/clean" --fail-on NONE --format sarif --output "$CLI_REPORT"
rc=$?
if [ $rc -ne 0 ]; then
  echo "FAIL: hop lint exited with $rc"
  exit 1
fi
"$HOP_CLI" lint --list-rules "$PROJECT_DIR/run-linter/clean" &gt; "$RULE_LIST" 2&gt;/dev/null

# A configuration file outside the folder linted is recorded relative to it, not as a local path.
CONFIG_REPORT="$PROJECT_DIR/output/sarif-clean-config.sarif"
rm -f "$CONFIG_REPORT"
"$HOP_CLI" lint "$PROJECT_DIR/run-linter/clean" --fail-on NONE --format sarif   --config "$PROJECT_DIR/files/run-linter-no-docs.yml" --output "$CONFIG_REPORT"

python3 - "$ACTION_REPORT" "$CLI_REPORT" "$RULE_LIST" "$CONFIG_REPORT" "$PROJECT_DIR" &lt;&lt;'PY'
import json
import os
import sys

action_path, cli_path, rules_path, config_path, project_dir = sys.argv[1:6]
failures = []


def expect(label, actual, expected):
    if actual != expected:
        failures.append(label)
        print("FAIL: " + label + ": expected " + repr(expected) + ", got " + repr(actual))
    else:
        shown = repr(actual)
        print("OK: " + label + " = " + (shown if len(shown) &lt;= 120 else shown[:117] + "..."))


with open(action_path) as f:
    action = json.load(f)["runs"][0]
with open(cli_path) as f:
    cli = json.load(f)["runs"][0]

enabled = []
with open(rules_path) as f:
    for line in f:
        columns = line.split()
        if len(columns) &gt; 1 and columns[1] == "enabled":
            enabled.append(columns[0])

declared = [rule["id"] for rule in cli["tool"]["driver"]["rules"]]
print("--list-rules shows " + str(len(enabled)) + " enabled rules; SARIF declares " + str(len(declared)))
expect("some rules are enabled", len(enabled) &gt; 0, True)
expect("SARIF declares every enabled rule, in order", declared[: len(enabled)], enabled)
expect("SEC-002 is declared without a finding", "SEC-002" in declared, True)

for result in cli["results"]:
    expect(
        "the finding of " + result["ruleId"] + " points at its rule",
        declared[result["ruleIndex"]],
        result["ruleId"],
    )

invocations = cli.get("invocations", [])
expect("one invocation", len(invocations), 1)
if invocations:
    invocation = invocations[0]
    properties = invocation.get("properties", {})
    expect("executionSuccessful", invocation.get("executionSuccessful"), True)
    expect("exitCode", invocation.get("exitCode"), 0)
    expect("failOn", properties.get("failOn"), "NONE")
    expect("severity", properties.get("severity"), "INFO")
    expect("includeMetadata", properties.get("includeMetadata"), True)
    core = [pack for pack in properties.get("rulePacks", []) if pack.get("id") == "hop-core"]
    expect("the core pack is listed", len(core), 1)
    if core:
        expect(
            "the core pack has Hop's version",
            core[0].get("version"),
            cli["tool"]["driver"].get("version"),
        )

with open(config_path) as f:
    config_text = f.read()
config_run = json.loads(config_text)["runs"][0]
expect(
    "a --config file outside the folder linted",
    config_run["invocations"][0]["properties"].get("configFile"),
    "../../files/run-linter-no-docs.yml",
)
for label, path in [("action", action_path), ("hop lint", cli_path), ("--config", config_path)]:
    with open(path) as f:
        text = f.read()
    leaked = [folder for folder in {project_dir, os.path.normpath(project_dir)} if folder in text]
    expect("the " + label + " report names no local folder", leaked, [])

expect("the action declares the same rules as hop lint", action["tool"], cli["tool"])
expect("the action records the same run as hop lint", action.get("invocations"), cli.get("invocations"))

if failures:
    print(str(len(failures)) + " check(s) failed.")
    sys.exit(1)
print("All checks passed.")
PY
</script>
      <loglevel>Basic</loglevel>
      <nr>0</nr>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Lint the clean folder to SARIF</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Lint the clean folder to SARIF</from>
      <to>Check the SARIF report</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check the SARIF report</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

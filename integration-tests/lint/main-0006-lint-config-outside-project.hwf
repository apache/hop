<workflow>
  <name>main-0006-lint-config-outside-project</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #9387: a hop-lint.yml above a project's root is not used for that project, and its exclude paths do not apply to it.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/08 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/08 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>96</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Lint the nested project</name>
      <description>outside-project/project has its own project-config.json and no hop-lint.yml. The one in outside-project, above it, switches on DOC-001 and excludes orphan.hpl. Fail on None, so the action succeeds, and writes a JSON report.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/outside-project/project</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file>${PROJECT_HOME}/output/outside-project.json</report_file>
      <report_format>JSON</report_format>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the findings</name>
      <description>TRANS-002 on orphan.hpl (linted) and no DOC-001 (it stays off), from the action and from hop lint on each file.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}/outside-project</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Note on ${} below: Hop resolves its own variables in this script before running it, so only Hop
# variables are written with braces. Shell variables are written without them.

set -u

PROJECT_DIR="${PROJECT_HOME}"
NESTED="$PROJECT_DIR/outside-project/project"

failures=0

# $1 label, $2 actual, $3 expected
expect() {
  if [ "$2" != "$3" ]; then
    echo "FAIL: $1: expected '$3', got '$2'"
    failures=$((failures + 1))
  else
    echo "OK: $1 = $2"
  fi
}

echo "=== The Run Linter action ignores the hop-lint.yml above the project ==="
# With it: one warning, DOC-001 on undocumented.hpl, and orphan.hpl excluded. Without it: the four
# warnings on orphan.hpl, TRANS-002 and three HOP-CHECK remarks on its transform with no hops.
expect "LINT_ERRORS" "${LINT_ERRORS}" "0"
expect "LINT_WARNINGS" "${LINT_WARNINGS}" "4"

REPORT="$PROJECT_DIR/output/outside-project.json"
if [ ! -s "$REPORT" ]; then
  echo "FAIL: the action wrote no report at $REPORT"
  exit 1
fi
expect "TRANS-002 findings" "$(grep -cF '"ruleId" : "TRANS-002"' "$REPORT")" "1"
expect "DOC-001 findings" "$(grep -cF '"ruleId" : "DOC-001"' "$REPORT")" "0"

echo "=== hop lint on one file of the project does the same ==="
# hop-run.sh starts the JVM from the Hop installation, so ${user.dir} is the install folder.
HOP_CLI="${user.dir}/hop"
if [ ! -x "$HOP_CLI" ]; then
  echo "FAIL: no hop CLI at $HOP_CLI"
  exit 1
fi
export HOP_CONFIG_FOLDER="$PROJECT_DIR"

# DOC-001 is off in the core pack: no warning, so --fail-on WARNING passes.
"$HOP_CLI" lint "$NESTED/undocumented.hpl" --fail-on WARNING --format json \
  --output "$PROJECT_DIR/output/outside-project-undocumented.json"
expect "hop lint undocumented.hpl --fail-on WARNING exit code" "$?" "0"

# The exclude above the project does not apply: orphan.hpl is linted, and TRANS-002 fails the run.
"$HOP_CLI" lint "$NESTED/orphan.hpl" --fail-on WARNING --format json \
  --output "$PROJECT_DIR/output/outside-project-orphan.json"
expect "hop lint orphan.hpl --fail-on WARNING exit code" "$?" "1"

if [ $failures -gt 0 ]; then
  echo "$failures check(s) failed."
  exit 1
fi
echo "All checks passed."
exit 0
</script>
      <loglevel>Basic</loglevel>
      <nr>0</nr>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Lint the nested project</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Lint the nested project</from>
      <to>Check the findings</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check the findings</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

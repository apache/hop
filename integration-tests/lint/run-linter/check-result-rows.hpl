<pipeline>
  <info>
    <name>check-result-rows</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Issue #8826: reads the rows the Run Linter action left in the result, one per finding, and aborts unless they are the two findings of run-linter/findings.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/09 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/09 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Get findings from result</from>
      <to>Expected rule?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Expected rule?</from>
      <to>Count findings</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Expected rule?</from>
      <to>Unexpected finding: abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count findings</from>
      <to>findings != 2?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>findings != 2?</from>
      <to>Wrong number of findings: abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Get findings from result</name>
    <type>RowsFromResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>severity</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>rule_id</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>rule_name</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>message</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>file</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>element_type</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>element_name</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Expected rule?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Count findings</send_true_to>
    <send_false_to>Unexpected finding: abort</send_false_to>
    <compare>
      <condition>
        <leftvalue>rule_id</leftvalue>
        <operator>-</operator>
        <negated>N</negated>
        <conditions>
</conditions>
        <function>IN LIST</function>
        <value>
          <name>constant</name>
          <length>-1</length>
          <text>SYSTEM-001;DOC-001</text>
          <isnull>N</isnull>
          <type>String</type>
          <mask/>
          <precision>-1</precision>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Unexpected finding: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>The Run Linter action returned a finding other than SYSTEM-001 (broken.hpl) and DOC-001 (undocumented.hpl).</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Count findings</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>Y</give_back_row>
    <group>
</group>
    <fields>
      <field>
        <aggregate>findings</aggregate>
        <subject>rule_id</subject>
        <type>COUNT_ANY</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>findings != 2?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Wrong number of findings: abort</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <leftvalue>findings</leftvalue>
        <operator>-</operator>
        <negated>Y</negated>
        <conditions>
</conditions>
        <function>=</function>
        <value>
          <name>constant</name>
          <length>-1</length>
          <text>2</text>
          <isnull>N</isnull>
          <type>Integer</type>
          <mask>####0;-####0</mask>
          <precision>0</precision>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wrong number of findings: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>The Run Linter action should return one result row per finding: two for run-linter/findings.</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

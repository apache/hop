<workflow>
  <name>main-0008-lint-secrets-stored-as-passwords</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #9500: SEC-002 and SEC-003 report the fields Hop stores as passwords, private keys and connection strings, and not the Kinesis stream name.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/21 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/21 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Lint the secrets folder</name>
      <description/>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/secrets</target>
      <include_metadata>N</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file>${PROJECT_HOME}/output/secrets-findings.json</report_file>
      <report_format>JSON</report_format>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the findings</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Note on ${} below: Hop resolves its own variables in this script before running it, so only Hop
# variables are written with braces. Shell variables are written without them, and the Python
# below uses none.

set -u

PROJECT_DIR="${PROJECT_HOME}"

# hop-run.sh and hop-gui.sh both start the JVM from the Hop installation, so ${user.dir} is the
# install folder: /opt/hop in the test image, the client folder when run from Hop GUI.
HOP_CLI="${user.dir}/hop"
if [ ! -x "$HOP_CLI" ]; then
  echo "FAIL: no hop CLI at $HOP_CLI"
  exit 1
fi
export HOP_CONFIG_FOLDER="$PROJECT_DIR"
mkdir -p "$PROJECT_DIR/output"

# Issue #9500, part 4: SEC-002 and SEC-003 matched field names only, so secrets Hop stores as
# passwords under other names were missed: Event Hubs' sasKey, Beam Snowflake's privateKey, the
# AWS transforms' awsKey and FTP Delete's keyFilePass, and the storage connection string of the
# Event Hubs Listener. The Kinesis stream name, which Hop used to mark as a password, is not a
# secret and is not reported.

REPORT="$PROJECT_DIR/output/secrets-findings.json"
if [ ! -s "$REPORT" ]; then
  echo "FAIL: the action wrote no report at $REPORT"
  exit 1
fi

python3 - "$REPORT" &lt;&lt;'PY'
import json
import sys

with open(sys.argv[1]) as f:
    report = f.read()
findings = json.loads(report)["findings"]
failures = []


def count(rule_id, source, field=None):
    matched = 0
    for finding in findings:
        if finding["ruleId"] != rule_id:
            continue
        if (finding.get("source") or {}).get("name") != source:
            continue
        if field is not None and "in field '" + field + "'" not in finding["message"]:
            continue
        matched += 1
    return matched


def expect(label, actual, expected):
    if actual != expected:
        failures.append(label)
        print("FAIL: " + label + ": expected " + repr(expected) + ", got " + repr(actual))
    else:
        print("OK: " + label + " = " + repr(actual))


expect("Event Hubs SAS key", count("SEC-002", "Event Hubs SAS key", "sasKey"), 1)
expect("Event Hubs SAS key from a variable", count("SEC-002", "Event Hubs SAS key from a variable"), 0)
expect(
    "Event Hubs storage connection string",
    count("SEC-002", "Event Hubs storage connection string", "storageConnectionString"),
    1,
)
expect("Snowflake private key", count("SEC-002", "Snowflake private key", "privateKey"), 1)
expect("SNS access key", count("SEC-002", "SNS access key", "awsKey"), 1)
expect("Kinesis stream name", count("SEC-002", "Kinesis stream"), 0)
expect("FTP Delete key file passphrase", count("SEC-003", "Delete with a key file", "keyFilePass"), 1)
expect(
    "FTP Delete passphrase from a variable",
    count("SEC-003", "Delete with a key file from a variable"),
    0,
)

for secret in ["c2FzLWtleQ", "MIIEvQIBADANBgkq", "AKIAIOSFODNN7EXAMPLE", "AccountKey=a2V5", "key-file-pass"]:
    expect("the report does not show " + secret, secret in report, False)

if failures:
    print(str(len(failures)) + " check(s) failed.")
    sys.exit(1)
print("All checks passed.")
PY
</script>
      <loglevel>Basic</loglevel>
      <nr>0</nr>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Lint the secrets folder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Lint the secrets folder</from>
      <to>Check the findings</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check the findings</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

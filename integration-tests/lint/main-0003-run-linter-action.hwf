<workflow>
  <name>main-0003-run-linter-action</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #8826: the Run Linter action returns one row per finding, sets LINT_ERRORS, LINT_WARNINGS, LINT_INFOS and LINT_REPORT_FILE, and gives the same report and outcome as hop lint.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/09 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/09 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>96</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Lint the findings folder</name>
      <description>One error (broken.hpl) and one warning (undocumented.hpl). Fail on None, so the action succeeds, and writes a JSON report.</description>
      <type>RUN_LINTER</type>
      <attributes/>
      <target>${PROJECT_HOME}/run-linter/findings</target>
      <include_metadata>Y</include_metadata>
      <config_file/>
      <minimum_severity>INFO</minimum_severity>
      <fail_on>NONE</fail_on>
      <max_warnings/>
      <baseline_file/>
      <report_file>${PROJECT_HOME}/output/run-linter-findings.json</report_file>
      <report_format>JSON</report_format>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the result rows</name>
      <description>One result row per finding: SYSTEM-001 and DOC-001.</description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/run-linter/check-result-rows.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check the variables and compare with hop lint</name>
      <description>LINT_ERRORS, LINT_WARNINGS, LINT_INFOS and LINT_REPORT_FILE, and the same report and exit code from hop lint on the same folder.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
# Note on ${} below: Hop resolves its own variables in this script before running it, so only Hop
# variables are written with braces. Shell variables are written without them.

set -u

PROJECT_DIR="${PROJECT_HOME}"

# hop-run.sh and hop-gui.sh both start the JVM from the Hop installation, so ${user.dir} is the
# install folder: /opt/hop in the test image, the client folder when run from Hop GUI.
HOP_CLI="${user.dir}/hop"
if [ ! -x "$HOP_CLI" ]; then
  echo "FAIL: no hop CLI at $HOP_CLI, so the action cannot be compared with hop lint."
  exit 1
fi
export HOP_CONFIG_FOLDER="$PROJECT_DIR"
mkdir -p "$PROJECT_DIR/output"

failures=0

# $1 label, $2 actual, $3 expected
expect() {
  if [ "$2" != "$3" ]; then
    echo "FAIL: $1: expected '$3', got '$2'"
    failures=$((failures + 1))
  else
    echo "OK: $1 = $2"
  fi
}

echo "=== The variables the action sets for the actions that follow ==="
ACTION_REPORT="$PROJECT_DIR/output/run-linter-findings.json"
expect "LINT_ERRORS" "${LINT_ERRORS}" "1"
expect "LINT_WARNINGS" "${LINT_WARNINGS}" "1"
expect "LINT_INFOS" "${LINT_INFOS}" "0"
expect "LINT_REPORT_FILE" "${LINT_REPORT_FILE}" "$ACTION_REPORT"

if [ ! -s "$ACTION_REPORT" ]; then
  echo "FAIL: the action wrote no report at $ACTION_REPORT"
  exit 1
fi

echo "=== hop lint gives the same findings and the same outcome ==="
CLI_REPORT="$PROJECT_DIR/output/run-linter-findings-cli.json"
rm -f "$CLI_REPORT"
"$HOP_CLI" lint "$PROJECT_DIR/run-linter/findings" --fail-on NONE --format json --output "$CLI_REPORT"
expect "hop lint --fail-on NONE exit code" "$?" "0"
if diff "$CLI_REPORT" "$ACTION_REPORT"; then
  echo "OK: the hop lint report and the action report are identical"
else
  echo "FAIL: the hop lint report (&lt;) and the action report (&gt;) differ"
  failures=$((failures + 1))
fi

# The action fails on the error with Fail on ERROR (main-0004); hop lint exits 1 on it.
"$HOP_CLI" lint "$PROJECT_DIR/run-linter/findings" --fail-on ERROR --format json --output "$CLI_REPORT"
expect "hop lint --fail-on ERROR exit code" "$?" "1"

if [ $failures -gt 0 ]; then
  echo "$failures check(s) failed."
  exit 1
fi
echo "All checks passed."
exit 0
</script>
      <loglevel>Basic</loglevel>
      <nr>0</nr>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Lint the findings folder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Lint the findings folder</from>
      <to>Check the result rows</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check the result rows</from>
      <to>Check the variables and compare with hop lint</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check the variables and compare with hop lint</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

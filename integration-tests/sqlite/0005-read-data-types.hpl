<pipeline>
  <info>
    <name>0005-read-data-types</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads one column of every declared type a SQLite table is likely to carry, values and nulls, and compares each with the text it should render as. Guards the date handling of issue #3910 against costing any other type its reading.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/21 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/21 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>read every type</from>
      <to>values to text</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>values to text</from>
      <to>null marker</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>null marker</from>
      <to>values match?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>values match?</from>
      <to>count rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>values match?</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count rows</from>
      <to>all rows read?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>all rows read?</from>
      <to>success</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>all rows read?</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>read every type</name>
    <type>TableInput</type>
    <description>One column per declared type a SQLite table is likely to carry, each next to the text it should render as once Hop has read it.

The last two are expressions rather than columns of the table. The driver types those from the first row it sees, and it saw a value in both, so they have to keep the type it gave them: reading every expression as a string would be as wrong as reading a date as a number.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sqlite</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT id
, t_string, t_varchar, t_char
, t_integer, t_bigint, t_number, t_double, t_bignumber, t_numeric
, t_boolean
, t_date, t_datetime, t_timestamp
, t_binary
, x_string, x_varchar, x_char
, x_integer, x_bigint, x_number, x_double, x_bignumber, x_numeric
, x_boolean
, x_date, x_datetime, x_timestamp
, x_binary
, t_integer * 2 AS e_number
, t_string || ' x' AS e_text
, CASE WHEN id = 1 THEN '84' ELSE '&lt;null&gt;' END AS x_e_number
, CASE WHEN id = 1 THEN 'text value x' ELSE '&lt;null&gt;' END AS x_e_text
FROM data_types
ORDER BY id</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>values to text</name>
    <type>SelectValues</type>
    <description>Renders what Hop read back to text. Every numeric conversion names its decimal symbol, so the comparison does not depend on the platform locale.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>t_integer</name>
        <rename>t_integer</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>0</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_bigint</name>
        <rename>t_bigint</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>0</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_number</name>
        <rename>t_number</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>0.0#########</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_double</name>
        <rename>t_double</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>0.0#########</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_bignumber</name>
        <rename>t_bignumber</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>0.0#####</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_numeric</name>
        <rename>t_numeric</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>0</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_boolean</name>
        <rename>t_boolean</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask/>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_date</name>
        <rename>t_date</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_datetime</name>
        <rename>t_datetime</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>t_timestamp</name>
        <rename>t_timestamp</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd HH:mm:ss.SSS</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
      <meta>
        <name>e_number</name>
        <rename>e_number</rename>
        <type>String</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>0</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
    </fields>
    <attributes/>
    <GUI>
      <xloc>272</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>null marker</name>
    <type>IfNull</type>
    <description>The expected columns spell a NULL out as &lt;null&gt;, so the null row takes part in the comparison.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <replaceAllByValue/>
    <replaceAllMask/>
    <selectFields>Y</selectFields>
    <selectValuesType>N</selectValuesType>
    <setEmptyStringAll>N</setEmptyStringAll>
    <valuetypes>
      </valuetypes>
    <fields>
      <field>
        <name>t_string</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_varchar</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_char</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_integer</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_bigint</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_number</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_double</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_bignumber</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_numeric</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_boolean</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_date</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>t_datetime</name>
        <value>&lt;null&gt;</value>
        <mask/>
        <set_empty_string>N</set_empty_string>

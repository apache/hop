    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>values match?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>count rows</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>t_string</leftvalue>
            <function>=</function>
            <rightvalue>x_string</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_varchar</leftvalue>
            <function>=</function>
            <rightvalue>x_varchar</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_char</leftvalue>
            <function>=</function>
            <rightvalue>x_char</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_integer</leftvalue>
            <function>=</function>
            <rightvalue>x_integer</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_bigint</leftvalue>
            <function>=</function>
            <rightvalue>x_bigint</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_number</leftvalue>
            <function>=</function>
            <rightvalue>x_number</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_double</leftvalue>
            <function>=</function>
            <rightvalue>x_double</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_bignumber</leftvalue>
            <function>=</function>
            <rightvalue>x_bignumber</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_numeric</leftvalue>
            <function>=</function>
            <rightvalue>x_numeric</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_boolean</leftvalue>
            <function>=</function>
            <rightvalue>x_boolean</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_date</leftvalue>
            <function>=</function>
            <rightvalue>x_date</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_datetime</leftvalue>
            <function>=</function>
            <rightvalue>x_datetime</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_timestamp</leftvalue>
            <function>=</function>
            <rightvalue>x_timestamp</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>t_binary</leftvalue>
            <function>=</function>
            <rightvalue>x_binary</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>e_number</leftvalue>
            <function>=</function>
            <rightvalue>x_e_number</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>e_text</leftvalue>
            <function>=</function>
            <rightvalue>x_e_text</rightvalue>
          </condition>
        </conditions>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>624</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>count rows</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <add_linenr>N</add_linenr>
    <all_rows>N</all_rows>
    <directory>${java.io.tmpdir}</directory>
    <fields>
      <field>
        <aggregate>nr_rows</aggregate>
        <subject>id</subject>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
    </fields>
    <give_back_row>N</give_back_row>
    <group>
</group>
    <ignore_aggregate>N</ignore_aggregate>
    <linenr_fieldname/>
    <prefix>grp</prefix>
    <attributes/>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>all rows read?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>success</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>nr_rows</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>2</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>976</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>success</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>1152</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <message>A SQLite column type was not read back as the value SQLite holds.</message>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>800</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

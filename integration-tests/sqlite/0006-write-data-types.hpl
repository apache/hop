<pipeline>
  <info>
    <name>0006-write-data-types</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Writes one value of every Hop type into SQLite so 0007 can read them back. Issue #3910.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/21 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/21 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>one value of every type</from>
      <to>write every type</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>one value of every type</name>
    <type>DataGrid</type>
    <description>One value of every Hop type Table Output can put in a SQLite column, each next to the text it should render as once it has been read back. Row 2 writes a null of every type.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>1</item>
        <item>text value</item>
        <item>42</item>
        <item>2.5</item>
        <item>12345.6789</item>
        <item>Y</item>
        <item>2024-05-16</item>
        <item>2024-05-16 10:11:12.123</item>
        <item>Hello</item>
        <item>text value</item>
        <item>42</item>
        <item>2.5</item>
        <item>12345.6789</item>
        <item>Y</item>
        <item>2024-05-16</item>
        <item>2024-05-16 10:11:12.123</item>
        <item>Hello</item>
      </line>
      <line>
        <item>2</item>
        <item/>
        <item/>
        <item/>
        <item/>
        <item/>
        <item/>
        <item/>
        <item/>
        <item>&lt;null&gt;</item>
        <item>&lt;null&gt;</item>
        <item>&lt;null&gt;</item>
        <item>&lt;null&gt;</item>
        <item>&lt;null&gt;</item>
        <item>&lt;null&gt;</item>
        <item>&lt;null&gt;</item>
        <item>&lt;null&gt;</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>id</name>
        <type>Integer</type>
        <format>0</format>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_string</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_integer</name>
        <type>Integer</type>
        <format>0</format>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_number</name>
        <type>Number</type>
        <format>0.0#########</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_bignumber</name>
        <type>BigNumber</type>
        <format>0.0#####</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_boolean</name>
        <type>Boolean</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_date</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_timestamp</name>
        <type>Timestamp</type>
        <format>yyyy-MM-dd HH:mm:ss.SSS</format>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_binary</name>
        <type>Binary</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_string</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_integer</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_number</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_bignumber</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_boolean</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_date</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_timestamp</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_binary</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>write every type</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>sqlite</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>id</stream_name>
      </field>
      <field>
        <column_name>w_string</column_name>
        <stream_name>w_string</stream_name>
      </field>
      <field>
        <column_name>w_integer</column_name>
        <stream_name>w_integer</stream_name>
      </field>
      <field>
        <column_name>w_number</column_name>
        <stream_name>w_number</stream_name>
      </field>
      <field>
        <column_name>w_bignumber</column_name>
        <stream_name>w_bignumber</stream_name>
      </field>
      <field>
        <column_name>w_boolean</column_name>
        <stream_name>w_boolean</stream_name>
      </field>
      <field>
        <column_name>w_date</column_name>
        <stream_name>w_date</stream_name>
      </field>
      <field>
        <column_name>w_timestamp</column_name>
        <stream_name>w_timestamp</stream_name>
      </field>
      <field>
        <column_name>w_binary</column_name>
        <stream_name>w_binary</stream_name>
      </field>
      <field>
        <column_name>x_string</column_name>
        <stream_name>x_string</stream_name>
      </field>
      <field>
        <column_name>x_integer</column_name>
        <stream_name>x_integer</stream_name>
      </field>
      <field>
        <column_name>x_number</column_name>
        <stream_name>x_number</stream_name>
      </field>
      <field>
        <column_name>x_bignumber</column_name>
        <stream_name>x_bignumber</stream_name>
      </field>
      <field>
        <column_name>x_boolean</column_name>
        <stream_name>x_boolean</stream_name>
      </field>
      <field>
        <column_name>x_date</column_name>
        <stream_name>x_date</stream_name>
      </field>
      <field>
        <column_name>x_timestamp</column_name>
        <stream_name>x_timestamp</stream_name>
      </field>
      <field>
        <column_name>x_binary</column_name>
        <stream_name>x_binary</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <table>data_types_written</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

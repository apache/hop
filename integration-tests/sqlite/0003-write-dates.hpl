<pipeline>
  <info>
    <name>0003-write-dates</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Writes Hop dates into a SQLite table so 0004 can check that both Hop and SQLite can read them back. Issue #3910.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/21 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/21 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>dates to write</from>
      <to>write dates</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>dates to write</name>
    <type>DataGrid</type>
    <description>Two dates Hop writes into SQLite, each with the text SQLite itself should end up storing.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>1</item>
        <item>2024-05-16</item>
        <item>2024-05-16 10:11:12</item>
        <item>2024-05-16</item>
        <item>2024-05-16 10:11:12</item>
      </line>
      <line>
        <item>2</item>
        <item>2023-01-02</item>
        <item>2023-01-02 08:09:10</item>
        <item>2023-01-02</item>
        <item>2023-01-02 08:09:10</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>id</name>
        <type>Integer</type>
        <format>####0;-####0</format>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_date</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>w_datetime</name>
        <type>Date</type>
        <format>yyyy-MM-dd HH:mm:ss</format>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_date</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>x_datetime</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>write dates</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>sqlite</connection>
    <fields>
      <field>
        <column_name>id</column_name>
        <stream_name>id</stream_name>
      </field>
      <field>
        <column_name>w_date</column_name>
        <stream_name>w_date</stream_name>
      </field>
      <field>
        <column_name>w_datetime</column_name>
        <stream_name>w_datetime</stream_name>
      </field>
      <field>
        <column_name>x_date</column_name>
        <stream_name>x_date</stream_name>
      </field>
      <field>
        <column_name>x_datetime</column_name>
        <stream_name>x_datetime</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <table>date_written</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

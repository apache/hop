          <source_filefolder>${PROJECT_HOME}/files/test.txt</source_filefolder>
          <destination_filefolder>${PROJECT_HOME}/output/002-move-source.txt</destination_filefolder>
          <wildcard/>
        </field>
      </fields>
      <name>Create a second disposable source file</name>

<workflow>
  <name>main-004-sftp-actions-with-connection</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>The SFTP put and get actions take their server from a named SFTP connection instead of from their own fields</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/08/04 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/04 10:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Put a file with SFTP</name>
      <description/>
      <type>SFTPPUT</type>
      <attributes/>
      <connection>sftp-test</connection>
      <servername/>
      <serverport/>
      <username/>
      <password>Encrypted </password>
      <sftpdirectory>/upload/actions</sftpdirectory>
      <localdirectory>${PROJECT_HOME}/files</localdirectory>
      <wildcard>.*.txt</wildcard>
      <copyprevious>N</copyprevious>
      <copypreviousfiles>N</copypreviousfiles>
      <addFilenameResut>N</addFilenameResut>
      <usekeyfilename>N</usekeyfilename>
      <keyfilename/>
      <keyfilepass>Encrypted </keyfilepass>
      <compression>none</compression>
      <proxyType/>
      <proxyHost/>
      <proxyPort/>
      <proxyUsername/>
      <proxyPassword>Encrypted </proxyPassword>
      <createRemoteFolder>Y</createRemoteFolder>
      <aftersftpput>nothing</aftersftpput>
      <destinationfolder/>
      <createdestinationfolder>N</createdestinationfolder>
      <preserveTargetFileTimestamp>Y</preserveTargetFileTimestamp>
      <successWhenNoFile>N</successWhenNoFile>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Get a file with SFTP</name>
      <description/>
      <type>SFTP</type>
      <attributes/>
      <connection>sftp-test</connection>
      <servername/>
      <serverport/>
      <username/>
      <password>Encrypted </password>
      <sftpdirectory>/upload/actions</sftpdirectory>
      <targetdirectory>${PROJECT_HOME}/output/actions</targetdirectory>
      <wildcard>.*.txt</wildcard>
      <remove>N</remove>
      <isaddresult>Y</isaddresult>
      <preserveTargetFileTimestamp>Y</preserveTargetFileTimestamp>
      <createtargetfolder>Y</createtargetfolder>
      <copyprevious>N</copyprevious>
      <usekeyfilename>N</usekeyfilename>
      <keyfilename/>
      <keyfilepass>Encrypted </keyfilepass>
      <compression>none</compression>
      <proxyType/>
      <proxyHost/>
      <proxyPort/>
      <proxyUsername/>
      <proxyPassword>Encrypted </proxyPassword>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>004-verify-downloaded-file.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/004-verify-downloaded-file.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>624</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Is the uploaded file on the server?</name>
      <description/>
      <type>FILE_EXISTS</type>
      <attributes/>
      <filename>sftp-test:///upload/actions/test.txt</filename>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Delete the file from the server</name>
      <description/>
      <type>DELETE_FILES</type>
      <attributes/>
      <arg_from_previous>N</arg_from_previous>
      <include_subfolders>N</include_subfolders>
      <fields>
        <field>
          <name>sftp-test:///upload/actions/test.txt</name>
          <filemask/>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Is it gone?</name>
      <description/>
      <type>FILE_EXISTS</type>
      <attributes/>
      <filename>sftp-test:///upload/actions/test.txt</filename>
      <parallel>N</parallel>
      <xloc>624</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>816</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>The file is still there</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>The file was not deleted from the server</message>
      <parallel>N</parallel>
      <xloc>816</xloc>
      <yloc>256</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Put a file with SFTP</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Put a file with SFTP</from>
      <to>Get a file with SFTP</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Get a file with SFTP</from>
      <to>004-verify-downloaded-file.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>004-verify-downloaded-file.hpl</from>
      <to>Is the uploaded file on the server?</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Is the uploaded file on the server?</from>
      <to>Delete the file from the server</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Delete the file from the server</from>
      <to>Is it gone?</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Is it gone?</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Is it gone?</from>
      <to>The file is still there</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

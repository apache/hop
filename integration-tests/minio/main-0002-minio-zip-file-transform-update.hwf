<workflow>
  <name>main-0002-minio-zip-file-transform-update</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/16 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/16 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create minio:///zip</name>
      <description/>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <foldername>minio:///zip</foldername>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>clean up minio:///zip/transform-update</name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>minio:///zip/transform-update/</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>write in/a.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <appendFile>N</appendFile>
      <content>a</content>
      <createParentFolder>Y</createParentFolder>
      <encoding>UTF-8</encoding>
      <filename>minio:///zip/transform-update/in/a.txt</filename>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>write in/b.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <appendFile>N</appendFile>
      <content>b</content>
      <createParentFolder>Y</createParentFolder>
      <encoding>UTF-8</encoding>
      <filename>minio:///zip/transform-update/in/b.txt</filename>
      <parallel>N</parallel>
      <xloc>720</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>write in2/a.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <appendFile>N</appendFile>
      <content>a2</content>
      <createParentFolder>Y</createParentFolder>
      <encoding>UTF-8</encoding>
      <filename>minio:///zip/transform-update/in2/a.txt</filename>
      <parallel>N</parallel>
      <xloc>880</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0002-minio-zip-file-transform.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0002-minio-zip-file-transform.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check the zip entries</name>
      <description/>
      <type>RunPipelineTests</type>
      <attributes/>
      <test_names>
        <test_name>
          <name>0002-minio-zip-validate transform UNIT</name>
        </test_name>
      </test_names>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>clean up minio:///zip/transform-update </name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>minio:///zip/transform-update/</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <parallel>N</parallel>
      <xloc>400</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>592</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>create minio:///zip</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>create minio:///zip</from>
      <to>clean up minio:///zip/transform-update</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>clean up minio:///zip/transform-update</from>
      <to>write in/a.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>write in/a.txt</from>
      <to>write in/b.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>write in/b.txt</from>
      <to>write in2/a.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>write in2/a.txt</from>
      <to>0002-minio-zip-file-transform.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0002-minio-zip-file-transform.hpl</from>
      <to>check the zip entries</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>check the zip entries</from>
      <to>clean up minio:///zip/transform-update </to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>clean up minio:///zip/transform-update </from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Cantarell</fontname>
      <fontsize>11</fontsize>
      <height>58</height>
      <xloc>192</xloc>
      <yloc>400</yloc>
      <note>Issue #8955: the Zip file transform with &quot;Overwrite zip entry&quot; updates one zip on S3 row by row.
It has to keep the entries already in the zip and replace a.txt with the newer version.</note>
      <width>600</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

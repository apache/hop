<workflow>
  <name>main-0003-minio-zip-file-action-append</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/16 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/16 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create minio:///zip</name>
      <description/>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <foldername>minio:///zip</foldername>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>clean up minio:///zip/action-append</name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>minio:///zip/action-append/</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>write in/a.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <appendFile>N</appendFile>
      <content>a</content>
      <createParentFolder>Y</createParentFolder>
      <encoding>UTF-8</encoding>
      <filename>minio:///zip/action-append/in/a.txt</filename>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>write in/b.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <appendFile>N</appendFile>
      <content>b</content>
      <createParentFolder>Y</createParentFolder>
      <encoding>UTF-8</encoding>
      <filename>minio:///zip/action-append/in/b.txt</filename>
      <parallel>N</parallel>
      <xloc>720</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>write in2/a.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <appendFile>N</appendFile>
      <content>a2</content>
      <createParentFolder>Y</createParentFolder>
      <encoding>UTF-8</encoding>
      <filename>minio:///zip/action-append/in2/a.txt</filename>
      <parallel>N</parallel>
      <xloc>880</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>zip in/a.txt</name>
      <description/>
      <type>ZIP_FILE</type>
      <attributes/>
      <SpecifyFormat>N</SpecifyFormat>
      <adddate>N</adddate>
      <addfiletoresult>N</addfiletoresult>
      <addtime>N</addtime>
      <afterzip>0</afterzip>
      <compressionrate>1</compressionrate>
      <createMoveToDirectory>N</createMoveToDirectory>
      <createparentfolder>Y</createparentfolder>
      <ifzipfileexists>1</ifzipfileexists>
      <include_subfolders>N</include_subfolders>
      <isfromprevious>N</isfromprevious>
      <sourcedirectory>minio:///zip/action-append/in</sourcedirectory>
      <stored_source_path_depth>1</stored_source_path_depth>
      <wildcard>a\.txt</wildcard>
      <zipfilename>minio:///zip/action-append/out/archive.zip</zipfilename>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>append in/b.txt</name>
      <description/>
      <type>ZIP_FILE</type>
      <attributes/>
      <SpecifyFormat>N</SpecifyFormat>
      <adddate>N</adddate>
      <addfiletoresult>N</addfiletoresult>
      <addtime>N</addtime>
      <afterzip>0</afterzip>
      <compressionrate>1</compressionrate>
      <createMoveToDirectory>N</createMoveToDirectory>
      <createparentfolder>Y</createparentfolder>
      <ifzipfileexists>1</ifzipfileexists>
      <include_subfolders>N</include_subfolders>
      <isfromprevious>N</isfromprevious>
      <sourcedirectory>minio:///zip/action-append/in</sourcedirectory>
      <stored_source_path_depth>1</stored_source_path_depth>
      <wildcard>b\.txt</wildcard>
      <zipfilename>minio:///zip/action-append/out/archive.zip</zipfilename>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>append in2/a.txt</name>
      <description/>
      <type>ZIP_FILE</type>
      <attributes/>
      <SpecifyFormat>N</SpecifyFormat>
      <adddate>N</adddate>
      <addfiletoresult>N</addfiletoresult>
      <addtime>N</addtime>
      <afterzip>0</afterzip>
      <compressionrate>1</compressionrate>
      <createMoveToDirectory>N</createMoveToDirectory>
      <createparentfolder>Y</createparentfolder>
      <ifzipfileexists>1</ifzipfileexists>
      <include_subfolders>N</include_subfolders>
      <isfromprevious>N</isfromprevious>
      <sourcedirectory>minio:///zip/action-append/in2</sourcedirectory>
      <stored_source_path_depth>1</stored_source_path_depth>
      <wildcard>a\.txt</wildcard>
      <zipfilename>minio:///zip/action-append/out/archive.zip</zipfilename>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>check the zip entries</name>
      <description/>
      <type>RunPipelineTests</type>
      <attributes/>
      <test_names>
        <test_name>
          <name>0002-minio-zip-validate action UNIT</name>
        </test_name>
      </test_names>
      <parallel>N</parallel>
      <xloc>192</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>clean up minio:///zip/action-append </name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>minio:///zip/action-append/</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <parallel>N</parallel>
      <xloc>400</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>592</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>create minio:///zip</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>create minio:///zip</from>
      <to>clean up minio:///zip/action-append</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>clean up minio:///zip/action-append</from>
      <to>write in/a.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>write in/a.txt</from>
      <to>write in/b.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>write in/b.txt</from>
      <to>write in2/a.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>write in2/a.txt</from>
      <to>zip in/a.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>zip in/a.txt</from>
      <to>append in/b.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>append in/b.txt</from>
      <to>append in2/a.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>append in2/a.txt</from>
      <to>check the zip entries</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>check the zip entries</from>
      <to>clean up minio:///zip/action-append </to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>clean up minio:///zip/action-append </from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Cantarell</fontname>
      <fontsize>11</fontsize>
      <height>58</height>
      <xloc>192</xloc>
      <yloc>400</yloc>
      <note>Issue #8955: three Zip file actions with &quot;If zip file exists: Append&quot; update one zip on S3.
The zip has to keep the entries already in it and end up with the newer version of a.txt.</note>
      <width>600</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

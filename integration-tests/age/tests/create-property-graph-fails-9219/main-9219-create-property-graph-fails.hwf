<workflow>
  <name>main-9219-create-property-graph-fails</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>#9219: on PostgreSQL (no SQL/PGQ) Create property graph drops the tables it created but keeps the ones that were there, and it is false on a missing connection</description>
  <extended_description/>
  <workflow_version/>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/11/07 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/07 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Drop test tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS knows;
DROP TABLE IF EXISTS works_at;
DROP TABLE IF EXISTS person;
DROP TABLE IF EXISTS company;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>age-sql</connection>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Existing company table</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TABLE company (code VARCHAR(10) PRIMARY KEY)</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>age-sql</connection>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>No SQL/PGQ in PostgreSQL</name>
      <description/>
      <type>CREATE_PROPERTY_GRAPH</type>
      <attributes/>
      <connection>age-sql</connection>
      <schema/>
      <graph_name>social_graph_9219</graph_name>
      <graph_model>social</graph_model>
      <create_tables>Y</create_tables>
      <replace_graph>N</replace_graph>
      <node_tables>
      </node_tables>
      <edge_tables>
      </edge_tables>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>No SQL/PGQ in PostgreSQL: expected false</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Created tables are dropped</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>age-sql</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' AND table_name IN ('person', 'knows', 'works_at')</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>832</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Existing table is kept</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>age-sql</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' AND table_name IN ('company')</custom_sql>

<pipeline>
  <info>
    <name>graphrag-build</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Writes fixed chunks and extraction rows the way the GraphRAG samples do</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/10 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/10 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>chunks</from>
      <to>Write documents and chunks</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>extracted graph</from>
      <to>Hold the graph</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hold the graph</from>
      <to>Wait for the chunks</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for the chunks</from>
      <to>Entity keys</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Entity keys</from>
      <to>Entity?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Entity?</from>
      <to>Write mentions</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Entity?</from>
      <to>Collect relationships</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Collect relationships</from>
      <to>Wait for the entities</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for the entities</from>
      <to>Write relationships</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>chunks</name>
    <type>DataGrid</type>
    <description>Three chunks</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>document_id</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>title</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>chunk_id</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>chunk_index</name>
        <precision>-1</precision>
        <type>Integer</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>chunk_text</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
    </fields>
    <data>
      <line>
        <item>d1</item>
        <item>Analytical Engine</item>
        <item>d1#0</item>
        <item>0</item>
        <item>Ada Lovelace worked with Charles Babbage.</item>
      </line>
      <line>
        <item>d1</item>
        <item>Analytical Engine</item>
        <item>d1#1</item>
        <item>1</item>
        <item>Babbage designed the Analytical Engine.</item>
      </line>
      <line>
        <item>d2</item>
        <item>Weather</item>
        <item>d2#0</item>
        <item>0</item>
        <item>The weather in London is fine today.</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write documents and chunks</name>
    <type>Neo4jGraphOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <model>graphrag</model>
    <batch_size>100</batch_size>
    <create_indexes>N</create_indexes>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <validate_against_model>N</validate_against_model>
    <out_of_order_allowed>Y</out_of_order_allowed>
    <mappings>
      <mapping>
        <source_field>document_id</source_field>
        <target_type>Node</target_type>
        <target_name>Document</target_name>
        <target_property>id</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>title</source_field>
        <target_type>Node</target_type>
        <target_name>Document</target_name>
        <target_property>title</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>chunk_id</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>id</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>chunk_index</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>chunk_index</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>chunk_text</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>text</target_property>
        <target_hint>None</target_hint>
      </mapping>
    </mappings>
    <relationship_mappings>
    </relationship_mappings>
    <node_mappings>
    </node_mappings>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>extracted graph</name>
    <type>DataGrid</type>
    <description>What Extract graph returns for the chunks. 'charles-babbage' merges with 'Charles Babbage'.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>chunk_id</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>graph_element</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>name</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>type</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>description</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>source</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>target</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
    </fields>
    <data>
      <line>
        <item>d1#0</item>
        <item>ENTITY</item>
        <item>Ada Lovelace</item>
        <item>Person</item>
        <item>Mathematician</item>
        <item/>
        <item/>
      </line>
      <line>
        <item>d1#0</item>
        <item>ENTITY</item>
        <item>Charles Babbage</item>
        <item>Person</item>
        <item>Inventor</item>
        <item/>
        <item/>
      </line>
      <line>
        <item>d1#0</item>
        <item>RELATIONSHIP</item>
        <item/>
        <item>WORKED_WITH</item>
        <item>Ada worked with Babbage</item>
        <item>Ada Lovelace</item>
        <item>Charles Babbage</item>
      </line>
      <line>
        <item>d1#1</item>
        <item>ENTITY</item>
        <item>Charles Babbage</item>
        <item>Person</item>
        <item>Inventor</item>
        <item/>
        <item/>
      </line>
      <line>
        <item>d1#1</item>
        <item>ENTITY</item>
        <item>Analytical Engine</item>
        <item>Product</item>
        <item>A mechanical computer</item>
        <item/>
        <item/>
      </line>
      <line>
        <item>d1#1</item>
        <item>RELATIONSHIP</item>
        <item/>
        <item>CREATED</item>
        <item>Babbage designed it</item>
        <item>charles-babbage</item>
        <item>Analytical Engine</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Hold the graph</name>
    <type>BlockingTransform</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>5000</cache_size>
    <compress>Y</compress>
    <directory>${java.io.tmpdir}</directory>
    <pass_all_rows>Y</pass_all_rows>
    <prefix>graphrag</prefix>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wait for the chunks</name>
    <type>BlockUntilTransformsFinish</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <transforms>
      <transform>
        <name>Write documents and chunks</name>
        <CopyNr>0</CopyNr>
      </transform>
    </transforms>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Entity keys</name>
    <type>ScriptValueMod</type>
    <description>Lowercase without spaces or punctuation, so 'Hop Run' and 'hop-run' are one entity</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function entityKey(name) {
  if (name == null) {
    return null;
  }
  return ("" + name).toLowerCase().replace(/[^a-z0-9+#]/g, "");
}
var key = entityKey(name);
var source_key = entityKey(source);
var target_key = entityKey(target);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>key</name>
        <rename>key</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>source_key</name>
        <rename>source_key</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>target_key</name>
        <rename>target_key</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Entity?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
        </conditions>
        <function>=</function>
        <leftvalue>graph_element</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <mask/>
          <name>constant</name>
          <precision>-1</precision>
          <text>ENTITY</text>
          <type>String</type>
        </value>
      </condition>
    </compare>
    <send_false_to>Collect relationships</send_false_to>
    <send_true_to>Write mentions</send_true_to>
    <attributes/>
    <GUI>
      <xloc>832</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write mentions</name>
    <type>Neo4jGraphOutput</type>
    <description>MERGE an Entity per key and the chunk's MENTIONS relationship to it</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <model>graphrag</model>
    <batch_size>100</batch_size>
    <create_indexes>N</create_indexes>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <validate_against_model>N</validate_against_model>
    <out_of_order_allowed>Y</out_of_order_allowed>
    <mappings>
      <mapping>
        <source_field>chunk_id</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>id</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>key</source_field>
        <target_type>Node</target_type>
        <target_name>Entity</target_name>
        <target_property>key</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>name</source_field>
        <target_type>Node</target_type>
        <target_name>Entity</target_name>
        <target_property>name</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>type</source_field>
        <target_type>Node</target_type>
        <target_name>Entity</target_name>
        <target_property>type</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>description</source_field>
        <target_type>Node</target_type>
        <target_name>Entity</target_name>
        <target_property>description</target_property>
        <target_hint>None</target_hint>
      </mapping>
    </mappings>
    <relationship_mappings>
    </relationship_mappings>
    <node_mappings>
    </node_mappings>
    <attributes/>
    <GUI>
      <xloc>1024</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Collect relationships</name>
    <type>BlockingTransform</type>
    <description>Reads all relationship rows first</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>5000</cache_size>
    <compress>Y</compress>
    <directory>${java.io.tmpdir}</directory>
    <pass_all_rows>Y</pass_all_rows>
    <prefix>graphrag</prefix>
    <attributes/>
    <GUI>
      <xloc>832</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wait for the entities</name>
    <type>BlockUntilTransformsFinish</type>
    <description>Relationships are written once every entity is</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <transforms>
      <transform>
        <name>Write mentions</name>
        <CopyNr>0</CopyNr>
      </transform>
    </transforms>
    <attributes/>
    <GUI>
      <xloc>1024</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write relationships</name>
    <type>Neo4jCypherOutput</type>
    <description>One RELATED_TO per type and source chunk. Graph output merges a relationship on its two nodes only, so a second type between the same entities would overwrite the first.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <cypher>MATCH (s:Entity {key: $source_key}), (t:Entity {key: $target_key})
MERGE (s)-[r:RELATED_TO {type: $type, chunk_id: $chunk_id}]-&gt;(t)
SET r.description = $description</cypher>
    <batch_size>1</batch_size>
    <read_only>N</read_only>
    <nr_retries_on_error/>
    <retry>N</retry>
    <cypher_from_field>N</cypher_from_field>
    <cypher_field/>
    <unwind>N</unwind>
    <unwind_map/>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <mappings>
      <mapping>
        <parameter>source_key</parameter>
        <field>source_key</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>target_key</parameter>
        <field>target_key</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>type</parameter>
        <field>type</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>chunk_id</parameter>
        <field>chunk_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>description</parameter>
        <field>description</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>

    </returns>
    <attributes/>
    <GUI>
      <xloc>1216</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<workflow>
  <name>main-graph-index-variables</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Graph index on Apache AGE with the index name, label and property in variables</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/10 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/10 12:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>TEST_FOLDER</name>
      <default_value>graph-index-variables</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>GRAPH_INDEX</name>
      <default_value>graph_index_variables_id</default_value>
      <description>The name of the index: the action resolves it</description>
    </parameter>
    <parameter>
      <name>GRAPH_LABEL</name>
      <default_value>IndexVariablesChunk</default_value>
      <description>The label of the index: it needs no nodes yet</description>
    </parameter>
    <parameter>
      <name>GRAPH_PROPERTY</name>
      <default_value>chunk_id</default_value>
      <description>The indexed property</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>drop index before</name>
      <description/>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>${GRAPH_INDEX}</index_name>
          <object_name>${GRAPH_LABEL}</object_name>
          <object_properties>${GRAPH_PROPERTY}</object_properties>
          <object_type>NODE</object_type>
          <update_type>DROP</update_type>
          <index_type>RANGE</index_type>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create index</name>
      <description/>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>${GRAPH_INDEX}</index_name>
          <object_name>${GRAPH_LABEL}</object_name>
          <object_properties>${GRAPH_PROPERTY}</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
          <index_type>RANGE</index_type>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>index created</name>
      <description>The index exists with the resolved name, on the resolved label and property</description>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>age-sql</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>1</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT indexname FROM pg_indexes WHERE schemaname = 'hop_it' AND tablename = 'IndexVariablesChunk' AND indexname = 'graph_index_variables_id' AND indexdef LIKE '%&quot;chunk_id&quot;%'</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>drop index</name>
      <description/>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>${GRAPH_INDEX}</index_name>
          <object_name>${GRAPH_LABEL}</object_name>
          <object_properties>${GRAPH_PROPERTY}</object_properties>
          <object_type>NODE</object_type>
          <update_type>DROP</update_type>
          <index_type>RANGE</index_type>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>index dropped</name>
      <description>The index with the resolved name is gone</description>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>age-sql</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT indexname FROM pg_indexes WHERE schemaname = 'hop_it' AND tablename = 'IndexVariablesChunk' AND indexname = 'graph_index_variables_id' AND indexdef LIKE '%&quot;chunk_id&quot;%'</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>drop index after failure</name>
      <description/>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>${GRAPH_INDEX}</index_name>
          <object_name>${GRAPH_LABEL}</object_name>
          <object_properties>${GRAPH_PROPERTY}</object_properties>
          <object_type>NODE</object_type>
          <update_type>DROP</update_type>
          <index_type>RANGE</index_type>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1024</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Error out</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>graph-index-variables failed</message>
      <parallel>N</parallel>
      <xloc>1024</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>drop index before</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>drop index before</from>
      <to>create index</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>create index</from>
      <to>index created</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>index created</from>
      <to>drop index</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>drop index</from>
      <to>index dropped</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>index dropped</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>create index</from>
      <to>drop index after failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>index created</from>
      <to>drop index after failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>drop index after failure</from>
      <to>Error out</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>index dropped</from>
      <to>Error out</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

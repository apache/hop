<workflow>
  <name>main-neo4j-graph-output-validate-model</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2019/08/07 13:45:04.042</created_date>
  <modified_user>-</modified_user>
  <modified_date>2019/08/07 13:45:04.042</modified_date>
  <parameters>
    <parameter>
      <name>TEST_FOLDER</name>
      <default_value>neo4j-graph-output-validate-model</default_value>
      <description/>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>176</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>cleanup-database.hwf</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/tests/shared/cleanup-database.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Nothing</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <pass_export>N</pass_export>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>336</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>load without index</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/tests/neo4j-graph-output-validate-model/neo4j-graph-output-validate-model.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>loaded without index</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>The validation should fail without an index on VPerson.id</message>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>304</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>load with index</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/tests/neo4j-graph-output-validate-model/neo4j-graph-output-validate-model.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>1232</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>drop index</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP INDEX IF EXISTS hop_it.vperson_id</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>age-sql</connection>
      <parallel>N</parallel>
      <xloc>336</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create label</name>
      <description>The label table of VPerson needs to exist to put an index on it</description>
      <type>NEO4J_CYPHER_SCRIPT</type>
      <attributes/>
      <connection>Test</connection>
      <replace_variables>N</replace_variables>
      <script>CREATE (:VPerson {id: -1})
;
MATCH (n:VPerson {id: -1}) DELETE n
;
</script>
      <parallel>N</parallel>
      <xloc>784</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create index</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE INDEX IF NOT EXISTS vperson_id ON hop_it."VPerson" (ag_catalog.agtype_access_operator(VARIADIC ARRAY[properties, '"id"'::ag_catalog.agtype]))</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>age-sql</connection>
      <parallel>N</parallel>
      <xloc>1008</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>cleanup-database.hwf</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>cleanup-database.hwf</from>
      <to>drop index</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>drop index</from>
      <to>load without index</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>load without index</from>
      <to>loaded without index</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>load without index</from>
      <to>create label</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>create label</from>
      <to>create index</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>create index</from>
      <to>load with index</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

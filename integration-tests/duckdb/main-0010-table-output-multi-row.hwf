<workflow>
  <name>main-0010-table-output-multi-row</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Table output with several rows per INSERT statement on DuckDB: a clean load of 2345 rows at 100 rows per statement and commit size 1000, and twelve rows at 3 rows per statement and commit size 6 with an error hop that must get exactly the three rows the database refuses, every other row written and reported once, with the amounts as sent. VALUES lists; failed batches recovered (LOSES_WHOLE_BATCH). DuckDB has no triggers, so the number of statements is not checked.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/27 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/27 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS tomr_clean;
DROP TABLE IF EXISTS tomr_target;
DROP TABLE IF EXISTS tomr_written;
DROP TABLE IF EXISTS tomr_rejects;
DROP TABLE IF EXISTS tomr_stmts;
CREATE TABLE tomr_clean (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(20) NOT NULL, amount DECIMAL(10,2));
CREATE TABLE tomr_target (id BIGINT NOT NULL PRIMARY KEY, label VARCHAR(20) NOT NULL, amount DECIMAL(10,2));
CREATE TABLE tomr_written (id BIGINT, label VARCHAR(20), amount DECIMAL(10,2));
CREATE TABLE tomr_rejects (id BIGINT, label VARCHAR(20), amount DECIMAL(10,2), err_desc VARCHAR, err_code VARCHAR(20));
CREATE TABLE tomr_stmts (tbl VARCHAR(30));
INSERT INTO tomr_target (id, label, amount) VALUES (9000, 'seed', 9.99);
INSERT INTO tomr_target (id, label, amount) VALUES (9001, 'seed', 9.99);
INSERT INTO tomr_target (id, label, amount) VALUES (9002, 'seed', 9.99);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>duckdb</connection>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0010-table-output-multi-row-clean.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0010-table-output-multi-row-clean.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0010-table-output-multi-row-errors.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0010-table-output-multi-row-errors.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0010-table-output-multi-row-check.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/0010-table-output-multi-row-check.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Init tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Init tables</from>
      <to>0010-table-output-multi-row-clean.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0010-table-output-multi-row-clean.hpl</from>
      <to>0010-table-output-multi-row-errors.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0010-table-output-multi-row-errors.hpl</from>
      <to>0010-table-output-multi-row-check.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

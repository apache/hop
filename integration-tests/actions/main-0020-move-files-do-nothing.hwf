<!--

  Guards issue #7858: "Do nothing" on an existing destination file must skip that file and
  let the action succeed, instead of failing the action.

  NOTE: the "move again, option missing from the file" action below deliberately has NO
  <iffileexists> tag. That is what workflows written before the option was serialized look
  like, and it is the exact shape that regressed. Opening this workflow in the Hop GUI and
  saving it writes the tag back and silently removes that half of the test coverage.

-->
<workflow>
  <name>main-0020-move-files-do-nothing</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Move files: "do nothing" when the destination file exists</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/08/10 09:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/10 09:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>clean up /tmp/action-0020</name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>${java.io.tmpdir}/action-0020</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>source/a.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <filename>${java.io.tmpdir}/action-0020/source/a.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>SOURCE-A</content>
      <encoding>UTF-8</encoding>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>source/b.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <filename>${java.io.tmpdir}/action-0020/source/b.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>SOURCE-B</content>
      <encoding>UTF-8</encoding>
      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>destination/a.txt</name>
      <description>Same name as source/a.txt but a different size, so overwriting is detectable</description>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <filename>${java.io.tmpdir}/action-0020/destination/a.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>DESTINATION-A-UNTOUCHED</content>
      <encoding>UTF-8</encoding>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>move, do nothing if it exists</name>
      <description/>
      <type>MOVE_FILES</type>
      <attributes/>
      <move_empty_folders>N</move_empty_folders>
      <arg_from_previous>N</arg_from_previous>
      <include_subfolders>N</include_subfolders>
      <add_result_filesname>N</add_result_filesname>
      <destination_is_a_file>N</destination_is_a_file>
      <create_destination_folder>N</create_destination_folder>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <nr_errors_less_than>10</nr_errors_less_than>
      <success_condition>success_if_no_errors</success_condition>
      <AddDateBeforeExtension>N</AddDateBeforeExtension>
      <DoNotKeepFolderStructure>N</DoNotKeepFolderStructure>
      <iffileexists>do_nothing</iffileexists>
      <destinationFolder/>
      <ifmovedfileexists>do_nothing</ifmovedfileexists>
      <moved_date_time_format/>
      <create_move_to_folder>N</create_move_to_folder>
      <add_moved_date>N</add_moved_date>
      <add_moved_time>N</add_moved_time>
      <SpecifyMoveFormat>N</SpecifyMoveFormat>
      <AddMovedDateBeforeExtension>N</AddMovedDateBeforeExtension>
      <simulate>N</simulate>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/action-0020/source/</source_filefolder>
          <destination_filefolder>${java.io.tmpdir}/action-0020/destination/</destination_filefolder>
          <wildcard>.*\.txt</wildcard>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>a.txt was left in source</name>
      <description/>
      <type>EVAL_FILES_METRICS</type>
      <attributes/>
      <scale>bytes</scale>
      <source_files>files</source_files>
      <evaluation_type>count</evaluation_type>
      <comparevalue>1</comparevalue>
      <successnumbercondition>equal</successnumbercondition>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/action-0020/source/</source_filefolder>
          <wildcard>a\.txt</wildcard>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>b.txt was moved out of source</name>
      <description/>
      <type>EVAL_FILES_METRICS</type>
      <attributes/>
      <scale>bytes</scale>
      <source_files>files</source_files>
      <evaluation_type>count</evaluation_type>
      <comparevalue>0</comparevalue>
      <successnumbercondition>equal</successnumbercondition>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/action-0020/source/</source_filefolder>
          <wildcard>b\.txt</wildcard>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>2 files in destination</name>
      <description/>
      <type>EVAL_FILES_METRICS</type>
      <attributes/>
      <scale>bytes</scale>
      <source_files>files</source_files>
      <evaluation_type>count</evaluation_type>
      <comparevalue>2</comparevalue>
      <successnumbercondition>equal</successnumbercondition>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/action-0020/destination/</source_filefolder>
          <wildcard>.*\.txt</wildcard>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>destination/a.txt was not overwritten</name>
      <description>DESTINATION-A-UNTOUCHED is 23 bytes, SOURCE-A is 8</description>
      <type>EVAL_FILES_METRICS</type>
      <attributes/>
      <scale>bytes</scale>
      <source_files>files</source_files>
      <evaluation_type>size</evaluation_type>
      <comparevalue>23</comparevalue>
      <successnumbercondition>equal</successnumbercondition>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/action-0020/destination/</source_filefolder>
          <wildcard>a\.txt</wildcard>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>move again, option missing from the file</name>
      <description>Deliberately has no iffileexists tag - see the comment at the top of this file</description>
      <type>MOVE_FILES</type>
      <attributes/>
      <move_empty_folders>N</move_empty_folders>
      <arg_from_previous>N</arg_from_previous>
      <include_subfolders>N</include_subfolders>
      <add_result_filesname>N</add_result_filesname>
      <destination_is_a_file>N</destination_is_a_file>
      <create_destination_folder>N</create_destination_folder>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <nr_errors_less_than>10</nr_errors_less_than>
      <success_condition>success_if_no_errors</success_condition>
      <AddDateBeforeExtension>N</AddDateBeforeExtension>
      <DoNotKeepFolderStructure>N</DoNotKeepFolderStructure>
      <destinationFolder/>
      <moved_date_time_format/>
      <create_move_to_folder>N</create_move_to_folder>
      <add_moved_date>N</add_moved_date>
      <add_moved_time>N</add_moved_time>
      <SpecifyMoveFormat>N</SpecifyMoveFormat>
      <AddMovedDateBeforeExtension>N</AddMovedDateBeforeExtension>
      <simulate>N</simulate>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/action-0020/source/</source_filefolder>
          <destination_filefolder>${java.io.tmpdir}/action-0020/destination/</destination_filefolder>
          <wildcard>.*\.txt</wildcard>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>272</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>a.txt is still in source</name>
      <description/>
      <type>EVAL_FILES_METRICS</type>
      <attributes/>
      <scale>bytes</scale>
      <source_files>files</source_files>
      <evaluation_type>count</evaluation_type>
      <comparevalue>1</comparevalue>
      <successnumbercondition>equal</successnumbercondition>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/action-0020/source/</source_filefolder>
          <wildcard>a\.txt</wildcard>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>272</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>destination/a.txt is still not overwritten</name>
      <description/>
      <type>EVAL_FILES_METRICS</type>
      <attributes/>
      <scale>bytes</scale>
      <source_files>files</source_files>
      <evaluation_type>size</evaluation_type>
      <comparevalue>23</comparevalue>
      <successnumbercondition>equal</successnumbercondition>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/action-0020/destination/</source_filefolder>
          <wildcard>a\.txt</wildcard>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>272</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>clean up /tmp/action-0020</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>clean up /tmp/action-0020</from>
      <to>source/a.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>source/a.txt</from>
      <to>source/b.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>source/b.txt</from>
      <to>destination/a.txt</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>destination/a.txt</from>
      <to>move, do nothing if it exists</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>move, do nothing if it exists</from>
      <to>a.txt was left in source</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>a.txt was left in source</from>
      <to>b.txt was moved out of source</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>b.txt was moved out of source</from>
      <to>2 files in destination</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>2 files in destination</from>
      <to>destination/a.txt was not overwritten</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>destination/a.txt was not overwritten</from>
      <to>move again, option missing from the file</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>move again, option missing from the file</from>
      <to>a.txt is still in source</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>a.txt is still in source</from>
      <to>destination/a.txt is still not overwritten</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

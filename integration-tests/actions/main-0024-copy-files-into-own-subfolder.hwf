<workflow>
  <name>main-0024-copy-files-into-own-subfolder</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Issue #8800: copying a folder into a subfolder of itself copies every file once and never copies the destination folder into itself.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/08 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/08 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create source folder</name>
      <description>Files and folders on both sides of the empty "copy" folder, in creation and in name order, so some files are copied before the traversal reaches "copy" whatever order the filesystem lists them in.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
set -e
BASE="${PROJECT_HOME}/workfiles-0024"
SRC="$BASE/project"
rm -rf "$BASE"
mkdir -p "$SRC"
for i in 0 1 2 3 4; do
  mkdir -p "$SRC/a$i"
  echo "a$i" > "$SRC/a$i/f.txt"
done
mkdir "$SRC/copy"
for i in 0 1 2 3 4; do
  echo "z$i" > "$SRC/z$i.txt"
done
ls -U "$SRC"</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Copy folder into own subfolder</name>
      <description/>
      <type>COPY_FILES</type>
      <attributes/>
      <copy_empty_folders>N</copy_empty_folders>
      <arg_from_previous>N</arg_from_previous>
      <overwrite_files>Y</overwrite_files>
      <include_subfolders>Y</include_subfolders>
      <remove_source_files>N</remove_source_files>
      <add_result_filesname>N</add_result_filesname>
      <destination_is_a_file>N</destination_is_a_file>
      <create_destination_folder>Y</create_destination_folder>
      <fields>
        <field>
          <source_filefolder>${PROJECT_HOME}/workfiles-0024/project</source_filefolder>
          <destination_filefolder>${PROJECT_HOME}/workfiles-0024/project/copy</destination_filefolder>
          <wildcard/>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check copied files</name>
      <description>Every file is copied once into copy/, and there is no copy/copy.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
BASE="${PROJECT_HOME}/workfiles-0024"
SRC="$BASE/project"
DEST="$SRC/copy"
FAILURES=0
find "$SRC" | sort
if [ -e "$DEST/copy" ]; then
  echo "FAIL: the destination folder was copied into itself: $DEST/copy"
  FAILURES=$((FAILURES + 1))
fi
for i in 0 1 2 3 4; do
  if [ "$(cat "$DEST/a$i/f.txt" 2>/dev/null)" != "a$i" ]; then
    echo "FAIL: $DEST/a$i/f.txt is missing or wrong"
    FAILURES=$((FAILURES + 1))
  fi
  if [ "$(cat "$DEST/z$i.txt" 2>/dev/null)" != "z$i" ]; then
    echo "FAIL: $DEST/z$i.txt is missing or wrong"
    FAILURES=$((FAILURES + 1))
  fi
done
rm -rf "$BASE"
if [ "$FAILURES" -ne 0 ]; then
  echo "$FAILURES check(s) failed"
  exit 1
fi
echo "All checks passed"</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>928</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort setup failed</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Could not create the source folder</message>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort copy failed</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Copy files failed</message>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort wrong copy</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Copying a folder into its own subfolder gave the wrong result, see the Check copied files log</message>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create source folder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create source folder</from>
      <to>Copy folder into own subfolder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Create source folder</from>
      <to>Abort setup failed</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Copy folder into own subfolder</from>
      <to>Check copied files</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Copy folder into own subfolder</from>
      <to>Abort copy failed</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check copied files</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check copied files</from>
      <to>Abort wrong copy</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

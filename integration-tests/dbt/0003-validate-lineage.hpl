<pipeline>
  <info>
    <name>0003-validate-lineage</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Validates that Hop and dbt landed in ONE lineage graph: the jobs of the Hop namespace in Marquez must contain both the Hop workflow that ran dbt and the dbt model job. dbt only reports into this namespace because the action passed Hop's OpenLineage settings to dbt-ol, and it is only a child of the Hop run because the action passed OPENLINEAGE_PARENT_ID.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/19 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/19 12:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Generate rows</from>
      <to>Query Marquez jobs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Query Marquez jobs</from>
      <to>check dbt model job present</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check dbt model job present</from>
      <to>no dbt lineage</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check dbt model job present</from>
      <to>check hop workflow job present</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check hop workflow job present</from>
      <to>no hop lineage</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check hop workflow job present</from>
      <to>one graph</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Generate rows</name>
    <type>RowGenerator</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
</fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <never_ending>N</never_ending>
    <limit>1</limit>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Query Marquez jobs</name>
    <type>Rest</type>
    <description>Lists every job Marquez knows in the Hop namespace.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>JSON</applicationType>
    <method>GET</method>
    <url>${MARQUEZ_API}/api/v1/namespaces/${OPENLINEAGE_NAMESPACE}/jobs</url>
    <urlInField>N</urlInField>
    <dynamicMethod>N</dynamicMethod>
    <methodFieldName/>
    <urlField/>
    <bodyField/>
    <httpLogin/>
    <httpPassword>Encrypted </httpPassword>
    <proxyHost/>
    <proxyPort/>
    <preemptive>N</preemptive>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <headers>
      </headers>
    <parameters>
      </parameters>
    <matrixParameters>
      </matrixParameters>
    <result>
      <name>jobs_body</name>
      <code>result_status</code>
      <response_time/>
      <response_header/>
    </result>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check dbt model job present</name>
    <type>FilterRows</type>
    <description>Aborts when dbt's own OpenLineage events never arrived.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>no dbt lineage</send_true_to>
    <send_false_to>check hop workflow job present</send_false_to>
    <compare>
      <condition>
        <negated>Y</negated>
        <leftvalue>jobs_body</leftvalue>
        <function>CONTAINS</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>orders_by_country</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check hop workflow job present</name>
    <type>FilterRows</type>
    <description>Aborts when the Hop side of the graph is missing.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>no hop lineage</send_true_to>
    <send_false_to>one graph</send_false_to>
    <compare>
      <condition>
        <negated>Y</negated>
        <leftvalue>jobs_body</leftvalue>
        <function>CONTAINS</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>main-0003-dbt-lineage</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>one graph</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>no dbt lineage</name>
    <type>Abort</type>
    <description>No dbt job in the Hop OpenLineage namespace: dbt-ol did not emit, or it emitted somewhere else - which is exactly what the action's OPENLINEAGE_URL/NAMESPACE wiring is supposed to prevent.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>no hop lineage</name>
    <type>Abort</type>
    <description>The dbt job is there but the Hop workflow job is not, so the two runs are not in the same graph.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<workflow>
  <name>main-0003-dbt-lineage</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Proves the lineage stitch: with Emit OpenLineage enabled the action runs dbt through dbt-ol, points it at the collector Hop's own sink delivers to and passes OPENLINEAGE_PARENT_ID, so the dbt run lands in the same graph as the Hop workflow that started it. The validation pipeline asserts that Marquez knows both jobs in the Hop namespace.</description>
  <extended_description/>
  <workflow_version/>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/08/19 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/19 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create source table</name>
      <description>Creates the table the Hop pipeline loads and the dbt source points at.</description>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS public.orders_source&#10;;&#10;CREATE TABLE public.orders_source (country varchar(2), amount integer)&#10;;&#10;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>warehouse</connection>
      <parallel>N</parallel>
      <xloc>200</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0001-load-orders-source.hpl</name>
      <description></description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0001-load-orders-source.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>380</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>dbt run with lineage</name>
      <description>Runs dbt through dbt-ol with Hop's OpenLineage settings.</description>
      <type>DBT</type>
      <attributes/>
      <dbt_project>warehouse-models</dbt_project>
      <operation>run</operation>
      <select></select>
      <exclude/>
      <target>dev</target>
      <threads/>
      <full_refresh>N</full_refresh>
      <emit_openlineage>Y</emit_openlineage>
      <timeout>600</timeout>
      <vars>
      </vars>
      <env_vars>
        <env_var>
          <name>DBT_HOST</name>
          <value>${POSTGRES_HOST}</value>
        </env_var>
        <env_var>
          <name>DBT_PORT</name>
          <value>${POSTGRES_PORT}</value>
        </env_var>
        <env_var>
          <name>DBT_USER</name>
          <value>${POSTGRES_USER}</value>
        </env_var>
        <env_var>
          <name>DBT_PASSWORD</name>
          <value>${POSTGRES_PASSWORD}</value>
        </env_var>
        <env_var>
          <name>DBT_DATABASE</name>
          <value>${POSTGRES_DATABASE}</value>
        </env_var>
      </env_vars>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Wait for delivery and ingestion</name>
      <description>Both sides deliver asynchronously; give Marquez time to ingest.</description>
      <type>DELAY</type>
      <attributes/>
      <maximumTimeout>20</maximumTimeout>
      <scaletime>0</scaletime>
      <parallel>N</parallel>
      <xloc>740</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0003-validate-lineage.hpl</name>
      <description></description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0003-validate-lineage.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>920</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create source table</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create source table</from>
      <to>0001-load-orders-source.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0001-load-orders-source.hpl</from>
      <to>dbt run with lineage</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>dbt run with lineage</from>
      <to>Wait for delivery and ingestion</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Wait for delivery and ingestion</from>
      <to>0003-validate-lineage.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

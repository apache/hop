<pipeline>
  <info>
    <name>0002-validate-model</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Validates that dbt actually built its model in the warehouse: dbt.orders_by_country must hold one row per country (3) and the amounts must add up to the 800 loaded by 0001. Anything else aborts with an error, failing the test.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/19 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/19 12:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>read model</from>
      <to>check row count</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check row count</from>
      <to>check total amount</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check row count</from>
      <to>no model built</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check total amount</from>
      <to>wrong aggregation</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check total amount</from>
      <to>model is correct</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>read model</name>
    <type>TableInput</type>
    <description>Reads what dbt materialised.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>warehouse</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT count(*) AS country_count, sum(total_amount) AS grand_total&#10;FROM dbt.orders_by_country&#10;</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check row count</name>
    <type>FilterRows</type>
    <description>Aborts when dbt did not produce exactly one row per country.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>no model built</send_true_to>
    <send_false_to>check total amount</send_false_to>
    <compare>
      <condition>
        <negated>Y</negated>
        <leftvalue>country_count</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>3</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>check total amount</name>
    <type>FilterRows</type>
    <description>Aborts when the aggregation does not match what Hop loaded.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>wrong aggregation</send_true_to>
    <send_false_to>model is correct</send_false_to>
    <compare>
      <condition>
        <negated>Y</negated>
        <leftvalue>grand_total</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>800</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>model is correct</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>no model built</name>
    <type>Abort</type>
    <description>dbt.orders_by_country does not hold one row per country: the dbt run did not build the model from the table Hop loaded.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>wrong aggregation</name>
    <type>Abort</type>
    <description>dbt.orders_by_country exists but its totals do not match the source data Hop loaded.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

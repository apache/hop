<workflow>
  <name>main-0001-dbt-warehouse</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>End to end run of the dbt action: Hop loads public.orders_source, dbt builds its model from it and passes its own tests, and the model is then verified in the warehouse. Proves the action starts dbt, that the warehouse credentials reach dbt through the environment (profiles.yml reads them with env_var(), they are nowhere on disk), that a dbt variable arrives typed, and that dbt's run_results are read back.</description>
  <extended_description/>
  <workflow_version/>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/08/19 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/19 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create source table</name>
      <description>Creates the table the Hop pipeline loads and the dbt source points at.</description>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS public.orders_source&#10;;&#10;CREATE TABLE public.orders_source (country varchar(2), amount integer)&#10;;&#10;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>warehouse</connection>
      <parallel>N</parallel>
      <xloc>200</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0001-load-orders-source.hpl</name>
      <description></description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0001-load-orders-source.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>380</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>dbt run</name>
      <description>Builds the dbt models from the table Hop just loaded.</description>
      <type>DBT</type>
      <attributes/>
      <dbt_project>warehouse-models</dbt_project>
      <operation>run</operation>
      <select></select>
      <exclude/>
      <target>dev</target>
      <threads/>
      <full_refresh>N</full_refresh>
      <emit_openlineage>N</emit_openlineage>
      <timeout>600</timeout>
      <vars>
        <var>
          <name>min_amount</name>
          <value>50</value>
        </var>
      </vars>
      <env_vars>
        <env_var>
          <name>DBT_HOST</name>
          <value>${POSTGRES_HOST}</value>
        </env_var>
        <env_var>
          <name>DBT_PORT</name>
          <value>${POSTGRES_PORT}</value>
        </env_var>
        <env_var>
          <name>DBT_USER</name>
          <value>${POSTGRES_USER}</value>
        </env_var>
        <env_var>
          <name>DBT_PASSWORD</name>
          <value>${POSTGRES_PASSWORD}</value>
        </env_var>
        <env_var>
          <name>DBT_DATABASE</name>
          <value>${POSTGRES_DATABASE}</value>
        </env_var>
      </env_vars>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>dbt test</name>
      <description>Runs the dbt tests on the aggregated model. The deliberately failing model is not selected here - main-0002 covers that.</description>
      <type>DBT</type>
      <attributes/>
      <dbt_project>warehouse-models</dbt_project>
      <operation>test</operation>
      <select>orders_by_country</select>
      <exclude/>
      <target>dev</target>
      <threads/>
      <full_refresh>N</full_refresh>
      <emit_openlineage>N</emit_openlineage>
      <timeout>600</timeout>
      <vars>
      </vars>
      <env_vars>
        <env_var>
          <name>DBT_HOST</name>
          <value>${POSTGRES_HOST}</value>
        </env_var>
        <env_var>
          <name>DBT_PORT</name>
          <value>${POSTGRES_PORT}</value>
        </env_var>
        <env_var>
          <name>DBT_USER</name>
          <value>${POSTGRES_USER}</value>
        </env_var>
        <env_var>
          <name>DBT_PASSWORD</name>
          <value>${POSTGRES_PASSWORD}</value>
        </env_var>
        <env_var>
          <name>DBT_DATABASE</name>
          <value>${POSTGRES_DATABASE}</value>
        </env_var>
      </env_vars>
      <parallel>N</parallel>
      <xloc>740</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0002-validate-model.hpl</name>
      <description></description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0002-validate-model.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>920</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create source table</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create source table</from>
      <to>0001-load-orders-source.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0001-load-orders-source.hpl</from>
      <to>dbt run</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>dbt run</from>
      <to>dbt test</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>dbt test</from>
      <to>0002-validate-model.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

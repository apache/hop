<workflow>
  <name>main-0002-dbt-test-failure</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Proves the dbt action can be used as a data quality gate: a dbt test that fails must fail the action so the workflow follows the error hop. dbt exits non-zero for a failed test, but the action also reads the failed node out of run_results.json. This test PASSES when the dbt test fails and the error hop is taken; if dbt test unexpectedly succeeds the workflow aborts with an error. The Success action at the end clears the error count the failed action left behind, so the harness sees the run as the pass it is.</description>
  <extended_description/>
  <workflow_version/>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2026/08/19 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/19 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create source table</name>
      <description>Creates the table the Hop pipeline loads and the dbt source points at.</description>
      <type>SQL</type>
      <attributes/>
      <sql>DROP TABLE IF EXISTS public.orders_source&#10;;&#10;CREATE TABLE public.orders_source (country varchar(2), amount integer)&#10;;&#10;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>warehouse</connection>
      <parallel>N</parallel>
      <xloc>200</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>0001-load-orders-source.hpl</name>
      <description></description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0001-load-orders-source.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>380</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>dbt run</name>
      <description>Builds the models, including the deliberately broken one.</description>
      <type>DBT</type>
      <attributes/>
      <dbt_project>warehouse-models</dbt_project>
      <operation>run</operation>
      <select></select>
      <exclude/>
      <target>dev</target>
      <threads/>
      <full_refresh>N</full_refresh>
      <emit_openlineage>N</emit_openlineage>
      <timeout>600</timeout>
      <vars>
      </vars>
      <env_vars>
        <env_var>
          <name>DBT_HOST</name>
          <value>${POSTGRES_HOST}</value>
        </env_var>
        <env_var>
          <name>DBT_PORT</name>
          <value>${POSTGRES_PORT}</value>
        </env_var>
        <env_var>
          <name>DBT_USER</name>
          <value>${POSTGRES_USER}</value>
        </env_var>
        <env_var>
          <name>DBT_PASSWORD</name>
          <value>${POSTGRES_PASSWORD}</value>
        </env_var>
        <env_var>
          <name>DBT_DATABASE</name>
          <value>${POSTGRES_DATABASE}</value>
        </env_var>
      </env_vars>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>dbt test that must fail</name>
      <description>Runs the not_null test on failing_orders.country, which is null by construction.</description>
      <type>DBT</type>
      <attributes/>
      <dbt_project>warehouse-models</dbt_project>
      <operation>test</operation>
      <select>failing_orders</select>
      <exclude/>
      <target>dev</target>
      <threads/>
      <full_refresh>N</full_refresh>
      <emit_openlineage>N</emit_openlineage>
      <timeout>600</timeout>
      <vars>
      </vars>
      <env_vars>
        <env_var>
          <name>DBT_HOST</name>
          <value>${POSTGRES_HOST}</value>
        </env_var>
        <env_var>
          <name>DBT_PORT</name>
          <value>${POSTGRES_PORT}</value>
        </env_var>
        <env_var>
          <name>DBT_USER</name>
          <value>${POSTGRES_USER}</value>
        </env_var>
        <env_var>
          <name>DBT_PASSWORD</name>
          <value>${POSTGRES_PASSWORD}</value>
        </env_var>
        <env_var>
          <name>DBT_DATABASE</name>
          <value>${POSTGRES_DATABASE}</value>
        </env_var>
      </env_vars>
      <parallel>N</parallel>
      <xloc>740</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>failure was caught</name>
      <description>The error hop was taken, which is what this test asserts.</description>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <loglevel>Basic</loglevel>
      <logmessage>The failing dbt test was routed to the error hop as expected</logmessage>
      <logsubject>dbt</logsubject>
      <parallel>N</parallel>
      <xloc>920</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>test should have failed</name>
      <description>Reached only when dbt test reported success, which means a failing dbt test no longer fails the action.</description>
      <type>ABORT</type>
      <attributes/>
      <message>dbt test on failing_orders succeeded - a failing dbt test is no longer failing the action</message>
      <parallel>N</parallel>
      <xloc>920</xloc>
      <yloc>32</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>expected failure handled</name>
      <description>Clears the error the failed dbt action left on the workflow result. Without it the workflow still carries nrErrors=1 and the test harness, which runs this file from run-workflow.hwf, reports the test as failed even though the error hop did its job.</description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1100</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create source table</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create source table</from>
      <to>0001-load-orders-source.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>0001-load-orders-source.hpl</from>
      <to>dbt run</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>dbt run</from>
      <to>dbt test that must fail</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>dbt test that must fail</from>
      <to>failure was caught</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>dbt test that must fail</from>
      <to>test should have failed</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>failure was caught</from>
      <to>expected failure handled</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

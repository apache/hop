<workflow>
  <name>main-0001-export-known-formats</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>hop export and hop-export.sh still write SVG and Mermaid, picked by --format, by the -o extension or by default</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/08 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/08 10:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>112</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Export as SVG and Mermaid</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
SUBJECT="${PROJECT_HOME}/subject"
OUT="${PROJECT_HOME}/output/0001-known-formats"
rm -rf "$OUT"

fail() {
  echo "$1"
  exit 1
}

# The same checks for both launchers: "hop export" and hop-export.sh.
for LAUNCHER in "bash hop export" "bash hop-export.sh"; do
  DIR="$OUT/$(echo "$LAUNCHER" | tr ' .' '__')"
  mkdir -p "$DIR/batch"

  $LAUNCHER -f "$SUBJECT/fast-pipeline.hpl" --format svg -o "$DIR/p.svg"
  grep -q '&lt;svg' "$DIR/p.svg" || fail "$LAUNCHER --format svg did not write an SVG"

  $LAUNCHER -f "$SUBJECT/fast-pipeline.hpl" --format MERMAID -o "$DIR/p.mmd"
  head -1 "$DIR/p.mmd" | grep -q '^flowchart' || fail "$LAUNCHER --format MERMAID did not write Mermaid"

  # Without --format, the extension of -o picks the format.
  $LAUNCHER -f "$SUBJECT/fast-pipeline.hpl" -o "$DIR/by-extension.mmd"
  head -1 "$DIR/by-extension.mmd" | grep -q '^flowchart' || fail "$LAUNCHER -o .mmd did not write Mermaid"
  $LAUNCHER -f "$SUBJECT/fast-pipeline.hpl" -o "$DIR/by-extension.svg"
  grep -q '&lt;svg' "$DIR/by-extension.svg" || fail "$LAUNCHER -o .svg did not write an SVG"

  # Without --format and -o, an SVG next to the file.
  cp "$SUBJECT/fast-workflow.hwf" "$DIR/default.hwf"
  $LAUNCHER -f "$DIR/default.hwf"
  grep -q '&lt;svg' "$DIR/default.svg" || fail "$LAUNCHER without a format did not write default.svg"

  $LAUNCHER -f "$SUBJECT/fast-workflow.hwf" --format mermaid -o "$DIR/w.mmd"
  head -1 "$DIR/w.mmd" | grep -q '^flowchart' || fail "$LAUNCHER did not write a workflow as Mermaid"

  $LAUNCHER -s "$SUBJECT" -t "$DIR/batch" --format mermaid
  test -f "$DIR/batch/fast-pipeline.mmd" || fail "$LAUNCHER -s did not export the pipeline"
  test -f "$DIR/batch/fast-workflow.mmd" || fail "$LAUNCHER -s did not export the workflow"
done</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Failure: hop export did not write SVG or Mermaid</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Failure: hop export did not write SVG or Mermaid</message>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Export as SVG and Mermaid</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Export as SVG and Mermaid</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Export as SVG and Mermaid</from>
      <to>Failure: hop export did not write SVG or Mermaid</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>210</backgroundcolorblue>
      <backgroundcolorgreen>136</backgroundcolorgreen>
      <backgroundcolorred>15</backgroundcolorred>
      <bordercolorblue>250</bordercolorblue>
      <bordercolorgreen>231</bordercolorgreen>
      <bordercolorred>200</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>250</fontcolorblue>
      <fontcolorgreen>231</fontcolorgreen>
      <fontcolorred>200</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>100</height>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <note>Exports a pipeline and a workflow with both launchers: --format svg / MERMAID / mermaid,
-o files ending in .mmd and .svg without --format, no format and no -o (an SVG next to the file),
and a folder export with -s and -t. Guards the formats that do have an exporter (issue #9383).</note>
      <width>560</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>main-0002-export-unknown-format-fails</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>hop export fails, and writes nothing, for a format without an exporter</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/11/08 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/08 10:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>112</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Export as PDF and as a typo</name>
      <description/>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>SUBJECT="${PROJECT_HOME}/subject"
OUT="${PROJECT_HOME}/output/0002-unknown-format"
rm -rf "$OUT"

fail() {
  echo "$1"
  test -f "$OUT/last.log" &amp;&amp; cat "$OUT/last.log"
  exit 1
}

# expect_failure EXIT_CODE FORMAT_ID LAUNCHER_ARGS...
# The command must end with EXIT_CODE, name FORMAT_ID and list the formats that do exist.
expect_failure() {
  CODE="$1"
  FORMAT="$2"
  shift 2
  "$@" &gt; "$OUT/last.log" 2&gt;&amp;1
  RC=$?
  test "$RC" = "$CODE" || fail "expected exit code $CODE, got $RC: $*"
  grep -q "No diagram exporter for format '$FORMAT'" "$OUT/last.log" \
    || fail "the error does not name format $FORMAT: $*"
  grep -q 'MERMAID (.mmd)' "$OUT/last.log" &amp;&amp; grep -q 'SVG (.svg)' "$OUT/last.log" \
    || fail "the error does not list the available formats: $*"
}

# "hop export" ends with 1 on a failure, hop-export.sh with 2 (see the hop-export docs).
for SPEC in "1 hop" "2 hop-export.sh"; do
  set -- $SPEC
  CODE="$1"
  if [ "$2" = "hop" ]; then LAUNCHER="bash hop export"; else LAUNCHER="bash hop-export.sh"; fi
  DIR="$OUT/$2"
  mkdir -p "$DIR/batch"
  cp "$SUBJECT/fast-pipeline.hpl" "$DIR/fast-pipeline.hpl"
  cp "$SUBJECT/fast-workflow.hwf" "$DIR/fast-workflow.hwf"

  # --format pdf: there is no PDF exporter, and the default target is fast-pipeline.pdf
  expect_failure "$CODE" PDF $LAUNCHER -f "$DIR/fast-pipeline.hpl" --format pdf
  test ! -e "$DIR/fast-pipeline.pdf" || fail "$LAUNCHER --format pdf wrote fast-pipeline.pdf"

  expect_failure "$CODE" PDF $LAUNCHER -f "$DIR/fast-workflow.hwf" --format pdf
  test ! -e "$DIR/fast-workflow.pdf" || fail "$LAUNCHER --format pdf wrote fast-workflow.pdf"

  # -o x.pdf without --format
  expect_failure "$CODE" PDF $LAUNCHER -f "$DIR/fast-pipeline.hpl" -o "$DIR/x.pdf"
  test ! -e "$DIR/x.pdf" || fail "$LAUNCHER -o x.pdf wrote x.pdf"

  # -o x.png without --format: an extension no exporter writes
  expect_failure "$CODE" PNG $LAUNCHER -f "$DIR/fast-pipeline.hpl" -o "$DIR/x.png"
  test ! -e "$DIR/x.png" || fail "$LAUNCHER -o x.png wrote x.png"

  # a typo
  expect_failure "$CODE" FOO $LAUNCHER -f "$DIR/fast-pipeline.hpl" --format foo -o "$DIR/y.foo"
  test ! -e "$DIR/y.foo" || fail "$LAUNCHER --format foo wrote y.foo"

  # a folder export
  expect_failure "$CODE" PDF $LAUNCHER -s "$SUBJECT" -t "$DIR/batch" --format pdf
  test -z "$(ls -A "$DIR/batch")" || fail "$LAUNCHER -s --format pdf wrote $(ls "$DIR/batch")"
done</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Failure: hop export wrote a format it has no exporter for</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <message>Failure: hop export wrote a format it has no exporter for</message>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Export as PDF and as a typo</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Export as PDF and as a typo</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Export as PDF and as a typo</from>
      <to>Failure: hop export wrote a format it has no exporter for</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>210</backgroundcolorblue>
      <backgroundcolorgreen>136</backgroundcolorgreen>
      <backgroundcolorred>15</backgroundcolorred>
      <bordercolorblue>250</bordercolorblue>
      <bordercolorgreen>231</bordercolorgreen>
      <bordercolorred>200</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>250</fontcolorblue>
      <fontcolorgreen>231</fontcolorgreen>
      <fontcolorred>200</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>100</height>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <note>A standard installation has no PDF exporter. hop export used to write a Mermaid diagram under
the .pdf (or .foo) name and end with exit code 0 (issue #9383).

Each case must end with a non-zero exit code (1 for hop export, 2 for hop-export.sh), name the
format, list MERMAID (.mmd) and SVG (.svg), and leave no file behind.</note>
      <width>560</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>main-0020-test-remote-pipeline-result-files-and-rows</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Regression test for issue #4826: a pipeline that runs through a remote pipeline run
    configuration adds files to its result (Text file output, "add filenames to result") and copies
    rows to it, but the parent workflow never saw either. The remote pipeline engine built its
    Result from the transform metrics alone and polled the server for the basic status, which
    carries no result files or rows. A Mail action after such a pipeline therefore sent no
    attachments, and "Get rows from result" read nothing.

    This workflow runs on the client. It executes 0020-add-file-and-rows-to-result.hpl on the test
    server (run configuration "remote-no-linked-resources", waiting until finished) and then runs
    0020-verify-result-files-and-rows.hpl locally, which reads the workflow result and aborts unless
    it holds exactly the one file and the three rows the remote pipeline produced.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2024/01/01 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2024/01/01 00:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Add file and rows to the result on the server</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0020-add-file-and-rows-to-result.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <run_configuration>remote-no-linked-resources</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>250</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Verify the result files and rows reached this workflow</name>
      <description>Runs locally with the result of the previous action: exactly one result file,
        remote-result-file.txt, and three result rows are expected.</description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/0020-verify-result-files-and-rows.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>50</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Add file and rows to the result on the server</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Add file and rows to the result on the server</from>
      <to>Verify the result files and rows reached this workflow</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

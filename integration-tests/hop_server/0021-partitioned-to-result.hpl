<pipeline>
  <info>
    <name>0021-partitioned-to-result</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>1000 rows partitioned on the Hop Server with Remainder of division and Hash on fields on a key that runs 1 to 7, and with Rebalance. Every row notes the partition (copy) it reached, and goes to the result.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/23 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/23 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>1000 rows</from>
      <to>id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>id</from>
      <to>key 1 to 7</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>key 1 to 7</from>
      <to>Remainder of division on key</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remainder of division on key</from>
      <to>Hash on key</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hash on key</from>
      <to>Rebalance</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Rebalance</from>
      <to>to result</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>1000 rows</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
    </fields>
    <limit>1000</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>id</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <valuename>id</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name/>
    <start_at>1</start_at>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>key 1 to 7</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <valuename>key</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name/>
    <start_at>1</start_at>
    <increment_by>1</increment_by>
    <max_value>7</max_value>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Remainder of division on key</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>ModPartitioner</method>
      <schema_name>part-mod4</schema_name>
      <field_name>key</field_name>
    </partitioning>
    <fields>
      <field>
        <name>modCopy</name>
        <variable>${Internal.Transform.CopyNr}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Hash on key</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>HashPartitioner</method>
      <schema_name>part-hash4</schema_name>
           <fields><field><name>key</name></field></fields>
    </partitioning>
    <fields>
      <field>
        <name>hashCopy</name>
        <variable>${Internal.Transform.CopyNr}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>656</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rebalance</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>RebalancePartitioner</method>
      <schema_name>part-rebalance4</schema_name>
    </partitioning>
    <fields>
      <field>
        <name>rebalanceCopy</name>
        <variable>${Internal.Transform.CopyNr}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>800</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>to result</name>
    <type>RowsToResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>944</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<pipeline>
  <info>
    <name>0020-verify-result-files-and-rows</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Runs locally, right after 0020-add-file-and-rows-to-result ran on the server, and
      reads what that pipeline left in the workflow result: exactly one result file named
      remote-result-file.txt and exactly three result rows. Either count being off aborts the
      pipeline, which fails the workflow. Only the result entries are read; the file itself lives on
      the server and is not opened here.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2024/01/01 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2024/01/01 00:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Get files from result</from>
      <to>Is the remote file?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Is the remote file?</from>
      <to>Count files</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Is the remote file?</from>
      <to>Unexpected file: abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count files</from>
      <to>files != 1?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>files != 1?</from>
      <to>Result file missing: abort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get rows from result</from>
      <to>Count rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count rows</from>
      <to>rows != 3?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>rows != 3?</from>
      <to>Result rows missing: abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Get files from result</name>
    <type>FilesFromResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Is the remote file?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Count files</send_true_to>
    <send_false_to>Unexpected file: abort</send_false_to>
    <compare>
      <condition>
        <leftvalue>filename</leftvalue>
        <operator>-</operator>
        <negated>N</negated>
        <conditions>
</conditions>
        <function>=</function>
        <value>
          <name>constant</name>
          <length>-1</length>
          <text>remote-result-file.txt</text>
          <isnull>N</isnull>
          <type>String</type>
          <mask/>
          <precision>-1</precision>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Unexpected file: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>A result file other than remote-result-file.txt came back from the remote pipeline.</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Count files</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>Y</give_back_row>
    <group>
</group>
    <fields>
      <field>
        <aggregate>files</aggregate>
        <subject>filename</subject>
        <type>COUNT_ANY</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>files != 1?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Result file missing: abort</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <leftvalue>files</leftvalue>
        <operator>-</operator>
        <negated>Y</negated>
        <conditions>
</conditions>
        <function>=</function>
        <value>
          <name>constant</name>
          <length>-1</length>
          <text>1</text>
          <isnull>N</isnull>
          <type>Integer</type>
          <mask>####0;-####0</mask>
          <precision>0</precision>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Result file missing: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>The file the remote pipeline added to its result did not reach the parent workflow (issue #4826).</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Get rows from result</name>
    <type>RowsFromResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>name</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Count rows</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>Y</give_back_row>
    <group>
</group>
    <fields>
      <field>
        <aggregate>rows</aggregate>
        <subject>name</subject>
        <type>COUNT_ANY</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>
  <transform>
    <name>rows != 3?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Result rows missing: abort</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <leftvalue>rows</leftvalue>
        <operator>-</operator>
        <negated>Y</negated>
        <conditions>
</conditions>
        <function>=</function>
        <value>
          <name>constant</name>
          <length>-1</length>
          <text>3</text>
          <isnull>N</isnull>
          <type>Integer</type>
          <mask>####0;-####0</mask>
          <precision>0</precision>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Result rows missing: abort</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <always_log_rows>Y</always_log_rows>
    <message>The rows the remote pipeline copied to its result did not reach the parent workflow (issue #4826).</message>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>336</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

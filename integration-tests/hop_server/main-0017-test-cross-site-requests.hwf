<workflow>
  <name>main-0017-test-cross-site-requests</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Proves hop-server rejects cross-site browser requests and leaves everything else alone (issue #8371). Runs against the default --cross-site-policy same-site.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/14 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/14 00:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Non-browser client is allowed</name>
      <description>hop-run, the Hop GUI, curl and customer automation send no Sec-Fetch-* headers at all. They have to keep working exactly as before, or the change breaks every existing integration.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -o /dev/null -w '%{http_code}' "http://hop-server:8181/hop/status?xml=Y" | grep -q '^200$' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Bookmark or typed address is allowed</name>
      <description>A browser sends Sec-Fetch-Site: none when the operator types the address or uses a bookmark.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -o /dev/null -w '%{http_code}' -H 'Sec-Fetch-Site: none' "http://hop-server:8181/hop/status?xml=Y" | grep -q '^200$' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>112</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>The server's own pages are allowed</name>
      <description>Every link and form on the status page is a same-origin request.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -o /dev/null -w '%{http_code}' -H 'Sec-Fetch-Site: same-origin' "http://hop-server:8181/hop/status?xml=Y" | grep -q '^200$' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>176</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Same-site is allowed under the default policy</name>
      <description>Another host on the same registrable domain - a second Hop server, an intranet portal, the same host on another port. Rejected only under --cross-site-policy same-origin.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -o /dev/null -w '%{http_code}' -H 'Sec-Fetch-Site: same-site' "http://hop-server:8181/hop/status?xml=Y" | grep -q '^200$' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>240</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Cross-site read is rejected</name>
      <description>A page on another site reading the server status through the operator's browser.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -o /dev/null -w '%{http_code}' -H 'Sec-Fetch-Site: cross-site' "http://hop-server:8181/hop/status?xml=Y" | grep -q '^403$' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>304</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Unrecognised Sec-Fetch-Site value is rejected</name>
      <description>A client that cannot send the header correctly can always send nothing at all, so an unknown value fails closed rather than open.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -o /dev/null -w '%{http_code}' -H 'Sec-Fetch-Site: nonsense' "http://hop-server:8181/hop/status?xml=Y" | grep -q '^403$' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>368</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>State-changing endpoint is reachable when allowed</name>
      <description>stopPipeline answers 400 with its own page for a pipeline that does not exist. That the servlet answered at all is what makes the cross-site 403 below meaningful.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -H 'Sec-Fetch-Site: same-origin' "http://hop-server:8181/hop/stopPipeline?name=no-such-pipeline" | grep -q 'Stop pipeline' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>432</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Cross-site stop is rejected</name>
      <description>The same state-changing endpoint, driven from another site, never reaches the servlet.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -o /dev/null -w '%{http_code}' -H 'Sec-Fetch-Site: cross-site' "http://hop-server:8181/hop/stopPipeline?name=no-such-pipeline" | grep -q '^403$' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>496</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Cross-site pipeline execution is rejected</name>
      <description>The case issue #8371 is really about: a visited web page starting a pipeline on a server the operator is logged in to. Rejected before routing, so the pipeline never runs.</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory/>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>curl -u cluster:cluster -s -o /dev/null -w '%{http_code}' -H 'Sec-Fetch-Site: cross-site' "http://hop-server:8181/hop/execPipeline?pipeline=/hop_server_volume/0016-echo-server-variables.hpl&amp;level=BASIC" | grep -q '^403$' || exit 1</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>560</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>624</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort workflow</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>48</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Non-browser client is allowed</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Non-browser client is allowed</from>
      <to>Bookmark or typed address is allowed</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Bookmark or typed address is allowed</from>
      <to>The server's own pages are allowed</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>The server's own pages are allowed</from>
      <to>Same-site is allowed under the default policy</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Same-site is allowed under the default policy</from>
      <to>Cross-site read is rejected</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Cross-site read is rejected</from>
      <to>Unrecognised Sec-Fetch-Site value is rejected</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Unrecognised Sec-Fetch-Site value is rejected</from>
      <to>State-changing endpoint is reachable when allowed</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>State-changing endpoint is reachable when allowed</from>
      <to>Cross-site stop is rejected</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Cross-site stop is rejected</from>
      <to>Cross-site pipeline execution is rejected</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Cross-site pipeline execution is rejected</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Non-browser client is allowed</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Bookmark or typed address is allowed</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>The server's own pages are allowed</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Same-site is allowed under the default policy</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Cross-site read is rejected</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Unrecognised Sec-Fetch-Site value is rejected</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>State-changing endpoint is reachable when allowed</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Cross-site stop is rejected</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Cross-site pipeline execution is rejected</from>
      <to>Abort workflow</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

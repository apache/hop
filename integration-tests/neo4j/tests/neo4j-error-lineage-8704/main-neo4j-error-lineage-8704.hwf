<workflow>
  <name>main-neo4j-error-lineage-8704</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Runs a failing pipeline with the Neo4j execution information location and checks the error lineage, see issue #8704.</description>
  <extended_description>Until issue #8704 the Neo4j execution information location rejected the first registration of
every workflow action because it had no name. The action never made it into the graph, so the pipeline
it executed wasn't connected to the workflow and the Error lineage tab of the workflow stayed empty.

The test leaves the execution graph behind, so the Execution information perspective can be checked in
Hop GUI afterwards. The next run starts by cleaning the database.</extended_description>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/01 10:00:00.000</created_date>
  <modified_date>2026/10/01 10:00:00.000</modified_date>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>96</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connections>
        <connection>Test</connection>
      </connections>
      <name>Check Neo4j Connections</name>
      <description/>
      <type>NEO4J_CHECK_CONNECTIONS</type>
      <attributes/>
      <xloc>224</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/tests/shared/cleanup-database.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Nothing</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <create_parent_folder>N</create_parent_folder>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>cleanup-database.hwf</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <xloc>384</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/tests/neo4j-error-lineage-8704/error-lineage-8704-run.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <create_parent_folder>N</create_parent_folder>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local-neo4j</run_configuration>
      <name>error-lineage-8704-run.hwf</name>
      <description>Fails on purpose, writing execution information to Neo4j</description>
      <type>WORKFLOW</type>
      <attributes/>
      <xloc>576</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>Expected a failure</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>576</xloc>
      <yloc>272</yloc>
      <attributes_hac/>
    </action>
    <action>
      <test_names>
        <test_name>
          <name>neo4j-error-lineage-8704-validation</name>
        </test_name>
      </test_names>
      <name>Run neo4j-error-lineage-8704 Tests</name>
      <description/>
      <type>RunPipelineTests</type>
      <attributes/>
      <xloc>800</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Check Neo4j Connections</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check Neo4j Connections</from>
      <to>cleanup-database.hwf</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>cleanup-database.hwf</from>
      <to>error-lineage-8704-run.hwf</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>error-lineage-8704-run.hwf</from>
      <to>Expected a failure</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>error-lineage-8704-run.hwf</from>
      <to>Run neo4j-error-lineage-8704 Tests</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

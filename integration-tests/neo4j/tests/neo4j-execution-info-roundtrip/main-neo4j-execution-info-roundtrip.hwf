<workflow>
  <name>main-neo4j-execution-info-roundtrip</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Writes a workflow and a pipeline to the Neo4j execution information location while graph logging is on, then reads them back. See issue #9039.</description>
  <extended_description>Graph logging stores executionStart as yyyy/MM/dd'T'HH:mm:ss. The check copies that text onto the pipeline registrationDate and the same instant as an ISO string onto the workflow, then reads both back through the execution information location.</extended_description>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/20 14:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/20 14:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>80</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>cleanup-database.hwf</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/tests/shared/cleanup-database.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Nothing</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <pass_export>N</pass_export>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>enable logging</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <replacevars>Y</replacevars>
      <filename/>
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <fields>
        <field>
          <variable_name>HOP_GRAPH_LOGGING_CONNECTION</variable_name>
          <variable_value>Test</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>subject-workflow.hwf</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <filename>${PROJECT_HOME}/tests/neo4j-execution-info-roundtrip/subject-workflow.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <pass_export>N</pass_export>
      <run_configuration>local-neo4j</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>disable logging</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <replacevars>Y</replacevars>
      <filename/>
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <fields>
        <field>
          <variable_name>HOP_GRAPH_LOGGING_CONNECTION</variable_name>
          <variable_value>-</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>roundtrip-check.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/tests/neo4j-execution-info-roundtrip/roundtrip-check.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>992</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>cleanup-database.hwf</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>cleanup-database.hwf</from>
      <to>enable logging</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>enable logging</from>
      <to>subject-workflow.hwf</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>subject-workflow.hwf</from>
      <to>disable logging</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>disable logging</from>
      <to>roundtrip-check.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

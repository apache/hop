  <transform>
    <name>stringify other dates</name>
    <type>Neo4jCypherOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <cypher>MATCH (e:Execution) WHERE e.executionType IS NOT NULL AND e.registrationDate IS NOT NULL AND NOT valueType(e.registrationDate) STARTS WITH 'STRING' SET e.registrationDate = '2026/10/07T16:08:52' RETURN count(e) AS converted</cypher>
    <cypher_from_field>N</cypher_from_field>
    <read_only>N</read_only>
    <retry>Y</retry>
    <returning_graph>N</returning_graph>
    <unwind>N</unwind>
    <returns>

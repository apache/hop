<pipeline>
  <info>
    <name>roundtrip-check</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads the subject workflow and pipeline back from the Neo4j execution information location, including a logging-format registration date. See issue #9039.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/20 14:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/20 14:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>names</from>
      <to>count logging dates</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>count logging dates</from>
      <to>logging dates present</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>logging dates present</from>
      <to>set pipeline date</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>logging dates present</from>
      <to>Abort no logging date</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>set pipeline date</from>
      <to>pipeline updated</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>pipeline updated</from>
      <to>set workflow date</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>pipeline updated</from>
      <to>Abort pipeline not stored</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>set workflow date</from>
      <to>workflow updated</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>workflow updated</from>
      <to>stringify other dates</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>workflow updated</from>
      <to>Abort workflow not stored</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>stringify other dates</from>
      <to>remove typeless</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>remove typeless</from>
      <to>find pipeline</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>remove typeless</from>
      <to>find workflow</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find pipeline</from>
      <to>missing pipeline</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find pipeline</from>
      <to>check pipeline</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>missing pipeline</from>
      <to>Abort missing pipeline</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check pipeline</from>
      <to>find parent</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check pipeline</from>
      <to>execution data</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find parent</from>
      <to>missing parent</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find parent</from>
      <to>check parent</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>missing parent</from>
      <to>Abort missing parent</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>check parent</from>
      <to>keep child lookup fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>keep child lookup fields</from>
      <to>find children</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find children</from>
      <to>child is pipeline</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>child is pipeline</from>
      <to>child ok</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>child ok</from>
      <to>no child</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>no child</from>
      <to>Abort no child</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>execution data</from>
      <to>rows with marker</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>rows with marker</from>
      <to>samples ok</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>samples ok</from>
      <to>no samples</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>no samples</from>
      <to>Abort no samples</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find workflow</from>
      <to>missing workflow</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>find workflow</from>
      <to>check workflow</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>missing workflow</from>
      <to>Abort missing workflow</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>names</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>subject-pipeline</item>
        <item>Pipeline</item>
        <item>subject-workflow</item>
        <item>Workflow</item>
        <item>all-transforms</item>
      </line>
    </data>
    <fields>
      <field>
        <name>pipelineName</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>pipelineType</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>workflowName</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>workflowType</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>owner</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>count logging dates</name>
    <type>Neo4jCypherOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <cypher>MATCH (e:Execution) WHERE e.executionStart IS NOT NULL AND valueType(e.executionStart) STARTS WITH 'STRING' RETURN count(e) AS loggingDates</cypher>
    <cypher_from_field>N</cypher_from_field>
    <read_only>N</read_only>
    <retry>Y</retry>
    <returning_graph>N</returning_graph>
    <unwind>N</unwind>
    <returns>
      <return>
        <name>loggingDates</name>
        <source_type>Integer</source_type>
        <type>Integer</type>
      </return>
    </returns>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>logging dates present</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>set pipeline date</send_true_to>
    <send_false_to>Abort no logging date</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>loggingDates</leftvalue>
        <function>&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>0</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort no logging date</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>Y</always_log_rows>
    <message>Graph logging did not store an executionStart string</message>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform>
    <name>set pipeline date</name>
    <type>Neo4jCypherOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <cypher>MATCH (src:Execution {type: 'PIPELINE', name: 'subject-pipeline'}) WHERE src.executionStart IS NOT NULL AND valueType(src.executionStart) STARTS WITH 'STRING' MATCH (e:Execution {executionType: 'Pipeline', name: 'subject-pipeline'}) SET e.registrationDate = src.executionStart RETURN src.executionStart AS loggedPipelineDate, count(e) AS pipelineNodes</cypher>
    <cypher_from_field>N</cypher_from_field>
    <read_only>N</read_only>
    <retry>Y</retry>
    <returning_graph>N</returning_graph>
    <unwind>N</unwind>
    <returns>
      <return>
        <name>loggedPipelineDate</name>
        <source_type>String</source_type>
        <type>String</type>
      </return>
      <return>
        <name>pipelineNodes</name>
        <source_type>Integer</source_type>
        <type>Integer</type>
      </return>
    </returns>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>pipeline updated</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>set workflow date</send_true_to>
    <send_false_to>Abort pipeline not stored</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>pipelineNodes</leftvalue>
        <function>&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>0</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>

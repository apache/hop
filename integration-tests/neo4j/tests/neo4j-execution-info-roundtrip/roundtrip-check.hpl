  <transform>
    <name>set workflow date</name>
    <type>Neo4jCypherOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <cypher>MATCH (src:Execution {type: 'WORKFLOW', name: 'subject-workflow'}) WHERE src.executionStart IS NOT NULL AND valueType(src.executionStart) STARTS WITH 'STRING' MATCH (e:Execution {executionType: 'Workflow', name: 'subject-workflow'}) SET e.registrationDate = replace(src.executionStart, '/', '-') RETURN replace(src.executionStart, '/', '-') AS loggedWorkflowDate, count(e) AS workflowNodes</cypher>
    <cypher_from_field>N</cypher_from_field>
    <read_only>N</read_only>
    <retry>Y</retry>
    <returning_graph>N</returning_graph>

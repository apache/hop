  <transform>
    <name>remove typeless</name>
    <type>Neo4jCypherOutput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <cypher>MATCH (e:Execution) WHERE e.executionType IS NULL WITH collect(e) AS doomed FOREACH (n IN doomed | DETACH DELETE n) RETURN size(doomed) AS removed</cypher>
    <cypher_from_field>N</cypher_from_field>
    <read_only>N</read_only>
    <retry>Y</retry>
    <returning_graph>N</returning_graph>
    <unwind>N</unwind>
    <returns>
      <return>
        <name>removed</name>
        <source_type>Integer</source_type>
        <type>Integer</type>
      </return>
    </returns>
    <attributes/>
    <GUI>
      <xloc>1488</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

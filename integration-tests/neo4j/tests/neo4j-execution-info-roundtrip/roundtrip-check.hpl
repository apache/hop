        <jsScript_script><![CDATA[if (registrationDate == null) {
  throw "Workflow execution is missing its registration date";
}
var DateFormat = Packages.java.text.SimpleDateFormat;
var text = "" + new DateFormat("yyyy-MM-dd'T'HH:mm:ss").format(registrationDate);
var expected = "" + loggedWorkflowDate;
if (text != expected) {
  throw "Workflow registrationDate was [" + text + "] expected [" + expected + "]";
}
]]></jsScript_script>

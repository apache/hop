<workflow>
  <name>main-neo4j-error-path-7662</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Verifies the error path lookup of the Neo4j perspective against a live Neo4j server, see issue #7662.</description>
  <extended_description>The Error path tab of the Neo4j perspective looks for the deepest executions which
reported errors. Until issue #7662 that condition was written as size((err)-[:EXECUTES]->())=0,
which Neo4j 5 rejects because size() on a pattern expression was removed.

This test builds a small Execution graph, the same shape the Neo4j execution information
location writes, and runs the lookup over it. It fails when the statement is rejected by the
server and when the wrong execution is reported as the deepest error.</extended_description>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/07/29 10:00:00.000</created_date>
  <modified_date>2026/07/29 10:00:00.000</modified_date>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>96</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connections>
        <connection>Test</connection>
      </connections>
      <name>Check Neo4j Connections</name>
      <description/>
      <type>NEO4J_CHECK_CONNECTIONS</type>
      <attributes/>
      <xloc>224</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/tests/shared/cleanup-database.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Nothing</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <create_parent_folder>N</create_parent_folder>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>cleanup-database.hwf</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <xloc>384</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection>Test</connection>
      <script>CREATE (workflow:Execution { id : 'it-7662-workflow', name : 'main-7662', type : 'WORKFLOW', registrationDate : '2026-07-29T10:00:00', errors : 1 })
CREATE (pipeline:Execution { id : 'it-7662-pipeline', name : 'load-customers-7662', type : 'PIPELINE', registrationDate : '2026-07-29T10:00:01', errors : 1 })
CREATE (failed:Execution { id : 'it-7662-failed', name : 'Table output', type : 'TRANSFORM', registrationDate : '2026-07-29T10:00:02', errors : 1 })
CREATE (ok:Execution { id : 'it-7662-ok', name : 'Dummy', type : 'TRANSFORM', registrationDate : '2026-07-29T10:00:02', errors : 0 })
CREATE (workflow)-[:EXECUTES]->(pipeline)
CREATE (pipeline)-[:EXECUTES]->(failed)
CREATE (pipeline)-[:EXECUTES]->(ok)
;</script>
      <replace_variables>N</replace_variables>
      <name>Create execution graph</name>
      <description>Builds the Execution graph of a workflow which executed a pipeline with a failing transform</description>
      <type>NEO4J_CYPHER_SCRIPT</type>
      <attributes/>
      <xloc>544</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <test_names>
        <test_name>
          <name>neo4j-error-path-7662-validation</name>
        </test_name>
      </test_names>
      <name>Run neo4j-error-path-7662 Tests</name>
      <description/>
      <type>RunPipelineTests</type>
      <attributes/>
      <xloc>736</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection>Test</connection>
      <script>MATCH (n:Execution) WHERE n.id STARTS WITH 'it-7662-' DETACH DELETE n
;</script>
      <replace_variables>N</replace_variables>
      <name>Remove execution graph</name>
      <description>Removes the executions this test created so it doesn't leave anything behind in the graph</description>
      <type>NEO4J_CYPHER_SCRIPT</type>
      <attributes/>
      <xloc>928</xloc>
      <yloc>128</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Check Neo4j Connections</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check Neo4j Connections</from>
      <to>cleanup-database.hwf</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>cleanup-database.hwf</from>
      <to>Create execution graph</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create execution graph</from>
      <to>Run neo4j-error-path-7662 Tests</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run neo4j-error-path-7662 Tests</from>
      <to>Remove execution graph</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

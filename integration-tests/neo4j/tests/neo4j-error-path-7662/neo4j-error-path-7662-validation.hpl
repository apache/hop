<pipeline>
  <info>
    <name>neo4j-error-path-7662-validation</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Runs the error path lookup of the Neo4j perspective, see issue #7662</description>
    <extended_description>The WHERE clause is the one from HopNeo4jPerspective.getErrorPathCypher(),
including the "AND NOT (err)-[:EXECUTES]-&gt;()" predicate which replaced the size() on a pattern
expression that Neo4j 5 rejects. See issue #7662.

Two things differ from the statement in the perspective, neither touches the predicate under test:
the RETURN is projected onto scalar fields so the result can be compared against a golden data set,
and the variable length patterns are bounded to 20 hops. Without that bound Neo4j returns an
UnboundedVariableLengthPattern notification, and the Cypher transform reports every notification
below WARNING severity as a transform error.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/07/29 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/29 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Subject execution</from>
      <to>Look up error path</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Look up error path</from>
      <to>ERROR PATH</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Subject execution</name>
    <type>RowGenerator</type>
    <description>The execution the Neo4j perspective was opened on</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>subjectName</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>main-7662</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>subjectType</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>WORKFLOW</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>subjectId</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>it-7662-workflow</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Look up error path</name>
    <type>Neo4jCypherOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Test</connection>
    <cypher>MATCH(top:Execution { name : $subjectName, type : $subjectType, id : $subjectId })-[rel:EXECUTES*1..20]-(err:Execution)
   , p=shortestpath((top)-[:EXECUTES*1..20]-(err))
WHERE top.registrationDate IS NOT NULL
  AND err.errors &gt; 0
  AND NOT (err)-[:EXECUTES]-&gt;()
RETURN err.id AS errorId, err.name AS errorName, size(RELATIONSHIPS(p)) AS pathLength
ORDER BY size(RELATIONSHIPS(p)) DESC
LIMIT 10</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <nr_retries_on_error>5</nr_retries_on_error>
    <retry>Y</retry>
    <cypher_from_field>N</cypher_from_field>
    <cypher_field/>
    <unwind>N</unwind>
    <unwind_map/>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <mappings>
      <mapping>
        <parameter>subjectName</parameter>
        <field>subjectName</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>subjectType</parameter>
        <field>subjectType</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>subjectId</parameter>
        <field>subjectId</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>errorId</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>errorName</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>pathLength</name>
        <type>Integer</type>
        <source_type>Integer</source_type>
      </return>
    </returns>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>ERROR PATH</name>
    <type>SelectValues</type>
    <description>Drops the lookup parameters so only the result of the error path is compared</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>errorId</name>
        <rename/>
      </field>
      <field>
        <name>errorName</name>
        <rename/>
      </field>
      <field>
        <name>pathLength</name>
        <rename/>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

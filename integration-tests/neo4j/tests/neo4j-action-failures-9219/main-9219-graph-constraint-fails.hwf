      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>1600</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1792</xloc>
      <yloc>80</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>cleanup-database.hwf</to>
      <enabled>Y</enabled>

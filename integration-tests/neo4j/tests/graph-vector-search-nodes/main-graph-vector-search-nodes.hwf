<workflow>
  <name>main-graph-vector-search-nodes</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Graph vector search on the vector index of nodes</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/07 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/07 12:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>TEST_FOLDER</name>
      <default_value>graph-vector-search-nodes</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>VECTOR_INDEX</name>
      <default_value>graph_vector_search_nodes</default_value>
      <description>The vector index: the actions and Graph vector search resolve its name</description>
    </parameter>
    <parameter>
      <name>VECTOR_LABEL</name>
      <default_value>VectorSearchDoc</default_value>
      <description>The label of the vector index</description>
    </parameter>
    <parameter>
      <name>VECTOR_PROPERTY</name>
      <default_value>embedding</default_value>
      <description>The property of the vector index</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>drop indexes before</name>
      <description/>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>${VECTOR_INDEX}</index_name>
          <object_name>${VECTOR_LABEL}</object_name>
          <object_properties>${VECTOR_PROPERTY}</object_properties>
          <object_type>NODE</object_type>
          <update_type>DROP</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>cleanup-database.hwf</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/tests/shared/cleanup-database.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Nothing</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create indexes</name>
      <description/>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>${VECTOR_INDEX}</index_name>
          <object_name>${VECTOR_LABEL}</object_name>
          <object_properties>${VECTOR_PROPERTY}</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>graph-vector-search-nodes-build.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/tests/graph-vector-search-nodes/graph-vector-search-nodes-build.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Run graph-vector-search-nodes tests</name>
      <description/>
      <type>RunPipelineTests</type>
      <attributes/>
      <test_names>
        <test_name>
          <name>graph-vector-search-nodes-validation UNIT</name>
        </test_name>
      </test_names>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>drop indexes after test</name>
      <description/>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>${VECTOR_INDEX}</index_name>
          <object_name>${VECTOR_LABEL}</object_name>
          <object_properties>${VECTOR_PROPERTY}</object_properties>
          <object_type>NODE</object_type>
          <update_type>DROP</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>1024</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>drop indexes after failure</name>
      <description/>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>Test</connection>
      <updates>
        <update>
          <index_name>${VECTOR_INDEX}</index_name>
          <object_name>${VECTOR_LABEL}</object_name>
          <object_properties>${VECTOR_PROPERTY}</object_properties>
          <object_type>NODE</object_type>
          <update_type>DROP</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>1024</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1184</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Error out</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>graph-vector-search-nodes failed</message>
      <parallel>N</parallel>
      <xloc>1184</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>drop indexes before</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>drop indexes before</from>
      <to>cleanup-database.hwf</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>cleanup-database.hwf</from>
      <to>create indexes</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>create indexes</from>
      <to>graph-vector-search-nodes-build.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>graph-vector-search-nodes-build.hpl</from>
      <to>Run graph-vector-search-nodes tests</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Run graph-vector-search-nodes tests</from>
      <to>drop indexes after test</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>drop indexes after test</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Run graph-vector-search-nodes tests</from>
      <to>drop indexes after failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>drop indexes after failure</from>
      <to>Error out</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.hop</groupId>
        <artifactId>hop-assemblies</artifactId>
        <version>2.21.0-SNAPSHOT</version>
    </parent>

    <artifactId>hop-client</artifactId>
    <packaging>pom</packaging>
    <name>Hop Client</name>

    <properties>
        <!-- Set to false to also build the clients without plugins, see the bare execution. -->
        <hop.bare.skip>true</hop.bare.skip>
        <!-- hop-client-<version>.zip is published to Maven Central next to the copy on
             dist.apache.org, so it can be resolved as a normal artifact. The other assemblies
             (web, plugins, static, debug) stay unpublished through the parent's
             maven.deploy.skip. -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <org.eclipse.swt.cocoa.macosx.aarch64.version>${org.eclipse.platform.version}</org.eclipse.swt.cocoa.macosx.aarch64.version>
        <org.eclipse.swt.cocoa.macosx.x86_64.version>${org.eclipse.platform.version}</org.eclipse.swt.cocoa.macosx.x86_64.version>
        <org.eclipse.swt.gtk.linux.aarch64.version>${org.eclipse.platform.version}</org.eclipse.swt.gtk.linux.aarch64.version>
        <org.eclipse.swt.gtk.linux.x86_64.version>${org.eclipse.platform.version}</org.eclipse.swt.gtk.linux.x86_64.version>
        <org.eclipse.swt.win32.win32.x86_64.version>${org.eclipse.platform.version}</org.eclipse.swt.win32.win32.x86_64.version>
    </properties>

    <!-- hop-core, hop-engine and hop-ui resolve their dependencies against hop-libs. Import it
         here too so lib/core gets the same versions and exclusions as those modules' builds. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.hop</groupId>
                <artifactId>hop-libs</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-assemblies-plugins</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <!-- Unpacked as is; its dependencies must not take part in version mediation
                 for the lib/core dependency set. -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-assemblies-static</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <!-- Unpacked as is; its dependencies must not take part in version mediation
                 for the lib/core dependency set. -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- hop-engines-beam and hop-engines-spark are marketplace-optional plugins (not bundled
             in the client). Use -Pbeam / -Pfull to bake the full Beam plugin — including its
             lib/core and lib/spark-client — into hop-client (IT / fat Beam builds). -->
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-ui</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- RCP fragment -->
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-ui-rcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.swt.cocoa.macosx.aarch64</artifactId>
            <version>${org.eclipse.swt.cocoa.macosx.aarch64.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.swt.cocoa.macosx.x86_64</artifactId>
            <version>${org.eclipse.swt.cocoa.macosx.x86_64.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.swt.gtk.linux.aarch64</artifactId>
            <version>${org.eclipse.swt.gtk.linux.aarch64.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.swt.gtk.linux.x86_64</artifactId>
            <version>${org.eclipse.swt.gtk.linux.x86_64.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId>
            <version>${org.eclipse.swt.win32.win32.x86_64.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Deploy a POM without parent or dependencies; see the assemblies parent. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <!-- The client without plugins, as directories under target/ for
                 tools/check-plugins-isolated.sh: hop-client-<version>-bare (hop-core,
                 hop-engine, hop-ui and hop-ui-rcp without SWT, the headless install) and
                 hop-client-<version>-bare-gui (plus SWT). Off by default and never attached:

                   ./mvnw -pl assemblies/client package -Dhop.bare.skip=false -->
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bare</id>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <skipAssembly>${hop.bare.skip}</skipAssembly>
                            <descriptors>
                                <descriptor>${basedir}/src/assembly-bare/bare.xml</descriptor>
                                <descriptor>${basedir}/src/assembly-bare/bare-gui.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Base manifest (lib/core/hop-client-manifest.json, see
                 org.apache.hop.core.plugins.manifest.PluginManifestGenerator): the jars the client
                 itself puts under lib/, as opposed to the plugins it bundles, which carry their
                 own plugin-manifest.json. With both, every lib/core jar has known owners. -->
            <plugin>
                <groupId>org.apache.hop</groupId>
                <artifactId>hop-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>base-manifest</id>
                        <goals>
                            <goal>manifest</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <!-- hop.manifest.skip is true for assemblies, which bundle plugins -->
                            <skip>false</skip>
                            <base>true</base>
                            <zip>${project.build.directory}/${project.build.finalName}.zip</zip>
                            <includeScope>runtime</includeScope>
                            <excludeTypes>
                                <excludeType>zip</excludeType>
                                <excludeType>pom</excludeType>
                            </excludeTypes>
                            <outputFile>${project.build.directory}/hop-client-manifest.json</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      Opt-in Beam engine + SDKs in hop-client (plugin jar plus its libs in lib/core).
      Analogous to HOP_SPARK_CLIENT_VERSION=native for Spark: default lean client has no Beam
      runners on the classpath; use -Pbeam for IT / local full Beam installs.

        ./mvnw -pl assemblies/client -am package -Pbeam
    -->
    <profiles>
        <profile>
            <id>beam</id>
            <dependencies>
                <dependency>
                    <groupId>org.apache.hop</groupId>
                    <artifactId>hop-engines-beam</artifactId>
                    <version>${project.version}</version>
                    <type>zip</type>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>full</id>
            <dependencies>
                <dependency>
                    <groupId>org.apache.hop</groupId>
                    <artifactId>hop-engines-beam</artifactId>
                    <version>${project.version}</version>
                    <type>zip</type>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>

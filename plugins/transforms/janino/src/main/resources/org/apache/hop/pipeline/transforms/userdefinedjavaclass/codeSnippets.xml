<codeSnippets language="us">

    <!-- ==================== Common use ==================== -->

    <codeSnippet>
        <name>Implement processRow</name>
        <category>COMMON</category>
        <code><![CDATA[//
// Process one row: read a row from the input hop and write a row to the output hop.
// Called until it returns false, at which point the transform is done.
//
public boolean processRow() throws HopException {

  // Get a row from the default input hop.
  //
  Object[] r = getRow();

  // When the row is null there is no more input, so we're done.
  //
  if (r == null) {
    setOutputDone();
    return false;
  }

  if (first) {
    first = false;
    // TODO: one time initialisation, now that the input row layout is known.
  }

  // Always call createOutputRow() so the output row is large enough to hold
  // the fields this transform adds.
  //
  r = createOutputRow(r, data.outputRowMeta.size());

  // TODO: read input fields and calculate output fields, for example:
  //
  //   String value = get(Fields.In, "input_field").getString(r);
  //   get(Fields.Out, "output_field").setValue(r, value + "!");

  // Send the row to the default output hop.
  //
  putRow(data.outputRowMeta, r);

  return true;
}
]]></code>
    </codeSnippet>

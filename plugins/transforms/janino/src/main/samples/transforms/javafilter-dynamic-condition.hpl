<pipeline>
  <info>
    <name>javafilter-dynamic-condition</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>The Java Filter condition itself comes from a parameter, so it can be built at runtime.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>GROUP</name>
        <default_value>A</default_value>
        <description>The department to keep, used inside the condition below.</description>
      </parameter>
      <parameter>
        <name>GROUP_FILTER</name>
        <default_value>"${GROUP}".equals(department)</default_value>
        <description>The whole Java Filter condition. Pass true to keep every row.</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/03 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/03 09:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>The condition of the filter below is nothing but ${GROUP_FILTER}.

Variables are resolved before the expression is compiled, so a variable can hold the complete
condition: a previous pipeline or the parent workflow decides what is filtered, this pipeline
does not have to know. The value used here still holds a variable of its own (${GROUP}), which
is resolved in the same pass.

Run it with -p GROUP_FILTER=true to keep every row, or with -p GROUP=B to keep another
department. Because the condition is compiled when the first row arrives, it is read once per
execution.</note>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <width>680</width>
      <heigth>160</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop><from>rows</from><to>filter from a variable</to><enabled>Y</enabled></hop>
    <hop><from>filter from a variable</from><to>kept</to><enabled>Y</enabled></hop>
    <hop><from>filter from a variable</from><to>filtered out</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>rows</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><set_empty_string>N</set_empty_string><length>-1</length><name>id</name><precision>-1</precision><type>Integer</type></field>
      <field><set_empty_string>N</set_empty_string><length>-1</length><name>department</name><precision>-1</precision><type>String</type></field>
    </fields>
    <data>
      <line><item>1</item><item>A</item></line>
      <line><item>2</item><item>B</item></line>
      <line><item>3</item><item>A</item></line>
    </data>
    <attributes/>
    <GUI><xloc>112</xloc><yloc>272</yloc></GUI>
  </transform>
  <transform>
    <name>filter from a variable</name>
    <type>JavaFilter</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>kept</send_true_to>
    <send_false_to>filtered out</send_false_to>
    <condition>${GROUP_FILTER}</condition>
    <attributes/>
    <GUI><xloc>336</xloc><yloc>272</yloc></GUI>
  </transform>
  <transform>
    <name>kept</name><type>Dummy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/><GUI><xloc>560</xloc><yloc>224</yloc></GUI>
  </transform>
  <transform>
    <name>filtered out</name><type>Dummy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/><GUI><xloc>560</xloc><yloc>320</yloc></GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<pipeline>
  <info>
    <name>javafilter-field-types</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Filtering on the different types a field can have, each one as its own Java class.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/03 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/03 09:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>A field is handed to the expression as the Java class of its Hop type:

  String     java.lang.String        Integer   java.lang.Long
  Number     java.lang.Double        BigNumber java.math.BigDecimal
  Date       java.util.Date          Timestamp java.sql.Timestamp
  Boolean    java.lang.Boolean       Binary    byte[]
  JSON       JsonNode (Jackson)      Internet Address  java.net.InetAddress

The three filters each use one of them. Values are objects, so a null field is a null object:
check for null first, or put the constant in front like "A".equals(field).</note>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <width>680</width>
      <heigth>160</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop><from>rows</from><to>a Timestamp is a Date</to><enabled>Y</enabled></hop>
    <hop><from>a Timestamp is a Date</from><to>a JSON field is a JsonNode</to><enabled>Y</enabled></hop>
    <hop><from>a Timestamp is a Date</from><to>too old</to><enabled>Y</enabled></hop>
    <hop><from>a JSON field is a JsonNode</from><to>a BigNumber compares with compareTo()</to><enabled>Y</enabled></hop>
    <hop><from>a JSON field is a JsonNode</from><to>small or missing id</to><enabled>Y</enabled></hop>
    <hop><from>a BigNumber compares with compareTo()</from><to>kept</to><enabled>Y</enabled></hop>
    <hop><from>a BigNumber compares with compareTo()</from><to>amount too low</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>rows</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><set_empty_string>N</set_empty_string><length>-1</length><name>id</name><precision>-1</precision><type>Integer</type></field>
      <field><set_empty_string>N</set_empty_string><length>-1</length><name>created_at</name><precision>-1</precision><type>Timestamp</type><format>yyyy/MM/dd HH:mm:ss.SSSSSSSSS</format></field>
      <field><set_empty_string>N</set_empty_string><length>-1</length><name>doc</name><precision>-1</precision><type>JSON</type></field>
      <field><set_empty_string>N</set_empty_string><length>-1</length><name>amount</name><precision>-1</precision><type>BigNumber</type></field>
    </fields>
    <data>
      <line><item>1</item><item>2024/06/01 10:00:00.000000000</item><item>{"id": 200, "label": "big"}</item><item>150.55</item></line>
      <line><item>2</item><item>2024/06/02 11:00:00.000000000</item><item>{"id": 5, "label": "small"}</item><item>250.00</item></line>
      <line><item>3</item><item>2000/01/01 00:00:00.000000000</item><item>{"id": 900, "label": "old"}</item><item>10.00</item></line>
      <line><item>4</item><item>2024/06/03 12:00:00.000000000</item><item>{"label": "no id here"}</item><item>99.99</item></line>
      <line><item>5</item><item>2024/06/04 13:00:00.000000000</item><item>{"id": 300, "label": "cheap"}</item><item>1.00</item></line>
    </data>
    <attributes/>
    <GUI><xloc>96</xloc><yloc>272</yloc></GUI>
  </transform>
  <transform>
    <name>a Timestamp is a Date</name>
    <type>JavaFilter</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>a JSON field is a JsonNode</send_true_to>
    <send_false_to>too old</send_false_to>
    <condition>created_at != null &amp;&amp; created_at.after(new java.util.GregorianCalendar(2020, 0, 1).getTime())</condition>
    <attributes/>
    <GUI><xloc>288</xloc><yloc>272</yloc></GUI>
  </transform>
  <transform>
    <name>too old</name><type>Dummy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/><GUI><xloc>288</xloc><yloc>400</yloc></GUI>
  </transform>
  <transform>
    <name>a JSON field is a JsonNode</name>
    <type>JavaFilter</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>a BigNumber compares with compareTo()</send_true_to>
    <send_false_to>small or missing id</send_false_to>
    <condition>doc != null &amp;&amp; doc.has("id") &amp;&amp; doc.get("id").asInt() &gt; 100</condition>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>272</yloc></GUI>
  </transform>
  <transform>
    <name>small or missing id</name><type>Dummy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/><GUI><xloc>480</xloc><yloc>400</yloc></GUI>
  </transform>
  <transform>
    <name>a BigNumber compares with compareTo()</name>
    <type>JavaFilter</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>kept</send_true_to>
    <send_false_to>amount too low</send_false_to>
    <condition>amount != null &amp;&amp; amount.compareTo(new java.math.BigDecimal("100")) &gt; 0</condition>
    <attributes/>
    <GUI><xloc>688</xloc><yloc>272</yloc></GUI>
  </transform>
  <transform>
    <name>kept</name><type>Dummy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/><GUI><xloc>880</xloc><yloc>272</yloc></GUI>
  </transform>
  <transform>
    <name>amount too low</name><type>Dummy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/><GUI><xloc>688</xloc><yloc>400</yloc></GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

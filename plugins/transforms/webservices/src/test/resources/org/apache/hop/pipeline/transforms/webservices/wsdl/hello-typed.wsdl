<!-- The Hello service with document/literal messages. Its types are in an XML schema imported
     from schema/hello-types.xsd, next to this file. -->
<definitions name="HelloTyped" targetNamespace="http://example.com/hello/typed"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://example.com/hello/typed"
    xmlns:types="http://example.com/hello/types"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <types>
    <xsd:schema targetNamespace="http://example.com/hello/typed">
      <xsd:import namespace="http://example.com/hello/types"
          schemaLocation="schema/hello-types.xsd"/>
    </xsd:schema>
  </types>
  <message name="SayHelloRequest">
    <part name="parameters" element="types:sayHello"/>
  </message>
  <message name="SayHelloResponse">
    <part name="parameters" element="types:sayHelloResponse"/>
  </message>
  <portType name="Hello_PortType">
    <operation name="sayHello">
      <input message="tns:SayHelloRequest"/>
      <output message="tns:SayHelloResponse"/>
    </operation>
  </portType>
  <binding name="Hello_Binding" type="tns:Hello_PortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="sayHello">
      <soap:operation soapAction="sayHello"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>
  </binding>
  <service name="Hello_Service">
    <port name="Hello_Port" binding="tns:Hello_Binding">
      <soap:address location="http://localhost:8080/hello"/>
    </port>
  </service>
</definitions>

<!-- The binding and service of the Hello service. The messages and the port type are imported
     from a file next to this one, by a relative location. -->
<definitions name="HelloService" targetNamespace="http://example.com/hello"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://example.com/hello">
  <import namespace="http://example.com/hello" location="abstract/hello-abstract.wsdl"/>
  <binding name="Hello_Binding" type="tns:Hello_PortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="sayHello">
      <soap:operation soapAction="sayHello"/>
      <input><soap:body use="literal" namespace="http://example.com/hello"/></input>
      <output><soap:body use="literal" namespace="http://example.com/hello"/></output>
    </operation>
  </binding>
  <service name="Hello_Service">
    <port binding="tns:Hello_Binding" name="Hello_Port">
      <soap:address location="http://localhost:8080/hello"/>
    </port>
  </service>
</definitions>

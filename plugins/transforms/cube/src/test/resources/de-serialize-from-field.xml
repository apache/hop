<transform>
    <name>De-serialize from file</name>
    <type>CubeInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
        <method>none</method>
        <schema_name/>
    </partitioning>
    <file>
        <name>${java.io.tmpdir}/sample.cube</name>
    </file>
    <limit>5</limit>
    <addfilenameresult>Y</addfilenameresult>
    <include_transform_nr>N</include_transform_nr>
    <filename_in_field>Y</filename_in_field>
    <filename_field>filename</filename_field>
    <attributes></attributes>
    <GUI>
        <xloc>160</xloc>
        <yloc>80</yloc>
    </GUI>
</transform>

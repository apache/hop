<!--
  The REST connection metadata type lives in its own plugin. Declaring its folder here puts
  hop-misc-rest on this plugin's class path, which the class loader group alone does not do:
  the group only decides which loader is shared, not which jars it carries.
-->
<dependencies>
    <folder>../../misc/rest/</folder>
</dependencies>

<pipeline>
  <info>
    <name>call-db-procedure</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/04 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/04 09:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Call a stored procedure in a database. Uses the hop-samples connection, an in-memory H2 database. Set the procedure name before running.</note>
      <xloc>128</xloc>
      <yloc>16</yloc>
      <width>400</width>
      <heigth>27</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>arguments</from>
      <to>Call DB procedure</to>
      <enabled>Y</enabled>
    </hop>
  </order>
<transform>
    <name>arguments</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>value</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>hello</item>
      </line>
      <line>
        <item>world</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
<transform>
    <name>Call DB procedure</name>
    <type>DBProc</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>hop-samples</connection>
    <procedure>addCount</procedure>
    <lookup>
      <arg>
        <name>value</name>
        <direction>IN</direction>
        <type>String</type>
      </arg>
    </lookup>
    <result>
      <name>count</name>
      <type>Integer</type>
    </result>
    <auto_commit>Y</auto_commit>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

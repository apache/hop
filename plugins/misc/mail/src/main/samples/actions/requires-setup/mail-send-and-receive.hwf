<workflow>
  <name>mail-send-and-receive</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/mail/report.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>Report generated by Apache Hop</content>
      <encoding>UTF-8</encoding>
      <name>Write attachment</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <delete_all_before>N</delete_all_before>
      <include_subfolders>N</include_subfolders>
      <fields>
        <field>
          <name>${java.io.tmpdir}/hop-samples/mail</name>
          <filemask>report\.txt</filemask>
        </field>
      </fields>
      <name>Add to result filenames</name>
      <description/>
      <type>ADD_RESULT_FILENAMES</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <server>${MAIL_SMTP_SERVER}</server>
      <destination>${MAIL_TO}</destination>
      <destinationCc/>
      <destinationBCc/>
      <replyto>${MAIL_USER}</replyto>
      <replytoname>Apache Hop</replytoname>
      <subject>Report from Apache Hop</subject>
      <include_date>N</include_date>
      <contact_persion/>
      <contact_phone/>
      <comment>Please find the report attached.</comment>
      <include_files>Y</include_files>
      <fileTypes>
        <fileType>GENERAL</fileType>
      </fileTypes>
      <zip_files>N</zip_files>
      <zip_name/>
      <use_auth>Y</use_auth>
      <usexoauth2>N</usexoauth2>
      <auth_user>${MAIL_USER}</auth_user>
      <auth_password>${MAIL_PASSWORD}</auth_password>
      <only_comment>N</only_comment>
      <use_HTML>N</use_HTML>
      <use_secure_auth>Y</use_secure_auth>
      <use_Priority>N</use_Priority>
      <trusted_hosts/>
      <check_server_identity>Y</check_server_identity>
      <port>${MAIL_SMTP_PORT}</port>
      <secureconnectiontype>TLS</secureconnectiontype>
      <encoding>UTF-8</encoding>
      <replyToAddresses/>
      <embeddedimages/>
      <connectionName/>
      <name>Mail</name>
      <description/>
      <type>MAIL</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <actiontype>get</actiontype>
      <conditionreceiveddate>ignore</conditionreceiveddate>
      <valueimaplist>imaplistall</valueimaplist>
      <aftergetimap>nothing</aftergetimap>
      <servername>${MAIL_IMAP_SERVER}</servername>
      <username>${MAIL_USER}</username>
      <password>${MAIL_PASSWORD}</password>
      <usessl>Y</usessl>
      <sslport>993</sslport>
      <usexoauth2>N</usexoauth2>
      <useproxy>N</useproxy>
      <outputdirectory>${java.io.tmpdir}/hop-samples/mail/inbox</outputdirectory>
      <filenamepattern>name_{SYS|hhmmss_MMddyyyy|}_#IdFile#.mail</filenamepattern>
      <retrievemails>0</retrievemails>
      <delete>N</delete>
      <protocol>IMAP</protocol>
      <saveattachment>Y</saveattachment>
      <savemessage>Y</savemessage>
      <usedifferentfolderforattachment>N</usedifferentfolderforattachment>
      <imapfirstmails>0</imapfirstmails>
      <imapfolder>INBOX</imapfolder>
      <nottermsendersearch>N</nottermsendersearch>
      <nottermbodysearch>N</nottermbodysearch>
      <nottermsubjectsearch>N</nottermsubjectsearch>
      <nottermreceipientsearh>N</nottermreceipientsearh>
      <nottermreceiveddatesearch>N</nottermreceiveddatesearch>
      <includesubfolders>N</includesubfolders>
      <createmovetofolder>N</createmovetofolder>
      <createlocalfolder>Y</createlocalfolder>
      <name>Get mails</name>
      <description/>
      <type>GET_POP</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>Mail sent, inbox downloaded to ${java.io.tmpdir}/hop-samples/mail/inbox</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Write attachment</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write attachment</from>
      <to>Add to result filenames</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add to result filenames</from>
      <to>Mail</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Mail</from>
      <to>Get mails</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get mails</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Mail action sends an email, optionally with the result files of the workflow as attachments. It can use a server and credentials,
or a mail server connection from the project metadata.

The Get mails (POP3/IMAP) action reads emails from a mailbox and saves the messages and/or attachments to a folder. It can also delete or move the messages it read.

This sample sends an email with a file attached and then downloads the messages of the inbox to ${java.io.tmpdir}/hop-samples/mail/inbox.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>1120</width>
      <height>192</height>
    </notepad>
    <notepad>
      <note>Requires setup: this sample needs a mail server. Set the MAIL_SMTP_SERVER, MAIL_SMTP_PORT, MAIL_IMAP_SERVER, MAIL_USER, MAIL_PASSWORD and MAIL_TO variables
(for example in an environment configuration file) before running it.
This sample is excluded from the samples integration tests.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>110</fontcolorred>
      <fontcolorgreen>50</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>220</backgroundcolorgreen>
      <backgroundcolorblue>180</backgroundcolorblue>
      <bordercolorred>230</bordercolorred>
      <bordercolorgreen>126</bordercolorgreen>
      <bordercolorblue>34</bordercolorblue>
      <xloc>80</xloc>
      <yloc>240</yloc>
      <width>1120</width>
      <height>110</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

<pipeline>
  <info>
    <name>mail</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/04 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/04 09:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Send an email for every row. Create a mail connection named sample-mail before running.</note>
      <xloc>128</xloc>
      <yloc>16</yloc>
      <width>400</width>
      <heigth>27</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>messages</from>
      <to>send mail</to>
      <enabled>Y</enabled>
    </hop>
  </order>
<transform>
    <name>messages</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>to</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>subject</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>message</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>senderAddress</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>senderName</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>someone@example.org</item>
        <item>Hello from Hop</item>
        <item>This is a sample message.</item>
        <item>hop@example.org</item>
        <item>Apache Hop</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
<transform>
    <name>send mail</name>
    <type>Mail</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attachContentField/>
    <attachContentFileNameField/>
    <attachContentFromField>N</attachContentFromField>
    <auth_password>Encrypted </auth_password>
    <auth_user/>
    <check_server_identity>N</check_server_identity>
    <comment>message</comment>
    <connectionName>sample-mail</connectionName>
    <contact_person/>
    <contact_phone/>
    <destination>to</destination>
    <destinationBCc/>
    <destinationCc/>
    <dynamicFieldname/>
    <dynamicWildcard/>
    <dynamicZipFilename/>
    <embeddedimages>
</embeddedimages>
    <encoding>UTF-8</encoding>
    <importance>normal</importance>
    <include_date>N</include_date>
    <include_files>N</include_files>
    <include_message_in_output>N</include_message_in_output>
    <include_subfolders>N</include_subfolders>
    <isFilenameDynamic>N</isFilenameDynamic>
    <message_output_field/>
    <only_comment>N</only_comment>
    <port/>
    <priority>normal</priority>
    <replyToAddresses/>
    <replyto>senderAddress</replyto>
    <replytoname>senderName</replytoname>
    <secureconnectiontype>SSL</secureconnectiontype>
    <sensitivity>normal</sensitivity>
    <server/>
    <sourcefilefoldername/>
    <sourcewildcard/>
    <subject>subject</subject>
    <trusted_hosts/>
    <use_HTML>N</use_HTML>
    <use_Priority>N</use_Priority>
    <use_auth>N</use_auth>
    <use_secure_auth>N</use_secure_auth>
    <usexoauth2>N</usexoauth2>
    <zipFilenameDynamic>N</zipFilenameDynamic>
    <zip_files>N</zip_files>
    <zip_limit_size>0</zip_limit_size>
    <zip_name/>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

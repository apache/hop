# Example project hop-lint.yml (override format)
# Copy to your Hop PROJECT ROOT as hop-lint.yml — this file is NOT installed with the plugin.
# Pack rules ship in plugin YAML:
#   hop-lint-core.yml (Apache core rules, in hop-lint)
#   any installed vendor rule pack (e.g. hop-lint-pack.yml in a third-party plugin)
# Use this file for per-project overrides only.

rules:
  TRANS-001:
    enabled: true
    severity: WARNING
    parameters:
      maxTransforms: 20

  TRANS-002:
    enabled: true
    severity: WARNING
    parameters: {}

  DB-001:
    enabled: true
    severity: ERROR
    parameters: {}

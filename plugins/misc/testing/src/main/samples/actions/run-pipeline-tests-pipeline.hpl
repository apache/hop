<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>run-pipeline-tests-pipeline</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/07 10:00:00.000</created_date>
    <modified_date>2026/10/07 10:00:00.000</modified_date>
    <created_hop_version/>
    <modified_hop_version/>
  </info>
  <transform>
    <type>DataGrid</type>
    <name>Order lines</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <name>product</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <name>quantity</name>
        <type>Integer</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <name>price</name>
        <type>Integer</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>Hop T-shirt</item>
        <item>2</item>
        <item>20</item>
      </line>
      <line>
        <item>Hop mug</item>
        <item>3</item>
        <item>10</item>
      </line>
      <line>
        <item>Hop sticker</item>
        <item>10</item>
        <item>1</item>
      </line>
    </data>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>80</xloc>
      <yloc>176</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Calculator</type>
    <name>Line total</name>
    <calculation>
      <field_name>total</field_name>
      <calc_type>MULTIPLY</calc_type>
      <field_a>quantity</field_a>
      <field_b>price</field_b>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
    </calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>272</xloc>
      <yloc>176</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Output</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>464</xloc>
      <yloc>176</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Order lines</from>
      <to>Line total</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Line total</from>
      <to>Output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>This pipeline is tested by the run-pipeline-tests-unit unit test, which is executed by the run-pipeline-tests workflow.
The unit test replaces the rows of the Order lines data grid with the run-pipeline-tests-input data set
and compares the rows arriving in Output with the run-pipeline-tests-golden data set.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>640</width>
      <height>90</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>

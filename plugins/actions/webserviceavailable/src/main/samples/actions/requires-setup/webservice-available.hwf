<workflow>
  <name>webservice-available</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <url>https://hop.apache.org</url>
      <connectTimeOut>5000</connectTimeOut>
      <readTimeOut>10000</readTimeOut>
      <name>Website available?</name>
      <description/>
      <type>WEBSERVICE_AVAILABLE</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>https://hop.apache.org is available.</logmessage>
      <name>Available</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>512</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject/>
      <logmessage>https://hop.apache.org is not available.</logmessage>
      <name>Not available</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>544</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Website available?</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Website available?</from>
      <to>Available</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Website available?</from>
      <to>Not available</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Check if webservice is available action succeeds when a URL can be opened within the connect and read timeouts (in milliseconds).
Use it to check that a REST API or website is up before calling it.

This sample checks the Apache Hop website.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>640</width>
      <height>120</height>
    </notepad>
    <notepad>
      <note>Requires setup: this sample needs internet access (or change the URL to a server in your network).
This sample is excluded from the samples integration tests.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>110</fontcolorred>
      <fontcolorgreen>50</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>220</backgroundcolorgreen>
      <backgroundcolorblue>180</backgroundcolorblue>
      <bordercolorred>230</bordercolorred>
      <bordercolorgreen>126</bordercolorgreen>
      <bordercolorblue>34</bordercolorblue>
      <xloc>80</xloc>
      <yloc>168</yloc>
      <width>640</width>
      <height>70</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

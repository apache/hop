<action>
    <catalog>prod-datahub</catalog>
    <check_deprecation>Y</check_deprecation>
    <max_age>26</max_age>
    <max_age_unit>HOURS</max_age_unit>
    <check_assertions>N</check_assertions>
    <unknown_answer>IGNORE</unknown_answer>
    <datasets>
        <dataset>
            <type>TABLE</type>
            <connection>warehouse</connection>
            <schema>public</schema>
            <name>orders</name>
        </dataset>
        <dataset>
            <type>FILE</type>
            <name>${INBOX}/customers.csv</name>
        </dataset>
        <dataset>
            <type>CATALOG_ID</type>
            <name>urn:li:dataset:(urn:li:dataPlatform:s3,bucket/key,PROD)</name>
        </dataset>
    </datasets>
</action>

<workflow>
  <name>file-compare</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/file-compare/a.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>Hello, Apache Hop!</content>
      <encoding>UTF-8</encoding>
      <name>Write a.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/file-compare/b.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>Hello, Apache Hop!</content>
      <encoding>UTF-8</encoding>
      <name>Write b.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/file-compare/c.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>Goodbye!</content>
      <encoding>UTF-8</encoding>
      <name>Write c.txt</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename1>${java.io.tmpdir}/hop-samples/file-compare/a.txt</filename1>
      <filename2>${java.io.tmpdir}/hop-samples/file-compare/b.txt</filename2>
      <add_filename_result>N</add_filename_result>
      <name>a.txt = b.txt?</name>
      <description/>
      <type>FILE_COMPARE</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename1>${java.io.tmpdir}/hop-samples/file-compare/a.txt</filename1>
      <filename2>${java.io.tmpdir}/hop-samples/file-compare/c.txt</filename2>
      <add_filename_result>N</add_filename_result>
      <name>a.txt = c.txt?</name>
      <description/>
      <type>FILE_COMPARE</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>a.txt and b.txt are identical, a.txt and c.txt are different.</logmessage>
      <name>Files differ</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>a.txt and c.txt should be different</message>
      <loglevel>Error</loglevel>
      <name>Unexpected: a = c</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>1232</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>a.txt and b.txt should be identical</message>
      <loglevel>Error</loglevel>
      <name>Unexpected: a &lt;&gt; b</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Write a.txt</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write a.txt</from>
      <to>Write b.txt</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write b.txt</from>
      <to>Write c.txt</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write c.txt</from>
      <to>a.txt = b.txt?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>a.txt = b.txt?</from>
      <to>a.txt = c.txt?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>a.txt = b.txt?</from>
      <to>Unexpected: a &lt;&gt; b</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>a.txt = c.txt?</from>
      <to>Unexpected: a = c</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>a.txt = c.txt?</from>
      <to>Files differ</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The File compare action compares the content of two files. It succeeds when both files are identical and fails when they differ.

This sample writes three files to ${java.io.tmpdir}/hop-samples/file-compare: a.txt and b.txt have the same content, c.txt is different.
Comparing a.txt with b.txt follows the success (green) hop, comparing a.txt with c.txt follows the failure (red) hop.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>1312</width>
      <height>156</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

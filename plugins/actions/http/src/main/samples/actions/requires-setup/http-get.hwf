<workflow>
  <name>http-get</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <url>https://hop.apache.org</url>
      <connectTimeOut>5000</connectTimeOut>
      <readTimeOut>10000</readTimeOut>
      <name>Website available?</name>
      <description/>
      <type>WEBSERVICE_AVAILABLE</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <url>https://hop.apache.org</url>
      <targetfilename>${java.io.tmpdir}/hop-samples/http/hop.html</targetfilename>
      <file_appended>N</file_appended>
      <date_time_added>N</date_time_added>
      <targetfilename_extension/>
      <uploadfilename/>
      <url_fieldname/>
      <upload_fieldname/>
      <dest_fieldname/>
      <run_every_row>N</run_every_row>
      <ignore_ssl>N</ignore_ssl>
      <proxy_host/>
      <proxy_port/>
      <non_proxy_hosts/>
      <username/>
      <password>Encrypted </password>
      <addfilenameresult>N</addfilenameresult>
      <headers/>
      <name>Download home page</name>
      <description/>
      <type>HTTP</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>Home page downloaded to ${java.io.tmpdir}/hop-samples/http/hop.html</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject/>
      <logmessage>https://hop.apache.org is not available.</logmessage>
      <name>Not available</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>544</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Website available?</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Website available?</from>
      <to>Download home page</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Download home page</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Website available?</from>
      <to>Not available</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Http action downloads the response of a URL to a file, or uploads a file to a URL. Headers, authentication and proxy settings can be configured,
and the URL can be taken from the result rows to download multiple files.

This sample checks that the Apache Hop website is available and downloads its home page to ${java.io.tmpdir}/hop-samples/http/hop.html.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>736</width>
      <height>138</height>
    </notepad>
    <notepad>
      <note>Requires setup: this sample needs internet access (or change the URL to a server in your network).
This sample is excluded from the samples integration tests.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>110</fontcolorred>
      <fontcolorgreen>50</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>220</backgroundcolorgreen>
      <backgroundcolorblue>180</backgroundcolorblue>
      <bordercolorred>230</bordercolorred>
      <bordercolorgreen>126</bordercolorgreen>
      <bordercolorblue>34</bordercolorblue>
      <xloc>80</xloc>
      <yloc>186</yloc>
      <width>736</width>
      <height>70</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

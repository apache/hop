<action>
    <xmlfilename>${Internal.Entry.Current.Folder}/files/in.xml</xmlfilename>
    <xslfilename>${Internal.Entry.Current.Folder}/files/style.xsl</xslfilename>
    <outputfilename>${Internal.Entry.Current.Folder}/files/out.csv</outputfilename>
    <ifFileExists>0</ifFileExists>
    <addfiletoresult>Y</addfiletoresult>
    <filenamesfromprevious>Y</filenamesfromprevious>
    <xsltfactory>SAXON</xsltfactory>
    <parameters>
        <parameter>
            <name>paramName</name>
            <field>paramField</field>
        </parameter>
    </parameters>
    <outputproperties>
        <outputproperty>
            <name>encoding</name>
            <value>UTF-8</value>
        </outputproperty>
    </outputproperties>
</action>

<workflow>
  <name>xsd-validator</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <xsdSource>filename</xsdSource>
      <xmlFilename>${PROJECT_HOME}/files/xml-actions/orders.xml</xmlFilename>
      <xsdFilename>${PROJECT_HOME}/files/xml-actions/orders.xsd</xsdFilename>
      <allowExternalEntities>N</allowExternalEntities>
      <name>Validate against XSD</name>
      <description/>
      <type>XSD_VALIDATOR</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>orders.xml matches the orders.xsd schema.</logmessage>
      <name>Valid</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>512</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject/>
      <logmessage>orders.xml does not match the orders.xsd schema.</logmessage>
      <name>Invalid</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Validate against XSD</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate against XSD</from>
      <to>Valid</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate against XSD</from>
      <to>Invalid</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The XSD validator action validates an XML file against an XML schema definition (XSD).
The schema can be specified as a file, or be taken from the schema location in the XML document.

This sample validates ${PROJECT_HOME}/files/xml-actions/orders.xml against ${PROJECT_HOME}/files/xml-actions/orders.xsd.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>640</width>
      <height>120</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

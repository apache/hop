<workflow>
  <name>sql-script</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>CREATE TABLE IF NOT EXISTS PUBLIC.SAMPLE_SQL_SCRIPT
(
  id INT
, name VARCHAR(50)
);

DELETE FROM PUBLIC.SAMPLE_SQL_SCRIPT;

INSERT INTO PUBLIC.SAMPLE_SQL_SCRIPT VALUES
(1, 'Apache Hop'),
(2, 'Apache Beam'),
(3, 'Apache Spark');</sql>
      <connection>hop-samples</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>Create and fill table</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <is_usevars>N</is_usevars>
      <is_custom_sql>N</is_custom_sql>
      <custom_sql/>
      <connection>hop-samples</connection>
      <tablename>SAMPLE_SQL_SCRIPT</tablename>
      <schemaname>PUBLIC</schemaname>
      <limit>3</limit>
      <success_condition>rows_count_equal</success_condition>
      <name>3 rows?</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>Table SAMPLE_SQL_SCRIPT contains 3 rows.</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>SAMPLE_SQL_SCRIPT should contain 3 rows</message>
      <loglevel>Error</loglevel>
      <name>Unexpected row count</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create and fill table</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create and fill table</from>
      <to>3 rows?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>3 rows?</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>3 rows?</from>
      <to>Unexpected row count</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The SQL action executes one or more SQL statements against a relational database connection.
The statements can be entered in the action or read from a file, and can contain variables.

This sample creates the table SAMPLE_SQL_SCRIPT, clears it and inserts three rows.
The hop-samples connection is an in-memory H2 database, so no database server is needed to run this sample.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>

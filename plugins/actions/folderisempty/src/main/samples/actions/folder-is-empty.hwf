<workflow>
  <name>folder-is-empty</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>${java.io.tmpdir}/hop-samples/folder-is-empty</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <name>Remove work folder</name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <foldername>${java.io.tmpdir}/hop-samples/folder-is-empty</foldername>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <name>Create empty folder</name>
      <description/>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <foldername>${java.io.tmpdir}/hop-samples/folder-is-empty</foldername>
      <include_subfolders>N</include_subfolders>
      <specify_wildcard>N</specify_wildcard>
      <wildcard/>
      <name>Folder is empty?</name>
      <description/>
      <type>FOLDER_IS_EMPTY</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/folder-is-empty/file.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>Some content</content>
      <encoding>UTF-8</encoding>
      <name>Write a file</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <foldername>${java.io.tmpdir}/hop-samples/folder-is-empty</foldername>
      <include_subfolders>N</include_subfolders>
      <specify_wildcard>N</specify_wildcard>
      <wildcard/>
      <name>Folder still empty?</name>
      <description/>
      <type>FOLDER_IS_EMPTY</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>The folder should no longer be empty</message>
      <loglevel>Error</loglevel>
      <name>Unexpected</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>1232</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>The folder contains a file now.</logmessage>
      <name>Folder is no longer empty</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>A new folder should be empty</message>
      <loglevel>Error</loglevel>
      <name>Folder not empty</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Remove work folder</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove work folder</from>
      <to>Create empty folder</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create empty folder</from>
      <to>Folder is empty?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Folder is empty?</from>
      <to>Write a file</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Folder is empty?</from>
      <to>Folder not empty</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write a file</from>
      <to>Folder still empty?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Folder still empty?</from>
      <to>Unexpected</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Folder still empty?</from>
      <to>Folder is no longer empty</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Folder is empty action succeeds when a folder contains no files. Optionally, only files matching a wildcard (regular expression) are counted.

This sample creates the empty folder ${java.io.tmpdir}/hop-samples/folder-is-empty and checks it, then writes a file into it and checks it again.
The second check fails, which takes the failure (red) hop.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>1312</width>
      <height>138</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.hop</groupId>
        <artifactId>hop-plugins-actions</artifactId>
        <version>2.20.0-SNAPSHOT</version>
    </parent>

    <artifactId>hop-action-ftp</artifactId>
    <packaging>jar</packaging>

    <name>Hop Plugins Actions Get/Put/Delete a file with FTP</name>

    <properties>
        <commons-net-version>3.12.0</commons-net-version>
        <!-- The FTP delete action talks SFTP through the client of the SFTP technology plugin. It
             sees it through the shared "sftp" class loader group, so the jar must not be copied
             into lib/core on top of that. -->
        <hop.libcore.exclude1>org.apache.hop:hop-tech-sftp</hop.libcore.exclude1>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.hop</groupId>
                <artifactId>hop-libs</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
            <version>${commons-net-version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The FTP delete action can talk SFTP as well: it uses the SFTP client of the SFTP
             technology plugin.  Both plugins share the "sftp" class loader group at runtime. -->
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-tech-sftp</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>

<workflow>
  <name>dos-to-unix</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>${java.io.tmpdir}/hop-samples/dos-to-unix</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <name>Remove work folder</name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/dos-to-unix/lines.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>line 1
line 2
line 3
</content>
      <encoding>UTF-8</encoding>
      <name>Write Unix file</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <include_subfolders>N</include_subfolders>
      <nr_errors_less_than>10</nr_errors_less_than>
      <success_condition>success_if_no_errors</success_condition>
      <resultfilenames>nothing</resultfilenames>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/hop-samples/dos-to-unix</source_filefolder>
          <wildcard>.*\.txt</wildcard>
          <ConversionType>unixtodos</ConversionType>
        </field>
      </fields>
      <name>Unix to DOS</name>
      <description/>
      <type>DOS_UNIX_CONVERTER</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <include_subfolders>N</include_subfolders>
      <nr_errors_less_than>10</nr_errors_less_than>
      <success_condition>success_if_no_errors</success_condition>
      <resultfilenames>nothing</resultfilenames>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/hop-samples/dos-to-unix</source_filefolder>
          <wildcard>.*\.txt</wildcard>
          <ConversionType>dostounix</ConversionType>
        </field>
      </fields>
      <name>DOS to Unix</name>
      <description/>
      <type>DOS_UNIX_CONVERTER</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>Converted ${java.io.tmpdir}/hop-samples/dos-to-unix/lines.txt to Windows and back to Unix line endings.</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Remove work folder</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove work folder</from>
      <to>Write Unix file</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write Unix file</from>
      <to>Unix to DOS</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Unix to DOS</from>
      <to>DOS to Unix</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DOS to Unix</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Dos To Unix action converts the line endings of text files between Windows (CR+LF) and Unix (LF).
The conversion can be set per file or folder: guess (detect the format and convert to the other one), DOS to Unix or Unix to DOS.

This sample writes a text file with Unix line endings to ${java.io.tmpdir}/hop-samples/dos-to-unix, converts it to Windows line endings and then back to Unix line endings.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>1120</width>
      <height>138</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

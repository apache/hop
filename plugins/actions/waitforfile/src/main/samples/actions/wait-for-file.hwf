<workflow>
  <name>wait-for-file</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/wait-for-file/trigger.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>go</content>
      <encoding>UTF-8</encoding>
      <name>Write trigger file</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/wait-for-file/trigger.txt</filename>
      <maximum_timeout>30</maximum_timeout>
      <check_cycle_time>2</check_cycle_time>
      <success_on_timeout>N</success_on_timeout>
      <file_size_check>N</file_size_check>
      <add_filename_result>N</add_filename_result>
      <name>Wait for trigger file</name>
      <description/>
      <type>WAIT_FOR_FILE</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>The trigger file arrived.</logmessage>
      <name>File arrived</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject/>
      <logmessage>The trigger file did not arrive within 30 seconds.</logmessage>
      <name>Timeout</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Write trigger file</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write trigger file</from>
      <to>Wait for trigger file</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for trigger file</from>
      <to>File arrived</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for trigger file</from>
      <to>Timeout</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Wait for file action waits until a file appears, checking every few seconds. It can also wait until the size of the file stops changing.
Set a maximum timeout to make sure a workflow does not wait forever, and choose whether the action succeeds or fails when the timeout is reached.

In a real workflow another process delivers the file. This sample writes ${java.io.tmpdir}/hop-samples/wait-for-file/trigger.txt itself, so the action finds it at the first check.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>736</width>
      <height>156</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

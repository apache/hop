<workflow>
  <name>copy-move-result-filenames</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>${java.io.tmpdir}/hop-samples/copy-move-result-filenames</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <name>Remove work folder</name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/copy-move-result-filenames/in/file-1.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>File 1</content>
      <encoding>UTF-8</encoding>
      <name>Write file 1</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/copy-move-result-filenames/in/file-2.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>File 2</content>
      <encoding>UTF-8</encoding>
      <name>Write file 2</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <delete_all_before>N</delete_all_before>
      <include_subfolders>N</include_subfolders>
      <fields>
        <field>
          <name>${java.io.tmpdir}/hop-samples/copy-move-result-filenames/in</name>
          <filemask>.*\.txt</filemask>
        </field>
      </fields>
      <name>Add to result filenames</name>
      <description/>
      <type>ADD_RESULT_FILENAMES</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <foldername>${java.io.tmpdir}/hop-samples/copy-move-result-filenames/archive</foldername>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <name>Create archive folder</name>
      <description/>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <foldername/>
      <specify_wildcard>N</specify_wildcard>
      <wildcard/>
      <wildcardexclude/>
      <destination_folder>${java.io.tmpdir}/hop-samples/copy-move-result-filenames/archive</destination_folder>
      <nr_errors_less_than>10</nr_errors_less_than>
      <success_condition>success_if_no_errors</success_condition>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <AddDateBeforeExtension>N</AddDateBeforeExtension>
      <action>copy</action>
      <OverwriteFile>Y</OverwriteFile>
      <CreateDestinationFolder>N</CreateDestinationFolder>
      <RemovedSourceFilename>N</RemovedSourceFilename>
      <AddDestinationFilename>N</AddDestinationFilename>
      <name>Copy result files to archive</name>
      <description/>
      <type>COPY_MOVE_RESULT_FILENAMES</type>
      <attributes/>
      <xloc>1232</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/copy-move-result-filenames/archive/file-2.txt</filename>
      <name>file-2.txt archived?</name>
      <description/>
      <type>FILE_EXISTS</type>
      <attributes/>
      <xloc>1424</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>The result files were copied to the archive folder.</logmessage>
      <name>Files archived</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>1616</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>file-2.txt was not copied to the archive folder</message>
      <loglevel>Error</loglevel>
      <name>Not archived</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>1424</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Remove work folder</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove work folder</from>
      <to>Write file 1</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write file 1</from>
      <to>Write file 2</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write file 2</from>
      <to>Add to result filenames</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add to result filenames</from>
      <to>Create archive folder</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create archive folder</from>
      <to>Copy result files to archive</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Copy result files to archive</from>
      <to>file-2.txt archived?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>file-2.txt archived?</from>
      <to>Files archived</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>file-2.txt archived?</from>
      <to>Not archived</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>Many actions and transforms add the files they read or write to the result filenames of a workflow.
The Copy or Move result filenames action copies or moves exactly those files, or the ones matching a wildcard, to a destination folder.

This sample writes two files to ${java.io.tmpdir}/hop-samples/copy-move-result-filenames/in, adds them to the result filenames and then copies them to ${java.io.tmpdir}/hop-samples/copy-move-result-filenames/archive.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>1696</width>
      <height>138</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

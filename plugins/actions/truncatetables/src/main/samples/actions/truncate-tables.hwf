<workflow>
  <name>truncate-tables</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>CREATE TABLE IF NOT EXISTS PUBLIC.SAMPLE_TRUNCATE_TABLES
(
  id INT
, name VARCHAR(50)
);

DELETE FROM PUBLIC.SAMPLE_TRUNCATE_TABLES;

INSERT INTO PUBLIC.SAMPLE_TRUNCATE_TABLES VALUES
(1, 'Apache Hop'),
(2, 'Apache Beam'),
(3, 'Apache Spark');</sql>
      <connection>hop-samples</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>Create and fill table</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <connection>hop-samples</connection>
      <fields>
        <field>
          <name>SAMPLE_TRUNCATE_TABLES</name>
          <schemaname>PUBLIC</schemaname>
        </field>
      </fields>
      <name>Truncate table</name>
      <description/>
      <type>TRUNCATE_TABLES</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <is_usevars>N</is_usevars>
      <is_custom_sql>N</is_custom_sql>
      <custom_sql/>
      <connection>hop-samples</connection>
      <tablename>SAMPLE_TRUNCATE_TABLES</tablename>
      <schemaname>PUBLIC</schemaname>
      <limit>0</limit>
      <success_condition>rows_count_equal</success_condition>
      <name>Table empty?</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>Table SAMPLE_TRUNCATE_TABLES was truncated.</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>SAMPLE_TRUNCATE_TABLES should be empty</message>
      <loglevel>Error</loglevel>
      <name>Table not empty</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create and fill table</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create and fill table</from>
      <to>Truncate table</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Truncate table</from>
      <to>Table empty?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Table empty?</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Table empty?</from>
      <to>Table not empty</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Truncate tables action removes all rows from one or more tables in a relational database connection.
The list of tables can be specified in the action or be taken from the result rows of a previous action.

This sample creates and fills the table SAMPLE_TRUNCATE_TABLES, truncates it and checks that it is empty.
The hop-samples connection is an in-memory H2 database, so no database server is needed to run this sample.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>928</width>
      <height>120</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

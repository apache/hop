<workflow>
  <name>wait-for-sql</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>CREATE TABLE IF NOT EXISTS PUBLIC.SAMPLE_WAIT_FOR_SQL
(
  id INT
, name VARCHAR(50)
);

DELETE FROM PUBLIC.SAMPLE_WAIT_FOR_SQL;

INSERT INTO PUBLIC.SAMPLE_WAIT_FOR_SQL VALUES
(1, 'Apache Hop'),
(2, 'Apache Beam'),
(3, 'Apache Spark');</sql>
      <connection>hop-samples</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>Create and fill table</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <clear_result_rows>Y</clear_result_rows>
      <add_rows_result>N</add_rows_result>
      <is_usevars>N</is_usevars>
      <is_custom_sql>N</is_custom_sql>
      <custom_sql/>
      <connection>hop-samples</connection>
      <tablename>SAMPLE_WAIT_FOR_SQL</tablename>
      <schemaname>PUBLIC</schemaname>
      <maximum_timeout>30</maximum_timeout>
      <check_cycle_time>5</check_cycle_time>
      <success_on_timeout>N</success_on_timeout>
      <rows_count_value>3</rows_count_value>
      <success_condition>rows_count_greater_equal</success_condition>
      <name>Wait for 3 rows</name>
      <description/>
      <type>WAIT_FOR_SQL</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>SAMPLE_WAIT_FOR_SQL contains at least 3 rows.</logmessage>
      <name>Rows arrived</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject/>
      <logmessage>The rows did not arrive within 30 seconds.</logmessage>
      <name>Timeout</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create and fill table</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create and fill table</from>
      <to>Wait for 3 rows</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for 3 rows</from>
      <to>Rows arrived</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for 3 rows</from>
      <to>Timeout</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Wait for SQL action runs a query or counts the rows in a table at a regular interval, until the row count meets a condition or a timeout is reached.
A typical use is waiting until another system has finished loading a table, or until a control table says a load is done.

In a real workflow another process fills the table. This sample creates the table SAMPLE_WAIT_FOR_SQL itself,
so the action finds the expected 3 rows at the first check.
The hop-samples connection is an in-memory H2 database, so no database server is needed to run this sample.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>

<workflow>
  <name>evaluate-files-metrics</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <arg_from_previous>N</arg_from_previous>
      <fields>
        <field>
          <name>${java.io.tmpdir}/hop-samples/evaluate-files-metrics</name>
        </field>
      </fields>
      <limit_folders>10</limit_folders>
      <success_condition>success_if_no_errors</success_condition>
      <name>Remove work folder</name>
      <description/>
      <type>DELETE_FOLDERS</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/evaluate-files-metrics/sales-1.csv</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>id,amount
1,10</content>
      <encoding>UTF-8</encoding>
      <name>Write file 1</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/evaluate-files-metrics/sales-2.csv</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>id,amount
2,20</content>
      <encoding>UTF-8</encoding>
      <name>Write file 2</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/evaluate-files-metrics/sales-3.csv</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>id,amount
3,30</content>
      <encoding>UTF-8</encoding>
      <name>Write file 3</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <scale>bytes</scale>
      <source_files>files</source_files>
      <evaluation_type>count</evaluation_type>
      <comparevalue>3</comparevalue>
      <minvalue/>
      <maxvalue/>
      <successnumbercondition>equal</successnumbercondition>
      <result_filenames_wildcard/>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/hop-samples/evaluate-files-metrics</source_filefolder>
          <wildcard>.*\.csv</wildcard>
          <include_subFolders>N</include_subFolders>
        </field>
      </fields>
      <Result_field_file/>
      <Result_field_wildcard/>
      <Result_field_includesubfolders/>
      <name>3 csv files?</name>
      <description/>
      <type>EVAL_FILES_METRICS</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <scale>bytes</scale>
      <source_files>files</source_files>
      <evaluation_type>size</evaluation_type>
      <comparevalue>0</comparevalue>
      <minvalue/>
      <maxvalue/>
      <successnumbercondition>greater</successnumbercondition>
      <result_filenames_wildcard/>
      <fields>
        <field>
          <source_filefolder>${java.io.tmpdir}/hop-samples/evaluate-files-metrics</source_filefolder>
          <wildcard>.*\.csv</wildcard>
          <include_subFolders>N</include_subFolders>
        </field>
      </fields>
      <Result_field_file/>
      <Result_field_wildcard/>
      <Result_field_includesubfolders/>
      <name>Files not empty?</name>
      <description/>
      <type>EVAL_FILES_METRICS</type>
      <attributes/>
      <xloc>1232</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>All 3 csv files were delivered and they contain data.</logmessage>
      <name>All files delivered</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>1424</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>Expected 3 csv files</message>
      <loglevel>Error</loglevel>
      <name>Wrong number of files</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>The csv files are empty</message>
      <loglevel>Error</loglevel>
      <name>Empty files</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>1232</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Remove work folder</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove work folder</from>
      <to>Write file 1</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write file 1</from>
      <to>Write file 2</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write file 2</from>
      <to>Write file 3</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write file 3</from>
      <to>3 csv files?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>3 csv files?</from>
      <to>Files not empty?</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>3 csv files?</from>
      <to>Wrong number of files</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Files not empty?</from>
      <to>All files delivered</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Files not empty?</from>
      <to>Empty files</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Evaluate files metrics action evaluates the total size or the number of files in a folder (or in the result filenames) against a value or a range.

This sample writes three csv files to ${java.io.tmpdir}/hop-samples/evaluate-files-metrics, checks that there are exactly 3 csv files and that they are not empty.
A typical use is checking that the expected number of files was delivered before starting a load.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>1504</width>
      <height>138</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

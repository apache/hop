<workflow>
  <name>write-to-file</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/write-to-file/run.log</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>Run log of workflow ${Internal.Workflow.Name}
</content>
      <encoding>UTF-8</encoding>
      <name>Write header</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/write-to-file/run.log</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>Y</appendFile>
      <content>Project home: ${PROJECT_HOME}
</content>
      <encoding>UTF-8</encoding>
      <name>Append line</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>Written to ${java.io.tmpdir}/hop-samples/write-to-file/run.log</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>256</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Write header</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write header</from>
      <to>Append line</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Append line</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Write to file action writes a piece of text to a file. Variables in the text are resolved, the parent folder can be created
and the text can be appended to an existing file instead of replacing it.

This sample creates ${java.io.tmpdir}/hop-samples/write-to-file/run.log with a header line and then appends a second line to it.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>736</width>
      <height>138</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

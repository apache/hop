<workflow>
  <name>snowflake-warehouse-manager</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection>snowflake</connection>
      <managementAction>create</managementAction>
      <warehouseName>HOP_SAMPLES_WH</warehouseName>
      <replace>N</replace>
      <failIfExists>N</failIfExists>
      <failIfNotExists>N</failIfNotExists>
      <warehouseSize>XSMALL</warehouseSize>
      <warehouseType>Standard</warehouseType>
      <maxClusterCount>1</maxClusterCount>
      <minClusterCount>1</minClusterCount>
      <autoSuspend>60</autoSuspend>
      <autoResume>N</autoResume>
      <initiallySuspended>Y</initiallySuspended>
      <resourceMonitor/>
      <comment>Created by the Apache Hop samples</comment>
      <name>Create warehouse</name>
      <description/>
      <type>SnowflakeWarehouseManager</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection>snowflake</connection>
      <managementAction>resume</managementAction>
      <warehouseName>HOP_SAMPLES_WH</warehouseName>
      <replace>N</replace>
      <failIfExists>N</failIfExists>
      <failIfNotExists>Y</failIfNotExists>
      <autoResume>N</autoResume>
      <initiallySuspended>N</initiallySuspended>
      <name>Resume warehouse</name>
      <description/>
      <type>SnowflakeWarehouseManager</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection>snowflake</connection>
      <managementAction>suspend</managementAction>
      <warehouseName>HOP_SAMPLES_WH</warehouseName>
      <replace>N</replace>
      <failIfExists>N</failIfExists>
      <failIfNotExists>Y</failIfNotExists>
      <autoResume>N</autoResume>
      <initiallySuspended>N</initiallySuspended>
      <name>Suspend warehouse</name>
      <description/>
      <type>SnowflakeWarehouseManager</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>HOP_SAMPLES_WH was resumed and suspended.</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create warehouse</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create warehouse</from>
      <to>Resume warehouse</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Resume warehouse</from>
      <to>Suspend warehouse</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Suspend warehouse</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Snowflake warehouse manager action creates, drops, resumes, suspends or alters a Snowflake virtual warehouse.
A typical use is resuming a warehouse before a load and suspending it afterwards, so you only pay for what you use.

This sample creates the HOP_SAMPLES_WH warehouse (if it does not exist yet), resumes it and suspends it again.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>928</width>
      <height>156</height>
    </notepad>
    <notepad>
      <note>Requires setup: this sample needs a Snowflake account and a Snowflake relational database connection called "snowflake" in the project metadata,
with a role that can create and operate warehouses. Create the connection before running this sample.
This sample is excluded from the samples integration tests.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>110</fontcolorred>
      <fontcolorgreen>50</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>220</backgroundcolorgreen>
      <backgroundcolorblue>180</backgroundcolorblue>
      <bordercolorred>230</bordercolorred>
      <bordercolorgreen>126</bordercolorgreen>
      <bordercolorblue>34</bordercolorblue>
      <xloc>80</xloc>
      <yloc>204</yloc>
      <width>928</width>
      <height>110</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>mssql-bulk-load</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <schemaname>dbo</schemaname>
      <tablename>customers</tablename>
      <filename>/data/customers.csv</filename>
      <datafiletype>char</datafiletype>
      <fieldterminator>,</fieldterminator>
      <lineterminated/>
      <codepage>RAW</codepage>
      <specificcodepage/>
      <startfile>2</startfile>
      <endfile>0</endfile>
      <orderby/>
      <addfiletoresult>N</addfiletoresult>
      <formatfilename/>
      <firetriggers>N</firetriggers>
      <checkconstraints>N</checkconstraints>
      <keepnulls>N</keepnulls>
      <tablock>N</tablock>
      <errorfilename/>
      <adddatetime>N</adddatetime>
      <orderdirection>Asc</orderdirection>
      <maxerrors>0</maxerrors>
      <batchsize>0</batchsize>
      <rowsperbatch>0</rowsperbatch>
      <keepidentity>N</keepidentity>
      <truncate>Y</truncate>
      <connection>mssql</connection>
      <name>Bulk load customers</name>
      <description/>
      <type>MSSQL_BULK_LOAD</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>customers loaded.</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Bulk load customers</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Bulk load customers</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The SQL Server bulk loader action loads a data file into a SQL Server table with the BULK INSERT statement. It is much faster than inserting rows one by one.
Note that SQL Server reads the file itself: the file has to be accessible from the database server, not only from the machine running Hop.

This sample truncates the table dbo.customers and loads the comma separated file /data/customers.csv, skipping the header line.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>640</width>
      <height>156</height>
    </notepad>
    <notepad>
      <note>Requires setup: this sample needs a SQL Server database and a relational database connection called "mssql" in the project metadata,
a dbo.customers table and a data file the database server can read. Create those before running this sample.
This sample is excluded from the samples integration tests.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>110</fontcolorred>
      <fontcolorgreen>50</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>220</backgroundcolorgreen>
      <backgroundcolorblue>180</backgroundcolorblue>
      <bordercolorred>230</bordercolorred>
      <bordercolorgreen>126</bordercolorgreen>
      <bordercolorblue>34</bordercolorblue>
      <xloc>80</xloc>
      <yloc>204</yloc>
      <width>640</width>
      <height>110</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

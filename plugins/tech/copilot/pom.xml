<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.hop</groupId>
        <artifactId>hop-plugins-tech</artifactId>
        <version>2.21.0-SNAPSHOT</version>
    </parent>

    <artifactId>hop-tech-copilot</artifactId>
    <packaging>jar</packaging>
    <name>Hop Plugins Technology GitHub Copilot</name>

    <properties>
        <copilot-sdk.version>1.0.28</copilot-sdk.version>
        <hop.pluginlib.exclude1>jackson-databind</hop.pluginlib.exclude1>
        <hop.pluginlib.exclude2>jackson-annotations</hop.pluginlib.exclude2>
        <hop.pluginlib.exclude3>jna</hop.pluginlib.exclude3>
    </properties>

    <dependencies>
        <dependency>
            <!-- The SDK registers JavaTimeModule. Hop's own Jackson databind is loaded parent-first,
                 so ship the module at Hop's Jackson version instead of the SDK's 2.22. -->
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.21.7</version>
        </dependency>
        <dependency>
            <groupId>com.github</groupId>
            <artifactId>copilot-sdk-java</artifactId>
            <version>${copilot-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-core</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- The parent list drops jackson-datatype-jsr310; this plugin must ship it. -->
                        <id>stage-plugin-lib</id>
                        <configuration>
                            <excludeArtifactIds>lombok,jakarta.servlet-api,${hop.pluginlib.exclude1},${hop.pluginlib.exclude2},${hop.pluginlib.exclude3}</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

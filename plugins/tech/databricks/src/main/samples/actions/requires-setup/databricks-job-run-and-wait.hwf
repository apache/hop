<workflow>
  <name>databricks-job-run-and-wait</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection>databricks</connection>
      <run_mode>RUN_EXISTING</run_mode>
      <job_id>123456789</job_id>
      <submit_json/>
      <fat_jar/>
      <pipeline_file/>
      <run_configuration/>
      <dbfs_base>dbfs:/FileStore/hop</dbfs_base>
      <upload_project_package>N</upload_project_package>
      <project_home/>
      <project_package_file/>
      <environment_config_file/>
      <cluster_id/>
      <new_cluster_spark_version/>
      <new_cluster_node_type/>
      <new_cluster_num_workers>1</new_cluster_num_workers>
      <new_cluster_json/>
      <environment_key/>
      <environment_client/>
      <job_name/>
      <update_existing_job>N</update_existing_job>
      <wait_mode>FIRE_AND_FORGET</wait_mode>
      <timeout_seconds>3600</timeout_seconds>
      <poll_seconds>15</poll_seconds>
      <var_job_id>DatabricksJobId</var_job_id>
      <var_run_id>DatabricksRunId</var_run_id>
      <var_status>DatabricksStatus</var_status>
      <var_page_url>DatabricksRunPageUrl</var_page_url>
      <var_error>DatabricksError</var_error>
      <name>Start job</name>
      <description/>
      <type>DATABRICKS_JOB_RUN</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>Databricks run ${DatabricksRunId} started: ${DatabricksRunPageUrl}</logmessage>
      <name>Log run page</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection>databricks</connection>
      <run_id>${DatabricksRunId}</run_id>
      <timeout_seconds>3600</timeout_seconds>
      <poll_seconds>15</poll_seconds>
      <cancel_on_stop>Y</cancel_on_stop>
      <var_job_id>DatabricksJobId</var_job_id>
      <var_run_id>DatabricksRunId</var_run_id>
      <var_status>DatabricksStatus</var_status>
      <var_page_url>DatabricksRunPageUrl</var_page_url>
      <var_error>DatabricksError</var_error>
      <name>Wait for run</name>
      <description/>
      <type>DATABRICKS_JOB_WAIT</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>Databricks run ${DatabricksRunId} finished with status ${DatabricksStatus}</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject/>
      <logmessage>Databricks run ${DatabricksRunId} failed: ${DatabricksError}</logmessage>
      <name>Run failed</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>544</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Start job</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Start job</from>
      <to>Log run page</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Log run page</from>
      <to>Wait for run</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for run</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for run</from>
      <to>Run failed</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The Databricks job run action starts a Databricks job: an existing job, a one-off run from JSON, or a Hop pipeline it deploys itself.
It can wait for the run to finish, or start it and continue ("fire and forget"). The ids, status and page URL of the run are stored in variables.

The Databricks job wait action waits for a run that was started earlier, for example by a job run action in fire and forget mode.

This sample starts an existing job without waiting, writes the run page URL to the log and then waits for the run to finish.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>928</width>
      <height>210</height>
    </notepad>
    <notepad>
      <note>Requires setup: this sample needs a Databricks workspace and a Databricks connection called "databricks" (host and access token) in the project metadata.
Create the connection and change the job id to one of your jobs before running this sample.
This sample is excluded from the samples integration tests.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>

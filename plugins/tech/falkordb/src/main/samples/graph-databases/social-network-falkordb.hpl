<pipeline>
  <info>
    <name>social-network-falkordb</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Write a small social network with Graph output and read it back, on FalkorDB. Needs the graph database connection demo-falkordb.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>90</heigth>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <note>Writes four people and the companies they work at with the Graph output transform and the social-network graph model: a Person and a Company node per row and the WORKS_AT relationship between them.
Then reads them back. Needs the graph database connection demo-falkordb to FalkorDB.
demo-falkordb uses the variables FALKORDB_HOSTNAME and FALKORDB_PORT (6379) and the graph hop_samples.
Every statement is committed on its own: FalkorDB has no transactions.</note>
      <width>720</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>People and companies</from>
      <to>Write the graph</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write the graph</from>
      <to>Wait until written</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait until written</from>
      <to>Who works where</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Who works where</from>
      <to>Write to log</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>People and companies</name>
    <type>DataGrid</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>person_id</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>person_name</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>company_code</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>company_name</name>
        <type>String</type>
      </field>
    </fields>
    <data>
      <line>
        <item>1</item>
        <item>Ann</item>
        <item>ACME</item>
        <item>Acme Corporation</item>
      </line>
      <line>
        <item>2</item>
        <item>Bob</item>
        <item>ACME</item>
        <item>Acme Corporation</item>
      </line>
      <line>
        <item>3</item>
        <item>Cleo</item>
        <item>GLOBEX</item>
        <item>Globex</item>
      </line>
      <line>
        <item>4</item>
        <item>Dan</item>
        <item>INITECH</item>
        <item>Initech</item>
      </line>
    </data>
    <attributes />
    <GUI>
      <xloc>80</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write the graph</name>
    <type>Neo4jGraphOutput</type>
    <description>Person and Company nodes and WORKS_AT relationships, merged on their primary properties</description>
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <batch_size>100</batch_size>
    <connection>demo-falkordb</connection>
    <create_indexes>N</create_indexes>
    <mappings>
      <mapping>
        <source_field>person_id</source_field>
        <target_hint>None</target_hint>
        <target_name>Person</target_name>
        <target_property>id</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>person_name</source_field>
        <target_hint>None</target_hint>
        <target_name>Person</target_name>
        <target_property>name</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>company_code</source_field>
        <target_hint>None</target_hint>
        <target_name>Company</target_name>
        <target_property>code</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>company_name</source_field>
        <target_hint>None</target_hint>
        <target_name>Company</target_name>
        <target_property>name</target_property>
        <target_type>Node</target_type>
      </mapping>
    </mappings>
    <model>social-network</model>
    <node_mappings>
    </node_mappings>
    <out_of_order_allowed>N</out_of_order_allowed>
    <relationship_mappings>
    </relationship_mappings>
    <return_graph_field>graph</return_graph_field>
    <returning_graph>N</returning_graph>
    <validate_against_model>N</validate_against_model>
    <attributes />
    <GUI>
      <xloc>288</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wait until written</name>
    <type>BlockingTransform</type>
    <description>Passes only the last row on, after all rows are written, so the query runs once</description>
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <cache_size>5000</cache_size>
    <compress>Y</compress>
    <directory>${java.io.tmpdir}</directory>
    <pass_all_rows>N</pass_all_rows>
    <prefix>block</prefix>
    <attributes />
    <GUI>
      <xloc>496</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Who works where</name>
    <type>Neo4jCypherOutput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>demo-falkordb</connection>
    <cypher>MATCH (p:Person)-[:WORKS_AT]-&gt;(c:Company)
RETURN p.name AS person, c.name AS company
ORDER BY person</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <retry>N</retry>
    <cypher_from_field>N</cypher_from_field>
    <cypher_field />
    <unwind>N</unwind>
    <unwind_map />
    <returning_graph>N</returning_graph>
    <return_graph_field />
    <mappings>
    </mappings>
    <returns>
      <return>
        <name>person</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>company</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
    </returns>
    <attributes />
    <GUI>
      <xloc>704</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write to log</name>
    <type>WriteToLog</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage />
    <loglevel>log_level_basic</loglevel>
    <fields>
    </fields>
    <attributes />
    <GUI>
      <xloc>912</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.hop</groupId>
        <artifactId>hop-plugins-tech</artifactId>
        <version>2.21.0-SNAPSHOT</version>
    </parent>

    <artifactId>hop-tech-datahub</artifactId>
    <packaging>jar</packaging>
    <name>Hop Plugins Technology DataHub</name>
    <description>ILineageSink plugin that writes Hop lineage to DataHub as metadata change proposals</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.hop</groupId>
                <artifactId>hop-libs</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The mapping, queue and spool this sink extends. At runtime they come from the
             openlineage plugin folder (see dependencies.xml), so nothing is bundled twice. -->
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-tech-openlineage</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.tomakehurst</groupId>
            <artifactId>wiremock-jre8-standalone</artifactId>
            <version>2.35.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Every jar this plugin needs is in the openlineage plugin folder, which
                 dependencies.xml adds to its class path: stage no lib/ folder of its own. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-plugin-lib</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

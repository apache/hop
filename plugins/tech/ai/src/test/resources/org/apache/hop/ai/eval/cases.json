  "workflows": {
    "load": {
      "actions": [
        {
          "name": "Start",
          "pluginId": "SPECIAL"
        },
        {
          "name": "Load orders",
          "pluginId": "PIPELINE",
          "filename": "${PROJECT_HOME}/load_orders.hpl"
        },
        {
          "name": "Success",
          "pluginId": "SUCCESS"
        },
        {
          "name": "Abort load",
          "pluginId": "ABORT"
        }
      ],
      "hops": [
        [
          "Start",
          "Load orders",
          "unconditional"
        ],
        [
          "Load orders",
          "Success",
          "success"
        ],
        [
          "Load orders",
          "Abort load",
          "failure"
        ]
      ]
    },
    "check-then-load": {
      "actions": [
        {
          "name": "Start",
          "pluginId": "SPECIAL"
        },
        {
          "name": "Check orders file",
          "pluginId": "FILE_EXISTS",
          "filename": "/data/in/orders.csv"
        },
        {
          "name": "Load orders",
          "pluginId": "PIPELINE",
          "filename": "${PROJECT_HOME}/load_orders.hpl"
        },
        {
          "name": "Success",
          "pluginId": "SUCCESS"
        }
      ],
      "hops": [
        [
          "Start",
          "Check orders file",
          "unconditional"
        ],
        [
          "Check orders file",
          "Load orders",
          "success"
        ],
        [
          "Load orders",
          "Success",
          "success"
        ]
      ]
    }
  }

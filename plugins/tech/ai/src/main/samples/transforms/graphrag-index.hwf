<workflow>
  <name>graphrag-index</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>GraphRAG indexing on Neo4j, Memgraph or FalkorDB: create the indexes, then index the documents. Uses the graph database connection demo-neo4j (Neo4j 5.18 or later); select demo-memgraph or demo-falkordb in the actions and transforms for those databases. The vector index has 768 dimensions, for nomic-embed-text.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/10 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/10 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create indexes</name>
      <description>Lookup indexes for the MERGEs and the vector index on the chunk embeddings. Existing indexes are left alone.</description>
      <type>NEO4J_INDEX</type>
      <attributes/>
      <connection>demo-neo4j</connection>
      <updates>
        <update>
          <index_name>graphrag_document_id</index_name>
          <object_name>Document</object_name>
          <object_properties>id</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
          <index_type>RANGE</index_type>
        </update>
        <update>
          <index_name>graphrag_chunk_id</index_name>
          <object_name>Chunk</object_name>
          <object_properties>id</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
          <index_type>RANGE</index_type>
        </update>
        <update>
          <index_name>graphrag_entity_key</index_name>
          <object_name>Entity</object_name>
          <object_properties>key</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
          <index_type>RANGE</index_type>
        </update>
        <update>
          <index_name>graphrag_chunks</index_name>
          <object_name>Chunk</object_name>
          <object_properties>embedding</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>768</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Index the documents</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/transforms/graphrag-index.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>

      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create indexes</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create indexes</from>
      <to>Index the documents</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Index the documents</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

<workflow>
  <name>extract-graph-to-database</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Create a unique constraint on Entity.name, then read the graph in texts and write it
    to the graph database. Needs a graph database connection called demo.</description>
  <extended_description />
  <workflow_version />
  <created_user>-</created_user>
  <created_date>2026/10/07 09:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/07 09:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description />
      <type>SPECIAL</type>
      <attributes />
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Unique entity names</name>
      <description />
      <type>NEO4J_CONSTRAINT</type>
      <attributes />
      <connection>demo</connection>
      <updates>
        <update>
          <constraint_type>UNIQUE</constraint_type>
          <index_name>entity_name_unique</index_name>
          <object_name>Entity</object_name>
          <object_properties>name</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Extract and write the graph</name>
      <description />
      <type>PIPELINE</type>
      <attributes />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/transforms/extract-graph-to-database.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Unique entity names</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Unique entity names</from>
      <to>Extract and write the graph</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>60</heigth>
      <xloc>64</xloc>
      <yloc>176</yloc>
      <note>Unique constraints exist on Neo4j and Memgraph. On FalkorDB, Apache AGE or Gremlin, remove the
"Unique entity names" action and connect Start to the pipeline.</note>
      <width>560</width>
    </notepad>
  </notepads>
  <attributes />
</workflow>

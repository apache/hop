<pipeline>
  <info>
    <name>graphrag-ask</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>GraphRAG question answering: embed the question, find the closest chunks with Graph vector search, add the facts the graph holds about the entities each chunk mentions, and ask the chat model. Run graphrag-index.hwf first. Uses the same connections and AI providers.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    <parameter>
      <name>QUESTION</name>
      <default_value>In which city did the designer of the machine Ada Lovelace wrote an algorithm for live?</default_value>
      <description>The question to answer</description>
    </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/10 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/10 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>One row</from>
      <to>Question</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Question</from>
      <to>Embed the question</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Embed the question</from>
      <to>Vector search on chunks</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Vector search on chunks</from>
      <to>Facts of the chunk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Facts of the chunk</from>
      <to>Fact</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fact</from>
      <to>One row per chunk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>One row per chunk</from>
      <to>Label the excerpts</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Label the excerpts</from>
      <to>Context</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Context</from>
      <to>Prompt</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Prompt</from>
      <to>Answer the question</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Answer the question</from>
      <to>Answer</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>One row</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <limit>1</limit>
    <fields/>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Question</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>question</name>
        <variable>${QUESTION}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Embed the question</name>
    <type>EmbedText</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <ai_provider>ollama-embeddings</ai_provider>
    <model_name/>
    <input_field>question</input_field>
    <output_field>question_embedding</output_field>
    <model_field/>
    <dimensions_field/>
    <include_model_metadata>N</include_model_metadata>
    <output_format>VECTOR</output_format>
    <batch_size>1</batch_size>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Vector search on chunks</name>
    <type>GraphVectorSearch</type>
    <description>The 3 chunks closest to the question</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>demo-neo4j</connection>
    <element_type>NODE</element_type>
    <index_name>graphrag_chunks</index_name>
    <label>Chunk</label>
    <vector_property>embedding</vector_property>
    <similarity>COSINE</similarity>
    <embedding_field>question_embedding</embedding_field>
    <top_k>3</top_k>
    <min_score>0</min_score>
    <eat_row_on_no_match>Y</eat_row_on_no_match>
    <score_field>score</score_field>
    <return_properties>
      <return_property>
        <property>id</property>
        <field_name>chunk_id</field_name>
        <type>String</type>
      </return_property>
      <return_property>
        <property>text</property>
        <field_name>chunk_text</field_name>
        <type>String</type>
      </return_property>
    </return_properties>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Facts of the chunk</name>
    <type>Neo4jCypherOutput</type>
    <description>The entities the chunk mentions and their relationships: one row per fact</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>demo-neo4j</connection>
    <cypher>MATCH (c:Chunk {id: $chunk_id})
OPTIONAL MATCH (c)-[:MENTIONS]-&gt;(e:Entity)
OPTIONAL MATCH (e)-[r:RELATED_TO]-&gt;(o:Entity)
RETURN e.name AS entity, e.type AS entity_type, r.type AS relation, o.name AS related_entity</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <nr_retries_on_error/>
    <retry>N</retry>
    <cypher_from_field>N</cypher_from_field>
    <cypher_field/>
    <unwind>N</unwind>
    <unwind_map/>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <mappings>
      <mapping>
        <parameter>chunk_id</parameter>
        <field>chunk_id</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>entity</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>entity_type</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>relation</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
      <return>
        <name>related_entity</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
    </returns>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Fact</name>
    <type>ScriptValueMod</type>
    <description>Entity (type) -RELATION-&gt; other entity</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var fact = null;
if (entity != null) {
  fact = entity;
  if (entity_type != null) {
    fact = fact + " (" + entity_type + ")";
  }
  if (relation != null) {
    fact = fact + " -" + relation + "-&gt; " + related_entity;
  }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>fact</name>
        <rename>fact</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>832</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>One row per chunk</name>
    <type>GroupBy</type>
    <description>The rows of a chunk are consecutive</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>graphrag</prefix>
    <add_linenr>N</add_linenr>
    <all_rows>N</all_rows>
    <fields>
      <field>
        <aggregate>facts</aggregate>
        <subject>fact</subject>
        <type>CONCAT_DISTINCT</type>
        <valuefield>; </valuefield>
      </field>
    </fields>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>question</name>
      </field>
      <field>
        <name>chunk_id</name>
      </field>
      <field>
        <name>chunk_text</name>
      </field>
      <field>
        <name>score</name>
      </field>
    </group>
    <ignore_aggregate>N</ignore_aggregate>
    <attributes/>
    <GUI>
      <xloc>992</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Label the excerpts</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var excerpt = "---\n" + chunk_text;
if (facts != null &amp;&amp; facts != "") {
  excerpt = excerpt + "\nFacts: " + facts;
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>excerpt</name>
        <rename>excerpt</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Context</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>graphrag</prefix>
    <add_linenr>N</add_linenr>
    <all_rows>N</all_rows>
    <fields>
      <field>
        <aggregate>context</aggregate>
        <subject>excerpt</subject>
        <type>CONCAT_STRING_CRLF</type>
        <valuefield/>
      </field>
    </fields>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>question</name>
      </field>
    </group>
    <ignore_aggregate>N</ignore_aggregate>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Prompt</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var prompt = "Answer the question using only the excerpts below. "
  + "Each excerpt lists the facts a knowledge graph holds about the entities it mentions; "
  + "use them to connect information across excerpts. "
  + "If the excerpts don't answer the question, say that you don't know.\n\n"
  + "Excerpts:\n" + context + "\n\nQuestion: " + question + "\n\nAnswer:";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>prompt</name>
        <rename>prompt</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Answer the question</name>
    <type>LanguageModelChat</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <aiProviderName>ollama-local</aiProviderName>
    <inputField>prompt</inputField>
    <inputChatJson>false</inputChatJson>
    <outputChatJson>false</outputChatJson>
    <mock>false</mock>
    <mockOutputValue/>
    <outputFieldNamePrefix>llm_</outputFieldNamePrefix>
    <parallelism>1</parallelism>
    <attributes/>
    <GUI>
      <xloc>1312</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Answer</name>
    <type>WriteToLog</type>
    <description>The answer is in llm_output</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <displayHeader>Y</displayHeader>
    <fields>
      <field>
        <name>question</name>
      </field>
      <field>
        <name>llm_output</name>
      </field>
    </fields>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <loglevel>Basic</loglevel>
    <logmessage/>
    <attributes/>
    <GUI>
      <xloc>1472</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

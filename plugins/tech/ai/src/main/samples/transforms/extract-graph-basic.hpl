<pipeline>
  <info>
    <name>extract-graph-basic</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Read the entities in short texts and the relationships between them. Needs an AI
      provider called ollama-local; change the AI provider option to one of your own.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/18 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/18 09:00:00.000</modified_date>
    <key_for_session_key />
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>texts</from>
      <to>Extract graph</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Extract graph</from>
      <to>graph elements</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>texts</name>
    <type>DataGrid</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <data>
      <line>
        <item>doc-1</item>
        <item>Ada Lovelace worked with Charles Babbage on the Analytical Engine in London. She wrote what is seen as the first computer program for it.</item>
      </line>
      <line>
        <item>doc-2</item>
        <item>Apache Hop is a data orchestration platform developed by the Apache Software Foundation.</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>document_id</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>text</name>
        <type>String</type>
      </field>
    </fields>
    <attributes />
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Extract graph</name>
    <type>ExtractGraph</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <ai_provider>ollama-local</ai_provider>
    <model_name />
    <input_field>text</input_field>
    <entity_types>Person, Organization, Product, Place</entity_types>
    <relationship_types>WORKED_WITH, WORKED_ON, CREATED, LOCATED_IN</relationship_types>
    <instructions />
    <kind_field>graph_element</kind_field>
    <name_field>name</name_field>
    <type_field>type</type_field>
    <description_field>description</description_field>
    <source_field>source</source_field>
    <target_field>target</target_field>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>graph elements</name>
    <type>Dummy</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <GUI>
      <xloc>496</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>

<pipeline>
  <info>
    <name>structured-extract-basic</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Read a severity, a product area, a customer impact flag and an amount out of
      free text support tickets. Needs an AI provider called ollama-local; change the AI provider
      option to one of your own.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/18 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/18 09:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop> <from>tickets</from> <to>Structured extract</to> <enabled>Y</enabled> </hop>
    <hop> <from>Structured extract</from> <to>extracted</to> <enabled>Y</enabled> </hop>
  </order>
  <transform>
    <name>tickets</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <data>
      <line>
        <item>Production database is unreachable since 03:00, the whole order intake is down. Estimated loss so far 4500 euros.</item>
      </line>
      <line>
        <item>The export button on the reporting screen is slightly misaligned in dark mode. Cosmetic only.</item>
      </line>
      <line>
        <item>Invoices for March were sent to the wrong address for about 30 customers. We need a correction run today.</item>
      </line>
    </data>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>ticket_text</name>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Structured extract</name>
    <type>StructuredExtract</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <ai_provider>ollama-local</ai_provider>
    <model_name/>
    <input_field>ticket_text</input_field>
    <instructions>The tickets are written by support staff in a hurry, so they are terse and may contain typos.</instructions>
    <fields>
      <field>
        <name>severity</name>
        <type>String</type>
        <description>How urgent this ticket is</description>
        <required>Y</required>
        <allowed_values>low,medium,high</allowed_values>
      </field>
      <field>
        <name>product_area</name>
        <type>String</type>
        <description>Which part of the product the ticket is about</description>
        <required>N</required>
        <allowed_values></allowed_values>
      </field>
      <field>
        <name>customer_impact</name>
        <type>Boolean</type>
        <description>Whether customers are affected right now</description>
        <required>Y</required>
        <allowed_values></allowed_values>
      </field>
      <field>
        <name>estimated_loss</name>
        <type>Number</type>
        <description>Money lost so far, in euros, if the ticket says</description>
        <required>N</required>
        <allowed_values></allowed_values>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>extracted</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<pipeline>
  <info>
    <name>graphrag-index</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>GraphRAG indexing: split documents into chunks, embed them and write them to the graph database, then extract entities and relationships per chunk. Needs the graph database connection demo-neo4j (Neo4j 5.18 or later; select demo-memgraph or demo-falkordb for those databases), an AI provider ollama-embeddings with an embedding model (768 dimensions, for example nomic-embed-text) and an AI provider ollama-local with a chat model. Set Thinking to Off on ollama-local for thinking models. Run graphrag-index.hwf the first time: it creates the indexes.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/10 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/10 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname/>
      <fontsize>-1</fontsize>
      <height>48</height>
      <xloc>64</xloc>
      <yloc>400</yloc>
      <note>Documents -&gt; chunks -&gt; embeddings -&gt; Document and Chunk nodes.
Once every chunk is written: Extract graph -&gt; Entity nodes and MENTIONS, then RELATED_TO per type and source chunk.</note>
      <width>640</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Documents</from>
      <to>Split into chunks</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Split into chunks</from>
      <to>Chunk ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Chunk ID</from>
      <to>Embed chunks</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Embed chunks</from>
      <to>Write documents and chunks</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Chunk ID</from>
      <to>Hold the chunks</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hold the chunks</from>
      <to>Wait for the chunks</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for the chunks</from>
      <to>Extract graph</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Extract graph</from>
      <to>Entity keys</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Entity keys</from>
      <to>Entity?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Entity?</from>
      <to>Write mentions</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Entity?</from>
      <to>Collect relationships</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Collect relationships</from>
      <to>Wait for the entities</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait for the entities</from>
      <to>Write relationships</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Documents</name>
    <type>DataGrid</type>
    <description>Replace with your own documents, for example a Text file input</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>document_id</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>title</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
      <field>
        <set_empty_string>N</set_empty_string>
        <length>-1</length>
        <name>text</name>
        <precision>-1</precision>
        <type>String</type>
      </field>
    </fields>
    <data>
      <line>
        <item>ada-lovelace</item>
        <item>Ada Lovelace</item>
        <item>Ada Lovelace was a mathematician. She wrote the first published algorithm intended for a machine: a method to calculate Bernoulli numbers on the Analytical Engine.</item>
      </line>
      <line>
        <item>analytical-engine</item>
        <item>The Analytical Engine</item>
        <item>The Analytical Engine was a design for a mechanical general-purpose computer. Charles Babbage designed it and first described it in 1837.</item>
      </line>
      <line>
        <item>charles-babbage</item>
        <item>Charles Babbage</item>
        <item>Charles Babbage was a mathematician and inventor. He lived in London, where he built a working part of his earlier Difference Engine.</item>
      </line>
    </data>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Split into chunks</name>
    <type>TextChunker</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <inputField>text</inputField>
    <outputChunkField>chunk_text</outputChunkField>
    <contentTypeField/>
    <chunkingStrategy>STRUCTURE</chunkingStrategy>
    <chunkSize>1500</chunkSize>
    <chunkOverlap>200</chunkOverlap>
    <includeMetadata>Y</includeMetadata>
    <chunkIndexField>chunk_index</chunkIndexField>
    <chunkStartPosField>chunk_start_position</chunkStartPosField>
    <sourceDocumentIdField>document_id</sourceDocumentIdField>
    <documentIdField>document_id</documentIdField>
    <chunkCountField>total_chunks</chunkCountField>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Chunk ID</name>
    <type>ScriptValueMod</type>
    <description>Document ID and chunk index: the key of a chunk</description>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var chunk_id = document_id + "#" + chunk_index;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>chunk_id</name>
        <rename>chunk_id</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Embed chunks</name>
    <type>EmbedText</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <ai_provider>ollama-embeddings</ai_provider>
    <model_name/>
    <input_field>chunk_text</input_field>
    <output_field>embedding</output_field>
    <model_field/>
    <dimensions_field/>
    <include_model_metadata>N</include_model_metadata>
    <output_format>VECTOR</output_format>
    <batch_size>16</batch_size>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write documents and chunks</name>
    <type>Neo4jGraphOutput</type>
    <description>MERGE the Document and Chunk nodes and HAS_CHUNK; the embedding is a Chunk property</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>demo-neo4j</connection>
    <model>graphrag</model>
    <batch_size>100</batch_size>
    <create_indexes>N</create_indexes>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <validate_against_model>N</validate_against_model>
    <out_of_order_allowed>Y</out_of_order_allowed>
    <mappings>
      <mapping>
        <source_field>document_id</source_field>
        <target_type>Node</target_type>
        <target_name>Document</target_name>
        <target_property>id</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>title</source_field>
        <target_type>Node</target_type>
        <target_name>Document</target_name>
        <target_property>title</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>chunk_id</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>id</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>chunk_index</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>chunk_index</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>chunk_text</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>text</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>embedding</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>embedding</target_property>
        <target_hint>None</target_hint>
      </mapping>
    </mappings>
    <relationship_mappings>
    </relationship_mappings>
    <node_mappings>
    </node_mappings>
    <attributes/>
    <GUI>
      <xloc>800</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Hold the chunks</name>
    <type>BlockingTransform</type>
    <description>The graph is extracted once every chunk is written</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>5000</cache_size>
    <compress>Y</compress>
    <directory>${java.io.tmpdir}</directory>
    <pass_all_rows>Y</pass_all_rows>
    <prefix>graphrag</prefix>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wait for the chunks</name>
    <type>BlockUntilTransformsFinish</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <transforms>
      <transform>
        <name>Write documents and chunks</name>
        <CopyNr>0</CopyNr>
      </transform>
    </transforms>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Extract graph</name>
    <type>ExtractGraph</type>
    <description>Entities and relationships per chunk, with the chunk's fields</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <ai_provider>ollama-local</ai_provider>
    <model_name/>
    <input_field>chunk_text</input_field>
    <entity_types>Person, Machine, Place, Concept</entity_types>
    <relationship_types>DESIGNED, WROTE_ALGORITHM_FOR, LIVED_IN, BUILT, DESCRIBED</relationship_types>
    <instructions/>
    <pass_rows_without_results>N</pass_rows_without_results>
    <kind_field>graph_element</kind_field>
    <name_field>name</name_field>
    <type_field>type</type_field>
    <description_field>description</description_field>
    <source_field>source</source_field>
    <target_field>target</target_field>
    <attributes/>
    <GUI>
      <xloc>800</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Entity keys</name>
    <type>ScriptValueMod</type>
    <description>Lowercase without spaces or punctuation, so 'Hop Run' and 'hop-run' are one entity</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function entityKey(name) {
  if (name == null) {
    return null;
  }
  return ("" + name).toLowerCase().replace(/[^a-z0-9+#]/g, "");
}
var key = entityKey(name);
var source_key = entityKey(source);
var target_key = entityKey(target);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>key</name>
        <rename>key</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>source_key</name>
        <rename>source_key</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>target_key</name>
        <rename>target_key</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>992</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Entity?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
        </conditions>
        <function>=</function>
        <leftvalue>graph_element</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <mask/>
          <name>constant</name>
          <precision>-1</precision>
          <text>ENTITY</text>
          <type>String</type>
        </value>
      </condition>
    </compare>
    <send_false_to>Collect relationships</send_false_to>
    <send_true_to>Write mentions</send_true_to>
    <attributes/>
    <GUI>
      <xloc>1152</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write mentions</name>
    <type>Neo4jGraphOutput</type>
    <description>MERGE an Entity per key and the chunk's MENTIONS relationship to it</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>demo-neo4j</connection>
    <model>graphrag</model>
    <batch_size>100</batch_size>
    <create_indexes>N</create_indexes>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <validate_against_model>N</validate_against_model>
    <out_of_order_allowed>Y</out_of_order_allowed>
    <mappings>
      <mapping>
        <source_field>chunk_id</source_field>
        <target_type>Node</target_type>
        <target_name>Chunk</target_name>
        <target_property>id</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>key</source_field>
        <target_type>Node</target_type>
        <target_name>Entity</target_name>
        <target_property>key</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>name</source_field>
        <target_type>Node</target_type>
        <target_name>Entity</target_name>
        <target_property>name</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>type</source_field>
        <target_type>Node</target_type>
        <target_name>Entity</target_name>
        <target_property>type</target_property>
        <target_hint>None</target_hint>
      </mapping>
      <mapping>
        <source_field>description</source_field>
        <target_type>Node</target_type>
        <target_name>Entity</target_name>
        <target_property>description</target_property>
        <target_hint>None</target_hint>
      </mapping>
    </mappings>
    <relationship_mappings>
    </relationship_mappings>
    <node_mappings>
    </node_mappings>
    <attributes/>
    <GUI>
      <xloc>1344</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Collect relationships</name>
    <type>BlockingTransform</type>
    <description>Reads all relationship rows first</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>5000</cache_size>
    <compress>Y</compress>
    <directory>${java.io.tmpdir}</directory>
    <pass_all_rows>Y</pass_all_rows>
    <prefix>graphrag</prefix>
    <attributes/>
    <GUI>
      <xloc>1152</xloc>
      <yloc>416</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wait for the entities</name>
    <type>BlockUntilTransformsFinish</type>
    <description>Relationships are written once every entity is</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <transforms>
      <transform>
        <name>Write mentions</name>
        <CopyNr>0</CopyNr>
      </transform>
    </transforms>
    <attributes/>
    <GUI>
      <xloc>1344</xloc>
      <yloc>416</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write relationships</name>
    <type>Neo4jCypherOutput</type>
    <description>One RELATED_TO per type and source chunk. Graph output merges a relationship on its two nodes only, so a second type between the same entities would overwrite the first.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>demo-neo4j</connection>
    <cypher>MATCH (s:Entity {key: $source_key}), (t:Entity {key: $target_key})
MERGE (s)-[r:RELATED_TO {type: $type, chunk_id: $chunk_id}]-&gt;(t)
SET r.description = $description</cypher>
    <batch_size>1</batch_size>
    <read_only>N</read_only>
    <nr_retries_on_error/>
    <retry>N</retry>
    <cypher_from_field>N</cypher_from_field>
    <cypher_field/>
    <unwind>N</unwind>
    <unwind_map/>
    <returning_graph>N</returning_graph>
    <return_graph_field/>
    <mappings>
      <mapping>
        <parameter>source_key</parameter>
        <field>source_key</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>target_key</parameter>
        <field>target_key</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>type</parameter>
        <field>type</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>chunk_id</parameter>
        <field>chunk_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>description</parameter>
        <field>description</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>

    </returns>
    <attributes/>
    <GUI>
      <xloc>1536</xloc>
      <yloc>416</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

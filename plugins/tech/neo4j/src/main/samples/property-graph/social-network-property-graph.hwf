<workflow>
  <name>social-network-property-graph</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Create the SOCIAL_NETWORK property graph from the social-network graph model, load its
    tables and query it with GRAPH_TABLE. Needs a relational database connection called oracle-23ai
    to Oracle Database 23ai or another database with SQL/PGQ (SQL:2023) property graphs.</description>
  <extended_description />
  <workflow_version />
  <created_user>-</created_user>
  <created_date>2026/10/07 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/07 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description />
      <type>SPECIAL</type>
      <attributes />
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Create property graph</name>
      <description>Create the Person, Company, KNOWS and WORKS_AT tables when they don't exist yet, and
        the SOCIAL_NETWORK property graph on top of them</description>
      <type>CREATE_PROPERTY_GRAPH</type>
      <attributes />
      <connection>oracle-23ai</connection>
      <schema />
      <graph_name>SOCIAL_NETWORK</graph_name>
      <graph_model>social-network</graph_model>
      <create_tables>Y</create_tables>
      <replace_graph>Y</replace_graph>
      <node_tables>
      </node_tables>
      <edge_tables>
      </edge_tables>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Load the node and edge tables</name>
      <description />
      <type>PIPELINE</type>
      <attributes />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/property-graph/social-network-load-tables.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Query the graph</name>
      <description />
      <type>PIPELINE</type>
      <attributes />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/property-graph/social-network-query.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>656</xloc>
      <yloc>96</yloc>
      <attributes_hac />
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create property graph</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create property graph</from>
      <to>Load the node and edge tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load the node and edge tables</from>
      <to>Query the graph</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>75</heigth>
      <xloc>64</xloc>
      <yloc>176</yloc>
      <note>Needs Oracle Database 23ai or another database with SQL/PGQ (SQL:2023) property graphs.
Create a relational database connection called oracle-23ai, or select your own connection
in the action and in both pipelines. Running it again replaces the graph and reloads the tables.</note>
      <width>656</width>
    </notepad>
  </notepads>
  <attributes />
</workflow>

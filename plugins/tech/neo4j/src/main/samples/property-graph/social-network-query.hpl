<pipeline>
  <info>
    <name>social-network-query</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Query the SOCIAL_NETWORK property graph with GRAPH_TABLE: the people each person knows and where
      they work. Needs a relational database connection called oracle-23ai.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>45</heigth>
      <xloc>64</xloc>
      <yloc>32</yloc>
      <note>GRAPH_TABLE matches a graph pattern and returns the COLUMNS as a table.
Here: every person, the people they know, since when, and the company those people work at.</note>
      <width>560</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Friends and their companies</from>
      <to>Write to log</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Friends and their companies</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>oracle-23ai</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT *
FROM GRAPH_TABLE ( SOCIAL_NETWORK
  MATCH (p IS Person) -[k IS KNOWS]-&gt; (f IS Person) -[w IS WORKS_AT]-&gt; (c IS Company)
  COLUMNS (p.name AS person, f.name AS friend, k.since AS since, c.name AS friend_works_at) )
ORDER BY person, friend</sql>
    <variables_active>N</variables_active>
    <attributes />
    <GUI>
      <xloc>112</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write to log</name>
    <type>WriteToLog</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage />
    <loglevel>log_level_basic</loglevel>
    <fields>
    </fields>
    <attributes />
    <GUI>
      <xloc>336</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>

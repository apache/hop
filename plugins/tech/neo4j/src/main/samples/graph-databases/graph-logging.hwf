<workflow>
  <name>graph-logging</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Log executions to a graph database: set HOP_GRAPH_LOGGING_CONNECTION and run a pipeline twice. Needs the graph database connection demo-neo4j.</description>
  <extended_description />
  <workflow_version />
  <created_user>-</created_user>
  <created_date>2026/10/07 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/07 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description />
      <type>SPECIAL</type>
      <attributes />
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Log to demo-neo4j</name>
      <description />
      <type>SET_VARIABLES</type>
      <attributes />
      <replacevars>Y</replacevars>
      <filename />
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <fields>
        <field>
          <variable_name>HOP_GRAPH_LOGGING_CONNECTION</variable_name>
          <variable_value>demo-neo4j</variable_value>
          <variable_type>CURRENT_WORKFLOW</variable_type>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>First run</name>
      <description />
      <type>PIPELINE</type>
      <attributes />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/graph-databases/graph-logging-info.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Second run</name>
      <description />
      <type>PIPELINE</type>
      <attributes />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/graph-databases/graph-logging-info.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>592</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Log to demo-neo4j</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Log to demo-neo4j</from>
      <to>First run</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>First run</from>
      <to>Second run</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>90</heigth>
      <xloc>48</xloc>
      <yloc>176</yloc>
      <note>Hop logs the executions of workflows and pipelines to a graph database when the variable
HOP_GRAPH_LOGGING_CONNECTION names a graph database connection. Here the Set variables action sets it
for this workflow; to log everything, set it in the project or environment instead.
The second run of graph-logging-info.hpl finds the first one. Look at the logged executions
in the Graph logging perspective. Works on Neo4j, Memgraph, Neptune, FalkorDB and Apache AGE.</note>
      <width>680</width>
    </notepad>
  </notepads>
  <attributes />
</workflow>

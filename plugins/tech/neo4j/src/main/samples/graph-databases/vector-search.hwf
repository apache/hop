<workflow>
  <name>vector-search</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Create vector indexes on nodes and relationships, write documents with embeddings and search them. Needs the graph database connection demo-neo4j to Neo4j 5.18 or later.</description>
  <extended_description />
  <workflow_version />
  <created_user>-</created_user>
  <created_date>2026/10/07 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/07 12:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description />
      <type>SPECIAL</type>
      <attributes />
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Check connection</name>
      <description />
      <type>NEO4J_CHECK_CONNECTIONS</type>
      <attributes />
      <connections>
        <connection>demo-neo4j</connection>
      </connections>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Drop vector indexes</name>
      <description />
      <type>NEO4J_INDEX</type>
      <attributes />
      <connection>demo-neo4j</connection>
      <updates>
        <update>
          <index_name>doc_embeddings</index_name>
          <object_name>Doc</object_name>
          <object_properties>embedding</object_properties>
          <object_type>NODE</object_type>
          <update_type>DROP</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
          <vector_capacity>1000</vector_capacity>
        </update>
        <update>
          <index_name>about_embeddings</index_name>
          <object_name>ABOUT</object_name>
          <object_properties>embedding</object_properties>
          <object_type>RELATIONSHIP</object_type>
          <update_type>DROP</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
          <vector_capacity>1000</vector_capacity>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>Create vector indexes</name>
      <description />
      <type>NEO4J_INDEX</type>
      <attributes />
      <connection>demo-neo4j</connection>
      <updates>
        <update>
          <index_name>doc_embeddings</index_name>
          <object_name>Doc</object_name>
          <object_properties>embedding</object_properties>
          <object_type>NODE</object_type>
          <update_type>CREATE</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
          <vector_capacity>1000</vector_capacity>
        </update>
        <update>
          <index_name>about_embeddings</index_name>
          <object_name>ABOUT</object_name>
          <object_properties>embedding</object_properties>
          <object_type>RELATIONSHIP</object_type>
          <update_type>CREATE</update_type>
          <index_type>VECTOR</index_type>
          <vector_dimensions>3</vector_dimensions>
          <vector_similarity>COSINE</vector_similarity>
          <vector_capacity>1000</vector_capacity>
        </update>
      </updates>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>vector-search-load.hpl</name>
      <description />
      <type>PIPELINE</type>
      <attributes />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/graph-databases/vector-search-load.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>720</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
    <action>
      <name>vector-search-query.hpl</name>
      <description />
      <type>PIPELINE</type>
      <attributes />
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/graph-databases/vector-search-query.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>896</xloc>
      <yloc>80</yloc>
      <attributes_hac />
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Check connection</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Check connection</from>
      <to>Drop vector indexes</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Drop vector indexes</from>
      <to>Create vector indexes</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create vector indexes</from>
      <to>vector-search-load.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>vector-search-load.hpl</from>
      <to>vector-search-query.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>150</heigth>
      <xloc>48</xloc>
      <yloc>192</yloc>
      <note>Vectors in a graph database, from index to search:
1. Check graph database connections: is demo-neo4j available?
2. Graph index: drop the vector indexes of an earlier run (a failure is fine), then create them,
    index type VECTOR, on Doc.embedding (nodes) and ABOUT.embedding (relationships), 3 dimensions.
3. vector-search-load.hpl writes Vector fields with Graph output.
4. vector-search-query.hpl searches them with Graph vector search.
demo-neo4j uses the variables NEO4J_HOSTNAME, NEO4J_PORT, NEO4J_USERNAME and NEO4J_PASSWORD.
Memgraph and FalkorDB have vector indexes too: change the connection of the actions and transforms
to demo-memgraph or demo-falkordb. Apache AGE, Neptune and Gremlin servers don't.</note>
      <width>700</width>
    </notepad>
  </notepads>
  <attributes />
</workflow>

<pipeline>
  <info>
    <name>vector-search-query</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Find the documents, and the document-topic relationships, nearest to a question vector with the Graph vector search transform. Run it from vector-search.hwf.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>75</heigth>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <note>Graph vector search finds the nodes, or the relationships, nearest to the vector of every row,
through a vector index: one output row per node or relationship found, with its score.
Neo4j and Memgraph find the index by its name, FalkorDB by label (or relationship type) and property:
both are filled in, so the transforms work on all three.</note>
      <width>640</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Questions</from>
      <to>Nearest documents</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Questions</from>
      <to>Nearest passages</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Nearest documents</from>
      <to>Log documents</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Nearest passages</from>
      <to>Log passages</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Questions</name>
    <type>DataGrid</type>
    <description>Copies every row to both searches</description>
    <distribute>N</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>question</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>question_embedding</name>
        <type>Vector</type>
      </field>
    </fields>
    <data>
      <line>
        <item>How is beer brewed?</item>
        <item>[0.85,0.15,0.05]</item>
      </line>
      <line>
        <item>What is a vector index?</item>
        <item>[0.05,0.75,0.5]</item>
      </line>
    </data>
    <attributes />
    <GUI>
      <xloc>80</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Nearest documents</name>
    <type>GraphVectorSearch</type>
    <description>Searches the vector index on Doc.embedding</description>
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>demo-neo4j</connection>
    <element_type>NODE</element_type>
    <index_name>doc_embeddings</index_name>
    <label>Doc</label>
    <vector_property>embedding</vector_property>
    <similarity>COSINE</similarity>
    <embedding_field>question_embedding</embedding_field>
    <top_k>2</top_k>
    <min_score />
    <eat_row_on_no_match>N</eat_row_on_no_match>
    <score_field>score</score_field>
    <return_properties>
      <return_property>
        <property>id</property>
        <field_name>doc_id</field_name>
        <type>String</type>
      </return_property>
      <return_property>
        <property>title</property>
        <field_name></field_name>
        <type>String</type>
      </return_property>
    </return_properties>
    <attributes />
    <GUI>
      <xloc>320</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Nearest passages</name>
    <type>GraphVectorSearch</type>
    <description>Searches the vector index on the embedding of the ABOUT relationships</description>
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>demo-neo4j</connection>
    <element_type>RELATIONSHIP</element_type>
    <index_name>about_embeddings</index_name>
    <label>ABOUT</label>
    <vector_property>embedding</vector_property>
    <similarity>COSINE</similarity>
    <embedding_field>question_embedding</embedding_field>
    <top_k>2</top_k>
    <min_score />
    <eat_row_on_no_match>N</eat_row_on_no_match>
    <score_field>score</score_field>
    <return_properties>
      <return_property>
        <property>passage</property>
        <field_name></field_name>
        <type>String</type>
      </return_property>
    </return_properties>
    <attributes />
    <GUI>
      <xloc>320</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Log documents</name>
    <type>WriteToLog</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>Nearest documents</logmessage>
    <loglevel>log_level_basic</loglevel>
    <fields>
    </fields>
    <attributes />
    <GUI>
      <xloc>560</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Log passages</name>
    <type>WriteToLog</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>Nearest ABOUT relationships</logmessage>
    <loglevel>log_level_basic</loglevel>
    <fields>
    </fields>
    <attributes />
    <GUI>
      <xloc>560</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>

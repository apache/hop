<pipeline>
  <info>
    <name>graph-csv-export</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Turn rows into graph values with Graph output, without a database, split them with Split graph and write them to CSV files with plain column names with Generate graph CSVs.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>120</heigth>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <note>No database needed: with 'Return graph data' on, Graph output builds a graph value per row
through the social-network model instead of writing to a database.
Split graph turns each graph into one row per node and relationship.
Generate graph CSVs writes a file per label and relationship type below
${java.io.tmpdir}/hop-samples-graph-csv/import. CSV header format 'Plain column names' gives headers
like code,name,label and start_id,end_id,type, for LOAD CSV or the import tool of any database.
Choose 'neo4j-admin import' for the id:ID, :LABEL, :START_ID headers of neo4j-admin import.</note>
      <width>660</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>People and companies</from>
      <to>Build graphs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build graphs</from>
      <to>Generate graph CSVs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build graphs</from>
      <to>Split graph</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Generate graph CSVs</from>
      <to>Files written</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Split graph</from>
      <to>Nodes and relationships</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>People and companies</name>
    <type>DataGrid</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>person_id</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>person_name</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>company_code</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>company_name</name>
        <type>String</type>
      </field>
    </fields>
    <data>
      <line>
        <item>1</item>
        <item>Ann</item>
        <item>ACME</item>
        <item>Acme Corporation</item>
      </line>
      <line>
        <item>2</item>
        <item>Bob</item>
        <item>ACME</item>
        <item>Acme Corporation</item>
      </line>
      <line>
        <item>3</item>
        <item>Cleo</item>
        <item>GLOBEX</item>
        <item>Globex</item>
      </line>
      <line>
        <item>4</item>
        <item>Dan</item>
        <item>INITECH</item>
        <item>Initech</item>
      </line>
    </data>
    <attributes />
    <GUI>
      <xloc>80</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Build graphs</name>
    <type>Neo4jGraphOutput</type>
    <description>Returns a graph value in field graph, no connection needed</description>
    <distribute>N</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <batch_size>100</batch_size>
    <connection></connection>
    <create_indexes>N</create_indexes>
    <mappings>
      <mapping>
        <source_field>person_id</source_field>
        <target_hint>None</target_hint>
        <target_name>Person</target_name>
        <target_property>id</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>person_name</source_field>
        <target_hint>None</target_hint>
        <target_name>Person</target_name>
        <target_property>name</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>company_code</source_field>
        <target_hint>None</target_hint>
        <target_name>Company</target_name>
        <target_property>code</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>company_name</source_field>
        <target_hint>None</target_hint>
        <target_name>Company</target_name>
        <target_property>name</target_property>
        <target_type>Node</target_type>
      </mapping>
    </mappings>
    <model>social-network</model>
    <node_mappings>
    </node_mappings>
    <out_of_order_allowed>N</out_of_order_allowed>
    <relationship_mappings>
    </relationship_mappings>
    <return_graph_field>graph</return_graph_field>
    <returning_graph>Y</returning_graph>
    <validate_against_model>N</validate_against_model>
    <attributes />
    <GUI>
      <xloc>288</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Generate graph CSVs</name>
    <type>Neo4jLoad</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <base_folder>${java.io.tmpdir}/hop-samples-graph-csv</base_folder>
    <file_type_field>file_type</file_type_field>
    <filename_field>filename</filename_field>
    <files_prefix>social</files_prefix>
    <header_format>PLAIN</header_format>
    <graph_field_name>graph</graph_field_name>
    <uniqueness_strategy>First</uniqueness_strategy>
    <attributes />
    <GUI>
      <xloc>512</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Split graph</name>
    <type>Neo4jSplitGraph</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <graph_field>graph</graph_field>
    <type_field>type</type_field>
    <id_field>id</id_field>
    <property_set_field>property_set</property_set_field>
    <attributes />
    <GUI>
      <xloc>512</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Files written</name>
    <type>WriteToLog</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage />
    <loglevel>log_level_basic</loglevel>
    <fields>
    </fields>
    <attributes />
    <GUI>
      <xloc>720</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Nodes and relationships</name>
    <type>WriteToLog</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage />
    <loglevel>log_level_basic</loglevel>
    <fields>
    </fields>
    <attributes />
    <GUI>
      <xloc>720</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>

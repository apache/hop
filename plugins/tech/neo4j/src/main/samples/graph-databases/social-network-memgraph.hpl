<pipeline>
  <info>
    <name>social-network-memgraph</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Write a small social network with Graph output and read it back, on Memgraph. Needs the graph database connection demo-memgraph.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/07 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/07 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <heigth>90</heigth>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <note>Writes four people and the companies they work at with the Graph output transform and the social-network graph model: a Person and a Company node per row and the WORKS_AT relationship between them.
Then reads them back. Needs the graph database connection demo-memgraph to Memgraph.
The Cypher builder builds MATCH (p:Person) MATCH (p)-[w:WORKS_AT]-&gt;(c) RETURN c.name, count(p).
demo-memgraph uses the variables MEMGRAPH_HOSTNAME and MEMGRAPH_PORT (7687). The same transforms work on
Neo4j, Amazon Neptune, FalkorDB and Apache AGE: change the connection.</note>
      <width>720</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>People and companies</from>
      <to>Write the graph</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write the graph</from>
      <to>Wait until written</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Wait until written</from>
      <to>Employees per company</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Employees per company</from>
      <to>Write to log</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>People and companies</name>
    <type>DataGrid</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>person_id</name>
        <type>Integer</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>person_name</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>company_code</name>
        <type>String</type>
      </field>
      <field>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <name>company_name</name>
        <type>String</type>
      </field>
    </fields>
    <data>
      <line>
        <item>1</item>
        <item>Ann</item>
        <item>ACME</item>
        <item>Acme Corporation</item>
      </line>
      <line>
        <item>2</item>
        <item>Bob</item>
        <item>ACME</item>
        <item>Acme Corporation</item>
      </line>
      <line>
        <item>3</item>
        <item>Cleo</item>
        <item>GLOBEX</item>
        <item>Globex</item>
      </line>
      <line>
        <item>4</item>
        <item>Dan</item>
        <item>INITECH</item>
        <item>Initech</item>
      </line>
    </data>
    <attributes />
    <GUI>
      <xloc>80</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write the graph</name>
    <type>Neo4jGraphOutput</type>
    <description>Person and Company nodes and WORKS_AT relationships, merged on their primary properties</description>
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <batch_size>100</batch_size>
    <connection>demo-memgraph</connection>
    <create_indexes>N</create_indexes>
    <mappings>
      <mapping>
        <source_field>person_id</source_field>
        <target_hint>None</target_hint>
        <target_name>Person</target_name>
        <target_property>id</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>person_name</source_field>
        <target_hint>None</target_hint>
        <target_name>Person</target_name>
        <target_property>name</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>company_code</source_field>
        <target_hint>None</target_hint>
        <target_name>Company</target_name>
        <target_property>code</target_property>
        <target_type>Node</target_type>
      </mapping>
      <mapping>
        <source_field>company_name</source_field>
        <target_hint>None</target_hint>
        <target_name>Company</target_name>
        <target_property>name</target_property>
        <target_type>Node</target_type>
      </mapping>
    </mappings>
    <model>social-network</model>
    <node_mappings>
    </node_mappings>
    <out_of_order_allowed>N</out_of_order_allowed>
    <relationship_mappings>
    </relationship_mappings>
    <return_graph_field>graph</return_graph_field>
    <returning_graph>N</returning_graph>
    <validate_against_model>N</validate_against_model>
    <attributes />
    <GUI>
      <xloc>288</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Wait until written</name>
    <type>BlockingTransform</type>
    <description>Passes only the last row on, after all rows are written, so the query runs once</description>
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <cache_size>5000</cache_size>
    <compress>Y</compress>
    <directory>${java.io.tmpdir}</directory>
    <pass_all_rows>N</pass_all_rows>
    <prefix>block</prefix>
    <attributes />
    <GUI>
      <xloc>496</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Employees per company</name>
    <type>Neo4jCypherBuilder</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connectionName>demo-memgraph</connectionName>
    <batchSize>1</batchSize>
    <retries>0</retries>
    <parameters>
    </parameters>
    <operations>
      <operation>
        <operationType>MATCH</operationType>
        <labels>Person</labels>
        <alias>p</alias>
      </operation>
      <operation>
        <operationType>EDGE_MATCH</operationType>
        <sourceAlias>p</sourceAlias>
        <edgeAlias>w</edgeAlias>
        <edgeLabel>WORKS_AT</edgeLabel>
        <targetAlias>c</targetAlias>
      </operation>
      <operation>
        <operationType>RETURN</operationType>
        <returnValues>
          <expression>c.name</expression>
          <rename>company</rename>
          <neoType>String</neoType>
          <hopType>String</hopType>
        </returnValues>
        <returnValues>
          <expression>count(p)</expression>
          <rename>employees</rename>
          <neoType>Integer</neoType>
          <hopType>Integer</hopType>
        </returnValues>
      </operation>
    </operations>
    <attributes />
    <GUI>
      <xloc>704</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write to log</name>
    <type>WriteToLog</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage />
    <loglevel>log_level_basic</loglevel>
    <fields>
    </fields>
    <attributes />
    <GUI>
      <xloc>912</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes />
</pipeline>

<transform>
    <connection>graph</connection>
    <index_name>doc_embeddings</index_name>
    <label>Doc</label>
    <vector_property>embedding</vector_property>
    <similarity>EUCLIDEAN</similarity>
    <embedding_field>query_vector</embedding_field>
    <top_k>3</top_k>
    <min_score>0.5</min_score>
    <eat_row_on_no_match>Y</eat_row_on_no_match>
    <score_field>similarity</score_field>
    <return_properties>
        <return_property>
            <property>id</property>
            <field_name>doc_id</field_name>
            <type>Integer</type>
        </return_property>
        <return_property>
            <property>text</property>
            <field_name/>
            <type/>
        </return_property>
    </return_properties>
</transform>

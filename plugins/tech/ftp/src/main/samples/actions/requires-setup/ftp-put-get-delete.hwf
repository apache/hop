<workflow>
  <name>ftp-put-get-delete</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/07 10:00:00.000</created_date>
  <modified_date>2026/10/07 10:00:00.000</modified_date>
  <created_hop_version/>
  <modified_hop_version/>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${java.io.tmpdir}/hop-samples/ftp/hop-ftp-sample.txt</filename>
      <createParentFolder>Y</createParentFolder>
      <appendFile>N</appendFile>
      <content>Uploaded by Apache Hop</content>
      <encoding>UTF-8</encoding>
      <name>Write file</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <attributes/>
      <xloc>272</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection/>
      <servername>${FTP_SERVER}</servername>
      <serverport>${FTP_PORT}</serverport>
      <username>${FTP_USER}</username>
      <password>${FTP_PASSWORD}</password>
      <remoteDirectory/>
      <localDirectory>${java.io.tmpdir}/hop-samples/ftp</localDirectory>
      <wildcard>hop-ftp-sample\.txt</wildcard>
      <binary>N</binary>
      <timeout>0</timeout>
      <remove>N</remove>
      <only_new>N</only_new>
      <active>N</active>
      <control_encoding>ISO-8859-1</control_encoding>
      <proxy_host/>
      <proxy_port/>
      <proxy_username/>
      <proxy_password>Encrypted </proxy_password>
      <socksproxy_host/>
      <socksproxy_port>1080</socksproxy_port>
      <socksproxy_username/>
      <socksproxy_password>Encrypted </socksproxy_password>
      <name>Put a file with FTP</name>
      <description/>
      <type>FTP_PUT</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection/>
      <servername>${FTP_SERVER}</servername>
      <username>${FTP_USER}</username>
      <password>${FTP_PASSWORD}</password>
      <ftpdirectory/>
      <targetdirectory>${java.io.tmpdir}/hop-samples/ftp/download</targetdirectory>
      <wildcard>hop-ftp-sample\.txt</wildcard>
      <binary>N</binary>
      <timeout>0</timeout>
      <remove>N</remove>
      <only_new>N</only_new>
      <active>N</active>
      <control_encoding>ISO-8859-1</control_encoding>
      <movefiles>N</movefiles>
      <movetodirectory/>
      <adddate>N</adddate>
      <addtime>N</addtime>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <AddDateBeforeExtension>N</AddDateBeforeExtension>
      <isaddresult>N</isaddresult>
      <createmovefolder>N</createmovefolder>
      <port>${FTP_PORT}</port>
      <proxy_host/>
      <proxy_port/>
      <proxy_username/>
      <proxy_password>Encrypted </proxy_password>
      <socksproxy_host/>
      <socksproxy_port>1080</socksproxy_port>
      <socksproxy_username/>
      <socksproxy_password>Encrypted </socksproxy_password>
      <ifFileExists>ifFileExistsSkip</ifFileExists>
      <nr_limit>10</nr_limit>
      <success_condition>success_if_no_errors</success_condition>
      <name>Get a file with FTP</name>
      <description/>
      <type>FTP</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection/>
      <sftp_connection/>
      <servername>${FTP_SERVER}</servername>
      <port>${FTP_PORT}</port>
      <username>${FTP_USER}</username>
      <password>${FTP_PASSWORD}</password>
      <ftpdirectory/>
      <wildcard>hop-ftp-sample\.txt</wildcard>
      <timeout>0</timeout>
      <active>N</active>
      <publicpublickey>N</publicpublickey>
      <keyfilename/>
      <keyfilepass>Encrypted </keyfilepass>
      <useproxy>N</useproxy>
      <proxy_host/>
      <proxy_port/>
      <proxy_username/>
      <proxy_password>Encrypted </proxy_password>
      <socksproxy_host/>
      <socksproxy_port>1080</socksproxy_port>
      <socksproxy_username/>
      <socksproxy_password>Encrypted </socksproxy_password>
      <protocol>FTP</protocol>
      <nr_limit_success>10</nr_limit_success>
      <success_condition>success_if_no_errors</success_condition>
      <copyprevious>N</copyprevious>
      <name>FTP delete</name>
      <description/>
      <type>FTP_DELETE</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <logmessage>The file was uploaded, downloaded and deleted.</logmessage>
      <name>Done</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>1040</xloc>
      <yloc>400</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Write file</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Write file</from>
      <to>Put a file with FTP</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Put a file with FTP</from>
      <to>Get a file with FTP</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get a file with FTP</from>
      <to>FTP delete</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>FTP delete</from>
      <to>Done</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>The FTP actions transfer files to and from an FTP server: Put a file with FTP uploads files, Get a file with FTP downloads them and FTP delete removes them.
Files are selected with a regular expression. Instead of a server name and credentials, the actions can also use an FTP connection from the project metadata.

This sample writes a file to ${java.io.tmpdir}/hop-samples/ftp, uploads it, downloads it again to ${java.io.tmpdir}/hop-samples/ftp/download and deletes it from the server.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>1120</width>
      <height>156</height>
    </notepad>
    <notepad>
      <note>Requires setup: this sample needs an FTP server. Set the FTP_SERVER, FTP_PORT, FTP_USER and FTP_PASSWORD variables
(for example in an environment configuration file) before running it.
This sample is excluded from the samples integration tests.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>110</fontcolorred>
      <fontcolorgreen>50</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>220</backgroundcolorgreen>
      <backgroundcolorblue>180</backgroundcolorblue>
      <bordercolorred>230</bordercolorred>
      <bordercolorgreen>126</bordercolorgreen>
      <bordercolorblue>34</bordercolorblue>
      <xloc>80</xloc>
      <yloc>204</yloc>
      <width>1120</width>
      <height>110</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.hop</groupId>
        <artifactId>hop-plugins-tech</artifactId>
        <version>2.20.0-SNAPSHOT</version>
    </parent>

    <artifactId>hop-tech-ftp</artifactId>
    <packaging>jar</packaging>

    <name>Hop Plugins Technology FTP</name>

    <properties>
        <!-- The FTP delete action talks SFTP through the client of the SFTP technology plugin. It
             sees it through the shared "sftp" class loader group, so the jar must not be copied
             into lib/core on top of that. -->
        <hop.libcore.exclude1>org.apache.hop:hop-tech-sftp</hop.libcore.exclude1>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.hop</groupId>
                <artifactId>hop-libs</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- The FTP delete action can talk SFTP as well: it uses the SFTP client of the SFTP
             technology plugin.  Both plugins share the "sftp" class loader group at runtime. -->
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-tech-sftp</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Embedded FTP/FTPS server, used to verify that the ftp:// and ftps:// schemes and the
             named connections behind them actually exchange bytes. Test scope only. -->
        <dependency>
            <groupId>org.apache.ftpserver</groupId>
            <artifactId>ftpserver-core</artifactId>
            <version>1.2.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Embedded SSH server, to cover the (deprecated) SFTP protocol of the delete action.
             jsch comes with it because the SFTP client of the technology plugin is compiled
             against it and that plugin keeps it 'provided', so it isn't inherited here. -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>2.16.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
            <version>2.16.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>

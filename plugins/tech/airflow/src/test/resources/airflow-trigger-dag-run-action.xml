<action>
    <name>Trigger Airflow DAG run</name>
    <description/>
    <type>AIRFLOW_TRIGGER_DAG_RUN</type>
    <connection>airflow</connection>
    <dag_id>daily_load</dag_id>
    <dag_run_id>hop-${RUN_ID}</dag_run_id>
    <logical_date>2026-11-21T10:00:00+01:00</logical_date>
    <conf_json>{"count": 3}</conf_json>
    <conf>
        <entry>
            <name>greeting</name>
            <value>hello</value>
        </entry>
        <entry>
            <name>source</name>
            <value>${SOURCE}</value>
        </entry>
    </conf>
    <wait_for_completion>N</wait_for_completion>
    <poll_interval_seconds>5</poll_interval_seconds>
    <timeout_seconds>600</timeout_seconds>
    <dag_run_id_variable>RUN</dag_run_id_variable>
    <state_variable>STATE</state_variable>
</action>

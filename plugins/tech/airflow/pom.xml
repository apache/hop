<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.hop</groupId>
        <artifactId>hop-plugins-tech</artifactId>
        <version>2.21.0-SNAPSHOT</version>
    </parent>

    <artifactId>hop-tech-airflow</artifactId>
    <packaging>jar</packaging>
    <name>Hop Plugins Technology Airflow</name>
    <description>Apache Airflow connection, the Trigger Airflow DAG run action and running workflows as Airflow DAGs</description>

    <properties>
        <!-- The launcher is unpacked in launcher/ by the assembly, never put on Hop's class path -->
        <hop.libcore.exclude1>org.apache.hop:hop-tech-airflow-launcher</hop.libcore.exclude1>
    </properties>

    <dependencies>
        <!-- The plugin uses only the launcher's constants, which the compiler copies: Hop never
             loads the launcher or the Airflow SDK. -->
        <dependency>
            <groupId>org.apache.hop</groupId>
            <artifactId>hop-tech-airflow-launcher</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- WireMock for the Airflow REST API client tests -->
        <dependency>
            <groupId>com.github.tomakehurst</groupId>
            <artifactId>wiremock-jre8-standalone</artifactId>
            <version>2.35.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- The launcher with its libraries, which the assembly unpacks in launcher/. Only when the
             module zips are built, as the root pom's assembly profile: with -Dmodule.zips=false
             the launcher builds no zip either. -->
        <profile>
            <id>launcher-zip</id>
            <activation>
                <property>
                    <name>module.zips</name>
                    <value>!false</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.hop</groupId>
                    <artifactId>hop-tech-airflow-launcher</artifactId>
                    <version>${project.version}</version>
                    <type>zip</type>
                    <scope>provided</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>

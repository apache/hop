<transform>
  <name>CDC</name>
  <type>BeamDebeziumInput</type>
  <connector>PostgreSQL</connector>
  <connector_class/>
  <hostname>${CDC_HOST}</hostname>
  <port>5432</port>
  <username>cdc_user</username>
  <password>${CDC_PASSWORD}</password>
  <connector_properties>{"database.dbname":"${CDC_DB}","plugin.name":"pgoutput","topic.prefix":"hop-cdc"}</connector_properties>
  <json_field>change</json_field>
  <max_records>25</max_records>
  <max_time_ms>3000</max_time_ms>
  <polling_timeout_ms>100</polling_timeout_ms>
</transform>

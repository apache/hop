<!--
  Debian/Ubuntu Maven (3.8.7 on 24.04, 3.9.12 on 26.04) uses distro Sisu
  0.3.4/0.3.5. That Sisu's shaded ASM only reads class files through Java 14,
  so it cannot index plexus-compiler-eclipse 2.17.0 (Java 17, @Named). The
  compiler class itself runs fine on JDK 21; only the scan fails. This Plexus
  descriptor registers compilerId=eclipse without ASM-indexing that class.
-->
<component-set>
  <components>
    <component>
      <role>org.codehaus.plexus.compiler.Compiler</role>
      <role-hint>eclipse</role-hint>
      <implementation>org.codehaus.plexus.compiler.eclipse.EclipseJavaCompiler</implementation>
      <isolated-realm>false</isolated-realm>
    </component>
  </components>
</component-set>

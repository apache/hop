# Sample systemd unit for a Hop Server that uses a git checkout of the
# project. The environment already references the project, so -e is enough.
# Install to /etc/systemd/system/hop-server.service and adjust the paths.

[Unit]
Description=Apache Hop Server
After=network.target

[Service]
Type=simple
User=hop
Group=hop
Environment=HOP_CONFIG_FOLDER=/etc/hop/config
Environment=HOP_SERVER_SHUTDOWN_TIMEOUT=120
WorkingDirectory=/opt/hop
ExecStart=/opt/hop/hop-server.sh -e prod /etc/hop/hop-server.xml
TimeoutStopSec=130
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
